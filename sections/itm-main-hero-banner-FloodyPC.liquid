<section
  class="hero color-{{ section.settings.color_scheme }} gradient"
  style="--hero-max: {{ section.settings.max_width | default: 1200 }}px;"
>
  {% if section.settings.image != blank %}
    <div class="page-width">
      <div class="hero__media">
        {{ section.settings.image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            sizes: '(min-width: 1200px) 1200px, 100vw',
            alt: section.settings.heading
        }}

        {% if section.settings.kicker != blank
          or section.settings.heading != blank
          or section.settings.body != blank
          or section.settings.cta_label != blank
        %}
          <div
            class="
              hero__overlay
              overlay--v-{{ section.settings.overlay_vertical_anchor }}
              overlay--h-{{ section.settings.overlay_horizontal_anchor }}
              overlay--content-{{ section.settings.content_position }}
              {% if section.settings.overlay_enabled %}overlay--on{% else %}overlay--off{% endif %}
            "
            style="
              --overlay-width: {{ section.settings.overlay_width }}%;
              --overlay-height: {{ section.settings.overlay_height }}%;
              --overlay-offset-x: {{ section.settings.overlay_offset_x }}px;
              --overlay-offset-y: {{ section.settings.overlay_offset_y }}px;
              --overlay-opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
            "
          >
            {% if section.settings.kicker != blank %}
              <p class="hero__kicker">{{ section.settings.kicker }}</p>
            {% endif %}

            {% if section.settings.heading != blank %}
              <h1 class="hero__title">{{ section.settings.heading }}</h1>
            {% endif %}

            {% if section.settings.body != blank %}
              <div class="hero__body rte">{{ section.settings.body }}</div>
            {% endif %}

            {% if section.settings.cta_label != blank %}
              <a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
            {% endif %}

            {%- if section.settings.quiz_label != blank -%}
              <button class="hero__quiz-btn" data-quiz-open>{{ section.settings.quiz_label }}</button>
            {%- endif -%}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <style>
    .hero {
      position: relative;
    }

    .hero__media {
      position: relative;
      max-width: var(--hero-max, 1200px);
      margin: 0 auto;
    }

    .hero__media > img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
      filter: none; /* no background dim */
    }

    /* -----------------------------
       OVERLAY PANEL (DIM BOX)
       ----------------------------- */
    .hero__overlay {
      position: absolute;
      width: min(100%, var(--overlay-width, 60%));
      height: min(100%, var(--overlay-height, 60%));
      display: flex;
      flex-direction: column;
      justify-content: center; /* overridden by content-position class */
      align-items: flex-start;
      padding: clamp(16px, 3vw, 32px);
      box-sizing: border-box;
      color: rgb(var(--color-foreground));
      background-color: rgba(var(--color-background), var(--overlay-opacity, 0.7));
      pointer-events: none; /* let buttons override */
    }

    .hero__overlay a,
    .hero__overlay button {
      pointer-events: auto;
    }

    /* When overlay is “off”, keep layout but remove dim */
    .hero__overlay.overlay--off {
      background-color: transparent;
    }

    /* Anchor: vertical */
    .hero__overlay.overlay--v-top {
      top: var(--overlay-offset-y, 0px);
      bottom: auto;
    }

    .hero__overlay.overlay--v-bottom {
      bottom: var(--overlay-offset-y, 0px);
      top: auto;
    }

    /* Anchor: horizontal */
    .hero__overlay.overlay--h-left {
      left: var(--overlay-offset-x, 0px);
      right: auto;
    }

    .hero__overlay.overlay--h-right {
      right: var(--overlay-offset-x, 0px);
      left: auto;
    }

    /* Content position INSIDE overlay (vertical alignment) */
    .hero__overlay.overlay--content-start {
      justify-content: flex-start;
    }

    .hero__overlay.overlay--content-center {
      justify-content: center;
    }

    .hero__overlay.overlay--content-end {
      justify-content: flex-end;
    }

    .hero__kicker {
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0.85;
      margin: 0 0 0.5rem;
      font-size: 0.9rem;
    }

    .hero__title {
      font-size: clamp(2rem, 5vw, 3.5rem);
      margin: 0 0 0.75rem;
    }

    .hero__body {
      margin: 0 0 1rem;
    }

    /* Mobile: let the overlay auto-height itself */
    @media (max-width: 749px) {
      .hero__overlay {
        width: min(100%, var(--overlay-width, 90%));
        height: auto;
      }
    }

    .hero__quiz-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      cursor: pointer;
      font-family: var(--font-heading-family, inherit);
      font-size: 0.875rem;
      font-weight: 600;
      color: #fff;
      text-decoration: underline;
      text-underline-offset: 3px;
      opacity: 0.9;
      margin-top: 8px;
      padding: 0;
      letter-spacing: 0.03em;
    }
    .hero__quiz-btn:hover { opacity: 1; }
  </style>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Minimal Power. Maximum Impact." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "quiz_label", "label": "Quiz link label", "default": "Not sure? Find your sharpener →" },

    {
      "type": "range",
      "id": "max_width",
      "label": "Max image width (px)",
      "min": 600,
      "max": 2000,
      "step": 50,
      "default": 1200
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },

    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "Enable overlay dim box",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "overlay_width",
      "label": "Overlay width (%)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "overlay_height",
      "label": "Overlay height (%)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "select",
      "id": "overlay_vertical_anchor",
      "label": "Overlay vertical anchor",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "overlay_horizontal_anchor",
      "label": "Overlay horizontal anchor",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_offset_x",
      "label": "Horizontal offset (px)",
      "min": 0,
      "max": 400,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_offset_y",
      "label": "Vertical offset (px)",
      "min": 0,
      "max": 400,
      "step": 5,
      "default": 40
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position inside overlay (vertical)",
      "default": "center",
      "options": [
        { "value": "start",  "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end",    "label": "Bottom" }
      ]
    }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
