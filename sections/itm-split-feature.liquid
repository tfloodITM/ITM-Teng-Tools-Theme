{%- comment -%}
  ITM Split Feature
  -----------------
  A purpose-built split block: small bold eyebrow line, big heading,
  paragraph, optional button, with a photo on one side (left or right).
  Built specifically for the "Made For Professionals" hero and
  "Improved Features" style blocks on the tool-control storage/modules
  pages — not a repurposed multi-purpose grid tile.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign image_side = section.settings.image_side | default: 'right'
-%}

{%- style -%}
  #shopify-section-{{ sid }} .itm-sf {
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ sid }} .itm-sf__inner {
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.column_gap | default: 48 }}px;
    align-items: center;
  }
  #shopify-section-{{ sid }} .itm-sf__text {
    order: {%- if image_side == 'left' -%}2{%- else -%}1{%- endif -%};
    text-align: {{ section.settings.text_align | default: 'left' }};
  }
  #shopify-section-{{ sid }} .itm-sf__media {
    order: {%- if image_side == 'left' -%}1{%- else -%}2{%- endif -%};
  }
  #shopify-section-{{ sid }} .itm-sf__media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.image_radius | default: 0 }}px;
  }
  {%- comment -%}
    text-align is set directly on every text element below (not just
    the shared .itm-sf__text wrapper): Dawn's base.css has its own
    global "h2, .h2 { text-align: center; ... }" rule that applies
    DIRECTLY to the <h2>, and a directly-matched rule always beats an
    INHERITED value regardless of the inherited-from selector's
    specificity — inheritance is only used as a fallback when nothing
    else targets the element itself. Setting it directly here, on the
    same element base.css also targets, wins on source order (this
    file loads after base.css) without needing !important.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .itm-sf__eyebrow {
    display: block;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .03em;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size_desktop }}px;
    margin: 0 0 {{ section.settings.eyebrow_gap }}px;
    text-align: {{ section.settings.text_align | default: 'left' }};
  }
  {%- comment -%}
    eyebrow is a richtext field now (for the same bold/italic editing
    ability as the body text), which always wraps its output in a <p> —
    reset that inner paragraph's own margin so it doesn't add extra
    spacing on top of the margin already set above.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .itm-sf__eyebrow p {
    margin: 0;
  }
  #shopify-section-{{ sid }} .itm-sf__heading {
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    line-height: 1.1;
    margin: 0 0 {{ section.settings.heading_gap }}px;
    text-align: {{ section.settings.text_align | default: 'left' }};
  }
  #shopify-section-{{ sid }} .itm-sf__body {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.55;
    text-align: {{ section.settings.text_align | default: 'left' }};
  }
  #shopify-section-{{ sid }} .itm-sf__body p {
    margin: 0 0 12px;
  }
  #shopify-section-{{ sid }} .itm-sf__body p:last-child {
    margin-bottom: 0;
  }
  #shopify-section-{{ sid }} .itm-sf__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 13px 24px;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text_color }};
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .04em;
    text-decoration: none;
    border-radius: {{ section.settings.btn_radius | default: 4 }}px;
  }
  @media (max-width: 989px) {
    #shopify-section-{{ sid }} .itm-sf__inner {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ sid }} .itm-sf__text,
    #shopify-section-{{ sid }} .itm-sf__media {
      order: initial;
    }
    #shopify-section-{{ sid }} .itm-sf__media {
      order: -1;
    }
    {%- assign ta_mobile = section.settings.text_align_mobile | default: section.settings.text_align | default: 'left' -%}
    #shopify-section-{{ sid }} .itm-sf__text {
      text-align: {{ ta_mobile }};
    }
    #shopify-section-{{ sid }} .itm-sf__eyebrow {
      font-size: {{ section.settings.eyebrow_size_mobile }}px;
      text-align: {{ ta_mobile }};
    }
    #shopify-section-{{ sid }} .itm-sf__heading {
      text-align: {{ ta_mobile }};
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    #shopify-section-{{ sid }} .itm-sf__body {
      font-size: {{ section.settings.text_size_mobile }}px;
      text-align: {{ ta_mobile }};
    }
  }
{%- endstyle -%}

<div class="itm-sf">
  <div class="itm-sf__inner">
    <div class="itm-sf__text">
      {%- if section.settings.eyebrow != blank -%}
        <div class="itm-sf__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- comment -%}
          heading is richtext (for bold/italic editing ability), which
          always wraps its output in <p>...</p> — a <p> isn't valid
          content inside <h2>, so it's stripped here while keeping any
          inline formatting (bold/italic/links) the merchant added.
        {%- endcomment -%}
        <h2 class="itm-sf__heading">{{ section.settings.heading | strip_newlines | remove_first: '<p>' | remove_last: '</p>' }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="itm-sf__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link }}" class="itm-sf__btn">{{ section.settings.btn_label }}</a>
      {%- endif -%}
    </div>
    <div class="itm-sf__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ITM — Split Feature",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment — desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment — mobile",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },
    {
      "type": "richtext",
      "id": "eyebrow",
      "label": "Eyebrow line (optional)"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Heading</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label (optional)"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow colour",
      "default": "#e30613"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text colour",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 4
    },
    {
      "type": "header",
      "content": "Eyebrow size"
    },
    {
      "type": "range",
      "id": "eyebrow_size_desktop",
      "label": "Desktop (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "label": "Mobile (px)",
      "min": 9,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_gap",
      "label": "Space below eyebrow (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Desktop (px)",
      "min": 20,
      "max": 72,
      "step": 2,
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile (px)",
      "min": 18,
      "max": 48,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "header",
      "content": "Body text size"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Desktop (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Mobile (px)",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Max content width (px)",
      "default": 1200
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between text and image (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "ITM — Split Feature"
    }
  ]
}
{% endschema %}
