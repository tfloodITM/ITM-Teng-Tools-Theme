{%- comment -%} ITM resync marker: video-section v1 — force GitHub→Shopify re-sync {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.padding_bg }};
  }
  #shopify-section-{{ section.id }} .itm-vs {
    position: relative;
    height: {{ section.settings.desktop_height }}px;
    background: {{ section.settings.bg }};
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .itm-vs video,
  #shopify-section-{{ section.id }} .itm-vs iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 0;
  }

  {%- unless section.settings.show_on_desktop -%}
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} { display: none; }
    }
  {%- endunless -%}

  {%- unless section.settings.show_on_mobile -%}
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} { display: none; }
    }
  {%- endunless -%}

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
    #shopify-section-{{ section.id }} .itm-vs {
      height: {{ section.settings.mobile_height }}px;
    }
  }
{%- endstyle -%}

<div class="itm-vs">
  {%- if section.settings.video != blank -%}
    {{
      section.settings.video
      | video_tag:
        autoplay: section.settings.autoplay,
        loop: section.settings.loop,
        controls: section.settings.controls,
        muted: section.settings.muted,
        image_size: '1500x'
    }}
  {%- elsif section.settings.video_url != blank -%}
    <iframe
      src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay={% if section.settings.autoplay %}1{% else %}0{% endif %}&mute={% if section.settings.muted %}1{% else %}0{% endif %}&loop={% if section.settings.loop %}1{% else %}0{% endif %}&playlist={{ section.settings.video_url.id }}&controls={% if section.settings.controls %}1{% else %}0{% endif %}&playsinline=1"
      frameborder="0"
      allow="autoplay; encrypted-media"
      title="{{ section.settings.video_title | default: 'Video' }}"
    ></iframe>
  {%- else -%}
    {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Full-Width Video",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL (YouTube / Vimeo fallback)",
      "info": "Used only if no Shopify video is selected above."
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title (accessibility)",
      "info": "Used for screen readers on the YouTube/Vimeo fallback only."
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "info": "Autoplay only works in most browsers when muted.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show playback controls",
      "default": false
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 150,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Video background colour",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "padding_bg",
      "label": "Padding background colour",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Full-Width Video"
    }
  ]
}
{% endschema %}
