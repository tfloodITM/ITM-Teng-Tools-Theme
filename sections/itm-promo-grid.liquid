        {%- when 'reviews' -%}
          {%- liquid
            assign rv_prod = block.settings.product
            assign rv_pid = ''
            if rv_prod != blank
              assign rv_pid = rv_prod.id
            endif
            assign star_pct = block.settings.fallback_score | default: 5 | times: 20

            comment
              Manual reviews, typed straight into the block's settings, are
              the primary path — no API, no token, nothing that can 404.
              Built into a small JSON array here so the carousel JS can
              rotate through all of them, not just show review 1 statically.
            endcomment
            assign mr_items = '' | split: ','
            for n in (1..4)
              case n
                when 1
                  assign mr_text = block.settings.fallback_quote
                  assign mr_name = block.settings.fallback_author
                when 2
                  assign mr_text = block.settings.manual_review_2_text
                  assign mr_name = block.settings.manual_review_2_author
                when 3
                  assign mr_text = block.settings.manual_review_3_text
                  assign mr_name = block.settings.manual_review_3_author
                when 4
                  assign mr_text = block.settings.manual_review_4_text
                  assign mr_name = block.settings.manual_review_4_author
              endcase
              if mr_text != blank
                assign mr_name = mr_name | default: 'Verified Buyer'
                capture mr_item
                  echo '{"content":'
                  echo mr_text | json
                  echo ',"name":'
                  echo mr_name | json
                  echo '}'
                endcapture
                assign mr_item_arr = mr_item | split: '||itm-never-splits-this||'
                assign mr_items = mr_items | concat: mr_item_arr
              endif
            endfor
            comment
              This was previously '[' | append: mr_items | join: ',' | append: ']'
              — wrong: `append` takes a STRING, not an array, so it silently
              stringified the array with no separators between objects
              instead of inserting commas. The resulting attribute was
              invalid JSON (four JSON objects jammed together with no comma
              between them), so JSON.parse() in the JS below threw on every
              page load, was caught silently, and manualReviews stayed
              empty — which is why nothing ever rotated, no dots, no
              arrows, just the single static fallback quote forever. `join`
              is the filter that actually inserts a separator between array
              elements; prepend/append then just wrap the brackets.
            endcomment
            assign manual_reviews_json = mr_items | join: ',' | prepend: '[' | append: ']'
          -%}
