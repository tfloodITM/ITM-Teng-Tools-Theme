                style="--scrim:{{ block.settings.scrim | default: 35 | divided_by: 100.0 }};--ov-color:{{ block.settings.overlay_color | default: '#FFFFFF' }};--ov-h:{{ ov_h }}px;--ov-t:{{ ov_t }}px;--ov-h-m:{{ ov_h_m }}px;--ov-t-m:{{ ov_t_m }}px;"
                aria-label="{{ block.settings.overlay_heading | default: 'Play video' | escape }}"
              >
