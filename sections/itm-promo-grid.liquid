{%- comment -%}
  Promo grid — a row of tiles on a 12 column grid, in the pattern Bunnings use
  under their header: one wide tile, a couple of narrower ones beside it, and a
  full width banner strip below.

  Every block sets its own desktop and mobile span, so the arrangement is made
  in the customiser rather than baked in here. Blocks:

    tile   — image + heading + body + button, in three layouts
    video  — a playable video, either Shopify hosted or a YouTube/Vimeo link
    banner — a full width strip, text centred, one button

  The video is click to play: until it is clicked only the poster image is in
  the page, so an embed is never loaded on page view.

  Content is deliberately left empty — fill it in the customiser.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign gap = section.settings.gap | default: 16
  assign radius = section.settings.radius | default: 16
  assign heading_weight = section.settings.heading_weight | default: '900'
  assign heading_uppercase = section.settings.heading_uppercase
-%}

{%- capture arrow_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>{%- endcapture -%}

{%- capture chevrons_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 5 6 7-6 7"/><path d="m14 5 6 7-6 7"/></svg>{%- endcapture -%}

{%- style -%}
  {%- comment -%}
    The theme's page width caps at the global setting; this section is allowed
    to run wider than that on its own.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .page-width{
    max-width:{{ section.settings.max_width | default: 1300 }}px;
  }

  #shopify-section-{{ sid }}{
    background:{{ section.settings.section_bg | default: '#F4F4F4' }};
    padding-top:{{ section.settings.padding_top | default: 24 }}px;
    padding-bottom:{{ section.settings.padding_bottom | default: 24 }}px;
  }

  #shopify-section-{{ sid }} .wpg{
    display:grid;
    grid-template-columns:repeat(12, minmax(0, 1fr));
    gap:{{ gap }}px;
    align-items:stretch;
  }

  {%- comment -%}
    Per-card "Hide on desktop" / "Hide on mobile" — the same breakpoint the
    rest of this section already switches on. display:none removes it from
    the grid entirely (not just visually), so hiding one card doesn't leave
    a gap for the others to awkwardly flow around.
  {%- endcomment -%}
  @media (min-width:750px){
    #shopify-section-{{ sid }} .wpg__hide-desktop{ display:none !important; }
  }
  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__hide-mobile{ display:none !important; }
  }

  /* Mobile span first; the desktop span takes over at the same breakpoint the
     rest of the theme uses for its two-column layouts. */
  {%- comment -%}
    Border is per-card now (each block has its own "Border" settings), not
    one section-wide value forcing every card to match. --card-border-w/-c
    are set per block in block_style below; this rule just reads them, so a
    card with nothing set falls back to 0px/transparent — invisible — while
    a card that DOES set them gets exactly its own width/colour, with zero
    risk of one card's inline style fighting another's.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__block{
    grid-column:span var(--span-m, 12);
    position:relative;
    display:flex;
    box-sizing:border-box;
    border-radius:{{ radius }}px;
    border:var(--card-border-w, 0px) solid var(--card-border-c, transparent);
    overflow:hidden;
    min-height:var(--min-h-m, 150px);
    text-decoration:none;
    isolation:isolate;
  }
  @media (min-width:750px){
    #shopify-section-{{ sid }} .wpg__block{
      grid-column:span var(--span-d, 6);
      min-height:var(--min-h, 300px);
    }
  }

  /* Only tiles that actually link anywhere should react to the pointer. */
  #shopify-section-{{ sid }} a.wpg__block{
    transition:transform .18s ease, box-shadow .18s ease;
  }
  #shopify-section-{{ sid }} a.wpg__block:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 26px rgba(0,0,0,.14);
  }
  @media (prefers-reduced-motion:reduce){
    #shopify-section-{{ sid }} a.wpg__block{ transition:none; }
    #shopify-section-{{ sid }} a.wpg__block:hover{ transform:none; }
  }

  /* ---------- tile ---------- */
  #shopify-section-{{ sid }} .wpg__tile{ flex-direction:column; }
  #shopify-section-{{ sid }} .wpg__tile--split{ flex-direction:row; align-items:stretch; }

  #shopify-section-{{ sid }} .wpg__body{
    display:flex;
    flex-direction:column;
    justify-content:{{ section.settings.body_align | default: 'center' }};
    gap:10px;
    padding:{{ section.settings.tile_padding | default: 24 }}px;
    flex:1 1 auto;
    min-width:0;
    z-index:2;
  }
  #shopify-section-{{ sid }} .wpg__tile--split .wpg__body{ flex:1 1 55%; }

  #shopify-section-{{ sid }} .wpg__media{
    position:relative;
    flex:0 0 auto;
    overflow:hidden;
    background:rgba(0,0,0,.06);
  }
  #shopify-section-{{ sid }} .wpg__tile--split .wpg__media{ flex:1 1 45%; align-self:stretch; }
  #shopify-section-{{ sid }} .wpg__tile--stacked .wpg__media{ width:100%; aspect-ratio:16/10; }
  #shopify-section-{{ sid }} .wpg__media img,
  #shopify-section-{{ sid }} .wpg__media video{
    width:100%; height:100%;
    object-fit:cover;
    display:block;
  }

  /* Full bleed image with the copy sitting on top of it. */
  #shopify-section-{{ sid }} .wpg__tile--overlay .wpg__media{
    position:absolute; inset:0; z-index:0; flex:none; width:100%; height:100%;
  }
  #shopify-section-{{ sid }} .wpg__tile--overlay .wpg__media::after{
    content:'';
    position:absolute; inset:0;
    background:linear-gradient(to top, rgba(0,0,0,{{ section.settings.overlay_opacity | default: 55 | divided_by: 100.0 }}) 0%, rgba(0,0,0,0) 70%);
  }
  #shopify-section-{{ sid }} .wpg__tile--overlay .wpg__body{ justify-content:flex-end; }

  {%- comment -%}
    Every size is a custom property set on the block, so a card can override
    the section default without needing its own stylesheet. The mobile rule
    scales whatever the block resolved to, rather than re-deriving it from the
    section, or a per-card override would be thrown away on small screens.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__heading{
    margin:0;
    font-size:var(--h-size, 24px);
    line-height:1.15;
    font-family:var(--font-heading-family);
    font-weight:{{ heading_weight }};
    letter-spacing:-.01em;
    {%- if heading_uppercase -%}text-transform:uppercase;{%- endif -%}
  }
  #shopify-section-{{ sid }} .wpg__text{
    margin:0;
    font-size:var(--t-size, 15px);
    line-height:1.45;
    opacity:.92;
  }
  #shopify-section-{{ sid }} .wpg__text > *{ margin:0; }
  #shopify-section-{{ sid }} .wpg__price{
    margin:0;
    font-size:var(--p-size, 30px);
    font-weight:800;
    font-style:italic;
    line-height:1;
  }

  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__body{ padding:{{ section.settings.tile_padding | default: 24 | times: 0.7 | round }}px; gap:8px; }
    #shopify-section-{{ sid }} .wpg__heading{ font-size:var(--h-size-m, 19px); }
    #shopify-section-{{ sid }} .wpg__text{ font-size:var(--t-size-m, 12px); }
    #shopify-section-{{ sid }} .wpg__price{ font-size:var(--p-size-m, 24px); }
  }

  /* ---------- button ----------
     Matches the hero section's button: square corners, uppercase, letter-
     spaced. The skew mechanic itself (skew the button, counter-skew its
     contents so the label stays sharp) already existed here and is
     unchanged — the hero uses the same trick for its "glow" button variant. */
  #shopify-section-{{ sid }} .wpg__btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    align-self:flex-start;
    margin-top:4px;
    padding:var(--b-py, 11px) var(--b-px, 18px);
    border-radius:{{ section.settings.btn_radius | default: 0 }}px;
    font-family:inherit;
    font-size:var(--b-size, 15px);
    font-weight:700;
    letter-spacing:.06em;
    text-transform:uppercase;
    line-height:1;
    text-decoration:none;
    border:none;
    cursor:pointer;
    transform:skewX(var(--btn-skew, 0deg));
    transition:filter .15s ease;
  }
  #shopify-section-{{ sid }} .wpg__btn > *{ transform:skewX(calc(var(--btn-skew, 0deg) * -1)); }
  #shopify-section-{{ sid }} .wpg__btn:hover{ filter:brightness(1.08); }
  #shopify-section-{{ sid }} .wpg__btn svg{ width:15px; height:15px; }

  /* The "Get inspired »" style: no button chrome, chevrons pinned bottom right */
  #shopify-section-{{ sid }} .wpg__link{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-top:auto;
    padding-top:12px;
    font-weight:700;
    font-size:var(--b-size, 15px);
  }
  #shopify-section-{{ sid }} .wpg__link svg{ width:19px; height:19px; flex:0 0 auto; }

  {%- comment -%}
    Must sit after the two rules above: same specificity, so declaring it
    earlier let the desktop size win and buttons never scaled down.
  {%- endcomment -%}
  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__btn,
    #shopify-section-{{ sid }} .wpg__link{ font-size:var(--b-size-m, 12px); }
  }

  {%- comment -%}
    "Featured" flag — shared by Featured product, Featured product 2 and the
    combo card. First attempt nested this inside .wpg__fp-media / .wpg__combo-
    media so it would visually sit right on the image — wrong call for
    Featured product / Featured product 2 specifically, because their desktop
    image is .wpg__block--bleed: deliberately overflow:visible and freely
    repositioned/rotated via the image position/rotation sliders (see
    "Product image" above), so anything nested inside it moves and rotates
    right along with it. That's the point for the photo itself, but it meant
    the badge could end up rotated, or bled way outside the card into
    whatever sat beside it, depending on those sliders — reported as sitting
    "way too high" on desktop.

    Anchoring it to the CARD instead (.wpg__block is already position:relative
    on every card type) fixes that: a plain top-left corner tag, independent
    of wherever the image itself has been dragged/rotated to, the same
    resting spot a "Sale"/"Best seller" ribbon usually has. No negative
    offsets either — non-bleed cards (the combo card, Featured product's own
    mobile layout) keep overflow:hidden, so anything hanging past the edge
    would just get clipped.

    Colours come in through CSS custom properties, not a direct background/
    color declaration, for the same reason the border feature does that: an
    inline background/color on the element itself would silently beat this
    class rule regardless of specificity, which is exactly the bug the
    theme-colour-scheme background fix above had to undo.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__badge-flag{
    position:absolute;
    top:12px;
    left:12px;
    z-index:5;
    max-width:calc(100% - 24px);
    padding:5px 18px 5px 10px;
    background:var(--badge-bg, #e30613);
    color:var(--badge-fg, #1a1a1a);
    font-size:11px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.04em;
    line-height:1.2;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    /* Notch cut a fixed 14px deep from the right edge, not a percentage of
       the box — a percentage cut deeper into longer badges than the padding
       could clear, slicing straight through the last letter or two. Fixed
       px means the same 14px is reserved regardless of how long the text
       runs, and the 18px right padding above always clears it. */
    clip-path:polygon(0 0, 100% 0, calc(100% - 14px) 50%, 100% 100%, 0 100%);
    box-shadow:0 4px 10px rgba(0,0,0,.25);
    pointer-events:none;
  }
  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__badge-flag{ top:8px; left:8px; font-size:10px; padding:4px 16px 4px 8px; }
  }

  /* ---------- video ---------- */
  #shopify-section-{{ sid }} .wpg__video{ background:#000; }
  #shopify-section-{{ sid }} .wpg__video .wpg__media{
    position:absolute; inset:0; width:100%; height:100%; flex:none;
  }
  #shopify-section-{{ sid }} .wpg__video iframe{
    position:absolute; inset:0; width:100%; height:100%; border:0;
  }
  {%- liquid
    assign glow = section.settings.play_glow | default: '#FFFFFF'
    assign glow_soft = glow | color_modify: 'alpha', 0.45
    assign ring_color = section.settings.play_pulse_color | default: '#FFFFFF'
    assign glow_ring = ring_color | color_modify: 'alpha', 0.30

    comment
      Hover scale arrives as a percentage; CSS wants a factor.
    endcomment
    assign hover_scale = section.settings.play_hover_scale | default: 112 | divided_by: 100.0
    assign glow_size = section.settings.play_glow_size | default: 30
    assign glow_size_hover = glow_size | times: 1.7 | round
  -%}
  #shopify-section-{{ sid }} .wpg__cover{
    position:absolute;
    inset:0;
    z-index:3;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:16px;
    padding:26px;
    border:0;
    cursor:pointer;
    text-align:center;
    color:var(--ov-color, #fff);
    background:linear-gradient(to top, rgba(0,0,0,calc(var(--scrim, .35) * 1.6)) 0%, rgba(0,0,0,var(--scrim, .35)) 55%, rgba(0,0,0,calc(var(--scrim, .35) * .5)) 100%);
    transition:opacity .35s ease, visibility .35s ease;
  }
  #shopify-section-{{ sid }} .wpg__cover--top{ justify-content:flex-start; }
  #shopify-section-{{ sid }} .wpg__cover--middle{ justify-content:center; }
  #shopify-section-{{ sid }} .wpg__cover--bottom{ justify-content:flex-end; }

  /* Fades out rather than vanishing, and stops catching clicks once gone. */
  #shopify-section-{{ sid }} .wpg__cover.is-playing{
    opacity:0;
    visibility:hidden;
    pointer-events:none;
  }

  #shopify-section-{{ sid }} .wpg__play{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 auto;
    width:{{ section.settings.play_size | default: 68 }}px;
    height:{{ section.settings.play_size | default: 68 }}px;
    border-radius:50%;
    color:{{ section.settings.play_icon | default: '#FFFFFF' }};
    background:{{ section.settings.play_bg | default: '#e30613' }};
    border:{{ section.settings.play_border_width | default: 0 }}px solid {{ section.settings.play_border_color | default: '#FFFFFF' }};
    box-shadow:0 10px 30px rgba(0,0,0,.34), 0 0 {{ glow_size }}px {{ glow_soft }};
    transition:transform .2s ease, box-shadow .2s ease;
  }
  #shopify-section-{{ sid }} .wpg__play svg{
    width:{{ section.settings.play_icon_size | default: 38 }}%;
    height:{{ section.settings.play_icon_size | default: 38 }}%;
    /* nudged right so the triangle looks centred rather than measuring centred */
    margin-left:{{ section.settings.play_icon_nudge | default: 8 }}%;
    filter:drop-shadow(0 1px 3px rgba(0,0,0,.35));
  }
  #shopify-section-{{ sid }} .wpg__cover:hover .wpg__play{
    transform:scale({{ hover_scale }});
    box-shadow:0 12px 40px rgba(0,0,0,.45), 0 0 {{ glow_size_hover }}px {{ glow_soft }};
  }
  #shopify-section-{{ sid }} .wpg__cover:focus-visible{ outline:2px solid var(--ov-color, #fff); outline-offset:-4px; }

  {%- if section.settings.play_pulse -%}
    /* A ring that expands out of the button and fades, on a loop. It is a
       pseudo-element so it never affects the button's own box. */
    #shopify-section-{{ sid }} .wpg__play::after{
      content:'';
      position:absolute;
      inset:0;
      border-radius:50%;
      box-shadow:0 0 0 0 {{ glow_ring }};
      animation:wpg-pulse-{{ sid }} {{ section.settings.play_pulse_speed | default: 2800 }}ms cubic-bezier(.22,.61,.36,1) infinite;
    }
    @keyframes wpg-pulse-{{ sid }}{
      0%   { box-shadow:0 0 0 0 {{ glow_ring }}; opacity:1; }
      70%  { box-shadow:0 0 0 {{ section.settings.play_pulse_spread | default: 26 }}px rgba(0,0,0,0); opacity:0; }
      100% { box-shadow:0 0 0 0 rgba(0,0,0,0); opacity:0; }
    }
  {%- endif -%}

  @media (prefers-reduced-motion:reduce){
    #shopify-section-{{ sid }} .wpg__play::after{ animation:none; }
    #shopify-section-{{ sid }} .wpg__cover{ transition:none; }
    #shopify-section-{{ sid }} .wpg__cover:hover .wpg__play{ transform:none; }
  }

  #shopify-section-{{ sid }} .wpg__cover-copy{
    display:flex;
    flex-direction:column;
    gap:6px;
    /* 34ch was breaking headings onto two lines while most of the tile sat
       empty; the cover's own padding is the real margin here. */
    max-width:92%;
    text-shadow:0 2px 14px rgba(0,0,0,.5);
  }
  #shopify-section-{{ sid }} .wpg__cover-heading{
    font-size:var(--ov-h, 28px);
    font-family:var(--font-heading-family);
    font-weight:{{ heading_weight }};
    line-height:1.15;
    letter-spacing:-.01em;
    {%- if heading_uppercase -%}text-transform:uppercase;{%- endif -%}
  }
  #shopify-section-{{ sid }} .wpg__cover-text{
    font-size:var(--ov-t, 15px);
    line-height:1.4;
    opacity:.92;
  }

  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__cover{ padding:18px; gap:12px; }
    #shopify-section-{{ sid }} .wpg__play{
      width:{{ section.settings.play_size | default: 68 | times: 0.72 | round }}px;
      height:{{ section.settings.play_size | default: 68 | times: 0.72 | round }}px;
    }
    #shopify-section-{{ sid }} .wpg__cover-heading{ font-size:var(--ov-h-m, 22px); }
    #shopify-section-{{ sid }} .wpg__cover-text{ font-size:var(--ov-t-m, 13px); }
  }

  /* ---------- banner ---------- */
  #shopify-section-{{ sid }} .wpg__banner{
    align-items:center;
    justify-content:center;
    text-align:center;
    min-height:0;
  }
  #shopify-section-{{ sid }} .wpg__banner .wpg__body{
    flex-direction:row;
    flex-wrap:wrap;
    align-items:center;
    justify-content:center;
    gap:6px 22px;
    text-align:center;
  }
  #shopify-section-{{ sid }} .wpg__banner .wpg__banner-copy{
    display:flex;
    flex-direction:column;
    gap:4px;
  }
  #shopify-section-{{ sid }} .wpg__banner .wpg__btn{ align-self:center; margin-top:0; }
  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__banner .wpg__body{ flex-direction:column; }
  }


  {%- comment -%} ---------- featured product ---------- {%- endcomment -%}
  /* The product image is meant to break out of the card, so this block opts
     out of the clipping every other block relies on. The background still
     rounds off, because border-radius applies to the box either way. */
  #shopify-section-{{ sid }} .wpg__block--bleed{ overflow:visible; }
  {%- comment -%}
    The IMAGE must never resize the card (it's absolutely positioned, out of
    flow, purely decorative as far as layout is concerned), but the TEXT+
    BUTTON must always be free to push the card taller if they need to — a
    hidden/clipped product name is worse than an uneven row of cards. So
    this is min-height (a floor, from the block's own setting) rather than
    a fixed height: the card starts at that size and only grows if the
    content genuinely needs more room.

    Desktop stacks the eyebrow/price/title and the button in ONE column —
    they used to be two separate flex items side by side (body, then the
    button next to it), which is why the button floated off to the right of
    the text instead of sitting under it. Both now live in the same column,
    which fills the entire width to the right of the image's own reserved
    gutter (folded into this element's own left padding, rather than a
    margin on the text alone, so the button gets the same inset for free
    instead of needing its own copy of the same gutter math).
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__fp{
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:14px;
    padding:{{ section.settings.tile_padding | default: 24 }}px
            {{ section.settings.tile_padding | default: 24 }}px
            {{ section.settings.tile_padding | default: 24 }}px
            calc({{ section.settings.tile_padding | default: 24 }}px + var(--fp-gutter, 34%));
    min-height:var(--min-h-m, 150px);
  }
  @media (min-width:750px){
    #shopify-section-{{ sid }} .wpg__fp{ min-height:var(--min-h, 300px); }
  }
  #shopify-section-{{ sid }} .wpg__fp-media{
    position:absolute;
    left:var(--fp-x, 0%);
    top:var(--fp-y, 50%);
    width:var(--fp-w, 34%);
    transform:translateY(-50%) rotate(var(--fp-rot, 0deg));
    transform-origin:center;
    pointer-events:none;
    z-index:2;
    filter:drop-shadow(0 18px 30px rgba(0,0,0,.35));
  }
  #shopify-section-{{ sid }} .wpg__fp-media img{ width:100%; height:auto; display:block; }

  #shopify-section-{{ sid }} .wpg__fp-body{
    flex:1 1 auto;
    width:100%;
    min-width:0;
    display:flex;
    flex-direction:column;
    gap:6px;
    z-index:1;
  }
  #shopify-section-{{ sid }} .wpg__fp-eyebrow{
    margin:0;
    display:flex;
    align-items:baseline;
    gap:8px;
    flex-wrap:wrap;
    font-size:var(--t-size, 15px);
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.06em;
  }
  #shopify-section-{{ sid }} .wpg__fp-price{
    font-size:var(--p-size, 30px);
    font-weight:800;
    letter-spacing:0;
  }
  #shopify-section-{{ sid }} .wpg__fp-title{
    margin:0;
    font-size:var(--h-size, 24px);
    font-weight:700;
    line-height:1.2;
  }
  #shopify-section-{{ sid }} .wpg__fp .wpg__btn{ flex:0 0 auto; align-self:flex-start; margin-top:0; z-index:1; }

  {%- comment -%}
    Icon row — sits between the title/price and the button, same trust-badge
    idea as the strip under the Add to Cart button on the product page
    itself (3-Year Warranty / 30-Day Money-Back / Free Delivery).
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__fp-icons{
    display:flex;
    flex-wrap:wrap;
    align-items:flex-start;
    gap:var(--fp-icon-gap, 16px);
    margin:2px 0 4px;
    z-index:1;
  }
  #shopify-section-{{ sid }} .wpg__fp-icon{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:4px;
    max-width:96px;
    text-align:center;
  }
  #shopify-section-{{ sid }} .wpg__fp-icon svg,
  #shopify-section-{{ sid }} .wpg__fp-icon img{
    width:var(--fp-icon-size, 28px);
    height:var(--fp-icon-size, 28px);
    object-fit:contain;
    flex-shrink:0;
  }
  #shopify-section-{{ sid }} .wpg__fp-icon em{
    font-style:normal;
    font-size:10px;
    font-weight:600;
    line-height:1.15;
    letter-spacing:.01em;
    opacity:.9;
  }

  {%- comment -%}
    Mobile deliberately does NOT reuse the desktop "bleed" treatment: the
    image is a plain, normal-flow block sitting at the top of the column,
    text and button flow underneath it exactly like any other stacked
    content — no absolute positioning, no manually-reserved margin trying to
    guess the image's height. That approach was fighting itself (a stray
    `inset:auto` was cancelling the position out entirely, and even fixed,
    reserving space by guessing it in a margin is inherently fragile). Real
    document flow can't get this wrong: whatever height the image actually
    renders at, the text starts right after it, every time.

    "Image size" growing the CARD'S HEIGHT is fine and expected — taller
    image, taller card, same as any other block on this row. What must
    never happen is the image affecting the card's WIDTH, which normal flow
    was never at risk of doing anyway. The image's own height is still sized
    off its own width (padding-top against a definite %, not the card's
    height), so it stays a clean, predictable shape regardless of how tall
    the card ends up.

    Two layouts, picked per-block via "Mobile layout": stacked (image on
    top, text below, full width — the default) or split (image and text
    side by side, both stretched to match whichever is taller).
  {%- endcomment -%}
  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__fp.wpg__block--bleed{ overflow:hidden; }

    /* Default: stacked. */
    #shopify-section-{{ sid }} .wpg__fp{
      display:flex;
      flex-direction:column;
      align-items:stretch;
      justify-content:flex-start;
      height:auto;
      min-height:var(--min-h-m, 150px);
      padding:{{ section.settings.tile_padding | default: 24 }}px;
    }
    {%- comment -%}
      Plain and boring on purpose: no aspect-ratio box, no cropping, no
      absolute positioning, no nudge controls to fight with. The image just
      renders at its own natural shape, scaled to whatever width "Image
      size" says (100% by default — the whole card width), and centred if
      that's less than 100%. Nothing about the product can ever be cropped
      off, because nothing here ever crops it — object-fit doesn't even
      apply to a plain, non-boxed image.
    {%- endcomment -%}
    #shopify-section-{{ sid }} .wpg__fp-media{
      position:relative;
      /* The desktop rule sets top/left (its bleed position, e.g. top:50%)
         — position:relative still honours those as an offset from its own
         normal spot rather than as an absolute coordinate, so without
         resetting them here the image gets shoved roughly halfway down the
         card and lands on top of the text below it. Confirmed by actually
         rendering this in a browser and measuring it: the image's box was
         landing 200+px past where the text started. */
      top:auto;
      left:auto;
      right:auto;
      bottom:auto;
      width:var(--fp-w-m, 100%);
      max-width:100%;
      margin:0 auto;
      overflow:visible;
      transform:none;
      filter:none;
      pointer-events:auto;
    }
    #shopify-section-{{ sid }} .wpg__fp-media img{
      position:static;
      width:100%;
      height:auto;
      display:block;
    }
    #shopify-section-{{ sid }} .wpg__fp-body{
      width:100%;
      margin-top:12px;
      justify-content:flex-start;
    }
    #shopify-section-{{ sid }} .wpg__fp .wpg__btn{
      align-self:flex-start;
      margin-top:6px;
    }

    /* Opt-in: side by side. Both columns stretch to the taller of the two —
       if the text needs more vertical room the image stretches to match it
       via object-fit:cover, so "image size" (its column's WIDTH here) still
       never has to fight the card for height. This variant was never the
       one growing the card (it's already a normal grid column, not a
       height-affecting flex item), so it keeps the image in flow. */
    #shopify-section-{{ sid }} .wpg__fp[data-mobile-layout="split"]{
      display:grid;
      grid-template-columns:var(--fp-w-m, 50%) 1fr;
      grid-template-rows:1fr auto;
      align-items:stretch;
      height:auto;
    }
    #shopify-section-{{ sid }} .wpg__fp[data-mobile-layout="split"] .wpg__fp-media{
      position:relative;
      grid-column:1;
      grid-row:1 / 3;
      width:100%;
      max-width:none;
      height:100%;
      margin:0;
    }
    /* The stacked default deliberately shows the image uncropped at its own
       natural shape; side-by-side still needs both columns to match height,
       so it keeps the old fill-the-cell treatment. */
    #shopify-section-{{ sid }} .wpg__fp[data-mobile-layout="split"] .wpg__fp-media img{
      position:static;
      width:100%;
      height:100%;
      object-fit:cover;
      transform:none;
    }
    #shopify-section-{{ sid }} .wpg__fp[data-mobile-layout="split"] .wpg__fp-body{
      grid-column:2;
      grid-row:1;
      margin-top:0;
    }
    #shopify-section-{{ sid }} .wpg__fp[data-mobile-layout="split"] .wpg__btn{
      grid-column:2;
      grid-row:2;
    }

    #shopify-section-{{ sid }} .wpg__fp-eyebrow{ gap:8px; font-size:var(--t-size-m, 12px); }
    #shopify-section-{{ sid }} .wpg__fp-price{ font-size:var(--p-size-m, 24px); }
    #shopify-section-{{ sid }} .wpg__fp-title{ font-size:var(--h-size-m, 19px); }
    #shopify-section-{{ sid }} .wpg__fp-icons{ gap:calc(var(--fp-icon-gap, 16px) * 0.7); }
    #shopify-section-{{ sid }} .wpg__fp-icon{ max-width:72px; }
    #shopify-section-{{ sid }} .wpg__fp-icon em{ font-size:9px; }
  }

  {%- comment -%}
    ---------- featured product — mobile combo ----------
    Always the same plain, stacked layout at every width (this card exists
    specifically to stop fighting two separate cards over how they pair up
    on mobile, so it doesn't have a separate desktop treatment to keep in
    sync — "Hide on desktop" under Visibility is how you keep it mobile-only
    if you want that). Icons and reviews reuse the exact classes/JS already
    built and verified for Featured Product and Reviews Slider 2 — only the
    wrapper below (.wpg__combo, .wpg__combo-media, .wpg__combo-body,
    .wpg__combo-reviews) is new.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__combo{
    display:flex;
    flex-direction:column;
    align-items:stretch;
    gap:12px;
    padding:{{ section.settings.tile_padding | default: 24 }}px;
    height:auto;
  }
  #shopify-section-{{ sid }} .wpg__combo-media{
    width:var(--combo-img-w, 70%);
    max-width:100%;
    margin:0 auto;
  }
  #shopify-section-{{ sid }} .wpg__combo-media img{
    width:100%;
    height:auto;
    display:block;
  }
  #shopify-section-{{ sid }} .wpg__combo-body{
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  {%- comment -%}
    The reviews sub-card deliberately has NO fixed height of its own here
    (unlike the standalone Reviews block, which needs one so swapping quotes
    never resizes ITS card) — this whole combo card is already one single
    unit that's allowed to grow for its content, so there's nothing for a
    second, separate fixed height to protect against.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__combo-reviews{
    display:flex;
    flex-direction:column;
    gap:6px;
    padding-top:12px;
    border-top:1px solid rgba(255,255,255,.15);
  }
  #shopify-section-{{ sid }} .wpg__combo .wpg__btn{ align-self:flex-start; }

  {%- comment -%} ---------- reviews ---------- {%- endcomment -%}
  {%- comment -%}
    Every other block only sets min-height, happy to grow with its content.
    The reviews card needs the opposite: a genuinely fixed height, because
    swapping in a shorter or longer review must never resize the card (the
    quote itself is already line-clamped for the same reason — this is the
    other half of that fix, since heights vary even at the same line count
    once names/counts differ). overflow:hidden is a safety net, not the
    mechanism — the line-clamp is what actually keeps content inside it.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__rv{
    flex-direction:column;
    justify-content:center;
    gap:8px;
    padding:{{ section.settings.tile_padding | default: 24 }}px;
    height:var(--min-h-m, 150px);
    overflow:hidden;
  }
  @media (min-width:750px){
    #shopify-section-{{ sid }} .wpg__rv{ height:var(--min-h, 300px); }
  }
  #shopify-section-{{ sid }} .wpg__rv-top{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }
  #shopify-section-{{ sid }} .wpg__stars{
    position:relative;
    display:inline-block;
    line-height:1;
    font-size:var(--star-size, 17px);
    letter-spacing:2px;
    flex:0 0 auto;
  }
  /* Two stacked copies, the filled one clipped to the score, so a 4.5 shows
     as half a star without needing half-star glyphs. */
  #shopify-section-{{ sid }} .wpg__stars span{ display:block; }
  #shopify-section-{{ sid }} .wpg__stars-bg{ color:var(--star-empty, rgba(255,255,255,.32)); }
  #shopify-section-{{ sid }} .wpg__stars-fill{
    position:absolute;
    inset:0;
    overflow:hidden;
    white-space:nowrap;
    width:var(--star-pct, 100%);
    color:var(--star-color, #e30613);
  }
  #shopify-section-{{ sid }} .wpg__rv-count{ font-size:var(--t-size, 15px); opacity:.85; }
  #shopify-section-{{ sid }} .wpg__rv-heading{ margin:0; font-size:var(--h-size, 24px); font-family:var(--font-heading-family); font-weight:{{ heading_weight }}; line-height:1.2; {%- if heading_uppercase %} text-transform:uppercase;{% endif %} }

  #shopify-section-{{ sid }} .wpg__rv-quote{
    margin:0;
    font-size:var(--t-size, 15px);
    line-height:1.45;
    transition:opacity .28s ease;
  }
  {%- comment -%}
    Real reviews vary wildly in length — this product has some under 10
    characters and some over 300 — so without a cap the card's height jumps
    every time the slide changes.
  {%- endcomment -%}
  {%- if section.settings.quote_lines != 0 -%}
    #shopify-section-{{ sid }} .wpg__rv-quote{
      display:-webkit-box;
      -webkit-line-clamp:{{ section.settings.quote_lines | default: 4 }};
      -webkit-box-orient:vertical;
      overflow:hidden;
    }
  {%- endif -%}
  #shopify-section-{{ sid }} .wpg__rv-quote.is-swapping{ opacity:0; }
  #shopify-section-{{ sid }} .wpg__rv-author{ font-size:var(--t-size, 15px); font-weight:700; }
  #shopify-section-{{ sid }} .wpg__rv-author .wpg__rv-verified{ font-weight:400; opacity:.8; }
  #shopify-section-{{ sid }} .wpg__rv-foot{ font-size:var(--t-size, 15px); opacity:.85; margin:0; }
  #shopify-section-{{ sid }} .wpg__rv .wpg__btn{ align-self:flex-start; }

  #shopify-section-{{ sid }} .wpg__rv-nav{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:2px;
    flex-shrink:0;
  }
  {%- comment -%}
    The [hidden] attribute selector has almost no specificity, so the plain
    class rule above was beating it and forcing the nav to display:flex even
    while JS has it marked hidden (e.g. a block with only one manual review
    set) — this restores the actual hide. {%- endcomment -%}
  #shopify-section-{{ sid }} .wpg__rv-nav[hidden]{ display:none; }
  #shopify-section-{{ sid }} .wpg__rv-nav button{
    width:26px; height:26px;
    display:flex; align-items:center; justify-content:center;
    border-radius:50%;
    border:1px solid currentColor;
    background:transparent;
    color:inherit;
    opacity:.6;
    cursor:pointer;
    padding:0;
  }
  #shopify-section-{{ sid }} .wpg__rv-nav button:hover{ opacity:1; }
  #shopify-section-{{ sid }} .wpg__rv-nav svg{ width:13px; height:13px; }
  #shopify-section-{{ sid }} .wpg__rv-dots{ display:flex; gap:5px; margin-left:2px; }
  #shopify-section-{{ sid }} .wpg__rv-dots i{
    width:6px; height:6px; border-radius:50%;
    background:currentColor; opacity:.3;
  }
  #shopify-section-{{ sid }} .wpg__rv-dots i.is-on{ opacity:1; }
  @media (max-width:749px){
    #shopify-section-{{ sid }} .wpg__rv-heading{ font-size:var(--h-size-m, 19px); }
    #shopify-section-{{ sid }} .wpg__rv-quote,
    #shopify-section-{{ sid }} .wpg__rv-author,
    #shopify-section-{{ sid }} .wpg__rv-count,
    #shopify-section-{{ sid }} .wpg__rv-foot{ font-size:var(--t-size-m, 12px); }
  }

  /* An empty section in the editor still needs to be clickable. */
  #shopify-section-{{ sid }} .wpg__placeholder{
    grid-column:1 / -1;
    padding:36px 20px;
    text-align:center;
    border:1px dashed rgba(0,0,0,.25);
    border-radius:{{ radius }}px;
    color:rgba(0,0,0,.55);
    font-size:14px;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="wpg">
    {%- for block in section.blocks -%}
      {%- liquid
        comment
          "Theme scheme" reuses the same mechanism the footer already uses
          for this (search color_scheme there) — a color-N class that the
          theme's own global CSS already backs with --color-background /
          --color-foreground custom properties, so a card can match the
          site's real palette instead of a one-off hex value. Manual colour
          stays the default so nothing already saved changes.
        endcomment
        comment
          The .gradient class (Dawn's own, in base.css) is what actually
          paints the scheme's gradient: `.gradient{ background:var(--gradient-
          background); }`. An inline background set on the SAME element
          always wins over that — even a value that LOOKS equivalent, like
          rgb(var(--color-background)) — because inline style beats any
          class rule regardless of specificity. That was silently cancelling
          the real gradient and leaving only a flat (often white) colour
          behind. Fix: when using a theme scheme, don't put background/color
          in the inline style at all — .color-{scheme} and .gradient already
          supply both (confirmed in theme.liquid: their combined selector
          list sets background-color AND color directly), so there's nothing
          for an inline declaration to add except a chance to break it.
        endcomment
        assign scheme_class = ''
        assign bg_color_css = ''
        if block.settings.color_style == 'theme'
          assign scheme_class = 'color-' | append: block.settings.color_scheme | append: ' gradient'
        else
          assign bg = block.settings.bg | default: '#1a1a1a'
          assign fg = block.settings.text_color | default: '#FFFFFF'
          assign bg_color_css = 'background:' | append: bg | append: ';color:' | append: fg | append: ';'
        endif
        assign border_w = block.settings.border_width | default: 0
        assign border_c = block.settings.border_color | default: '#000000'
        assign border_css = '--card-border-w:' | append: border_w | append: 'px;--card-border-c:' | append: border_c | append: ';'
        if block.settings.hide_desktop
          assign scheme_class = scheme_class | append: ' wpg__hide-desktop'
        endif
        if block.settings.hide_mobile
          assign scheme_class = scheme_class | append: ' wpg__hide-mobile'
        endif
        assign span_d = block.settings.span_desktop | default: 6
        assign span_m = block.settings.span_mobile | default: 12
        assign min_h = block.settings.min_height | default: 300
        assign min_h_m = block.settings.min_height_mobile | default: 150
        assign has_btn = false
        if block.settings.btn_label != blank
          assign has_btn = true
        endif

        comment
          A block size of 0 means "use the section default", so a card only
          carries its own value when it has actually been set.
        endcomment
        assign h_size = block.settings.heading_size | default: 0
        if h_size == 0
          assign h_size = section.settings.heading_size | default: 24
        endif
        assign t_size = block.settings.text_size | default: 0
        if t_size == 0
          assign t_size = section.settings.text_size | default: 15
        endif
        assign p_size = block.settings.price_size | default: 0
        if p_size == 0
          assign p_size = section.settings.price_size | default: 30
        endif
        assign b_size = block.settings.btn_size | default: 0
        if b_size == 0
          assign b_size = section.settings.btn_size | default: 15
        endif
        assign b_py = block.settings.btn_pad_y | default: 0
        if b_py == 0
          assign b_py = section.settings.btn_pad_y | default: 11
        endif
        assign b_px = block.settings.btn_pad_x | default: 0
        if b_px == 0
          assign b_px = section.settings.btn_pad_x | default: 18
        endif
        assign m_scale = section.settings.mobile_scale | default: 80 | divided_by: 100.0

        comment
          Mobile resolves in three steps: the block's own mobile value, then
          the section's, then the desktop size scaled down. So sizes can be set
          per breakpoint where it matters and left alone where it does not.
        endcomment
        assign h_size_m = block.settings.heading_size_mobile | default: 0
        if h_size_m == 0
          assign h_size_m = section.settings.heading_size_mobile | default: 0
        endif
        if h_size_m == 0
          assign h_size_m = h_size | times: m_scale | round
        endif
        assign t_size_m = block.settings.text_size_mobile | default: 0
        if t_size_m == 0
          assign t_size_m = section.settings.text_size_mobile | default: 0
        endif
        if t_size_m == 0
          assign t_size_m = t_size | times: m_scale | round
        endif
        assign p_size_m = block.settings.price_size_mobile | default: 0
        if p_size_m == 0
          assign p_size_m = section.settings.price_size_mobile | default: 0
        endif
        if p_size_m == 0
          assign p_size_m = p_size | times: m_scale | round
        endif
        assign b_size_m = block.settings.btn_size_mobile | default: 0
        if b_size_m == 0
          assign b_size_m = section.settings.btn_size_mobile | default: 0
        endif
        if b_size_m == 0
          assign b_size_m = b_size | times: m_scale | round
        endif
      -%}
      {%- capture block_style -%}--span-d:{{ span_d }};--span-m:{{ span_m }};--min-h:{{ min_h }}px;--min-h-m:{{ min_h_m }}px;--h-size:{{ h_size }}px;--t-size:{{ t_size }}px;--p-size:{{ p_size }}px;--b-size:{{ b_size }}px;--b-py:{{ b_py }}px;--b-px:{{ b_px }}px;--h-size-m:{{ h_size_m }}px;--t-size-m:{{ t_size_m }}px;--p-size-m:{{ p_size_m }}px;--b-size-m:{{ b_size_m }}px;{{ bg_color_css }}{{ border_css }}{%- endcapture -%}

      {%- case block.type -%}

        {%- when 'tile' -%}
          {%- liquid
            assign layout = block.settings.layout | default: 'split'
            assign wrap_link = false
            if block.settings.link != blank and has_btn == false
              assign wrap_link = true
            endif
          -%}
          {%- if wrap_link -%}
            <a href="{{ block.settings.link }}" class="wpg__block wpg__tile wpg__tile--{{ layout }} {{ scheme_class }}" style="{{ block_style }}" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="wpg__block wpg__tile wpg__tile--{{ layout }} {{ scheme_class }}" style="{{ block_style }}" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- if block.settings.image != blank and layout == 'stacked' -%}
              <div class="wpg__media">
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 100vw', widths: '400,600,900,1200' }}
              </div>
            {%- endif -%}

            {%- if block.settings.image != blank and layout == 'overlay' -%}
              <div class="wpg__media">
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 60vw, 100vw', widths: '500,800,1100,1400' }}
              </div>
            {%- endif -%}

            <div class="wpg__body">
              {%- if block.settings.heading != blank -%}
                <p class="wpg__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="wpg__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <p class="wpg__price">{{ block.settings.price }}</p>
              {%- endif -%}

              {%- if has_btn -%}
                {%- comment -%}
                  "Button opens the Father's Day Quiz" swaps the normal link
                  for a plain button carrying data-quiz-open — the quiz
                  section's own script already listens for a click on ANY
                  element with that attribute anywhere on the page (see
                  itm-fathers-day-quiz.liquid, document.addEventListener
                  ('click', ...) matching against its own Trigger ID
                  setting), so this doesn't need any JS of its own here.
                {%- endcomment -%}
                {%- if block.settings.open_quiz -%}
                  <button
                    type="button"
                    class="wpg__btn"
                    data-quiz-open="{{ block.settings.quiz_trigger_id | default: 'fathers-day' }}"
                    style="background:{{ block.settings.btn_bg | default: '#FFFFFF' }};color:{{ block.settings.btn_text | default: '#1a1a1a' }};--btn-skew:{{ block.settings.btn_skew | default: 0 }}deg;"
                  >
                    <span>{{ block.settings.btn_label }}</span>
                    {%- if block.settings.btn_arrow -%}{{ arrow_svg }}{%- endif -%}
                  </button>
                {%- else -%}
                  <a
                    href="{{ block.settings.link | default: '#' }}"
                    class="wpg__btn"
                    style="background:{{ block.settings.btn_bg | default: '#FFFFFF' }};color:{{ block.settings.btn_text | default: '#1a1a1a' }};--btn-skew:{{ block.settings.btn_skew | default: 0 }}deg;"
                  >
                    <span>{{ block.settings.btn_label }}</span>
                    {%- if block.settings.btn_arrow -%}{{ arrow_svg }}{%- endif -%}
                  </a>
                {%- endif -%}
              {%- elsif block.settings.link_label != blank -%}
                <span class="wpg__link">
                  <span>{{ block.settings.link_label }}</span>
                  {{ chevrons_svg }}
                </span>
              {%- endif -%}
            </div>

            {%- if block.settings.image != blank and layout == 'split' -%}
              <div class="wpg__media">
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 45vw', widths: '300,500,700,1000' }}
              </div>
            {%- endif -%}

          {%- if wrap_link -%}</a>{%- else -%}</div>{%- endif -%}

        {%- when 'video' -%}
          {%- liquid
            assign has_video = false
            if block.settings.video != blank or block.settings.video_url != blank
              assign has_video = true
            endif
            assign vurl = ''
            if block.settings.video == blank and block.settings.video_url != blank
              if block.settings.video_url.type == 'youtube'
                assign vurl = 'https://www.youtube.com/embed/' | append: block.settings.video_url.id | append: '?autoplay=1&rel=0'
              elsif block.settings.video_url.type == 'vimeo'
                assign vurl = 'https://player.vimeo.com/video/' | append: block.settings.video_url.id | append: '?autoplay=1'
              endif
            endif
            assign ov_pos = block.settings.overlay_position | default: 'bottom'
            assign ov_scale = section.settings.mobile_scale | default: 80 | divided_by: 100.0
            assign ov_h = block.settings.overlay_heading_size | default: 28
            assign ov_t = block.settings.overlay_text_size | default: 15
            assign ov_h_m = block.settings.overlay_heading_size_mobile | default: 0
            if ov_h_m == 0
              assign ov_h_m = ov_h | times: ov_scale | round
            endif
            assign ov_t_m = block.settings.overlay_text_size_mobile | default: 0
            if ov_t_m == 0
              assign ov_t_m = ov_t | times: ov_scale | round
            endif
            assign has_overlay_text = false
            if block.settings.overlay_heading != blank or block.settings.overlay_text != blank
              assign has_overlay_text = true
            endif
          -%}
          <div class="wpg__block wpg__video {{ scheme_class }}" style="{{ block_style }}" {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
