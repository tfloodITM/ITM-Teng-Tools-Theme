          -%}
          <div class="wpg__block wpg__fp wpg__block--bleed {{ scheme_class }}" data-mobile-layout="stacked" style="{{ block_style }}--fp-w:{{ fp_w }}%;--fp-x:{{ fp_x }}%;--fp-y:{{ block.settings.image_y | default: 50 }}%;--fp-rot:{{ block.settings.image_rotate | default: 0 }}deg;--fp-gutter:{{ fp_gutter }}%;--fp-w-m:{{ fp_w_m }}%;" {{ block.shopify_attributes }}>
            {%- if fp_img != blank -%}
              <div class="wpg__fp-media">
                {{ fp_img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 30vw, 55vw', widths: '300,500,700,900', alt: fp_title }}
              </div>
              {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                {%- comment -%}
                  Sibling of .wpg__fp-media, not nested inside it — that
                  container is the .wpg__block--bleed image itself on
                  desktop (overflow:visible, freely repositioned/rotated via
                  the sliders above), so a badge nested inside it moved and
                  rotated right along with it. Anchored to the CARD
                  (.wpg__fp, already position:relative) instead, it stays a
                  plain top-left corner tag no matter where the image is
                  dragged to.
                {%- endcomment -%}
                <span class="wpg__badge-flag" style="--badge-bg:{{ block.settings.badge_bg | default: '#e30613' }};--badge-fg:{{ block.settings.badge_text_color | default: '#1a1a1a' }};">{{ block.settings.badge_text }}</span>
              {%- endif -%}
            {%- endif -%}
            <div class="wpg__fp-body">
              {%- if block.settings.eyebrow != blank or fp_price != blank -%}
                <p class="wpg__fp-eyebrow">
                  {%- if block.settings.eyebrow != blank -%}<span>{{ block.settings.eyebrow }}</span>{%- endif -%}
                  {%- if fp_price != blank -%}<span class="wpg__fp-price">{{ fp_price }}</span>{%- endif -%}
                </p>
              {%- endif -%}
              {%- if fp_title != blank -%}
                <p class="wpg__fp-title">{{ fp_title }}</p>
              {%- endif -%}
            </div>
            {%- liquid
              comment
                An icon counts as "set" if it has an image OR a preset —
                NOT only when it has a label. The label is just a caption;
                requiring it too meant an icon with a custom image and no
                caption text silently vanished, which is exactly the bug
                where "I set an image on the 3rd one, it's just not
                showing up" came from.
              endcomment
              assign has_icons = false
              for n in (1..6)
                case n
                  when 1
                    assign icon_preset = block.settings.icon_1_preset
                    assign icon_image = block.settings.icon_1_image
                  when 2
                    assign icon_preset = block.settings.icon_2_preset
                    assign icon_image = block.settings.icon_2_image
                  when 3
                    assign icon_preset = block.settings.icon_3_preset
                    assign icon_image = block.settings.icon_3_image
                  when 4
                    assign icon_preset = block.settings.icon_4_preset
                    assign icon_image = block.settings.icon_4_image
                  when 5
                    assign icon_preset = block.settings.icon_5_preset
                    assign icon_image = block.settings.icon_5_image
                  when 6
                    assign icon_preset = block.settings.icon_6_preset
                    assign icon_image = block.settings.icon_6_image
                endcase
                if icon_image != blank or icon_preset != blank
                  assign has_icons = true
                endif
              endfor
            -%}
            {%- if has_icons -%}
              <div class="wpg__fp-icons" style="--fp-icon-size:{{ block.settings.icon_size | default: 28 }}px;--fp-icon-gap:{{ block.settings.icon_gap | default: 16 }}px;color:{{ block.settings.icon_color | default: '#FFFFFF' }};">
                {%- for n in (1..6) -%}
                  {%- case n -%}
                    {%- when 1 -%}
                      {%- assign icon_label = block.settings.icon_1_label -%}
                      {%- assign icon_preset = block.settings.icon_1_preset -%}
                      {%- assign icon_image = block.settings.icon_1_image -%}
                    {%- when 2 -%}
                      {%- assign icon_label = block.settings.icon_2_label -%}
                      {%- assign icon_preset = block.settings.icon_2_preset -%}
                      {%- assign icon_image = block.settings.icon_2_image -%}
                    {%- when 3 -%}
                      {%- assign icon_label = block.settings.icon_3_label -%}
                      {%- assign icon_preset = block.settings.icon_3_preset -%}
                      {%- assign icon_image = block.settings.icon_3_image -%}
                    {%- when 4 -%}
                      {%- assign icon_label = block.settings.icon_4_label -%}
                      {%- assign icon_preset = block.settings.icon_4_preset -%}
                      {%- assign icon_image = block.settings.icon_4_image -%}
                    {%- when 5 -%}
                      {%- assign icon_label = block.settings.icon_5_label -%}
                      {%- assign icon_preset = block.settings.icon_5_preset -%}
                      {%- assign icon_image = block.settings.icon_5_image -%}
                    {%- when 6 -%}
                      {%- assign icon_label = block.settings.icon_6_label -%}
                      {%- assign icon_preset = block.settings.icon_6_preset -%}
