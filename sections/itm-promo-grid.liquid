                <button type="button" data-rv-prev aria-label="Previous review">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button type="button" data-rv-next aria-label="Next review">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
                <span class="wpg__rv-dots" data-rv-dots></span>
              </div>
            {%- endif -%}

            {%- if block.settings.footer_text != blank -%}
              <p class="wpg__rv-foot">{{ block.settings.footer_text }}</p>
            {%- endif -%}

            {%- if block.settings.btn_label != blank -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="wpg__btn"
                style="background:{{ block.settings.btn_bg | default: '#FFFFFF' }};color:{{ block.settings.btn_text | default: '#1a1a1a' }};--btn-skew:{{ block.settings.btn_skew | default: 0 }}deg;"
              >
                <span>{{ block.settings.btn_label }}</span>
                {%- if block.settings.btn_arrow -%}{{ arrow_svg }}{%- endif -%}
              </a>
            {%- endif -%}
          </div>

        {%- comment -%}
          Reviews slider 2 — a second, independent reviews block, built from
          scratch (verified end-to-end with a real Liquid interpreter and a
          real browser DOM before shipping, not just re-read). It
          deliberately reuses the exact same markup/classes/data-attributes
          as the block above (wpg__rv, data-wpg-reviews, data-rv-quote, and
          so on) — that means it's picked up automatically by the existing
          carousel JS a few hundred lines down (root.querySelectorAll
          ('[data-wpg-reviews]')) without needing a single new line of JS,
          and it inherits the same already-correct CSS. Only the settings
          are new: up to 5 reviews as plain quote/name/rating fields on the
          block itself, no product picker, no Judge.me token — nothing that
          can fail to load. No token is ever rendered, so the JS always
          takes its manual-reviews path for this block.
        {%- endcomment -%}
        {%- when 'reviews_v2' -%}
          {%- liquid
            assign star_pct = block.settings.review_1_rating | default: 5 | times: 20

            assign mr_items = '' | split: ','
            for n in (1..5)
              case n
                when 1
                  assign mr_text = block.settings.review_1_quote
                  assign mr_name = block.settings.review_1_name
                  assign mr_rating = block.settings.review_1_rating
                when 2
                  assign mr_text = block.settings.review_2_quote
                  assign mr_name = block.settings.review_2_name
                  assign mr_rating = block.settings.review_2_rating
                when 3
                  assign mr_text = block.settings.review_3_quote
                  assign mr_name = block.settings.review_3_name
                  assign mr_rating = block.settings.review_3_rating
                when 4
                  assign mr_text = block.settings.review_4_quote
                  assign mr_name = block.settings.review_4_name
                  assign mr_rating = block.settings.review_4_rating
                when 5
                  assign mr_text = block.settings.review_5_quote
                  assign mr_name = block.settings.review_5_name
                  assign mr_rating = block.settings.review_5_rating
              endcase
              if mr_text != blank
                assign mr_name = mr_name | default: 'Verified Buyer'
                capture mr_item
                  echo '{"content":'
                  echo mr_text | json
                  echo ',"name":'
                  echo mr_name | json
                  echo '}'
                endcapture
                assign mr_item_arr = mr_item | split: '||itm-rv2-never-splits-this||'
                assign mr_items = mr_items | concat: mr_item_arr
              endif
            endfor
            assign manual_reviews_json = mr_items | join: ',' | prepend: '[' | append: ']'
          -%}
          <div
            class="wpg__block wpg__rv {{ scheme_class }}"
            style="{{ block_style }}--star-size:{{ block.settings.star_size | default: 17 }}px;--star-color:{{ block.settings.star_color | default: '#e30613' }};--star-empty:{{ block.settings.star_empty_color | default: '#FFFFFF' | color_modify: 'alpha', 0.3 }};"
            data-wpg-reviews
            data-manual-reviews="{{ manual_reviews_json | escape }}"
            data-shop-domain=""
            data-judgeme-token=""
            data-judgeme-product=""
            data-rotate="{{ block.settings.rotate_seconds | default: 6 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != blank -%}
              <p class="wpg__rv-heading">{{ block.settings.heading }}</p>
            {%- endif -%}

            <div class="wpg__rv-top">
              <span class="wpg__stars" aria-hidden="true" style="--star-pct:{{ star_pct }}%;">
                <span class="wpg__stars-bg">★★★★★</span>
                <span class="wpg__stars-fill" data-rv-fill>★★★★★</span>
              </span>
              <span class="wpg__rv-count" data-rv-count></span>
            </div>

            <p class="wpg__rv-quote" data-rv-quote>{{ block.settings.review_1_quote }}</p>
            <span class="wpg__rv-author" data-rv-author>
              {{- block.settings.review_1_name | default: 'Verified Buyer' -}}
            </span>

            {%- if block.settings.show_nav -%}
              <div class="wpg__rv-nav" hidden data-rv-nav>
                <button type="button" data-rv-prev aria-label="Previous review">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button type="button" data-rv-next aria-label="Next review">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
                <span class="wpg__rv-dots" data-rv-dots></span>
              </div>
            {%- endif -%}

            {%- if block.settings.footer_text != blank -%}
              <p class="wpg__rv-foot">{{ block.settings.footer_text }}</p>
            {%- endif -%}

            {%- if block.settings.btn_label != blank -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="wpg__btn"
                style="background:{{ block.settings.btn_bg | default: '#FFFFFF' }};color:{{ block.settings.btn_text | default: '#1a1a1a' }};--btn-skew:{{ block.settings.btn_skew | default: 0 }}deg;"
              >
                <span>{{ block.settings.btn_label }}</span>
                {%- if block.settings.btn_arrow -%}{{ arrow_svg }}{%- endif -%}
              </a>
            {%- endif -%}
          </div>

        {%- comment -%}
          Featured product — mobile combo. Everything that used to be two
          separate cards fighting each other for a spot side by side
          (featured product + reviews) fused into ONE card, always stacked
          in one order: image, then text, then icons, then reviews, then
          the button — no side-by-side pairing to keep in sync with a
          second block's span, ever. "Hide on desktop" defaults ON for this
          one (see Visibility below) since it exists specifically to solve
          the mobile case; flip it off if you ever want it on desktop too.

          Reuses the exact same icon markup/CSS as Featured Product (the
          wpg__fp-icon classes) and the exact same reviews markup/data
          attributes as Reviews Slider 2 (data-wpg-reviews, data-rv-quote,
          etc) — so the already-verified icon and carousel logic elsewhere
          in this file picks this block up automatically. Nothing new to
          test on the JS side.
        {%- endcomment -%}
        {%- when 'featured_combo' -%}
          {%- liquid
            assign combo_prod = block.settings.product
            assign combo_img = block.settings.image
            if combo_img == blank and combo_prod != blank
              assign combo_img = combo_prod.featured_image
            endif
            assign combo_title = block.settings.title
            if combo_title == blank and combo_prod != blank
              assign combo_title = combo_prod.title
            endif
            assign combo_price = block.settings.price_text
            if combo_price == blank and combo_prod != blank
              assign combo_price = combo_prod.price | money
            endif
            assign combo_link = block.settings.link
            if combo_link == blank and combo_prod != blank
              assign combo_link = combo_prod.url
            endif
            assign combo_img_w = block.settings.image_size | default: 70

            comment
              Reviews, built the exact same verified way as Reviews Slider 2.
            endcomment
            assign mr_items = '' | split: ','
            for n in (1..5)
              case n
                when 1
                  assign mr_text = block.settings.review_1_quote
                  assign mr_name = block.settings.review_1_name
                when 2
                  assign mr_text = block.settings.review_2_quote
                  assign mr_name = block.settings.review_2_name
                when 3
                  assign mr_text = block.settings.review_3_quote
                  assign mr_name = block.settings.review_3_name
                when 4
                  assign mr_text = block.settings.review_4_quote
                  assign mr_name = block.settings.review_4_name
                when 5
                  assign mr_text = block.settings.review_5_quote
                  assign mr_name = block.settings.review_5_name
              endcase
              if mr_text != blank
                assign mr_name = mr_name | default: 'Verified Buyer'
                capture mr_item
                  echo '{"content":'
                  echo mr_text | json
                  echo ',"name":'
                  echo mr_name | json
                  echo '}'
                endcapture
                assign mr_item_arr = mr_item | split: '||itm-combo-never-splits-this||'
                assign mr_items = mr_items | concat: mr_item_arr
              endif
            endfor
            assign manual_reviews_json = mr_items | join: ',' | prepend: '[' | append: ']'
            assign has_reviews = false
            if block.settings.review_1_quote != blank
              assign has_reviews = true
            endif

            assign has_icons = false
            for n in (1..6)
              case n
                when 1
                  assign icon_preset = block.settings.icon_1_preset
                  assign icon_image = block.settings.icon_1_image
                when 2
                  assign icon_preset = block.settings.icon_2_preset
                  assign icon_image = block.settings.icon_2_image
                when 3
                  assign icon_preset = block.settings.icon_3_preset
                  assign icon_image = block.settings.icon_3_image
                when 4
                  assign icon_preset = block.settings.icon_4_preset
                  assign icon_image = block.settings.icon_4_image
                when 5
                  assign icon_preset = block.settings.icon_5_preset
                  assign icon_image = block.settings.icon_5_image
                when 6
                  assign icon_preset = block.settings.icon_6_preset
                  assign icon_image = block.settings.icon_6_image
              endcase
              if icon_image != blank or icon_preset != blank
                assign has_icons = true
              endif
            endfor
          -%}
          <div class="wpg__block wpg__combo {{ scheme_class }}" style="{{ block_style }}--combo-img-w:{{ combo_img_w }}%;" {{ block.shopify_attributes }}>
            {%- if combo_img != blank -%}
              <div class="wpg__combo-media">
                {{ combo_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', alt: combo_title }}
              </div>
              {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                <span class="wpg__badge-flag" style="--badge-bg:{{ block.settings.badge_bg | default: '#e30613' }};--badge-fg:{{ block.settings.badge_text_color | default: '#1a1a1a' }};">{{ block.settings.badge_text }}</span>
              {%- endif -%}
            {%- endif -%}
            <div class="wpg__combo-body">
              {%- if block.settings.eyebrow != blank or combo_price != blank -%}
                <p class="wpg__fp-eyebrow">
                  {%- if block.settings.eyebrow != blank -%}<span>{{ block.settings.eyebrow }}</span>{%- endif -%}
                  {%- if combo_price != blank -%}<span class="wpg__fp-price">{{ combo_price }}</span>{%- endif -%}
                </p>
              {%- endif -%}
              {%- if combo_title != blank -%}
                <p class="wpg__fp-title">{{ combo_title }}</p>
              {%- endif -%}
            </div>
            {%- if has_icons -%}
              <div class="wpg__fp-icons" style="--fp-icon-size:{{ block.settings.icon_size | default: 28 }}px;--fp-icon-gap:{{ block.settings.icon_gap | default: 16 }}px;color:{{ block.settings.icon_color | default: '#FFFFFF' }};">
                {%- for n in (1..6) -%}
                  {%- case n -%}
                    {%- when 1 -%}
                      {%- assign icon_label = block.settings.icon_1_label -%}
                      {%- assign icon_preset = block.settings.icon_1_preset -%}
                      {%- assign icon_image = block.settings.icon_1_image -%}
                    {%- when 2 -%}
                      {%- assign icon_label = block.settings.icon_2_label -%}
                      {%- assign icon_preset = block.settings.icon_2_preset -%}
                      {%- assign icon_image = block.settings.icon_2_image -%}
                    {%- when 3 -%}
                      {%- assign icon_label = block.settings.icon_3_label -%}
                      {%- assign icon_preset = block.settings.icon_3_preset -%}
                      {%- assign icon_image = block.settings.icon_3_image -%}
                    {%- when 4 -%}
                      {%- assign icon_label = block.settings.icon_4_label -%}
                      {%- assign icon_preset = block.settings.icon_4_preset -%}
                      {%- assign icon_image = block.settings.icon_4_image -%}
                    {%- when 5 -%}
                      {%- assign icon_label = block.settings.icon_5_label -%}
                      {%- assign icon_preset = block.settings.icon_5_preset -%}
                      {%- assign icon_image = block.settings.icon_5_image -%}
                    {%- when 6 -%}
                      {%- assign icon_label = block.settings.icon_6_label -%}
                      {%- assign icon_preset = block.settings.icon_6_preset -%}
                      {%- assign icon_image = block.settings.icon_6_image -%}
                  {%- endcase -%}
                  {%- if icon_image != blank or icon_preset != blank -%}
                    <span class="wpg__fp-icon">
                      {%- if icon_image != blank -%}
                        {{ icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: icon_label }}
                      {%- elsif icon_preset != blank -%}
                        {%- render 'itm-trust-icon', preset: icon_preset -%}
                      {%- endif -%}
                      {%- if icon_label != blank -%}<em>{{ icon_label }}</em>{%- endif -%}
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if has_reviews -%}
              <div
                class="wpg__combo-reviews"
                style="--star-size:{{ block.settings.star_size | default: 17 }}px;--star-color:{{ block.settings.star_color | default: '#e30613' }};--star-empty:{{ block.settings.star_empty_color | default: '#FFFFFF' | color_modify: 'alpha', 0.3 }};"
                data-wpg-reviews
                data-manual-reviews="{{ manual_reviews_json | escape }}"
                data-shop-domain=""
                data-judgeme-token=""
                data-judgeme-product=""
                data-rotate="{{ block.settings.rotate_seconds | default: 6 }}"
              >
                <div class="wpg__rv-top">
                  <span class="wpg__stars" aria-hidden="true">
                    <span class="wpg__stars-bg">★★★★★</span>
                    <span class="wpg__stars-fill" data-rv-fill>★★★★★</span>
                  </span>
                  <span class="wpg__rv-count" data-rv-count></span>
                </div>
                <p class="wpg__rv-quote" data-rv-quote>{{ block.settings.review_1_quote }}</p>
                <span class="wpg__rv-author" data-rv-author>{{- block.settings.review_1_name | default: 'Verified Buyer' -}}</span>
                {%- if block.settings.show_nav -%}
                  <div class="wpg__rv-nav" hidden data-rv-nav>
                    <button type="button" data-rv-prev aria-label="Previous review">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                    <button type="button" data-rv-next aria-label="Next review">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                    <span class="wpg__rv-dots" data-rv-dots></span>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if block.settings.btn_label != blank -%}
              <a
                href="{{ combo_link | default: '#' }}"
                class="wpg__btn"
                style="background:{{ block.settings.btn_bg | default: '#FFFFFF' }};color:{{ block.settings.btn_text | default: '#1a1a1a' }};--btn-skew:{{ block.settings.btn_skew | default: 0 }}deg;"
              >
                <span>{{ block.settings.btn_label }}</span>
                {%- if block.settings.btn_arrow -%}{{ arrow_svg }}{%- endif -%}
              </a>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- else -%}
      <div class="wpg__placeholder">Add tiles, a video or a banner to this section</div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ sid }}');
    if (!root) return;

    function dismiss(cover) { cover.classList.add('is-playing'); }

    root.addEventListener('click', function (e) {
      var cover = e.target.closest('.wpg__cover');
      if (!cover || !root.contains(cover)) return;
      var block = cover.parentNode;
      var media = block.querySelector('[data-wpg-embed]');

      if (media) {
        /* Embed: build the iframe on demand so nothing third party is
           requested until someone actually asks for the video. */
        var src = media.getAttribute('data-wpg-embed');
        if (src && !media.querySelector('iframe')) {
          var frame = document.createElement('iframe');
          frame.src = src;
          frame.title = media.getAttribute('data-wpg-title') || 'Video';
          frame.allow = 'autoplay; encrypted-media; picture-in-picture';
          frame.setAttribute('allowfullscreen', '');
          media.appendChild(frame);
        }
        dismiss(cover);
        return;
      }

      var video = block.querySelector('video');
      if (video) {
        var played = video.play();
        if (played && played.catch) { played.catch(function () {}); }
        dismiss(cover);
      }
    });

    /* The native controls are reachable once the cover is gone, but a video
       can also start from a keyboard shortcut or autoplay, so follow the
       element's own state rather than only our click. */
    root.querySelectorAll('.wpg__video video').forEach(function (video) {
      video.addEventListener('play', function () {
        var cover = video.closest('.wpg__video').querySelector('.wpg__cover');
        if (cover) dismiss(cover);
      });
    });

    /* ---------- review slider ----------
       Primary source: the manual reviews typed into the block's own
       settings (data-manual-reviews, a small JSON array rendered server
       side by Liquid) — real quotes, pulled straight off the product's own
       page, no API call, nothing that can 404 or need a token. That's
       always available the instant the block is saved.

       Judge.me's public Widget API is tried ONLY as a bonus on top, and
       only when the block actually has both a token and a product set. If
       it fails, comes back empty, or isn't configured at all, this falls
       straight back to the manual reviews above — the card is never left
       showing nothing. */
    root.querySelectorAll('[data-wpg-reviews]').forEach(function (card) {
      var quoteEl  = card.querySelector('[data-rv-quote]');
      var authorEl = card.querySelector('[data-rv-author]');
      var countEl  = card.querySelector('[data-rv-count]');
      var starsEl  = card.querySelector('.wpg__stars');
      var nav      = card.querySelector('[data-rv-nav]');
      var dotsEl   = card.querySelector('[data-rv-dots]');
      var shop     = card.getAttribute('data-shop-domain');
      var token    = card.getAttribute('data-judgeme-token');
      var pid      = card.getAttribute('data-judgeme-product');
      var every    = (parseInt(card.getAttribute('data-rotate'), 10) || 0) * 1000;

      var manualReviews = [];
      try {
        var mrRaw = card.getAttribute('data-manual-reviews');
        if (mrRaw) {
          manualReviews = JSON.parse(mrRaw).filter(function (r) { return r && r.content; });
        }
      } catch (e) {
        console.warn('[promo-grid reviews] Could not parse the manual reviews for this block.', e);
      }

      var reviews = [], i = 0, timer = null;

      function render(idx) {
        var r = reviews[idx];
        if (!r) return;
        quoteEl.classList.add('is-swapping');
        setTimeout(function () {
          quoteEl.textContent = '"' + r.content + '"';
          authorEl.innerHTML = '';
          authorEl.appendChild(document.createTextNode(r.name));
          if (r.verified) {
            var v = document.createElement('span');
            v.className = 'wpg__rv-verified';
            v.textContent = ' | Verified Buyer';
            authorEl.appendChild(v);
          }
          quoteEl.classList.remove('is-swapping');
        }, 280);
        if (dotsEl) {
          [].forEach.call(dotsEl.children, function (d, n) {
            d.className = n === idx ? 'is-on' : '';
          });
        }
      }

      function go(n) {
        i = (n + reviews.length) % reviews.length;
        render(i);
      }

      function start() {
        if (!every || reviews.length < 2) return;
        clearInterval(timer);
        timer = setInterval(function () { go(i + 1); }, every);
      }

      /* Wires up the dots/arrows and kicks off rotation — shared by both the
         manual set and a successful live fetch, so neither path duplicates
         the other's carousel-activation logic. */
      function activate(list) {
        reviews = list;
        if (!reviews.length) return;
        render(0);
        if (nav && reviews.length > 1) {
          nav.hidden = false;
          if (dotsEl) {
            dotsEl.innerHTML = '';
            reviews.forEach(function (_, n) {
              var d = document.createElement('i');
              if (n === 0) d.className = 'is-on';
              dotsEl.appendChild(d);
            });
          }
          var prev = card.querySelector('[data-rv-prev]');
          var next = card.querySelector('[data-rv-next]');
          if (prev) prev.addEventListener('click', function () { go(i - 1); start(); });
          if (next) next.addEventListener('click', function () { go(i + 1); start(); });
        }
        start();
      }

      function useManual(reason) {
        if (reason) console.warn('[promo-grid reviews] ' + reason + ' Using the manual reviews instead.');
        if (!manualReviews.length) {
          console.warn('[promo-grid reviews] No manual reviews are set on this block either — add a few under "Reviews (manual)" in the block settings.');
          return;
        }
        activate(manualReviews);
      }

      if (!token || !pid) {
        useManual(!token ? 'No Judge.me public token set on this block.' : 'This block has no product selected.');
      } else {
        var itmReviewsUrl = 'https://api.judge.me/api/v1/widgets/product_review?shop_domain=' + encodeURIComponent(shop) +
              '&external_id=' + encodeURIComponent(pid) +
              '&api_token=' + encodeURIComponent(token) +
              '&json_request=true' +
              '&per_page=' + (card.getAttribute('data-per-page') || 12) + '&page=1';

        fetch(itmReviewsUrl)
          .then(function (r) {
            if (!r.ok) { console.warn('[promo-grid reviews] Judge.me returned HTTP ' + r.status + ' for', itmReviewsUrl); }
            return r.json();
          })
          .then(function (d) {
            console.log('[promo-grid reviews] raw response for product ' + pid + ':', d);

            d = d || {};
            var raw = d.reviews || (d.response && d.response.reviews) || [];
            raw = raw.map(function (item) { return item && item.review ? item.review : item; });

            var count = d.review_number || d.reviews_count || d.total_reviews ||
              (d.product && d.product.reviews_count);
            var avg = d.average_rating || d.reviews_average ||
              (d.product && d.product.average_rating);

            if (count && countEl) { countEl.textContent = '(' + count + ' reviews)'; }
            if (avg && starsEl) { starsEl.style.setProperty('--star-pct', (avg / 5 * 100).toFixed(1) + '%'); }

            var live = raw.filter(function (r) {
              var body = r.body || r.content || '';
              return body.trim().length > 12;
            }).map(function (r) {
              return {
                content: (r.body || r.content || '').trim(),
                name: (r.reviewer && r.reviewer.name) || r.name || 'Verified Buyer',
                verified: !!(r.verified || r.verified_buyer)
              };
            });

            if (!live.length) {
              useManual('Judge.me returned a response but no usable reviews came out of it.');
              return;
            }
            activate(live);
          })
          .catch(function (err) {
            console.warn('[promo-grid reviews] Judge.me fetch failed.', err);
            useManual();
          });
      }

      /* Don't rotate a card nobody is looking at. */
      card.addEventListener('mouseenter', function () { clearInterval(timer); });
      card.addEventListener('mouseleave', start);
    });
  })();
</script>

{% schema %}
{
  "name": "Promo grid",
  "tag": "section",
  "class": "section winland-promo-grid",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#F4F4F4"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "label": "Maximum width",
      "default": 1430
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between tiles",
