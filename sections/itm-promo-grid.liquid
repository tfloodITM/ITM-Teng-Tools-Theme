            {%- comment -%} Manual reviews (above) are the primary source —
              always available, nothing to configure. Judge.me live fetch is
              only attempted as a bonus on top, and only if both a token AND
              a product are set; if it fails or comes back empty the JS
              below falls straight back to the manual reviews. {%- endcomment -%}
            data-manual-reviews="{{ manual_reviews_json | escape }}"
            data-shop-domain="{{ shop.permanent_domain }}"
            data-judgeme-token="{{ block.settings.judgeme_public_token }}"
            data-judgeme-product="{{ rv_pid }}"
            data-rotate="{{ block.settings.rotate_seconds | default: 6 }}"
            {{ block.shopify_attributes }}
