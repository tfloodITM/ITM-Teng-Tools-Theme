              </span>
            </div>

            <p class="wpg__rv-quote" data-rv-quote>{{ block.settings.fallback_quote }}</p>
            <span class="wpg__rv-author" data-rv-author>
              {{- block.settings.fallback_author -}}
              {%- if block.settings.fallback_author != blank and block.settings.verified_label != blank -%}
                <span class="wpg__rv-verified"> | {{ block.settings.verified_label }}</span>
              {%- endif -%}
            </span>

            {%- if block.settings.show_nav -%}
