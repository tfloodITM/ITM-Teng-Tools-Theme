                {%- for n in (1..6) -%}
                  {%- case n -%}
                    {%- when 1 -%}
                      {%- assign icon_label = block.settings.icon_1_label -%}
                      {%- assign icon_preset = block.settings.icon_1_preset -%}
                      {%- assign icon_image = block.settings.icon_1_image -%}
