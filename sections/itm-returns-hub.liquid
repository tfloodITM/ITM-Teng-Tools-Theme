{%- comment -%} ITM resync marker: returns-hub v1 — force GitHub→Shopify re-sync {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

<div class="rh-wrap page-width">

  <!-- Intro -->
  <div class="rh-intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rh-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="rh-heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="rh-subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <!-- Start your return — clickable card -->
  <a href="{{ section.settings.card_link | default: '#' }}" class="rh-start-card">
    <div class="rh-start-card__icon">
      {%- if section.settings.card_icon != blank -%}
        {{ section.settings.card_icon | image_url: width: 120 | image_tag: alt: section.settings.card_heading, loading: 'lazy' }}
      {%- else -%}
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 7h13v13H3z"/>
          <path d="M16 10h3l2 3v4h-5"/>
          <circle cx="7.5" cy="20" r="1.5"/>
          <circle cx="17.5" cy="20" r="1.5"/>
          <path d="M3 7l2-4h8l2 4"/>
        </svg>
      {%- endif -%}
    </div>
    <div class="rh-start-card__body">
      <p class="rh-start-card__kicker">{{ section.settings.card_kicker }}</p>
      <h2 class="rh-start-card__heading">{{ section.settings.card_heading }}</h2>
      <p class="rh-start-card__sub">{{ section.settings.card_subtext }}</p>
    </div>
    <div class="rh-start-card__arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </div>
  </a>

  <!-- What you need to know — steps -->
  {%- if section.settings.steps_heading != blank -%}
    <h2 class="rh-section-heading">{{ section.settings.steps_heading }}</h2>
  {%- endif -%}
  <div class="rh-steps">
    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        <div class="rh-step" {{ block.shopify_attributes }}>
          <span class="rh-step__num">{{ forloop.index }}</span>
          <h3 class="rh-step__title">{{ block.settings.title }}</h3>
          <p class="rh-step__text">{{ block.settings.text }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- Info cards -->
  <div class="rh-info-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'info_card' -%}
        <div class="rh-info-card" {{ block.shopify_attributes }}>
          <div class="rh-info-card__icon">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 80 | image_tag: alt: block.settings.heading, loading: 'lazy' }}
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="13"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            {%- endif -%}
          </div>
          <h3 class="rh-info-card__heading">{{ block.settings.heading }}</h3>
          <div class="rh-info-card__text">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link | default: '#' }}" class="rh-info-card__link">
              {{ block.settings.link_label }}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

</div>

<style>
.rh-wrap { max-width: 1100px; }

.rh-intro {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 40px;
}
.rh-eyebrow {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #e30613;
  margin: 0 0 10px;
}
.rh-heading {
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 800;
  margin: 0 0 12px;
  color: #1a1a1a;
}
.rh-subtext {
  font-size: 16px;
  color: #555;
  line-height: 1.6;
  margin: 0;
}

/* Start return card */
.rh-start-card {
  display: flex;
  align-items: center;
  gap: 24px;
  text-decoration: none;
  color: inherit;
  background: #1a1a1a;
  border-radius: 16px;
  padding: 32px 36px;
  margin: 0 0 56px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.rh-start-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
}
.rh-start-card__icon {
  flex-shrink: 0;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: #e30613;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.rh-start-card__icon img { width: 100%; height: 100%; object-fit: cover; }
.rh-start-card__body { flex: 1; min-width: 0; text-align: left; }
.rh-start-card__kicker {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #e30613;
  margin: 0 0 4px;
  text-align: left !important;
}
.rh-start-card__heading {
  font-size: clamp(1.3rem, 2.4vw, 1.7rem);
  font-weight: 800;
  color: #fff;
  margin: 0 0 6px;
  text-align: left !important;
}
.rh-start-card__sub {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.75);
  margin: 0;
  line-height: 1.5;
  text-align: left !important;
}
.rh-start-card__arrow {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.35);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, background 0.2s ease;
}
.rh-start-card:hover .rh-start-card__arrow {
  background: #e30613;
  border-color: #e30613;
  color: #1a1a1a;
  transform: translateX(4px);
}

.rh-section-heading {
  text-align: center;
  font-size: clamp(1.3rem, 2.6vw, 1.8rem);
  font-weight: 800;
  color: #1a1a1a;
  margin: 0 0 28px;
}

/* Steps */
.rh-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin: 0 0 56px;
}
.rh-step {
  text-align: center;
  padding: 24px 20px;
  border: 1px solid #e0e0e0;
  border-radius: 12px;
}
.rh-step__num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #e30613;
  color: #1a1a1a;
  font-weight: 800;
  font-size: 15px;
  margin-bottom: 12px;
}
.rh-step__title {
  font-size: 15px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 6px;
}
.rh-step__text {
  font-size: 14px;
  color: #666;
  line-height: 1.5;
  margin: 0;
}

/* Info cards */
.rh-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.rh-info-card {
  border: 1px solid #ececec;
  border-radius: 14px;
  padding: 28px;
  background: #fafafa;
}
.rh-info-card__icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid #ececec;
  color: #e30613;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  overflow: hidden;
}
.rh-info-card__icon img { width: 100%; height: 100%; object-fit: cover; }
.rh-info-card__heading {
  font-size: 16px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 8px;
}
.rh-info-card__text {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}
.rh-info-card__text a { color: #1a1a1a; text-decoration: underline; }
.rh-info-card__link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #1a1a1a;
  text-decoration: none;
  border-bottom: 1px solid #1a1a1a;
  padding-bottom: 2px;
}

@media (max-width: 989px) {
  .rh-steps { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 749px) {
  .rh-start-card {
    flex-wrap: wrap;
    padding: 24px;
    gap: 16px;
  }
  .rh-start-card__arrow { display: none; }
  .rh-steps { grid-template-columns: repeat(2, 1fr); gap: 24px 16px; }
  .rh-info-grid { grid-template-columns: 1fr; }
}
</style>

{% schema %}
{
  "name": "Returns Hub",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "30-DAY MONEY-BACK GUARANTEE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Returns & Refunds"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We offer a 30-day money-back guarantee on everything bought directly from us."
    },
    {
      "type": "header",
      "content": "Start your return — card"
    },
    {
      "type": "image_picker",
      "id": "card_icon",
      "label": "Icon (optional)",
      "info": "Small round icon on the card. Leave blank for a default box icon."
    },
    {
      "type": "text",
      "id": "card_kicker",
      "label": "Kicker text",
      "default": "READY TO SEND SOMETHING BACK?"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Heading",
      "default": "Start Your Return"
    },
    {
      "type": "text",
      "id": "card_subtext",
      "label": "Subtext",
      "default": "All you need to start the return process is the email you used in your order."
    },
    {
      "type": "url",
      "id": "card_link",
      "label": "Link",
      "info": "Where the whole card links to, e.g. your customer account / order lookup page."
    },
    {
      "type": "header",
      "content": "What you need to know"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Heading",
      "default": "What You Need to Know"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    },
    {
      "type": "info_card",
      "name": "Info Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Leave blank to hide the link."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Returns Hub",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "info_card" },
        { "type": "info_card" }
      ]
    }
  ]
}
{% endschema %}
