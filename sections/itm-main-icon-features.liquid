{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.padding_bg }};
  }
  #shopify-section-{{ section.id }} .features {
    {%- if section.settings.section_use_scheme -%}
      {%- assign _fs = section.settings.section_fill_scheme -%}
      background: {{ _fs.settings.background_gradient | default: _fs.settings.background }};
    {%- else -%}
      background-color: {{ section.settings.section_bg }};
    {%- endif -%}
    {%- comment -%}
      0px width renders as no visible line at all, so this doesn't need
      its own on/off checkbox — same approach as the icon circle border.
    {%- endcomment -%}
    border-top: {{ section.settings.section_border_width }}px solid {{ section.settings.section_border_color }};
    border-bottom: {{ section.settings.section_border_width }}px solid {{ section.settings.section_border_color }};
  }
  #shopify-section-{{ section.id }} .page-width {
    max-width: 100% !important;
    padding-left: 150px !important;
    padding-right: 150px !important;
  }
  #shopify-section-{{ section.id }} .feature__iconwrap {
    color: {{ section.settings.icon_color }};
    width: {{ section.settings.icon_wrap_size }}px;
    height: {{ section.settings.icon_wrap_size }}px;
    flex: 0 0 {{ section.settings.icon_wrap_size }}px;
  }
  {%- comment -%}
    The bubble is the circle itself (border-radius:999px in the base
    stylesheet) — "remove the circle" is display:none here rather than
    deleting the element, so the icon above it keeps the exact same
    centred position either way. Border lives on this same element since
    it's already the perfect circle; icon_border_width defaults to 0,
    which renders as no visible border without needing a separate on/off
    toggle for it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .feature__bubble {
    {%- if section.settings.show_icon_bubble -%}
      background: {{ section.settings.icon_bubble_color }};
    {%- else -%}
      background: transparent;
    {%- endif -%}
    border-style: solid;
    border-width: {{ section.settings.icon_border_width }}px;
    border-color: {{ section.settings.icon_border_color }};
  }
  #shopify-section-{{ section.id }} .feature__glyph,
  #shopify-section-{{ section.id }} .feature__glyphimg,
  #shopify-section-{{ section.id }} .feature__lottie {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
  }
  {%- comment -%}
    "True colour" mode: show the uploaded icon exactly as uploaded
    instead of the default flat-tint mask. The mask keeps only the
    icon's silhouette and discards its actual colours, which is right
    for plain transparent line-art icons but turns a pre-coloured badge
    icon (its own circle/background baked in) into one solid blob —
    that's the "icons render as a black dot" symptom this fixes. The
    bubble is forced transparent here too, since a pre-styled badge icon
    already has its own background baked in and doesn't need a second
    circle drawn behind it.
  {%- endcomment -%}
  {%- if section.settings.icon_true_color -%}
    #shopify-section-{{ section.id }} .feature__bubble {
      background: transparent !important;
    }
    #shopify-section-{{ section.id }} .feature__glyph {
      display: none;
    }
    #shopify-section-{{ section.id }} .feature__glyphimg {
      display: block;
      filter: none;
    }
  {%- endif -%}
  #shopify-section-{{ section.id }} .feature__title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
  }
  #shopify-section-{{ section.id }} .feature__desc {
    font-size: {{ section.settings.desc_size }}px;
    font-weight: {{ section.settings.desc_weight }};
    color: {{ section.settings.desc_color }};
  }
  @media (min-width: 750px) and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .page-width {
      padding-left: 40px !important;
      padding-right: 40px !important;
    }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .page-width {
      padding-left: 16px !important;
      padding-right: 16px !important;
    }
    #shopify-section-{{ section.id }} .feature__title {
      font-size: {{ section.settings.title_size_mobile }}px;
      {%- if section.settings.title_color_mobile != blank %}
        color: {{ section.settings.title_color_mobile }};
      {%- endif %}
    }
    #shopify-section-{{ section.id }} .feature__desc {
      font-size: {{ section.settings.desc_size_mobile }}px;
      {%- if section.settings.desc_color_mobile != blank %}
        color: {{ section.settings.desc_color_mobile }};
      {%- endif %}
    }
    {%- if section.settings.section_bg_mobile != blank and section.settings.section_use_scheme != true %}
      #shopify-section-{{ section.id }} .features {
        background-color: {{ section.settings.section_bg_mobile }};
      }
    {%- endif %}
    #shopify-section-{{ section.id }} .feature__iconwrap {
      width: {{ section.settings.icon_wrap_size_mobile }}px;
      height: {{ section.settings.icon_wrap_size_mobile }}px;
      flex: 0 0 {{ section.settings.icon_wrap_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .feature__glyph,
    #shopify-section-{{ section.id }} .feature__glyphimg,
    #shopify-section-{{ section.id }} .feature__lottie {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="features color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="features__viewport" data-pause="3000" data-columns="{{ section.settings.columns_desktop | default: 3 }}">
      <div class="features__track">
        {%- assign has_lottie_feature = false -%}
        {% for block in section.blocks %}
          {%- if block.settings.lottie_url != blank -%}{%- assign has_lottie_feature = true -%}{%- endif -%}
          <div class="feature{% if block.settings.text == blank %} feature--no-desc{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.lottie_url != blank %}
              <div class="feature__iconwrap">
                <span class="feature__bubble" aria-hidden="true"></span>
                <lord-icon
                  class="feature__lottie"
                  src="{{ block.settings.lottie_url }}"
                  trigger="loop"
                  delay="2000"
                  colors="primary:{{ section.settings.icon_color }}"
                  role="img"
                  aria-label="{{ block.settings.title | escape }}">
                </lord-icon>
              </div>
            {% elsif block.settings.icon != blank %}
              {%- assign icon_url = block.settings.icon | image_url: width: 128, format: 'png' -%}
              <div class="feature__iconwrap" style="--icon-url: url('{{ icon_url }}');">
                <span class="feature__bubble" aria-hidden="true"></span>
                <span class="feature__glyph" aria-hidden="true"></span>
                <img class="feature__glyphimg" src="{{ icon_url }}" alt="" loading="lazy" width="42" height="42">
              </div>
            {% endif %}
            <div class="feature__text">
              <div class="feature__title">{{ block.settings.title }}</div>
              {% if block.settings.text != blank %}
                <div class="feature__desc">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <style>
    :root { --feat-gap: 28px; --feat-cards: 3; }
    {%- comment -%}
      Section-scoped AND desktop-gated: an ID selector always beats a
      bare :root selector on specificity alone, media query or not — so
      without the min-width guard here, this rule was winning over the
      mobile :root override further down even at mobile widths, forcing
      every instance back to its desktop column count on phones
      regardless of what the mobile rule said. Gating it to desktop
      keeps it out of the mobile cascade entirely instead of relying on
      specificity to sort it out.
    {%- endcomment -%}
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} { --feat-cards: {{ section.settings.columns_desktop | default: 3 }}; }
    }

    .features__viewport {
      overflow: hidden;
      position: relative;
      padding-block: 3rem;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
    }

    .features__track {
      display: flex;
      gap: var(--feat-gap);
      will-change: transform;
    }

    .feature {
      flex: 0 0 calc((100% - (var(--feat-gap) * (var(--feat-cards) - 1))) / var(--feat-cards));
      scroll-snap-align: start;
      display: flex;
      gap: 1.5rem;
      {%- comment -%}
        Configurable per section: "Top" keeps every icon/title level
        across a row even when descriptions vary a lot in length (cards
        stretch to the tallest one, so centering would otherwise put a
        short card's title lower than a tall card's). "Center" reads
        better when every description in the row is roughly the same
        (often just one line), since there's no meaningful height
        difference for top-alignment to protect against.
      {%- endcomment -%}
      align-items: {% if section.settings.content_align == 'center' %}center{% else %}flex-start{% endif %};
      padding: 2rem;
      border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
      border-radius: 18px;
      background: color-mix(in srgb, var(--color-background) 98%, transparent);
      color: var(--color-foreground);
    }
    {%- comment -%}
      A card with no description has nothing below the title to justify
      top-aligning it with a (typically taller) icon — flex-start above
      only exists to keep titles level across cards where descriptions
      of differing lengths would otherwise push things out of line.
      With no description at all, centering the title against the icon
      reads correctly instead of looking like it's floating above it.
      This applies at every breakpoint, not just mobile.
    {%- endcomment -%}
    .feature--no-desc {
      align-items: center;
    }

    /* ==== ICON AREA ==== */
    .feature__iconwrap {
      position: relative;
      width: 84px;
      height: 84px;
      flex: 0 0 84px;
    }

    .feature__bubble {
      position: absolute;
      inset: 0;
      border-radius: 999px;
    }
    .feature__glyph {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 42px;
      height: 42px;
      transform: translate(-50%, -50%);
      background: currentColor;
      -webkit-mask-image: var(--icon-url);
              mask-image: var(--icon-url);
      -webkit-mask-repeat: no-repeat;
              mask-repeat: no-repeat;
      -webkit-mask-size: contain;
              mask-size: contain;
      -webkit-mask-position: center;
              mask-position: center;
      pointer-events: none;
    }
    .feature__glyphimg {
      position: absolute;
      left: 50%; top: 50%;
      width: 42px; height: 42px;
      transform: translate(-50%, -50%);
      object-fit: contain;
      display: none;
      pointer-events: none;
    }
    .feature__lottie {
      position: absolute;
      left: 50%; top: 50%;
      width: 48px; height: 48px;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }
    @supports not (-webkit-mask-image: url("")) {
      .feature__glyph { display: none; }
      .feature__glyphimg { display: block; filter: brightness(0) saturate(100%); }
    }

    /* ==== TEXT STYLES ==== */
    .feature__title {
      font-weight: 800;
      text-transform: uppercase;
      font-size: 1.5rem;
      line-height: 1.2;
      letter-spacing: 0.5px;
    }
    .feature__desc {
      opacity: 0.75;
      font-size: 1.05rem;
      margin-top: 0.25rem;
    }

    /* ==== RESPONSIVE ==== */
    @media (max-width: 900px) {
      :root { --feat-cards: 2; }
    }

    @media (max-width: 749px) {
      {%- comment -%}
        --feat-cards:2 + flex-wrap here means 4 items break into 2 rows
        of 2 instead of overflowing/scrolling — the viewport's
        overflow:hidden + scroll-snap above is only needed for the
        genuinely-scrolling case (more items than fit), so wrapping is
        safe here since a static, wrapped grid never needs to scroll.
      {%- endcomment -%}
      :root { --feat-gap: 8px; --feat-cards: 2; }
      .features__track { flex-wrap: wrap; }
      .feature {
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0.75rem 0.35rem;
        gap: 0.4rem;
      }
      .feature__text { text-align: center; }
      .feature__iconwrap { width: 52px; height: 52px; flex: 0 0 52px; }
      .feature__glyph, .feature__glyphimg, .feature__lottie { width: 26px; height: 26px; }
      {%- comment -%}
        Titles/descriptions were still rendering at their full desktop
        font-size on mobile (there was no override at all here before),
        so a two-word title like "EXTRA TOOL PROTECTION" at 24px bold
        had no choice but to wrap across several lines in a ~45%-width
        column — that's what was actually making the layout look
        cramped, independent of the column-count bug fixed above.
      {%- endcomment -%}
      .feature__title { font-size: 1.05rem; letter-spacing: 0.2px; }
      .feature__desc { font-size: 0.85rem; }
      {%- comment -%}
        A feature with no description text has nothing to fill the
        space a stacked, centered layout leaves below the title — so
        it keeps the icon next to the title in one row instead,
        matching the desktop layout, rather than stacking icon-on-top
        with an empty gap where the (missing) description would go.
      {%- endcomment -%}
      .feature--no-desc {
        flex-direction: row;
        align-items: center;
        text-align: left;
      }
      .feature--no-desc .feature__text { text-align: left; }
    }
  </style>

  {%- if has_lottie_feature -%}
    <script>
      {%- comment -%}
        Dynamic injection + a DOM marker, not a plain <script src>: this
        section can appear on the same page as the header's trust bar,
        which can ALSO load LordIcon's player independently if it uses
        lottie icons too. Two independent <script src="lordicon.js"> tags
        would both execute and both call customElements.define('lord-icon',
        ...) — the second one throws, since a custom element tag name can
        only be registered once per page. Checking for the marker first
        makes this safe regardless of which section(s) actually need it.
      {%- endcomment -%}
      if (!document.querySelector('script[data-lordicon-player]')) {
        var lis = document.createElement('script');
        lis.src = 'https://cdn.lordicon.com/lordicon.js';
        lis.defer = true;
        lis.setAttribute('data-lordicon-player', '1');
        document.head.appendChild(lis);
      }
    </script>
  {%- endif -%}

  <script>
    (() => {
      const section = document.currentScript.closest('section');
      const vp = section.querySelector('.features__viewport');
      const track = section.querySelector('.features__track');
      if (!vp || !track) return;

      const pauseMs = parseInt(vp.dataset.pause || '3000', 10);
      const columns = parseInt(vp.dataset.columns || '3', 10);
      const originals = Array.from(track.children);
      const total = originals.length;

      {%- comment -%}
        Below 750px, the CSS switches .features__track to flex-wrap:
        wrap regardless of how many columns are configured for
        desktop — so "6 configured, only fits 3-4 per desktop row"
        still ends up as a perfectly fine static wrapped grid on
        mobile, it just never needed the scrolling/cloning setup below
        in the first place. Skipping it there matters because those
        clones are meant to sit off-screen, revealed only by scrolling
        — with wrapping active there's no scrolling happening, so they
        wrap into extra, very real, very visible duplicate rows
        instead. Checked once at load, matching how the rest of this
        script treats layout mode as fixed for the page's lifetime
        rather than re-deciding on every resize.
      {%- endcomment -%}
      const isMobileLayout = window.matchMedia('(max-width: 749px)').matches;

      // Fits within the configured column count: show statically, no scrolling
      if (isMobileLayout || total <= columns) return;

      if (total < 4) {
        const need = 4 - total;
        for (let i = 0; i < need; i++) track.appendChild(originals[i % total].cloneNode(true));
      }
      const wrapCount = Math.min(total, 3);
      for (let i = 0; i < wrapCount; i++) track.appendChild(originals[i].cloneNode(true));

      let index = 0, timer, hover = false;
      vp.addEventListener('mouseenter', () => hover = true);
      vp.addEventListener('mouseleave', () => hover = false);

      const cardStep = () => {
        const first = track.children[0];
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        return first.getBoundingClientRect().width + gap;
      };

      const snap = (i, instant = false) =>
        vp.scrollTo({ left: cardStep() * i, behavior: instant ? 'instant' : 'smooth' });

      const queue = () => { clearTimeout(timer); timer = setTimeout(tick, pauseMs); };

      const tick = () => {
        if (hover) return queue();
        index += 1;
        snap(index);
        if (index >= total) {
          setTimeout(() => { index -= total; snap(index, true); }, 450);
        }
        queue();
      };

      window.addEventListener('resize', () => snap(index, true));
      queue();
    })();
  </script>

  {% schema %}
  {
    "name": "Icon features",
    "max_blocks": 12,
    "settings": [
      {
        "type": "header",
        "content": "Section background"
      },
      {
        "type": "checkbox",
        "id": "section_use_scheme",
        "label": "Use colour scheme for section fill",
        "info": "When on, the section background uses the 'Background fill scheme' below instead of the flat colour.",
        "default": false
      },
      {
        "type": "color_scheme",
        "id": "section_fill_scheme",
        "label": "Background fill scheme",
        "info": "The section background uses this scheme's Background colour. Independent of the card/text scheme.",
        "default": "scheme-1"
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background colour (when not using scheme) — desktop",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "section_bg_mobile",
        "label": "Section background colour — mobile",
        "info": "Leave blank to use the desktop colour above on mobile too."
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme (section fill / card / text base)",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "Section border (top & bottom)"
      },
      {
        "type": "range",
        "id": "section_border_width",
        "label": "Border thickness",
        "info": "0 = no border. Applies to both the top and bottom edge of the whole section.",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "color",
        "id": "section_border_color",
        "label": "Border colour",
        "default": "#e2e2e2"
      },
      {
        "type": "range",
        "id": "columns_desktop",
        "label": "Columns shown at once — desktop",
        "info": "When the number of items fits within this many columns, they all display in one static row instead of auto-scrolling.",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 3
      },
      {
        "type": "select",
        "id": "content_align",
        "label": "Icon/text vertical alignment",
        "info": "Top keeps titles level across cards when descriptions vary a lot in length. Center looks better when every description is roughly the same length (e.g. all one line).",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "center", "label": "Center" }
        ],
        "default": "top"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "color",
        "id": "padding_bg",
        "label": "Padding background colour",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Icons"
      },
      {
        "type": "color",
        "id": "icon_color",
        "label": "Icon colour",
        "default": "#1a1a1a"
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size — desktop",
        "info": "Applies to the icon/logo image, the mask icon and any animated (Lottie) icon alike.",
        "min": 16,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 42
      },
      {
        "type": "range",
        "id": "icon_size_mobile",
        "label": "Icon size — mobile",
        "min": 12,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 26
      },
      {
        "type": "range",
        "id": "icon_wrap_size",
        "label": "Icon circle size — desktop",
        "info": "The circle the icon sits inside. Keep it a bit larger than the icon size above so the icon doesn't overflow it.",
        "min": 40,
        "max": 160,
        "step": 2,
        "unit": "px",
        "default": 84
      },
      {
        "type": "range",
        "id": "icon_wrap_size_mobile",
        "label": "Icon circle size — mobile",
        "min": 30,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 52
      },
      {
        "type": "checkbox",
        "id": "show_icon_bubble",
        "label": "Show circle behind icon",
        "info": "Turn off to remove the coloured circle and show just the icon on its own.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "icon_true_color",
        "label": "Show uploaded icons in full colour",
        "info": "Off (default) tints every icon a single flat colour — for plain transparent line-art icons only. Turn this on if your icons already have their own colours/background baked in (e.g. a pre-made circle badge icon) — otherwise they render as solid blobs, since the tint effect discards all colour information and keeps only the icon's silhouette.",
        "default": false
      },
      {
        "type": "color",
        "id": "icon_bubble_color",
        "label": "Circle background colour",
        "info": "Matches the old look (icon colour at 15% opacity) by default so nothing shifts visually until you change it.",
        "default": "rgba(0,0,0,0.15)"
      },
      {
        "type": "range",
        "id": "icon_border_width",
        "label": "Circle border thickness",
        "info": "0 = no border.",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "color",
        "id": "icon_border_color",
        "label": "Circle border colour",
        "default": "#e30613"
      },
      {
        "type": "header",
        "content": "Title"
      },
      {
        "type": "range",
        "id": "title_size",
        "label": "Font size – desktop",
        "min": 10,
        "max": 36,
        "step": 1,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "title_size_mobile",
        "label": "Font size – mobile",
        "min": 8,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "select",
        "id": "title_weight",
        "label": "Font weight",
        "default": "800",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semi-bold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra-bold" }
        ]
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Text colour — desktop",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "title_color_mobile",
        "label": "Text colour — mobile",
        "info": "Leave blank to use the desktop colour above on mobile too."
      },
      {
        "type": "header",
        "content": "Subtitle"
      },
      {
        "type": "range",
        "id": "desc_size",
        "label": "Font size – desktop",
        "min": 10,
        "max": 28,
        "step": 1,
        "unit": "px",
        "default": 17
      },
      {
