      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_h_mobile",
      "label": "Side padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Category icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon (optional — leave blank to use default)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Icon Strip",
      "blocks": [
        { "type": "icon", "settings": { "label": "Hunt" } },
        { "type": "icon", "settings": { "label": "Kitchen" } },
        { "type": "icon", "settings": { "label": "Pocket" } },
        { "type": "icon", "settings": { "label": "Serrations" } },
        { "type": "icon", "settings": { "label": "Scissors" } },
        { "type": "icon", "settings": { "label": "Axes & Tools" } },
        { "type": "icon", "settings": { "label": "Fishing" } }
      ]
    }
  ]
}
{% endschema %}
