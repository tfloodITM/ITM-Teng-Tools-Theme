      "label": "Circle background on hover",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "icon_color_hover",
      "label": "Icon colour on hover",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "border_hover_color",
      "label": "Border/ring colour on hover",
      "default": "#f5a623"
    },
    {
      "type": "range",
      "id": "border_hover_width",
      "label": "Border/ring width on hover",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Label text"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text colour on hover",
      "default": "#f5a623"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text style",
      "options": [
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing (× 0.01em)",
      "min": 0,
      "max": 20,
      "step": 1,
      "info": "e.g. 5 = 0.05em",
      "default": 5
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
