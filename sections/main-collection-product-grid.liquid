    },
    {
      "type": "checkbox",
      "id": "pg_show_enquiry_cta",
      "default": true,
      "label": "Show 'Make an enquiry' button"
    },
    {
      "type": "text",
      "id": "pg_related_product",
      "label": "Compatible product handle",
      "info": "Enter the product handle (from the product URL, e.g. work-sharp-wskts). More reliable than the product picker."
    },
    {
