    {
      "type": "color",
      "id": "pg_related_card_text_color",
      "label": "Card text colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "pg_related_card_star_color",
      "label": "Star review colour",
      "default": "#f5a200"
    },
    {
      "type": "color",
      "id": "pg_related_card_border_color",
      "label": "Card border colour",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
