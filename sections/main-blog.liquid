{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Hero header background: custom gradient vs theme colour scheme vs plain
  assign hero_has_bg = false
  assign hero_class = 'itm-blog__hero itm-blog__hero--plain'
  if section.settings.header_bg_style == 'gradient'
    assign hero_class = 'itm-blog__hero itm-blog__hero--gradient'
    assign hero_has_bg = true
  elsif section.settings.header_bg_style == 'scheme'
    assign hero_class = 'itm-blog__hero color-' | append: section.settings.header_color_scheme | append: ' gradient'
    assign hero_has_bg = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {% if hero_has_bg and section.settings.show_title %}0{% else %}{{ section.settings.padding_top }}px{% endif %};
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .itm-blog__inner {
    padding-left: {{ section.settings.section_padding_h }}px;
    padding-right: {{ section.settings.section_padding_h }}px;
  }

  /* ── Hero header (gradient / scheme / plain) ── */
  #shopify-section-{{ section.id }} .itm-blog__hero {
    padding: 4rem 0 4.5rem;
    margin-bottom: {{ section.settings.header_gap }}px;
    {% if section.settings.hero_border_width > 0 %}border-bottom: {{ section.settings.hero_border_width }}px solid {{ section.settings.hero_border_color }};{% endif %}
  }
  #shopify-section-{{ section.id }} .itm-blog__hero--gradient {
    background: linear-gradient(135deg, {{ section.settings.header_grad_start }}, {{ section.settings.header_grad_end }});
    color: {{ section.settings.header_text }};
  }
  #shopify-section-{{ section.id }} .itm-blog__hero--plain {
    padding: 0;
  }
  #shopify-section-{{ section.id }} .itm-blog__hero-inner {
    padding-inline: {{ section.settings.section_padding_h }}px;
    text-align: {{ section.settings.header_alignment }};
  }
  #shopify-section-{{ section.id }} .itm-blog__hero-crumbs {
    font-size: 1.3rem;
    opacity: .8;
    margin-bottom: 1.6rem;
  }
  #shopify-section-{{ section.id }} .itm-blog__hero-crumbs a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .itm-blog__hero-crumbs a:hover { text-decoration: underline; }
  #shopify-section-{{ section.id }} .itm-blog__hero-crumbs .sep { margin: 0 .6rem; opacity: .5; }
  #shopify-section-{{ section.id }} .itm-blog__hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    line-height: 1.12;
    letter-spacing: -.01em;
    font-weight: 700;
  }
  #shopify-section-{{ section.id }} .itm-blog__hero-sub {
    margin: 1.6rem 0 0;
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    line-height: 1.6;
    opacity: .85;
    max-width: 760px;
    {% if section.settings.header_alignment == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .itm-blog__hero { padding: 2.8rem 0 3.2rem; }
  }

  /* ── Filter pills ── */
  #shopify-section-{{ section.id }} .itm-blog__filters {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.pill_gap }}px;
    justify-content: center;
    padding-bottom: 32px;
  }
  #shopify-section-{{ section.id }} .itm-blog__filter-btn {
    display: inline-flex;
    align-items: center;
    height: {{ section.settings.pill_height }}px;
    padding: 0 {{ section.settings.pill_padding_h }}px;
    border-radius: {{ section.settings.pill_radius }}px;
    border: {{ section.settings.pill_border_width }}px solid {{ section.settings.pill_inactive_color }};
    font-size: {{ section.settings.pill_font_size }}px;
    font-weight: {{ section.settings.pill_font_weight }};
    text-decoration: none;
    color: {{ section.settings.pill_inactive_color }};
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  #shopify-section-{{ section.id }} .itm-blog__filter-btn:hover {
    background: {{ section.settings.pill_inactive_color | color_modify: 'alpha', 0.08 }};
  }
  #shopify-section-{{ section.id }} .itm-blog__filter-btn--active {
    background: rgb(var(--color-button));
    border-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
  }
  #shopify-section-{{ section.id }} .itm-blog__filter-btn--active:hover {
    background: rgb(var(--color-button));
  }

  /* ── Featured row ── */
  #shopify-section-{{ section.id }} .itm-blog__featured-grid {
    display: grid;
    gap: {{ section.settings.card_gap }}px;
    margin-bottom: {{ section.settings.card_gap }}px;
  }

  /* ── Regular grid ── */
  #shopify-section-{{ section.id }} .itm-blog__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
    transition: opacity 0.2s ease;
  }

  /* ── Card base ── */
  #shopify-section-{{ section.id }} .itm-blog-card {
    display: flex;
    flex-direction: column;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: {{ section.settings.card_bg }};
    {% if section.settings.card_border %}border: 1px solid rgba(0,0,0,0.08);{% endif %}
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  #shopify-section-{{ section.id }} .itm-blog-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
    transform: translateY(-2px);
  }

  /* ── Image wrapper ── */
  #shopify-section-{{ section.id }} .itm-blog-card__img-wrap {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_ratio }};
    background: #1a1a1a;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .itm-blog-card--featured .itm-blog-card__img-wrap {
    aspect-ratio: {{ section.settings.featured_image_ratio }};
  }
  #shopify-section-{{ section.id }} .itm-blog-card__img-wrap img,
  #shopify-section-{{ section.id }} .itm-blog-card__img-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  #shopify-section-{{ section.id }} .itm-blog-card:hover .itm-blog-card__img-wrap img {
    transform: scale(1.04);
  }

  /* Featured permanent bar via ::before */
  #shopify-section-{{ section.id }} .itm-blog-card--featured .itm-blog-card__img-wrap::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: {{ section.settings.featured_bar_height }}px;
    background: {{ section.settings.featured_color }};
    z-index: 2;
    pointer-events: none;
  }

  /* Hover line via ::after — slides up from below the image */
  #shopify-section-{{ section.id }} .itm-blog-card__img-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: {{ section.settings.hover_line_height }}px;
    background: {{ section.settings.hover_line_color }};
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: 3;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .itm-blog-card:hover .itm-blog-card__img-wrap::after {
    transform: translateY(0);
  }

  /* Category / Featured badges on image (top-left) */
  #shopify-section-{{ section.id }} .itm-blog-card__img-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    z-index: 4;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .itm-blog-card__badge {
    display: inline-block;
    padding: {{ section.settings.badge_padding_v }}px {{ section.settings.badge_padding_h }}px;
    background: {{ section.settings.badge_bg | color_modify: 'alpha', 0.82 }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    border-radius: {{ section.settings.badge_radius }}px;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .itm-blog-card__badge--featured {
    background: {{ section.settings.featured_color }};
    color: #fff;
  }

  /* ── Card body (below image) ── */
  #shopify-section-{{ section.id }} .itm-blog-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: {{ section.settings.card_padding }}px;
    gap: 6px;
    background: {{ section.settings.card_bg }};
  }

  /* Title */
  #shopify-section-{{ section.id }} .itm-blog-card__title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: {{ section.settings.title_color }};
  }
  #shopify-section-{{ section.id }} .itm-blog-card--featured .itm-blog-card__title {
    font-size: {{ section.settings.title_size | plus: 4 }}px;
  }

  /* Excerpt */
  #shopify-section-{{ section.id }} .itm-blog-card__excerpt {
    font-size: {{ section.settings.excerpt_size }}px;
    line-height: 1.65;
    color: {{ section.settings.excerpt_color }};
    margin: 0;
    flex: 1;
  }

  /* Meta row (date + read more) */
  #shopify-section-{{ section.id }} .itm-blog-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid rgba(0,0,0,0.07);
    margin-top: auto;
  }
  #shopify-section-{{ section.id }} .itm-blog-card__date {
    font-size: {{ section.settings.date_size }}px;
    color: {{ section.settings.date_color }};
    opacity: 0.75;
  }
  #shopify-section-{{ section.id }} .itm-blog-card__read-more {
    font-size: {{ section.settings.read_more_size }}px;
    font-weight: 600;
    color: {{ section.settings.read_more_color }};
    white-space: nowrap;
  }

  /* ── Tablet (990px) ── */
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .itm-blog__inner {
      padding-left: {{ section.settings.section_padding_h | times: 0.6 | round }}px;
      padding-right: {{ section.settings.section_padding_h | times: 0.6 | round }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.card_gap | times: 0.75 | round }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog__featured-grid {
      gap: {{ section.settings.card_gap | times: 0.75 | round }}px;
      margin-bottom: {{ section.settings.card_gap | times: 0.75 | round }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog-card__title {
      font-size: {{ section.settings.title_size | minus: 2 }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog-card--featured .itm-blog-card__title {
      font-size: {{ section.settings.title_size | plus: 1 }}px;
    }
  }

  /* ── Mobile (750px) ── */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .itm-blog__inner {
      padding-left: {{ section.settings.section_padding_h_mobile }}px;
      padding-right: {{ section.settings.section_padding_h_mobile }}px;
    }
    /* Featured: always 1 col (full width) on mobile */
    #shopify-section-{{ section.id }} .itm-blog__featured-grid {
      grid-template-columns: 1fr !important;
      gap: {{ section.settings.card_gap | times: 0.6 | round }}px;
      margin-bottom: {{ section.settings.card_gap | times: 0.6 | round }}px;
    }
    /* Regular: 2 cols on mobile */
    #shopify-section-{{ section.id }} .itm-blog__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.card_gap | times: 0.6 | round }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog__filters {
      gap: 6px;
    }
    #shopify-section-{{ section.id }} .itm-blog__filter-btn {
      height: {{ section.settings.pill_height | minus: 6 }}px;
      padding: 0 {{ section.settings.pill_padding_h | minus: 4 }}px;
      font-size: {{ section.settings.pill_font_size | minus: 2 }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog-card__title {
      font-size: {{ section.settings.title_size | minus: 4 }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog-card--featured .itm-blog-card__title {
      font-size: {{ section.settings.title_size | minus: 1 }}px;
    }
    #shopify-section-{{ section.id }} .itm-blog-card__body {
      padding: {{ section.settings.card_padding | times: 0.75 | round }}px;
      gap: 4px;
    }
    #shopify-section-{{ section.id }} .itm-blog-card__date,
    #shopify-section-{{ section.id }} .itm-blog-card__read-more {
      font-size: 11px;
    }
    #shopify-section-{{ section.id }} .itm-blog-card__excerpt {
      display: none;
    }
  }
{%- endstyle -%}

{%- assign known_cats = 'Gift Guide,In The Kitchen,Learn To Sharpen,Press,Sharp Matters,The Workshop' | split: ',' -%}

{%- comment -%}
  Featured articles use the article pickers in the customizer — reliable across all 313 articles.
  Tag them 'Featured' to show the orange Featured badge; the picker controls what appears at the top.
{%- endcomment -%}
{%- assign _feat_1 = section.settings.feat_article_1 -%}
{%- assign _feat_2 = section.settings.feat_article_2 -%}
{%- assign _feat_3 = section.settings.feat_article_3 -%}

{%- comment -%}Count how many are picked, in order (must fill 1 before 2, 2 before 3){%- endcomment -%}
{%- assign _feat_show = 0 -%}
{%- if _feat_1 != blank -%}
  {%- assign _feat_show = 1 -%}
  {%- if _feat_2 != blank -%}
    {%- assign _feat_show = 2 -%}
    {%- if _feat_3 != blank -%}
      {%- assign _feat_show = 3 -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- paginate blog.articles by section.settings.articles_per_page -%}

{%- if section.settings.show_title -%}
  <div class="{{ hero_class }}">
    <div class="itm-blog__hero-inner">
      {%- if section.settings.show_breadcrumbs -%}
        <nav class="itm-blog__hero-crumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a><span class="sep">/</span><span>{{ blog.title | escape }}</span>
        </nav>
      {%- endif -%}
      <h1 class="itm-blog__hero-title">{{ blog.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="itm-blog__hero-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<div class="itm-blog__inner">

  {%- if section.settings.show_filters -%}
    {%- assign filter_tags = 'Gift Guide,In The Kitchen,Learn To Sharpen,Press,Sharp Matters,The Workshop' | split: ',' -%}
    <nav class="itm-blog__filters" aria-label="Filter articles by category">
      <a href="{{ blog.url }}" class="itm-blog__filter-btn{% unless current_tags %} itm-blog__filter-btn--active{% endunless %}">All</a>
      {%- for tag in filter_tags -%}
        {%- assign _pill_active = false -%}
        {%- assign _tag_handle = tag | handle -%}
        {%- for _ct in current_tags -%}
          {%- assign _ct_handle = _ct | handle -%}
          {%- if _ct_handle == _tag_handle -%}{%- assign _pill_active = true -%}{%- endif -%}
        {%- endfor -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="itm-blog__filter-btn{% if _pill_active %} itm-blog__filter-btn--active{% endif %}">{{ tag }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  {%- comment -%}── Featured row: page 1 of All only ──{%- endcomment -%}
  {%- if _feat_show > 0 and paginate.current_page == 1 and current_tags == blank -%}
    {%- comment -%}Grid columns: 1 article = full width, 2 = side by side, 3 = three in a row{%- endcomment -%}
    {%- assign _feat_cols = _feat_show -%}
    <div class="itm-blog__featured-grid" style="grid-template-columns: repeat({{ _feat_cols }}, 1fr);">

      {%- for _fi in (1.._feat_show) -%}
        {%- if _fi == 1 -%}{%- assign _fa = _feat_1 -%}{%- endif -%}
        {%- if _fi == 2 -%}{%- assign _fa = _feat_2 -%}{%- endif -%}
        {%- if _fi == 3 -%}{%- assign _fa = _feat_3 -%}{%- endif -%}

        {%- assign _fa_first_cat = '' -%}
        {%- for tag in _fa.tags -%}
          {%- if known_cats contains tag -%}{%- assign _fa_first_cat = tag -%}{%- break -%}{%- endif -%}
        {%- endfor -%}

        {%- assign _fa_excerpt = _fa.excerpt | default: _fa.content -%}

        <a href="{{ _fa.url }}" class="itm-blog-card itm-blog-card--featured">
          <div class="itm-blog-card__img-wrap">
            {%- if _fa.image -%}
              <img
                src="{{ _fa.image | image_url: width: 900 }}"
                srcset="{{ _fa.image | image_url: width: 600 }} 600w, {{ _fa.image | image_url: width: 900 }} 900w, {{ _fa.image | image_url: width: 1400 }} 1400w"
                sizes="(max-width: 749px) calc(100vw - {{ section.settings.section_padding_h_mobile | times: 2 }}px), calc({{ 100 | divided_by: _feat_cols }}vw - {{ section.settings.section_padding_h }}px)"
                alt="{{ _fa.image.alt | default: _fa.title | escape }}"
                loading="lazy"
                width="{{ _fa.image.width }}"
                height="{{ _fa.image.height }}"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <div class="itm-blog-card__img-badges">
              <span class="itm-blog-card__badge itm-blog-card__badge--featured">Featured</span>
              {%- if section.settings.show_category and _fa_first_cat != '' -%}
                <span class="itm-blog-card__badge">{{ _fa_first_cat }}</span>
              {%- endif -%}
            </div>
          </div>
          <div class="itm-blog-card__body">
            <h3 class="itm-blog-card__title">{{ _fa.title | escape }}</h3>
            {%- if section.settings.show_excerpt and _fa_excerpt != blank -%}
              <p class="itm-blog-card__excerpt">{{ _fa_excerpt | strip_html | truncatewords: section.settings.excerpt_words }}</p>
            {%- endif -%}
            <div class="itm-blog-card__meta">
              {%- if section.settings.show_date -%}
                <span class="itm-blog-card__date">{{ _fa.published_at | date: '%b %d, %Y' }}</span>
              {%- endif -%}
              <span class="itm-blog-card__read-more">{{ section.settings.read_more_text }}</span>
            </div>
          </div>
        </a>

      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%}── Regular grid: skip whichever articles are shown as featured ──{%- endcomment -%}
  <div class="itm-blog__grid">
    {%- for article in blog.articles -%}
      {%- if article.handle == _feat_1.handle or article.handle == _feat_2.handle or article.handle == _feat_3.handle -%}
        {%- comment -%}skip — already shown in featured row{%- endcomment -%}
      {%- else -%}

        {%- assign first_cat = '' -%}
        {%- for tag in article.tags -%}
          {%- if known_cats contains tag -%}{%- assign first_cat = tag -%}{%- break -%}{%- endif -%}
        {%- endfor -%}

        {%- assign excerpt_text = article.excerpt | default: article.content -%}

        <a href="{{ article.url }}" class="itm-blog-card">
          <div class="itm-blog-card__img-wrap">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 720 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 720 }} 720w, {{ article.image | image_url: width: 1000 }} 1000w"
                sizes="(max-width: 749px) calc(50vw - {{ section.settings.section_padding_h_mobile }}px), (max-width: 989px) calc(50vw - {{ section.settings.section_padding_h | times: 0.6 | round }}px), calc(33vw - {{ section.settings.section_padding_h }}px)"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if section.settings.show_category and first_cat != '' -%}
              <div class="itm-blog-card__img-badges">
                <span class="itm-blog-card__badge">{{ first_cat }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="itm-blog-card__body">
            <h3 class="itm-blog-card__title">{{ article.title | escape }}</h3>
            {%- if section.settings.show_excerpt and excerpt_text != blank -%}
              <p class="itm-blog-card__excerpt">{{ excerpt_text | strip_html | truncatewords: section.settings.excerpt_words }}</p>
            {%- endif -%}
            <div class="itm-blog-card__meta">
              {%- if section.settings.show_date -%}
                <span class="itm-blog-card__date">{{ article.published_at | date: '%b %d, %Y' }}</span>
              {%- endif -%}
              <span class="itm-blog-card__read-more">{{ section.settings.read_more_text }}</span>
            </div>
          </div>
        </a>

      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="itm-blog__pagination-wrap">
    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>

</div>

{%- endpaginate -%}

<script>
(function () {
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;
  var blogUrl = '{{ blog.url }}';

  /* Base path of the currently displayed category (no query string).
     Pagination hrefs may be relative (?page=2) so we resolve them against this. */
  var currentBasePath = blogUrl;

  /* Mark one pill active, clear all others */
  function setActivePill(btn) {
    section.querySelectorAll('.itm-blog__filter-btn').forEach(function (b) {
      b.classList.remove('itm-blog__filter-btn--active');
    });
    btn.classList.add('itm-blog__filter-btn--active');
  }

  /* Featured row: show only on the All tab */
  function toggleFeatured(visible) {
    var feat = section.querySelector('.itm-blog__featured-grid');
    if (feat) feat.style.display = visible ? '' : 'none';
  }

  /* Resolve a pagination href (possibly relative like ?page=2) against
     the path we fetched, not the browser document URL. */
  function resolvePageUrl(href) {
    try {
      return new URL(href, location.origin + currentBasePath).pathname +
             new URL(href, location.origin + currentBasePath).search;
    } catch (e) {
      return href;
    }
  }

  /* Fetch url using Shopify Sections Rendering API (?sections=main).
     Returns JSON { "main": "<section html>" } — only this section, no full page.
     Guarantees pagination reflects the actual tag/page requested. */
  function swapGrid(url, scrollUp) {
    currentBasePath = url.split('?')[0];
    var grid = section.querySelector('.itm-blog__grid');
    if (grid) { grid.style.opacity = '0.3'; grid.style.pointerEvents = 'none'; }

    var sep = url.indexOf('?') !== -1 ? '&' : '?';
    var apiUrl = url + sep + 'sections={{ section.id }}';

    fetch(apiUrl)
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var html = data['{{ section.id }}'];
        if (!html) return;
        var doc = new DOMParser().parseFromString(html, 'text/html');

        var newGrid = doc.querySelector('.itm-blog__grid');
        var oldGrid = section.querySelector('.itm-blog__grid');
        if (newGrid && oldGrid) oldGrid.replaceWith(newGrid);

        var newPag = doc.querySelector('.itm-blog__pagination-wrap');
        var oldPag = section.querySelector('.itm-blog__pagination-wrap');
        if (oldPag) {
          if (newPag) { oldPag.replaceWith(newPag); }
          else { oldPag.innerHTML = ''; }
        }

        bindPagination();

        if (scrollUp) {
          var target = section.querySelector('.itm-blog__grid');
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      })
      .catch(function () {
        var g = section.querySelector('.itm-blog__grid');
        if (g) { g.style.opacity = ''; g.style.pointerEvents = ''; }
      });
  }

  /* Filter pill: swap articles, keep browser URL unchanged */
  function onFilterClick(e) {
    e.preventDefault();
    var url = this.getAttribute('href');
    if (!url) return;
    setActivePill(this);
    toggleFeatured(url.split('?')[0] === blogUrl);
    swapGrid(url, false);
  }

  /* Pagination: resolve href against current category path, then swap */
  function onPageClick(e) {
    e.preventDefault();
    var href = this.getAttribute('href');
    if (!href) return;
    swapGrid(resolvePageUrl(href), true);
  }

  function bindPagination() {
    var wrap = section.querySelector('.itm-blog__pagination-wrap');
    if (!wrap) return;
    wrap.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', onPageClick);
    });
  }

  section.querySelectorAll('.itm-blog__filters .itm-blog__filter-btn').forEach(function (a) {
    a.addEventListener('click', onFilterClick);
  });

  bindPagination();
})();
</script>
