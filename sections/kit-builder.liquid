{% comment %}
  Kit Builder Section

  Embeds the TengTools Kit Builder application in an iframe.
  Handles:
  - Full-screen mode (default): the builder covers the site with a slim top bar (logo, cart, close),
    fills the screen up to 4K wide (3840px) and centres beyond that. Turn off for an inline embed.
  - Dynamic iframe height (inline mode only; full-screen fills the viewport and scrolls inside)
  - Add to Cart via postMessage, accepted only from the builder iframe's own origin
  - Tags kit lines for the kit price-break discount (kept correct by the kit-discount-sync
    snippet, which should also be rendered site-wide in layout/theme.liquid)
  - Cart drawer updates using the theme's #CartDrawer / cart-icon-bubble sections, opening the
    drawer over the builder after a kit is added (drawer z-index 1000 > builder 950)

  Messages from the builder app (unchanged): teng-height-update, teng-add-to-cart,
  teng-add-configuration.
{% endcomment %}

{%- liquid
  assign fullscreen = section.settings.fullscreen
  assign bar_bg = section.settings.bar_background | default: '#c1272d'
  assign bar_text = section.settings.bar_text | default: '#ffffff'
-%}

<div
  class="kit-builder-section{% if fullscreen %} kit-builder--fullscreen{% endif %}"
  id="kit-builder-{{ section.id }}"
  data-close-url="{{ section.settings.close_url | default: routes.root_url }}"
  {% if fullscreen %}role="dialog" aria-modal="true" aria-label="TengTools Kit Builder"{% endif %}
>
  {%- if fullscreen -%}
    <div class="kit-builder__bar">
      <div class="kit-builder__bar-inner">
        <a href="{{ routes.root_url }}" class="kit-builder__brand">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 400 | image_tag: class: 'kit-builder__logo', alt: shop.name, loading: 'eager' }}
          {%- else -%}
            <span class="kit-builder__shop-name">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <span class="kit-builder__title">Kit Builder</span>
        <div class="kit-builder__actions">
          {%- if section.settings.show_cart_button -%}
            <a href="{{ routes.cart_url }}" class="kit-builder__btn" data-kb-cart aria-label="Cart, {{ cart.item_count }} items">
              <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h9.7a1 1 0 0 0 1-.8L21 8H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
              <span class="kit-builder__btn-label">Cart</span>
              <span class="kit-builder__count" data-kb-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
            </a>
          {%- endif -%}
          <button type="button" class="kit-builder__btn kit-builder__btn--close" data-kb-close aria-label="Close Kit Builder">
            <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18"/></svg>
            <span class="kit-builder__btn-label">Close</span>
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="kit-builder__stage">
    <div class="kit-builder__loading" data-kb-loading aria-live="polite">
      <span class="kit-builder__spinner" aria-hidden="true"></span>
      <p>Loading Kit Builder&hellip;</p>
      <p class="kit-builder__slow">
        Taking longer than usual. Try refreshing the page, or
        <a href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}">contact us</a>
        and we'll help you build your kit.
      </p>
    </div>
    <iframe
      id="kit-builder-iframe"
      src="{{ section.settings.iframe_url }}"
      title="TengTools Kit Builder"
      frameborder="0"
      scrolling="auto"
      allow="clipboard-write"
    ></iframe>
  </div>
</div>

{% render 'kit-discount-sync' %}

<script>
(function() {
  const root = document.getElementById('kit-builder-{{ section.id }}');
  if (!root) return;
  const iframe = root.querySelector('iframe');
  const fullscreen = root.classList.contains('kit-builder--fullscreen');
  const routeRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  const KIT_PROPERTY = '_kit_build';           // hidden line property marking kit-builder lines

  let builderOrigin = null;
  try { builderOrigin = new URL(iframe.src, location.href).origin; } catch (e) { /* bad URL setting */ }

  // ---- Full-screen shell -------------------------------------------------------------------
  if (fullscreen && !(window.Shopify && window.Shopify.designMode)) {
    document.documentElement.classList.add('kb-fullscreen-open');
  }

  const closeBtn = root.querySelector('[data-kb-close]');
  if (closeBtn) closeBtn.addEventListener('click', closeBuilder);

  // Back to where the customer came from on this site, otherwise the "Close" setting / homepage
  function closeBuilder() {
    try {
      const ref = document.referrer ? new URL(document.referrer) : null;
      if (ref && ref.origin === location.origin && ref.pathname !== location.pathname && history.length > 1) {
        history.back();
        return;
      }
    } catch (e) { /* ignore bad referrer */ }
    location.href = root.dataset.closeUrl || routeRoot;
  }

  const cartBtn = root.querySelector('[data-kb-cart]');
  if (cartBtn) {
    cartBtn.addEventListener('click', function(event) {
      const drawer = document.querySelector('cart-drawer');
      if (drawer && typeof drawer.open === 'function') {
        event.preventDefault();
        drawer.open(cartBtn);
      }
    });
  }

  // ---- Loading state -----------------------------------------------------------------------
  const slowTimer = setTimeout(() => root.classList.add('is-slow'), 20000);
  iframe.addEventListener('load', () => {
    clearTimeout(slowTimer);
    root.classList.add('is-loaded');
  });

  // ---- Messages from the builder -----------------------------------------------------------
  window.addEventListener('message', async function(event) {
    // Only the builder iframe may talk to the cart
    if (event.source !== iframe.contentWindow) return;
    if (builderOrigin && event.origin !== builderOrigin) return;

    const data = event.data;
    if (!data || !data.type) return;

    // Inline mode grows the iframe to fit; full-screen fills the viewport and scrolls inside
    if (data.type === 'teng-height-update' && data.height) {
      if (!fullscreen) iframe.style.height = data.height + 'px';
    }

    if (data.type === 'teng-add-to-cart') {
      const ok = await addLines([{ id: data.variantId, quantity: data.quantity || 1 }]);
      if (ok) await refreshCart(true);
      else notify('Sorry, that item couldn’t be added to your cart. It may be out of stock.', true);
    }

    // Bulk configuration add. The kit discount is then recalculated by kit-discount-sync
    // (rendered above), which watches every cart change.
    if (data.type === 'teng-add-configuration' && data.items) {
      const sync = window.tengKitDiscountSync;
      if (sync && sync.pause) sync.pause();
      try {
        await addConfigurationToCart(data.items, data.kitId);
      } finally {
        if (sync && sync.resume) sync.resume();
      }
    }
  });

  /**
   * Add lines with the Shopify AJAX Cart API. Returns true if Shopify accepted them all.
   */
  async function addLines(lines, properties) {
    const items = lines
      .filter(line => line.id)
      .map(line => ({
        id: parseInt(line.id, 10),
        quantity: line.quantity || 1,
        ...(properties ? { properties } : {})
      }));
    if (items.length === 0) return false;

    try {
      const response = await fetch(routeRoot + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items })
      });
      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        console.warn('[Kit Builder] Add to cart failed:', errorData.description || errorData.message || response.status);
        return false;
      }
      return true;
    } catch (error) {
      console.error('[Kit Builder] Add to cart error:', error);
      return false;
    }
  }

  /**
   * Add a whole kit. Each line carries the kit ID (a hidden "_" property) so kit-builder lines can
   * be found for the price-break discount. Shopify rejects the whole bulk add if any one line can't
   * be added (e.g. not enough stock), so fall back to line by line and tell the customer what's missing.
   */
  async function addConfigurationToCart(items, kitId) {
    if (!items || items.length === 0) return false;
    const properties = kitId ? { [KIT_PROPERTY]: kitId } : undefined;
    const lines = items.map(item => ({ id: item.variantId, quantity: item.qty || 1 }));

    if (await addLines(lines, properties)) {
      await refreshCart(true);
      return true;
    }

    let added = 0;
    for (const line of lines) {
      if (await addLines([line], properties)) added++;
    }
    const missing = lines.length - added;

    if (added > 0) await refreshCart(true);
    if (added === 0) {
      notify('Sorry, your kit couldn’t be added to the cart. Some items may be out of stock. Please try again or contact us.', true);
    } else if (missing > 0) {
      notify(missing + ' of ' + lines.length + ' items couldn’t be added (out of stock or unavailable). Check your cart before checking out.', true);
    }
    return added > 0;
  }

  /**
   * Re-render the theme's cart drawer and header cart icon, optionally opening the drawer.
   * Mirrors CartDrawer.renderContents() in assets/cart-drawer.js; the theme's custom elements
   * (quantity-input, cart-remove-button) bind themselves when re-created, so no re-binding here.
   */
  async function refreshCart(openDrawer) {
    try {
      const [sections, cart] = await Promise.all([
        fetch(routeRoot + '?sections=cart-drawer,cart-icon-bubble').then(r => r.json()),
        fetch(routeRoot + 'cart.js').then(r => r.json())
      ]);
      const parse = html => new DOMParser().parseFromString(html, 'text/html');

      const drawerTarget = document.getElementById('CartDrawer');
      const drawerSource = sections['cart-drawer'] && parse(sections['cart-drawer']).getElementById('CartDrawer');
      if (drawerTarget && drawerSource) drawerTarget.innerHTML = drawerSource.innerHTML;

      const bubbleTarget = document.getElementById('cart-icon-bubble');
      const bubbleSource = sections['cart-icon-bubble'] && parse(sections['cart-icon-bubble']).querySelector('.shopify-section');
      if (bubbleTarget && bubbleSource) bubbleTarget.innerHTML = bubbleSource.innerHTML;

      updateBarCount(cart.item_count);

      const drawer = document.querySelector('cart-drawer');
      if (drawer) {
        drawer.classList.toggle('is-empty', cart.item_count === 0);
        const overlay = drawer.querySelector('#CartDrawer-Overlay');
        if (overlay && typeof drawer.close === 'function') overlay.addEventListener('click', drawer.close.bind(drawer));
        if (openDrawer && typeof drawer.open === 'function') {
          drawer.open();
          return;
        }
      }
      if (openDrawer) notify('Added to cart. Your cart now has ' + cart.item_count + (cart.item_count === 1 ? ' item.' : ' items.'));
    } catch (error) {
      console.error('[Kit Builder] Failed to refresh cart:', error);
    }
  }

  // kit-discount-sync calls this after changing the kit discount (refresh only, don't pop the drawer)
  window.tengRefreshCart = () => refreshCart(false);

  function updateBarCount(count) {
    const el = root.querySelector('[data-kb-count]');
    if (!el) return;
    el.textContent = count;
    el.hidden = count === 0;
    if (cartBtn) cartBtn.setAttribute('aria-label', 'Cart, ' + count + ' items');
  }

  /**
   * Small on-brand message, shown above the builder (and the cart drawer)
   */
  function notify(message, isError) {
    const toast = document.createElement('div');
    toast.className = 'kit-builder-toast' + (isError ? ' kit-builder-toast--error' : '');
    toast.setAttribute('role', isError ? 'alert' : 'status');
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.classList.add('is-leaving'), isError ? 7000 : 3500);
    setTimeout(() => toast.remove(), isError ? 7400 : 3900);
  }
})();
</script>

<style>
  .kit-builder-section {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .kit-builder__stage {
    position: relative;
  }

  #kit-builder-iframe {
    display: block;
    width: 100%;
    min-height: 800px;
    border: none;
    transition: height 0.3s ease;
  }

  /* ---- Full-screen ---- */
  html.kb-fullscreen-open,
  html.kb-fullscreen-open body {
    overflow: hidden;
  }

  .kit-builder--fullscreen {
    position: fixed;
    inset: 0;
    z-index: 950; /* above the header, below the cart drawer (1000) */
    display: flex;
    flex-direction: column;
    background: #f4f4f4; /* shows either side beyond 4K */
  }

  .kit-builder--fullscreen .kit-builder__stage {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    max-width: 3840px;
    margin: 0 auto;
    background: #fff;
  }

  .kit-builder--fullscreen #kit-builder-iframe {
    position: absolute;
    inset: 0;
    height: 100%;
    min-height: 0;
    transition: none;
  }

  .kit-builder__bar {
    flex: 0 0 auto;
    background: {{ bar_bg }};
    color: {{ bar_text }};
  }

  .kit-builder__bar-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 3840px;
    height: 56px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .kit-builder__brand {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    color: inherit;
    text-decoration: none;
  }

  .kit-builder__logo {
    display: block;
    height: 28px;
    width: auto;
  }

  .kit-builder__shop-name {
    font-weight: 700;
    font-size: 1.8rem;
  }

  .kit-builder__title {
    flex: 1 1 auto;
    padding-left: 16px;
    border-left: 1px solid currentColor;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
    white-space: nowrap;
  }

  .kit-builder__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .kit-builder__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid currentColor;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .kit-builder__btn:hover,
  .kit-builder__btn:focus-visible {
    background: rgba(255, 255, 255, 0.15);
  }

  .kit-builder__btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .kit-builder__count {
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    background: {{ bar_text }};
    color: {{ bar_bg }};
    font-size: 1.2rem;
    line-height: 20px;
    text-align: center;
  }

  .kit-builder__count[hidden] {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .kit-builder__title,
    .kit-builder__btn-label {
      display: none;
    }
    .kit-builder__bar-inner {
      height: 52px;
      padding: 0 12px;
    }
    .kit-builder__logo {
      height: 22px;
    }
    .kit-builder__btn {
      padding: 0 10px;
    }
  }

  /* ---- Loading ---- */
  .kit-builder__loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 24px;
    text-align: center;
    pointer-events: none;
  }

  .kit-builder-section:not(.kit-builder--fullscreen) .kit-builder__loading {
    height: 800px;
    bottom: auto;
  }

  .kit-builder__loading p {
    margin: 0;
  }

  .kit-builder__spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(0, 0, 0, 0.12);
    border-top-color: {{ bar_bg }};
    border-radius: 50%;
    animation: kit-builder-spin 0.9s linear infinite;
  }

  .kit-builder__slow {
    display: none;
    max-width: 420px;
    pointer-events: auto;
  }

  .kit-builder-section.is-slow .kit-builder__slow {
    display: block;
  }

  .kit-builder-section.is-loaded .kit-builder__loading {
    display: none;
  }

  @keyframes kit-builder-spin {
    to { transform: rotate(360deg); }
  }

  /* ---- Messages ---- */
  .kit-builder-toast {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 1100;
    max-width: min(420px, calc(100vw - 40px));
    padding: 14px 18px;
    border-left: 4px solid {{ bar_bg }};
    border-radius: 4px;
    background: #1a1a1a;
    color: #fff;
    font-size: 1.4rem;
    line-height: 1.4;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
    animation: kit-builder-toast-in 0.3s ease-out;
  }

  .kit-builder-toast--error {
    border-left-color: #ffb400;
  }

  .kit-builder-toast.is-leaving {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  @keyframes kit-builder-toast-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kit-builder__spinner,
    .kit-builder-toast {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Kit Builder",
  "tag": "section",
  "class": "section-kit-builder",
  "settings": [
    {
      "type": "text",
      "id": "iframe_url",
      "label": "Kit Builder URL",
      "default": "https://teng-kit-builder-production.up.railway.app",
      "info": "The URL of your hosted Kit Builder application. Add-to-cart messages are only accepted from this address."
    },
    {
      "type": "checkbox",
      "id": "fullscreen",
      "label": "Open full screen",
      "default": true,
      "info": "Covers the site header and footer with a slim bar (logo, cart, close). Fills the screen up to 4K wide."
    },
    {
      "type": "url",
      "id": "close_url",
      "label": "Close button fallback link",
      "info": "Close goes back to the customer's previous page on this site. If they arrived from elsewhere, it goes here (homepage if blank)."
    },
    {
      "type": "checkbox",
      "id": "show_cart_button",
      "label": "Show cart button in the top bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Top bar background",
      "default": "#c1272d"
    },
    {
      "type": "color",
      "id": "bar_text",
      "label": "Top bar text and icons",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Kit Builder"
    }
  ]
}
{% endschema %}
