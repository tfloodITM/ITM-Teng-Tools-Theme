      "label": "Row height (px)",
      "min": 28,
      "max": 64,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "atc_font_size",
      "label": "Font size (px)",
      "min": 9,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "atc_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "700", "label": "Bold" },
        { "value": "400", "label": "Normal" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "atc_bg",
      "label": "Background",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "atc_color",
      "label": "Text / icon colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "actions_divider_color",
      "label": "Divider colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "list_btn_bg",
      "label": "Save-to-list button background",
      "default": "#f5a623"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
