      "label": "Show price",
      "default": true
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Font size – desktop (px)",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "price_size_mobile",
      "label": "Font size – mobile (px)",
      "min": 8,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Font weight",
      "options": [
        { "value": "700", "label": "Bold" },
        { "value": "400", "label": "Normal" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Text colour",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Add to Cart button"
    },
    {
      "type": "checkbox",
      "id": "show_atc",
      "label": "Show Add to Cart row",
      "default": true
