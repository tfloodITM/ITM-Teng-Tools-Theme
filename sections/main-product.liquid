                          <details id="PaymentOptions-Cta-{{ block.id }}-{{ section.id }}">
                            <summary><div class="summary__title">{% render 'icon-accordion', icon: block.settings.icon %}<h2 class="h4 accordion__title inline-richtext">{{ block.settings.heading | escape }}</h2></div>{{- 'icon-caret.svg' | inline_asset_content -}}</summary>
