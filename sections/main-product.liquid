                        <p class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}" id="Sku-{{ section.id }}" role="status" {{ block.shopify_attributes }}>SKU:&nbsp;{{ product.selected_or_first_available_variant.sku | default: product.title }}</p>
                      {%- endunless -%}

                    {%- when 'sharpens' -%}
                      {%- assign sharpens_list = product.metafields.itm.sharpens.value | parse_json -%}
                      {%- if sharpens_list != blank -%}
                        {%- assign sharpens_slots = 'Hunt|sharpens-hunt.svg?v=1782705521,Kitchen|sharpens-kitchen.svg?v=1782705520,Pocket|sharpens-pocket.svg?v=1782705520,Serrations|sharpens-serrations-bread.svg?v=1782705521,Scissors|sharpens-scissors.svg?v=1782705520,Axes & Tools|sharpens-axes-tools.svg?v=1782705520,Fishing|sharpens-hunt.svg?v=1782705521' | split: ',' -%}
                        <div class="itm-sharpens" {{ block.shopify_attributes }}>
                          {%- assign mobile_slots = 'Kitchen|sharpens-kitchen.svg?v=1782705520,Pocket|sharpens-pocket.svg?v=1782705520,Serrations|sharpens-serrations-bread.svg?v=1782705521,Scissors|sharpens-scissors.svg?v=1782705520,Axes & Tools|sharpens-axes-tools.svg?v=1782705520' | split: ',' -%}
                          {%- assign hunt_fish_active = false -%}
                          {%- if sharpens_list contains 'Hunt' or sharpens_list contains 'Fishing' -%}{%- assign hunt_fish_active = true -%}{%- endif -%}
                          <p class="itm-sharpens__label">Ideal for Sharpening:</p>
                          <div class="itm-sharpens__icons itm-sharpens__icons--desktop">
                            {%- for slot in sharpens_slots -%}
                              {%- assign sp = slot | split: '|' -%}
                              {%- assign sn = sp[0] -%}
                              {%- assign sf = sp[1] -%}
                              {%- if sharpens_list contains sn -%}
                                <div class="itm-sharpens__slot itm-sharpens__slot--active">
                                  <img src="https://cdn.shopify.com/s/files/1/0778/6928/5630/files/{{ sf }}" alt="{{ sn }}" width="52" height="52" loading="lazy">
                                  <span class="itm-sharpens__name">{{ sn }}</span>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                            {%- for slot in sharpens_slots -%}
                              {%- assign sp = slot | split: '|' -%}
                              {%- assign sn = sp[0] -%}
                              {%- assign sf = sp[1] -%}
                              {%- unless sharpens_list contains sn -%}
                                <div class="itm-sharpens__slot">
                                  <img src="https://cdn.shopify.com/s/files/1/0778/6928/5630/files/{{ sf }}" alt="{{ sn }}" width="52" height="52" loading="lazy">
                                  <span class="itm-sharpens__name">{{ sn }}</span>
                                </div>
                              {%- endunless -%}
                            {%- endfor -%}
                          </div>
                          <div class="itm-sharpens__icons itm-sharpens__icons--mobile">
                            {%- if hunt_fish_active -%}
                              <div class="itm-sharpens__slot itm-sharpens__slot--active">
                                <img src="https://cdn.shopify.com/s/files/1/0778/6928/5630/files/sharpens-hunt.svg?v=1782705521" alt="Hunt & Fish" width="52" height="52" loading="lazy">
                                <span class="itm-sharpens__name">Hunt & Fish</span>
                              </div>
                            {%- endif -%}
                            {%- for slot in mobile_slots -%}
                              {%- assign sp = slot | split: '|' -%}
                              {%- assign sn = sp[0] -%}
                              {%- assign sf = sp[1] -%}
                              {%- if sharpens_list contains sn -%}
                                <div class="itm-sharpens__slot itm-sharpens__slot--active">
                                  <img src="https://cdn.shopify.com/s/files/1/0778/6928/5630/files/{{ sf }}" alt="{{ sn }}" width="52" height="52" loading="lazy">
                                  <span class="itm-sharpens__name">{{ sn }}</span>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                            {%- unless hunt_fish_active -%}
                              <div class="itm-sharpens__slot">
                                <img src="https://cdn.shopify.com/s/files/1/0778/6928/5630/files/sharpens-hunt.svg?v=1782705521" alt="Hunt & Fish" width="52" height="52" loading="lazy">
                                <span class="itm-sharpens__name">Hunt & Fish</span>
                              </div>
                            {%- endunless -%}
                            {%- for slot in mobile_slots -%}
                              {%- assign sp = slot | split: '|' -%}
                              {%- assign sn = sp[0] -%}
                              {%- assign sf = sp[1] -%}
                              {%- unless sharpens_list contains sn -%}
                                <div class="itm-sharpens__slot">
                                  <img src="https://cdn.shopify.com/s/files/1/0778/6928/5630/files/{{ sf }}" alt="{{ sn }}" width="52" height="52" loading="lazy">
                                  <span class="itm-sharpens__name">{{ sn }}</span>
                                </div>
                              {%- endunless -%}
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endif -%}

                    {%- when 'bundle_contents' -%}
                      <div class="itm-bundle-contents" id="BundleContents-{{ block.id }}" {{ block.shopify_attributes }}>
                        {%- if block.settings.bundle_heading != blank -%}
                          <p class="itm-bundle-contents__heading">{{ block.settings.bundle_heading }}</p>
                        {%- endif -%}
                        <div class="itm-bundle-contents__grid">
                          {%- for bc_i in (1..4) -%}
                            {%- assign bc_img_key = 'bundle_item' | append: bc_i | append: '_image' -%}
                            {%- assign bc_text_key = 'bundle_item' | append: bc_i | append: '_text' -%}
                            {%- assign bc_img = block.settings[bc_img_key] -%}
                            {%- assign bc_text = block.settings[bc_text_key] -%}
                            {%- if bc_img != blank or bc_text != blank -%}
                              <div class="itm-bundle-contents__item">
                                {%- if bc_img != blank -%}
                                  <img
                                    class="itm-bundle-contents__img"
                                    src="{{ bc_img | image_url: width: 400 }}"
                                    alt="{{ bc_text | default: block.settings.bundle_heading | escape }}"
                                    width="400"
                                    height="400"
                                    loading="lazy"
                                  >
                                {%- endif -%}
                                {%- if bc_text != blank -%}
                                  <p class="itm-bundle-contents__text">{{ bc_text }}</p>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                      <style>
                        #BundleContents-{{ block.id }} .itm-bundle-contents__heading {
                          font-size: {{ block.settings.bundle_heading_size | default: 14 }}px;
                        }
                        #BundleContents-{{ block.id }} .itm-bundle-contents__img {
                          height: {{ block.settings.bundle_image_height | default: 160 }}px;
                        }
                        #BundleContents-{{ block.id }} .itm-bundle-contents__text {
                          font-size: {{ block.settings.bundle_text_size | default: 13 }}px;
                        }
                        @media screen and (max-width: 749px) {
                          #BundleContents-{{ block.id }} .itm-bundle-contents__heading {
                            font-size: {{ block.settings.bundle_heading_size_mobile | default: 14 }}px;
                          }
                          #BundleContents-{{ block.id }} .itm-bundle-contents__img {
                            height: {{ block.settings.bundle_image_height_mobile | default: 140 }}px;
                          }
                          #BundleContents-{{ block.id }} .itm-bundle-contents__text {
                            font-size: {{ block.settings.bundle_text_size_mobile | default: 13 }}px;
                          }
                        }
                      </style>

                    {%- when 'metafield_html' -%}
                      {%- assign mf_out = '' -%}
                      {%- assign mf_used_manual = false -%}
                      {%- if block.settings.source == 'metafield' and block.settings.metafield_id != blank -%}
                        {%- assign mf_parts = block.settings.metafield_id | strip | split: '.' -%}
                        {%- assign mf_ns = mf_parts | first -%}
                        {%- assign mf_key = mf_parts | last -%}
                        {%- if product.metafields[mf_ns][mf_key] != blank -%}
                          {%- assign mf_out = product.metafields[mf_ns][mf_key] -%}
                        {%- endif -%}
                      {%- endif -%}
                      {%- if mf_out == '' and block.settings.manual_html != blank -%}
                        {%- assign mf_out = block.settings.manual_html -%}
                        {%- assign mf_used_manual = true -%}
                      {%- endif -%}
                      {%- assign mf_out = mf_out | replace: 'prod-desc-intro', '' -%}
                      {%- capture mf_style -%}
                        {%- if mf_used_manual and block.settings.manual_text_size > 0 -%}font-size: {{ block.settings.manual_text_size }}px;{%- endif -%}
                        {%- if block.settings.padding_top > 0 -%}padding-top: {{ block.settings.padding_top }}px;{%- endif -%}
                      {%- endcapture -%}
                      {%- assign mf_style = mf_style | strip_newlines | strip -%}
                      {%- if mf_out != blank -%}
                        <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}{% if mf_style != blank %} style="{{ mf_style }}"{% endif %}>
                          {{ mf_out }}
                        </div>
                      {%- endif -%}

                    {%- when 'custom_liquid' -%}
                      {%- assign rendered = block.settings.custom_liquid | strip_html | strip -%}
                      {%- if rendered != '' -%}
                        {{ block.settings.custom_liquid }}
                      {%- endif -%}

                    {%- when 'collapsible_tab' -%}
                      {%- assign rich_content = block.settings.content | strip_html | strip -%}
                      {%- assign page_content = block.settings.page.content | strip_html | strip -%}
                      {%- assign combined = rich_content | append: page_content | strip -%}
                      {%- if combined != '' -%}
                        <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                          <details id="Details-{{ block.id }}-{{ section.id }}">
                            <summary>
                              <div class="summary__title">
                                {% render 'icon-accordion', icon: block.settings.icon %}
                                <h2 class="h4 accordion__title inline-richtext">{{ block.settings.heading | default: block.settings.page.title | escape }}</h2>
                              </div>
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </summary>
                            <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                              {{ block.settings.content }}
                              {{ block.settings.page.content }}
                            </div>
                          </details>
                        </div>
                      {%- endif -%}

                    {%- when 'payment_options_grid' -%}
                      {%- assign payment_intro = block.settings.content | strip_html | strip -%}
                      {%- assign payment_extra = block.settings.custom_liquid | strip_html | strip -%}
                      {%- if block.settings.show_payment_terms or payment_intro != '' or payment_extra != '' -%}
                        <div class="product__accordion accordion quick-add-hidden itm-payment-options-grid" {{ block.shopify_attributes }}>
                          <details id="PaymentOptions-{{ block.id }}-{{ section.id }}">
                            <summary>
                              <div class="summary__title">
                                {% render 'icon-accordion', icon: block.settings.icon %}
                                <h2 class="h4 accordion__title inline-richtext">{{ block.settings.heading | escape }}</h2>
                              </div>
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </summary>
                            <div class="accordion__content rte itm-payment-options-grid__content" id="PaymentOptionsContent-{{ block.id }}-{{ section.id }}">
                              {%- if payment_intro != '' -%}
                                <div class="itm-payment-options-grid__intro">{{ block.settings.content }}</div>
                              {%- endif -%}
                              {%- if block.settings.show_payment_terms and settings.information_only_mode == false -%}
                                {%- assign payment_options_form_id = 'payment-options-form-' | append: block.id | append: '-' | append: section.id -%}
                                {%- form 'product', product, id: payment_options_form_id, class: 'installment caption-large itm-payment-options-grid__terms' -%}
                                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                                  {{ form | payment_terms }}
                                {%- endform -%}
                              {%- endif -%}
                              {%- if payment_extra != '' -%}
                                <div class="itm-payment-options-grid__extra">{{ block.settings.custom_liquid }}</div>
                              {%- endif -%}
                            </div>
                          </details>
                        </div>
                      {%- endif -%}

                    {%- when 'quantity_selector' -%}
                      {%- unless settings.information_only_mode -%}
                        <div class="itm-qty-atc-row">
                          <div id="Quantity-Form-{{ section.id }}" class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}" {{ block.shopify_attributes }}>
                            {% # theme-check-disable %}
                            {%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
                            {% # theme-check-enable %}
                            <span class="visually-hidden" id="quantity-label-{{ section.id }}">
                              {%- if cart_qty > 0 -%}
                                {{- 'products.product.quantity.in_cart_aria_label' | t: quantity: cart_qty -}}
                              {%- else -%}
                                {{- 'products.product.quantity.label' | t -}}
                              {%- endif -%}
                            </span>
                            <label class="quantity__label form__label" for="Quantity-{{ section.id }}" aria-labelledby="quantity-label-{{ section.id }}">
                              <span aria-hidden="true">{{ 'products.product.quantity.label' | t }}</span>
                              <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}" aria-hidden="true">
                                {%- render 'loading-spinner' -%}
                                <span>({{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}})</span>
                              </span>
                            </label>
                            <div class="price-per-item__container">
                              <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                                <button class="quantity__button" name="minus" type="button"><span class="visually-hidden">{{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}</span><span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span></button>
                                <input class="quantity__input" type="number" name="quantity" id="Quantity-{{ section.id }}" data-cart-quantity="{{ cart_qty }}" data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}" min="{{ product.selected_or_first_available_variant.quantity_rule.min }}" {% if product.selected_or_first_available_variant.quantity_rule.max != null %}data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}" max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"{% endif %} step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}" value="{{ product.selected_or_first_available_variant.quantity_rule.min }}" form="{{ product_form_id }}">
                                <button class="quantity__button" name="plus" type="button"><span class="visually-hidden">{{- 'products.product.quantity.increase' | t: product: product.title | escape -}}</span><span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span></button>
                              </quantity-input>
                            </div>
                          </div>
                          <button type="button"
                            class="itm-custom-atc-btn button button--full-width button--primary"
                            data-atc-form="{{ product_form_id }}">
                            {{- block.settings.custom_atc_text | default: 'Add to cart' -}}
                          </button>
                        </div>
                      {%- endunless -%}

                    {%- when 'popup' -%}
                      <modal-opener class="product-popup-modal__opener quick-add-hidden" data-modal="#PopupModal-{{ block.id }}" {{ block.shopify_attributes }}>
                        <button id="ProductPopup-{{ block.id }}" class="product-popup-modal__button link" type="button" aria-haspopup="dialog">
                          {{ block.settings.text | default: block.settings.page.title | escape }}
                        </button>
                      </modal-opener>

                    {%- when 'share' -%}
                      <div class="pg__hero-share" {{ block.shopify_attributes }}>
                        {% liquid
                          assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                          render 'share-button', block: block, share_link: share_url
                        %}
                      </div>

                    {%- when 'shipping_notes' -%}
                      {%- assign standard_shipping_note = block.settings.standard_shipping_note -%}
                      {%- assign standard_shipping_icon = block.settings.standard_shipping_icon -%}
                      {%- assign express_shipping_note = block.settings.express_shipping_note -%}
                      {%- if standard_shipping_note != blank or express_shipping_note != blank -%}
                        <div class="pg__hero-share-notes" style="--pg-share-note-size: {{ block.settings.shipping_note_font_size | default: 14 | divided_by: 10.0 }}rem;" {{ block.shopify_attributes }}>
                          {%- if standard_shipping_note != blank -%}
                            <div class="pg__hero-share-note">
                              {%- if standard_shipping_icon != blank -%}<span class="pg__hero-share-note-icon" aria-hidden="true">{{ standard_shipping_icon }}</span>{%- endif -%}
                              <div class="pg__hero-share-note-text">{{ standard_shipping_note | newline_to_br }}</div>
                            </div>
                          {%- endif -%}
                          {%- if express_shipping_note != blank -%}
                            <div class="pg__hero-share-note">
                              {%- if block.settings.express_shipping_icon != blank -%}<span class="pg__hero-share-note-icon" aria-hidden="true">{{ block.settings.express_shipping_icon }}</span>{%- endif -%}
                              <div class="pg__hero-share-note-text">{{ express_shipping_note | newline_to_br }}</div>
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                    {%- when 'variant_picker' -%}
                      {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}

                    {%- when 'buy_buttons' -%}
                      {%- render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true, inline_with_quantity: false -%}

                    {%- when 'divider' -%}
                      <div class="itm-divider-block" {{ block.shopify_attributes }} style="
                        height: {{ block.settings.thickness | default: 1 }}px;
                        background: {{ block.settings.color | default: '#e1e1e1' }};
                        width: {{ block.settings.width | default: 100 }}%;
                        margin-top: {{ block.settings.space_above | default: 16 }}px;
                        margin-bottom: {{ block.settings.space_below | default: 16 }}px;
                        {% if block.settings.align == 'left' %}margin-right: auto;{% elsif block.settings.align == 'right' %}margin-left: auto;{% else %}margin-left: auto; margin-right: auto;{% endif %}
                      "></div>

                    {%- when 'rating' -%}
                      {%- if product.metafields.reviews.rating.value != blank -%}
                        <div class="rating-wrapper">
                          {% liquid
                            assign rating_decimal = 0
                            assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                            if decimal >= 0.3 and decimal <= 0.7
                              assign rating_decimal = 0.5
                            elsif decimal > 0.7
                              assign rating_decimal = 1
                            endif
                          %}
                          <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}">
                            <span aria-hidden="true" class="rating-star" style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
                          </div>
                          <p class="rating-text caption"><span aria-hidden="true">{{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max -}}</span></p>
                          <p class="rating-count caption"><span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span><span class="visually-hidden">{{- product.metafields.reviews.rating_count }} {{ 'accessibility.total_reviews' | t -}}</span></p>
                        </div>
                      {%- endif -%}

                    {%- when 'static_rating' -%}
                      {%- liquid
                        assign sr_value = block.settings.static_rating_value | default: 5
                        assign sr_percent = sr_value | times: 100.0 | divided_by: 5 | at_most: 100
                      -%}
                      {%- capture sr_markup -%}
                        <div class="rating-wrapper itm-static-rating">
                          <div class="itm-static-rating-stars" role="img" aria-label="{{ sr_value }} out of 5 stars">
                            <span class="itm-static-rating-stars__bg" aria-hidden="true">★★★★★</span>
                            <span class="itm-static-rating-stars__fill" aria-hidden="true" style="width: {{ sr_percent }}%;">★★★★★</span>
                          </div>
                          <p class="itm-static-rating-text caption">{{ block.settings.static_rating_text }}</p>
                        </div>
                      {%- endcapture -%}
                      {%- if itm_inv_block -%}
                        <div class="itm-reviews-stock-row">
                          <div class="itm-reviews-stock-row__reviews">{{ sr_markup }}</div>
                          {%- unless settings.information_only_mode -%}
                            <p class="product__inventory{% if itm_inv_block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif itm_inv_block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if itm_inv_block.settings.force_in_stock == false and product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}" {{ itm_inv_block.shopify_attributes }} id="Inventory-{{ section.id }}" role="status" style="{% if itm_inv_block.settings.inv_font_size > 0 %}font-size:{{ itm_inv_block.settings.inv_font_size }}px;{% endif %}{% if itm_inv_block.settings.inv_bold %}font-weight:bold;{% endif %}{% if itm_inv_block.settings.inv_pad_top > 0 %}padding-top:{{ itm_inv_block.settings.inv_pad_top }}px;{% endif %}{% if itm_inv_block.settings.inv_pad_bottom > 0 %}padding-bottom:{{ itm_inv_block.settings.inv_pad_bottom }}px;{% endif %}">
                              {%- if itm_inv_block.settings.force_in_stock -%}
                                <span class="svg-wrapper" style="color: rgb(62, 214, 96)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                                In Stock, Ready to ship
                              {%- elsif product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                                {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                                  <span class="svg-wrapper" style="color: rgb(62, 214, 96)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                                  In Stock, Ready to ship
                                {%- else -%}
                                  {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                                    <span class="svg-wrapper" style="color: rgb(62, 214, 96)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                                    {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                                  {%- else -%}
                                    <span class="svg-wrapper" style="color: rgb(200, 200, 200)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                                    {{- 'products.product.inventory_out_of_stock' | t -}}
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endif -%}
                            </p>
                          {%- endunless -%}
                          {%- assign itm_inv_prerendered = true -%}
                        </div>
                      {%- else -%}
                        {{ sr_markup }}
                      {%- endif -%}

                    {%- when 'complementary' -%}
                  <product-recommendations
                    class="complementary-products quick-add-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}"
                    data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.product_list_limit }}&intent=complementary"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                  >
                    {%- if recommendations.performed and recommendations.products_count > 0 -%}
                      <aside
                        aria-label="{{ 'accessibility.complementary_products' | t }}"
                        {{ block.shopify_attributes -}}
                        {% if block.settings.make_collapsible_row %}
                          class="product__accordion accordion"
                        {% endif %}
                      >
                        <div class="complementary-products__container">
                          {%- if block.settings.make_collapsible_row -%}
                            <details id="Details-{{ block.id }}-{{ section.id }}" open>
                              <summary>
                          {%- endif -%}
                          <div class="summary__title">
                            {%- if block.settings.make_collapsible_row -%}
                              {% render 'icon-accordion', icon: block.settings.icon %}
                              <h2 class="h4 accordion__title">{{ block.settings.block_heading }}</h2>
                            {%- else -%}
                              <h2 class="h3 accordion__title">{{ block.settings.block_heading }}</h2>
                            {%- endif -%}
                          </div>
                          {%- if block.settings.make_collapsible_row -%}
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                            </summary>
                          {%- endif -%}
                          <slideshow-component class="slider-mobile-gutter">
                            {%- assign number_of_slides = recommendations.products_count
                              | plus: 0.0
                              | divided_by: block.settings.products_per_page
                              | ceil
                            -%}
                            <div
                              id="Slider-{{ block.id }}"
                              class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere"
                              role="list"
                              {% if number_of_slides > 1 %}
                                aria-label="{{ 'general.slider.name' | t }}"
                              {% endif %}
                            >
                              {% assign skip_card_product_styles = false %}
                              {%- for i in (1..number_of_slides) -%}
                                <div
                                  id="Slide-{{ block.id }}-{{ forloop.index }}"
                                  class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide"
                                  tabindex="-1"
                                  role="group"
                                  {% if number_of_slides > 1 %}
                                    aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                    aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                  {% endif %}
                                >
                                  <ul class="list-unstyled" role="list">
                                    {%- for product in recommendations.products
                                      limit: block.settings.products_per_page
                                      offset: continue
                                    -%}
                                      <li>
                                        {%- if block.settings.enable_quick_add -%}
                                          {% assign quick_add = 'standard' %}
                                        {%- else -%}
                                          {% assign quick_add = 'none' %}
                                        {%- endif -%}
                                        {% render 'card-product',
                                          card_product: product,
                                          media_aspect_ratio: block.settings.image_ratio,
                                          show_secondary_image: false,
                                          lazy_load: false,
                                          skip_styles: skip_card_product_styles,
                                          quick_add: quick_add,
                                          section_id: section.id,
                                          horizontal_class: true,
                                          horizontal_quick_add: true
                                        %}
                                      </li>
                                      {%- assign skip_card_product_styles = true -%}
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              {%- endfor -%}
                            </div>
                            {%- if number_of_slides > 1 -%}
                              <div class="slider-buttons">
                                <button
                                  type="button"
                                  class="slider-button slider-button--prev"
                                  name="previous"
                                  aria-label="{{ 'general.slider.previous_slide' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-caret.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                  {%- if block.settings.pagination_style == 'counter' -%}
                                    <span class="slider-counter--current">1</span>
                                    <span aria-hidden="true"> / </span>
                                    <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                    <span class="slider-counter--total">{{ number_of_slides }}</span>
                                  {%- else -%}
                                    <div class="slideshow__control-wrapper">
                                      {%- for i in (1..number_of_slides) -%}
                                        <button
                                          class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link"
                                          aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                          aria-controls="Slider-{{ block.id }}"
                                        >
                                          {%- if block.settings.pagination_style == 'numbers' -%}
                                            {{ forloop.index -}}
                                          {%- else -%}
                                            <span class="dot"></span>
                                          {%- endif -%}
                                        </button>
                                      {%- endfor -%}
                                    </div>
                                  {%- endif -%}
                                </div>
                                <button
                                  type="button"
                                  class="slider-button slider-button--next"
                                  name="next"
                                  aria-label="{{ 'general.slider.next_slide' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-caret.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                              </div>
                            {%- endif -%}
                          </slideshow-component>
                          {%- if block.settings.make_collapsible_row -%}
                            </details>
                          {%- endif -%}
                        </div>
                      </aside>
                    {%- endif -%}
                    {{ 'component-card.css' | asset_url | stylesheet_tag }}
                    {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                    {%- if block.settings.enable_quick_add -%}
                      {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                      <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                    {%- endif -%}
                  </product-recommendations>

                {%- when 'icon-with-text' -%}
                  {% render 'icon-with-text', block: block %}
                  {%- endcase -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}


              <a href="{{ product.url }}" class="link product__view-details animate-arrow">
                {{ 'products.product.view_full_details' | t }}
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </a>
            </section>

            {%- if section.settings.show_cta_block -%}
            <div class="pg__hero-ctas">
          {%- if settings.allow_external_stockist -%}
          <a href="https://www.industrialtool.com.au/stockists" class="button pg__btn pg__btn--icon">
            <span class="pg__icon" aria-hidden="true">
              {{ 'ITM-Binocular--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
            </span>
            Find a stockist
          </a>
          {%- endif -%}

          {%- comment -%} ITM: Use CDN for brochure/manual PDFs based on SKU {%- endcomment -%}
          {%- assign product_sku = product.selected_or_first_available_variant.sku | default: product.title | strip -%}
          
          {%- if product_sku != blank -%}
            <a href="{% render 'itm-cdn-product-image', sku: product_sku, media_type: 'brochure' %}" class="button pg__btn pg__btn--icon hidden" data-check-exists="true" target="_blank" rel="noopener noreferrer">
              <span class="pg__icon" aria-hidden="true">
                {{ 'ITM-Book-Open-Bookmark--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
              </span>
              Product Brochure
            </a>

            <a href="{% render 'itm-cdn-product-image', sku: product_sku, media_type: 'manual' %}" class="button pg__btn pg__btn--icon hidden" data-check-exists="true" target="_blank" rel="noopener noreferrer">
              <span class="pg__icon" aria-hidden="true">
                {{ 'ITM-Book-Book-Pages--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
              </span>
              User Manual
            </a>
          {%- else -%}
            {%- comment -%} Fallback to metafield if SKU not available {%- endcomment -%}
            {%- if product.metafields.itm_media.brochure_url -%}
              <a href="{{ product.metafields.itm_media.brochure_url }}" class="button pg__btn pg__btn--icon" target="_blank" rel="noopener noreferrer">
                <span class="pg__icon" aria-hidden="true">
                  {{ 'ITM-Book-Open-Bookmark--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
                </span>
                Product Brochure
              </a>
            {%- endif -%}

            {%- if product.metafields.itm_media.manual_url -%}
              <a href="{{ product.metafields.itm_media.manual_url }}" class="button pg__btn pg__btn--icon" target="_blank" rel="noopener noreferrer">
                <span class="pg__icon" aria-hidden="true">
                  {{ 'ITM-Book-Book-Pages--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
                </span>
                User Manual
              </a>
            {%- endif -%}
          {%- endif -%}

              {%- assign skipped_cta_block_id = '' -%}
              {%- for block in section.blocks -%}
                {%- if skipped_cta_block_id == block.id -%}
                  {%- assign skipped_cta_block_id = '' -%}
                {%- else -%}
                  {%- liquid
                    assign block_in_cta = false
                    if block.settings.show_in_aside == true
                      assign block_in_cta = true
                    endif
                    if block.type == 'guarantee'
                      assign block_in_cta = true
                    endif
                    assign next_block_index = forloop.index0 | plus: 1
                    assign next_block = section.blocks[next_block_index]
                    assign inline_buy_buttons = false
                    if block.type == 'quantity_selector' and next_block and next_block.type == 'buy_buttons' and next_block.settings.inline_with_quantity and next_block.settings.show_in_aside == true
                      assign inline_buy_buttons = true
                    endif
                  -%}
                {%- if block_in_cta -%}
                  {%- case block.type -%}
                    {%- when 'text' -%}
                      {%- assign rendered = block.settings.text | strip_html | strip -%}
