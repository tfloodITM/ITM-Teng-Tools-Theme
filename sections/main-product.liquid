                <div class="itm-trust__row">
                  <span class="itm-trust__icon" aria-hidden="true">
                    {%- if section.settings.trust_ship_icon != blank -%}
                      <img src="{{ section.settings.trust_ship_icon | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
                    {%- else -%}
                      {{ 'itm-icon-shipping.svg' | inline_asset_content }}
                    {%- endif -%}
                  </span>
                  <div class="itm-trust__text">
                    {%- if section.settings.trust_ship_text != blank -%}<strong class="itm-trust__heading">{{ section.settings.trust_ship_text | escape }}</strong>{%- endif -%}
