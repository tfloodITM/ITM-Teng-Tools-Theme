                                {%- form 'product', product, id: payment_options_cta_form_id, class: 'installment caption-large itm-payment-options-grid__terms' -%}
                                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                                  {{ form | payment_terms }}
                                {%- endform -%}
                              {%- endif -%}
                              {%- if payment_extra != '' -%}
                                <div class="itm-payment-options-grid__extra">{{ block.settings.custom_liquid }}</div>
                              {%- endif -%}
                            </div>
                          </details>
                        </div>
                      {%- endif -%}

                    {%- when 'quantity_selector' -%}
                      {%- unless settings.information_only_mode -%}
                        {%- if inline_buy_buttons -%}<div class="pg__hero-aside-item itm-product-inline-purchase-row">{%- endif -%}
                        <div class="pg__hero-aside-item pg__hero-aside-item--quantity" {{ block.shopify_attributes }}>
                          {% # theme-check-disable %}
