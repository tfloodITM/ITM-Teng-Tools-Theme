{%- comment -%} ITM Theme - Updated Dec 9 2025 - Force sync {%- endcomment -%}
<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

{%- style -%}
  /* Gradient: anchor it to THIS section instead of the viewport. With the theme
     default (background-attachment: fixed) the gradient is pinned to the viewport,
     so as the product section scrolls up to leave, its bottom sits at the top of
     the screen and shows the gradient's TOP colour. Anchoring to the section means
     the section's bottom always shows the gradient's bottom colour. */
  #MainProduct-{{ section.id }}.gradient {
    background-attachment: scroll;
    background-size: 100% 100%;
  }

  .itm-fd-pdp-badge {
    display: inline-block;
    margin: 0 0 10px;
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Section padding */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  h2 { text-align: left; }

  /* ==========================
     PRODUCT GRID LAYOUT
     ========================== */
  .itm-product-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 32px;
    align-items: flex-start;
  }

  /* Full-bleed hero: the grid spans edge-to-edge so the image grid touches the
     left wall + top. The info column carries its own padding (settings below). */
  #shopify-section-{{ section.id }} .page-width { max-width: none; padding: 0; }

  .itm-product-col--info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  .itm-product-title-row {
    width: 100%;
    margin: 0;
  }

  .itm-product-detail-columns {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2rem;
  }

  .itm-product-detail-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  .itm-product-detail-main.product__info-container {
    max-width: none;
  }

  .pg__hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 0 0 32rem;
    width: 100%;
    max-width: 32rem;
  }

  .pg__hero-ctas > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .itm-product-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .itm-product-detail-columns {
      flex-direction: column;
      gap: 24px;
    }

    .pg__hero-ctas {
      max-width: 100%;
      flex-basis: auto;
    }
  }

  /* ==========================
     MAIN MEDIA FULL WIDTH (no caps)
     ========================== */

  /* Make the wrapper always full width */
  .product.itm-product-wrapper .product__media-wrapper {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Remove Dawn’s internal width styling */
  .product__media-wrapper[style] {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* ==========================
     MEDIA SLIDES: FORCE FULL WIDTH
     ========================== */

  /* Ensures all slides in the gallery expand to the full media column width */
  .product.itm-product-wrapper .product__media-list {
    width: 100% !important;
  }

  .product.itm-product-wrapper .product__media-list.slider--mobile {
    grid-auto-columns: 100% !important; /* each slide = full width */
  }

  .product.itm-product-wrapper .product__media-item.slider__slide {
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
  }

  /* Match placeholder footprint to real product images in the main gallery */
  .product.itm-product-wrapper .product__media-wrapper .product__media img {
    width: 100% !important;
    height: auto !important;
    object-fit: contain;
    display: block;
  }

  /* Keep CDN fallback placeholder the same visual size as normal product media */
  .product.itm-product-wrapper .product__media-wrapper img.cdn-fallback-image {
    width: 100% !important;
    max-width: 100% !important;
    height: 100% !important;
    object-fit: contain;
    display: block;
  }

  /* ==========================
     CDN IMAGE GRID (left, full-bleed, 1px hairlines)
     ========================== */
  #shopify-section-{{ section.id }} .itm-pdp-mediagrid {
    display: grid;
    grid-template-columns: repeat(var(--pdp-img-cols, 2), 1fr);
    background: transparent;
    border-top: 1px solid #d0d0d0;
    border-left: 1px solid #d0d0d0;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .itm-pdp-mediacell {
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    aspect-ratio: var(--pdp-img-ratio, 1 / 1);
    overflow: hidden;
    box-sizing: border-box;
    background: {{ section.settings.image_cell_bg | default: section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background }};
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .itm-pdp-mediaimg {
    width: 100%;
    height: 100%;
    object-fit: var(--pdp-img-fit, contain);
    display: block;
    mix-blend-mode: multiply;
  }
  /* A single image (others 404'd and were removed) fills the whole width */
  #shopify-section-{{ section.id }} .itm-pdp-mediacell:only-child { grid-column: 1 / -1; }

  /* Hover zoom — only on devices that actually hover (desktop) */
  @media (hover: hover) {
    #shopify-section-{{ section.id }} .itm-pdp-mediaimg {
      transition: transform 0.45s ease;
    }
    #shopify-section-{{ section.id }} .itm-pdp-mediacell:hover .itm-pdp-mediaimg {
      transform: scale(1.09);
    }
  }

  /* Dots hidden on desktop (grid mode) */
  #shopify-section-{{ section.id }} .itm-pdp-dots { display: none; }

  /* ==========================
     MOBILE: one-image-at-a-time swipe slider + dots
     ========================== */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .itm-pdp-mediagrid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      border-top: 0;
      border-left: 0;
    }
    #shopify-section-{{ section.id }} .itm-pdp-mediagrid::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .itm-pdp-mediacell {
      flex: 0 0 100%;
      scroll-snap-align: center;
      border-right: 0;
      border-bottom: 0;
    }
    #shopify-section-{{ section.id }} .itm-pdp-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 12px 0 2px;
    }
    #shopify-section-{{ section.id }} .itm-pdp-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 0;
      padding: 0;
      background: #cdcdcd;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    #shopify-section-{{ section.id }} .itm-pdp-dot.is-active {
      background: {{ section.settings.image_dot_active_color | default: '#1a1a1a' }};
      transform: scale(1.2);
    }
  }

  /* Lightbox */
  .itm-lb {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 20000;
    background: rgba(0,0,0,0.92);
    align-items: center;
    justify-content: center;
  }
  .itm-lb.is-open { display: flex; }
  .itm-lb__img-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 90vw;
    max-height: 90vh;
    background: #ffffff;
    border-radius: 8px;
    padding: 24px;
  }
  .itm-lb__img {
    max-width: calc(90vw - 48px);
    max-height: calc(90vh - 48px);
    object-fit: contain;
    display: block;
    mix-blend-mode: multiply;
  }
  .itm-lb__close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    color: #fff;
    font-size: 36px;
    line-height: 1;
    cursor: pointer;
    padding: 8px;
    z-index: 20001;
    opacity: 0.85;
    transition: opacity 0.15s;
  }
  .itm-lb__close:hover { opacity: 1; }
  .itm-lb__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    font-size: 40px;
    line-height: 1;
    cursor: pointer;
    padding: 12px 18px;
    border-radius: 4px;
    z-index: 20001;
    transition: background 0.2s;
  }
  .itm-lb__arrow:hover { background: rgba(255,255,255,0.25); }
  .itm-lb__arrow--prev { left: 16px; }
  .itm-lb__arrow--next { right: 16px; }
  .itm-lb__counter {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.65);
    font-size: 13px;
    white-space: nowrap;
  }
  @media (max-width: 749px) {
    .itm-lb__arrow--prev { left: 8px; padding: 10px 14px; }
    .itm-lb__arrow--next { right: 8px; padding: 10px 14px; }
  }

  /* ==========================
     INFO COLUMN: alignment + padding + typography (customizable)
     ========================== */
  #shopify-section-{{ section.id }} .itm-product-col--info {
    text-align: {{ section.settings.info_align | default: 'left' }};
    padding: {{ section.settings.info_pad_top | default: 12 }}px {{ section.settings.info_pad_right | default: 40 }}px {{ section.settings.info_pad_bottom | default: 24 }}px {{ section.settings.info_pad_left | default: 24 }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .itm-product-col--info {
      padding: {{ section.settings.info_mobile_pad_top | default: section.settings.info_pad_top | default: 12 }}px {{ section.settings.info_mobile_pad_right | default: section.settings.info_pad_right | default: 16 }}px {{ section.settings.info_mobile_pad_bottom | default: section.settings.info_pad_bottom | default: 24 }}px {{ section.settings.info_mobile_pad_left | default: section.settings.info_pad_left | default: 16 }}px;
    }
  }
  {%- if section.settings.info_align == 'center' -%}
    #shopify-section-{{ section.id }} .itm-product-col--info .itm-product-detail-columns,
    #shopify-section-{{ section.id }} .itm-product-col--info .product__info-container { align-items: center; }
  {%- elsif section.settings.info_align == 'right' -%}
    #shopify-section-{{ section.id }} .itm-product-col--info .itm-product-detail-columns,
    #shopify-section-{{ section.id }} .itm-product-col--info .product__info-container { align-items: flex-end; }
  {%- endif -%}
  /* Heading */
  #shopify-section-{{ section.id }} .itm-product-title-row h2 {
    font-size: {{ section.settings.heading_size | default: 28 }}px;
    color: {{ section.settings.heading_color | default: '#1a1a1a' }};
  }
  /* Reviews / rating */
  #shopify-section-{{ section.id }} .itm-product-col--info .rating,
  #shopify-section-{{ section.id }} .itm-product-col--info .jdgm-prev-badge { font-size: {{ section.settings.reviews_size | default: 14 }}px; }
  /* Body text + description */
  #shopify-section-{{ section.id }} .itm-product-col--info .product__text,
  #shopify-section-{{ section.id }} .itm-product-col--info .product__description {
    font-size: {{ section.settings.body_size | default: 15 }}px;
    color: {{ section.settings.body_color | default: '#333333' }};
  }
  /* If the description's first line is bold on its own (a NetSuite-style intro
     line), style it like a small heading. Does nothing when there isn't one. */
  #shopify-section-{{ section.id }} .itm-product-col--info .product__description > p:first-child > strong:only-child,
  #shopify-section-{{ section.id }} .itm-product-col--info .product__description > p:first-child > b:only-child {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 1.2em;
    line-height: 1.3;
    margin-bottom: 0.4em;
  }
  /* Price */
  #shopify-section-{{ section.id }} .itm-product-col--info .price {
    font-size: {{ section.settings.price_size | default: 22 }}px;
    color: {{ section.settings.price_color | default: '#1a1a1a' }};
  }
  /* Add to cart button */
  #shopify-section-{{ section.id }} .itm-product-col--info .product-form__submit {
    font-size: {{ section.settings.atc_size | default: 15 }}px;
    background: {{ section.settings.atc_bg | default: '#e30613' }};
    color: {{ section.settings.atc_color | default: '#000000' }};
  }
  /* SKU / Product code */
  #shopify-section-{{ section.id }} .itm-product-col--info .product__sku {
    font-size: {{ section.settings.sku_size | default: 13 }}px;
    color: {{ section.settings.sku_color | default: '#666666' }};
  }
  /* Guarantee rows (Free shipping / warranty) */
  #shopify-section-{{ section.id }} .itm-product-col--info .pg__hero-share-note-text {
    font-size: {{ section.settings.guarantee_size | default: 13 }}px;
    color: {{ section.settings.guarantee_color | default: '#333333' }};
  }

  /* ITM trust block (bottom of product info) */
  #shopify-section-{{ section.id }} .itm-trust {
    display: flex;
    flex-direction: {% if section.settings.trust_layout == 'vertical' %}column{% else %}row{% endif %};
    flex-wrap: {% if section.settings.trust_layout == 'vertical' %}wrap{% else %}nowrap{% endif %};
    align-items: stretch;
    gap: {{ section.settings.trust_row_gap | default: 14 }}px;
    margin-top: {{ section.settings.trust_margin_top | default: 8 }}px;
    margin-bottom: {{ section.settings.trust_margin_bottom | default: 0 }}px;
  }
  #shopify-section-{{ section.id }} .itm-trust__row {
    display: flex;
    gap: {{ section.settings.trust_icon_gap | default: 8 }}px;
    {%- if section.settings.trust_layout == 'vertical' -%}
    align-items: center;
    {%- else -%}
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
    {%- endif -%}
  }
  {%- if section.settings.trust_layout != 'vertical' -%}
  #shopify-section-{{ section.id }} .itm-trust__text { align-items: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .itm-trust__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Scales up on wider screens: = setting at ~1440px, grows beyond, capped at 2x,
       never below the setting on smaller screens. */
    width: clamp({{ section.settings.trust_icon_size | default: 36 }}px, calc({{ section.settings.trust_icon_size | default: 36 }}px + (100vw - 1440px) * 0.025), {{ section.settings.trust_icon_size | default: 36 | times: 2 }}px);
    height: clamp({{ section.settings.trust_icon_size | default: 36 }}px, calc({{ section.settings.trust_icon_size | default: 36 }}px + (100vw - 1440px) * 0.025), {{ section.settings.trust_icon_size | default: 36 | times: 2 }}px);
    color: {{ section.settings.trust_icon_color | default: '#1a1a1a' }};
  }
  #shopify-section-{{ section.id }} .itm-trust__icon svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .itm-trust__icon img { width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ section.id }} .itm-trust__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  #shopify-section-{{ section.id }} .itm-trust__heading {
    font-family: var(--font-body-family);
    font-size: clamp({{ section.settings.trust_heading_size | default: 14 }}px, calc({{ section.settings.trust_heading_size | default: 14 }}px + (100vw - 1440px) * 0.006), {{ section.settings.trust_heading_size | default: 14 | times: 1.7 | round }}px);
    font-weight: {% if section.settings.trust_heading_bold %}700{% else %}400{% endif %};
    line-height: 1.25;
    color: {{ section.settings.trust_color | default: '#1a1a1a' }};
  }
  #shopify-section-{{ section.id }} .itm-trust__sub {
    font-family: var(--font-body-family);
    font-size: clamp({{ section.settings.trust_text_size | default: 13 }}px, calc({{ section.settings.trust_text_size | default: 13 }}px + (100vw - 1440px) * 0.005), {{ section.settings.trust_text_size | default: 13 | times: 1.7 | round }}px);
    font-weight: {% if section.settings.trust_sub_bold %}600{% else %}400{% endif %};
    line-height: 1.3;
    color: {{ section.settings.trust_sub_color | default: '#666666' }};
  }
  {%- if section.settings.trust_layout != 'vertical' -%}
  /* Short vertical 1px divider centered in the gap between trust items */
  #shopify-section-{{ section.id }} .itm-trust__row { position: relative; }
  #shopify-section-{{ section.id }} .itm-trust__row + .itm-trust__row::before {
    content: '';
    position: absolute;
    left: calc(-1 * {{ section.settings.trust_row_gap | default: 14 }}px / 2);
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: {{ section.settings.trust_divider_height | default: 55 }}%;
    background: {{ section.settings.trust_divider_color | default: '#d0d0d0' }};
  }
  {%- endif -%}

  /* Left-align the dynamic-checkout "More payment options" link */
  #shopify-section-{{ section.id }} .shopify-payment-button__more-options {
    text-align: left;
    margin-left: 0;
    margin-right: auto;
  }

  /* Features / Specifications accordions under the trust block */
  #shopify-section-{{ section.id }} .itm-info-accordions {
    margin-top: {{ section.settings.info_accordions_margin_top | default: 16 }}px;
  }
  #shopify-section-{{ section.id }} .itm-info-accordions .product__accordion + .product__accordion { margin-top: 0; }
  /* Accordion title styling */
  #shopify-section-{{ section.id }} .itm-info-accordions .itm-acc-title {
    font-size: {{ section.settings.acc_title_size | default: 16 }}px;
    font-weight: {% if section.settings.acc_title_bold %}700{% else %}400{% endif %};
    color: {{ section.settings.acc_title_color | default: '#1a1a1a' }};
  }
  /* Accordion body content styling */
  #shopify-section-{{ section.id }} .itm-info-accordions .itm-acc-content {
    font-size: {{ section.settings.acc_content_size | default: 14 }}px;
    color: {{ section.settings.acc_content_color | default: '#333333' }};
  }

  /* ==========================
     PER-ITEM SPACING (absolute) — the slider value IS the gap below each item.
     0 = items touch. The theme's own top-margins on these items are zeroed so
     the slider fully controls the spacing.
     ========================== */
  #shopify-section-{{ section.id }} .itm-pdp-breadcrumb,
  #shopify-section-{{ section.id }} .itm-product-title-row,
  #shopify-section-{{ section.id }} .itm-product-col--info .product__sku,
  #shopify-section-{{ section.id }} .itm-product-col--info .rating-wrapper,
  #shopify-section-{{ section.id }} .itm-product-col--info .jdgm-prev-badge,
  #shopify-section-{{ section.id }} .itm-product-col--info .product__text,
  #shopify-section-{{ section.id }} .itm-product-col--info .product__description,
  #shopify-section-{{ section.id }} .itm-product-col--info [id^="price-"],
  #shopify-section-{{ section.id }} .itm-product-col--info .itm-qty-atc-row,
  #shopify-section-{{ section.id }} .itm-product-col--info .product-form__buttons,
  #shopify-section-{{ section.id }} .itm-product-col--info .pg__hero-share-notes {
    margin-top: 0;
  }
  #shopify-section-{{ section.id }} .itm-pdp-breadcrumb { margin-bottom: {{ section.settings.sp_breadcrumb }}px; }
  #shopify-section-{{ section.id }} .itm-pdp-breadcrumb .breadcrumbs {
    padding-top: {{ section.settings.pad_breadcrumb_top | default: 12 }}px;
    padding-bottom: {{ section.settings.pad_breadcrumb_bottom | default: 12 }}px;
  }
  #shopify-section-{{ section.id }} .itm-product-title-row { margin-bottom: {{ section.settings.sp_title }}px; }
  #shopify-section-{{ section.id }} .itm-product-col--info .product__sku { margin-bottom: {{ section.settings.sp_sku }}px; }
  #shopify-section-{{ section.id }} .itm-product-col--info .rating-wrapper,
  #shopify-section-{{ section.id }} .itm-product-col--info .jdgm-prev-badge { margin-bottom: {{ section.settings.sp_reviews }}px; }
  #shopify-section-{{ section.id }} .itm-product-col--info .product__text,
  #shopify-section-{{ section.id }} .itm-product-col--info .product__description { margin-bottom: {{ section.settings.sp_body }}px; }
  #shopify-section-{{ section.id }} .itm-product-col--info [id^="price-"] { margin-bottom: {{ section.settings.sp_price }}px; }
  #shopify-section-{{ section.id }} .itm-product-col--info .itm-qty-atc-row,
  #shopify-section-{{ section.id }} .itm-product-col--info .product-form__buttons { margin-bottom: {{ section.settings.sp_purchase }}px; }
  #shopify-section-{{ section.id }} .itm-product-col--info .pg__hero-share-notes { margin-bottom: {{ section.settings.sp_guarantee }}px; }

  {%- if section.settings.enable_sticky_info -%}
  @media screen and (min-width: 990px) {
    /* Sticky info: the whole info column stays while the image grid scrolls, and
       releases at the grid bottom. Offset by the header height so it doesn't slide
       behind the header. Note: the buy box is intentionally NOT independently sticky —
       it scrolls with the column so it can't overlap the trust block / accordions. */
    .itm-product-grid > .itm-product-col--info {
      position: sticky;
      top: calc(var(--header-height, 100px) + {{ section.settings.info_sticky_top | default: 20 }}px);
      align-self: start;
    }
  }
  {%- endif -%}

  .thumbnail__badge {
    bottom: 4px;
    right: 4px;
  }

  .share-button__button {
    margin-left: 5px;
  }

  .pg__hero-share-note {
    display: flex;
    align-items: stretch;
    gap: 0.8rem;
    margin-top: 0;
    color: rgba(var(--color-foreground), 0.85);
    font-size: var(--pg-share-note-size, 1.4rem);
    line-height: 1.4;
  }

  .pg__hero-share-note-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    color: rgba(var(--color-foreground), 0.85);
    align-self: stretch;
  }

  .pg__hero-share-note-icon svg {
    width: auto;
    height: 100%;
    min-height: 1.8rem;
    max-height: 4.2rem;
    display: block;
  }

  .pg__hero-share-note-text {
    display: block;
  }

  .pg__hero-share-notes {
    margin-top: 0;
  }

  .pg__hero-share-notes .pg__hero-share-note {
    margin-top: 0;
  }

  .pg__hero-share-notes .pg__hero-share-note + .pg__hero-share-note {
    margin-top: 0.4rem;
  }

  .itm-price-block--bold .price .price-item,
  .itm-price-block--bold .price__regular .price-item--regular,
  .itm-price-block--bold .price__sale .price-item--sale,
  .itm-price-block--bold .price__sale .price-item--last {
    font-weight: 700;
  }

  .itm-payment-options-grid .accordion__content {
    display: grid;
    gap: 1.2rem;
  }

  .itm-payment-options-grid__extra {
    display: grid;
    gap: 1rem;
  }

  .itm-payment-options-grid__terms {
    margin: 0;
  }

  .itm-payment-options-grid__terms .shopify-installments {
    margin: 0;
  }

  .itm-payment-options-grid__apps {
    display: grid;
    gap: 1.2rem;
  }

  .pg__hero-aside-item {
    margin-top: 0;
  }

  .pg__hero-ctas .rte > * {
    margin-top: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .pg__hero-ctas .rte > *:first-child {
    margin-top: 0;
  }

  .pg__hero-ctas .rte > *:last-child {
    margin-bottom: 0;
  }

  /* Custom inline ATC row: quantity selector + add to cart button side by side */
  .itm-qty-atc-row {
    display: flex;
    align-items: flex-end;
    gap: {{ section.settings.qty_btn_gap | default: 0 }}px;
  }

  .itm-qty-atc-row .product-form__input {
    flex: 0 0 auto;
    margin: 0;
  }

  /* Reduce quantity stepper width from Dawn's default 14rem */
  .itm-qty-atc-row .quantity {
    width: calc(10rem / var(--font-body-scale) + var(--inputs-border-width) * 2);
  }
  .itm-qty-atc-row .quantity__button {
    width: calc(3rem / var(--font-body-scale));
  }

  /* Custom ATC button fills remaining space */
  .itm-custom-atc-btn {
    flex: 1;
    max-width: none !important;
    margin: 0 !important;
    background-color: {{ section.settings.atc_bg | default: '#e30613' }};
    color: {{ section.settings.atc_color | default: '#000000' }};
    font-size: {{ section.settings.atc_size | default: 12 }}px;
    border-color: transparent;
  }
  .itm-custom-atc-btn:hover {
    background-color: {{ section.settings.atc_bg | default: '#e30613' }};
    filter: brightness(0.92);
  }
  .itm-custom-atc-btn[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.5;
  }
  /* Overlap button 1px left over quantity's right border so there's one line at the junction, not two.
     Button renders on top (later in DOM), its background covers the quantity's right shadow,
     and its own ::after left shadow becomes the single 1px border at the join. */
  .itm-qty-atc-row .itm-custom-atc-btn {
    margin-left: calc(-1 * var(--buttons-border-width)) !important;
    z-index: 1;
  }
  /* Override ::after box-shadow border to use the custom border colour */
  .itm-custom-atc-btn::after {
    box-shadow: 0 0 0 var(--buttons-border-width) {{ section.settings.atc_border_color | default: '#000000' }};
  }

  /* Hide taxes/shipping text — user requested removal */
  #shopify-section-{{ section.id }} .product__tax {
    display: none;
  }

  /* Buy buttons block — force all containers to fill full width.
     product-form custom element defaults to display:inline; shopify-payment-button also needs explicit width.
     Note: inline_with_quantity:false means .product-form__inline-item--buttons never exists — target directly. */
  #shopify-section-{{ section.id }} product-form,
  #shopify-section-{{ section.id }} .product-form .form {
    display: block;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .product-form__buttons {
    max-width: none !important;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .shopify-payment-button,
  #shopify-section-{{ section.id }} .shopify-payment-button__button {
    width: 100% !important;
    max-width: none !important;
  }
  /* Match Buy with Shop / Shop Pay button height to ATC button */
  #shopify-section-{{ section.id }} .shopify-payment-button__button {
    min-height: calc(4.5rem + var(--buttons-border-width) * 2) !important;
  }

  /* Hide the native ATC submit button (keep it in DOM so JS can click it) */
  #shopify-section-{{ section.id }} .product-form__submit {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .itm-qty-atc-row {
      margin-left: calc(-1 * var(--page-width-margin, 1.5rem));
      margin-right: calc(-1 * var(--page-width-margin, 1.5rem));
      gap: 0;
    }
    .itm-qty-atc-row .product-form__input {
      padding-left: var(--page-width-margin, 1.5rem);
    }
    .itm-custom-atc-btn {
      border-radius: 0;
    }
    /* Smaller quantity stepper on mobile */
    .itm-qty-atc-row .quantity {
      width: calc(8rem / var(--font-body-scale) + var(--inputs-border-width) * 2);
      min-height: calc((var(--inputs-border-width) * 2) + 3.8rem);
    }
    .itm-qty-atc-row .quantity__button {
      width: calc(2.6rem / var(--font-body-scale));
    }
    /* Match ATC button height to the mobile quantity stepper (3.8rem not Dawn's default 4.5rem) */
    .itm-qty-atc-row .itm-custom-atc-btn {
      min-height: unset;
      height: calc((var(--inputs-border-width) * 2) + 3.8rem);
    }
  }

  /* pickup-availability below the atc row */
  .itm-qty-atc-row + pickup-availability {
    display: block;
    margin-top: 8px;
  }

  .pg__hero-aside-item .product__description {
    margin-top: 0;
  }

    /* ================================
     LIGHTBOX / PRODUCT MEDIA MODAL
     ================================ */

  /* 3. Put the modal above the header/menu */
  .product-media-modal {
    z-index: 10000;
    transition: opacity 0.3s ease-in-out !important;
  }

  .product-media-modal[open] {
    background-color: rgba(0, 0, 0, 0.85) !important;
  }

  .product-media-modal__dialog {
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 16px 16px;
    box-sizing: border-box;
    min-height: 100vh;
    transition: transform 0.3s ease-out, opacity 0.3s ease-out !important;
  }

  .product-media-modal__content {
    z-index: 10002;
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    margin: 0 auto;
    overflow: visible !important;
    padding: 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Media inside the modal should scale to 100% unless it exceeds viewport */
  .product-media-modal .product__media {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;
  }

  .product-media-modal .product__media img,
  .product-media-modal .product__media video {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* 2. Only show the active slide so they don’t stack */
  .product-media-modal .product__media-item:not(.is-active) {
    display: none;
  }

  .product__sku {
    text-align: left !important;
  }

  /* Enhanced modal controls */
  .product-media-modal__content > *:not(.active) {
    display: none !important;
  }

  .product-media-modal__content > .active {
    display: flex !important;
    align-items: center;
    justify-content: center;
    margin: 0 !important;
    transition: opacity 0.15s ease-in-out;
  }

  /* Navigation arrows */
  .product-media-modal__arrow {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10003;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .product-media-modal__arrow:hover {
    background: rgba(255, 255, 255, 1);
  }

  .product-media-modal__arrow--prev {
    left: 20px;
  }

  .product-media-modal__arrow--next {
    right: 20px;
  }

  .product-media-modal__arrow svg {
    width: 20px;
    height: 20px;
    fill: rgba(0, 0, 0, 0.8);
  }

  .product-media-modal__arrow--prev svg {
    transform: rotate(90deg);
  }

  .product-media-modal__arrow--next svg {
    transform: rotate(-90deg);
  }

  @media screen and (max-width: 749px) {
    .product-media-modal__arrow {
      width: 40px;
      height: 40px;
    }
    .product-media-modal__arrow--prev {
      left: 10px;
    }
    .product-media-modal__arrow--next {
      right: 10px;
    }
  }

  /* Image counter */
  .product-media-modal__counter {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
    z-index: 10004;
    pointer-events: none;
  }

  /* Improve close button visibility */
  .product-media-modal__toggle {
    position: fixed !important;
    top: 20px !important;
    right: 20px !important;
    background: rgba(255, 255, 255, 0.9) !important;
    border: none !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: background 0.2s !important;
    z-index: 10005 !important;
    pointer-events: auto !important;
  }

  .product-media-modal__toggle:hover {
    background: rgba(255, 255, 255, 1) !important;
  }

  .product-media-modal__toggle svg {
    width: 20px;
    height: 20px;
    fill: rgba(0, 0, 0, 0.8);
    pointer-events: none;
  }

  /* Price + SKU on same line */
  .itm-price-sku-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .itm-price-sku-row .product__sku {
    margin: 0;
    flex-shrink: 0;
    text-align: right;
  }

  /* Reviews + stock status row */
  .itm-reviews-stock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .itm-reviews-stock-row .product__inventory {
    margin: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Ping animation on the green in-stock dot */
  @keyframes itm-ping {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.8); opacity: 0.3; }
  }
  .product__inventory .svg-wrapper svg {
    animation: itm-ping 2.4s ease-in-out infinite;
    transform-origin: center;
    display: block;
  }

  /* ---- Font normalisation ---- */

  /* In stock — Dawn's caption-with-letter-spacing/subtitle utility classes force small sizes.
     Reset those inside the reviews row so it matches the reviews text exactly. */
  .itm-reviews-stock-row .product__inventory,
  .itm-reviews-stock-row .product__inventory.caption-with-letter-spacing,
  .itm-reviews-stock-row .product__inventory.subtitle {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    font-size: {{ section.settings.reviews_size | default: 14 }}px;
    letter-spacing: normal;
    text-transform: none;
  }

  /* SKU, quantity label, payment text — all should inherit the body font */
  #shopify-section-{{ section.id }} .itm-product-col--info .product__sku,
  #shopify-section-{{ section.id }} .itm-product-col--info .product-form__label,
  #shopify-section-{{ section.id }} .itm-product-col--info .quantity__label {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
  }

  /* Hide the visible "Quantity" label above the selector (kept accessible to
     screen readers via clip so the input keeps its accessible name). */
  #shopify-section-{{ section.id }} .itm-qty-atc-row .quantity__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Afterpay placement widget — not an iframe so we can push the theme font onto it */
  afterpay-placement,
  .afterpay-paragraph,
  .afterpay-paragraph * {
    font-family: var(--font-body-family) !important;
    font-size: {{ section.settings.body_size | default: 15 }}px !important;
    font-style: var(--font-body-style) !important;
  }

  /* ==========================
     Combined "Pay in 4" line (custom — replaces the PayPal + Afterpay widgets)
     ========================== */
  #shopify-section-{{ section.id }} .itm-pay-in-4 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: {{ section.settings.payin4_gap | default: 8 }}px;
    margin: {{ section.settings.payin4_margin_top | default: 12 }}px 0 {{ section.settings.payin4_margin_bottom | default: 12 }}px;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.payin4_font_size | default: 13 }}px;
    line-height: 1.2;
    color: {{ section.settings.payin4_color | default: '#000000' }};
  }
  #shopify-section-{{ section.id }} .itm-pay-in-4__logo {
    display: block;
    width: auto;
  }
  #shopify-section-{{ section.id }} .itm-pay-in-4__logo--paypal {
    height: {{ section.settings.payin4_paypal_height | default: 18 }}px;
  }
  #shopify-section-{{ section.id }} .itm-pay-in-4__logo--afterpay {
    height: {{ section.settings.payin4_afterpay_height | default: 22 }}px;
  }

  /* Price & SKU padding (desktop) */
  #shopify-section-{{ section.id }} .itm-product-col--info [id^="price-"] {
    padding-top: {{ section.settings.price_pad_top | default: 0 }}px;
    padding-bottom: {{ section.settings.price_pad_bottom | default: 0 }}px;
  }
  #shopify-section-{{ section.id }} .itm-product-col--info .product__sku {
    padding-top: {{ section.settings.sku_pad_top | default: 0 }}px;
    padding-bottom: {{ section.settings.sku_pad_bottom | default: 0 }}px;
  }

  /* Hide the standalone PayPal Pay Later message (app embed iframe) now that
     its info lives in the combined line above. */
  #shopify-section-{{ section.id }} [data-pp-message],
  #shopify-section-{{ section.id }} .paypal-installment-banner {
    display: none !important;
  }

  /* Mobile inventory above title — hidden on desktop */
  .itm-inv-above-title { display: none; }

  @media screen and (max-width: 749px) {
    /* Zero the hardcoded flex gap so sp_ sliders fully control spacing */
    #shopify-section-{{ section.id }} .itm-product-col--info { gap: 0; }
    #shopify-section-{{ section.id }} .itm-product-detail-columns { gap: 0; }
    #shopify-section-{{ section.id }} .product__info-container > * + * { margin-top: 0; margin-bottom: 0; }

    /* Show In Stock above product title, hide it inside the reviews row */
    .itm-inv-above-title {
      display: block;
      margin-bottom: 4px;
    }
    .itm-reviews-stock-row .product__inventory { display: none; }

    /* Mobile font size overrides */
    {%- if section.settings.mob_heading_size > 0 -%}
    #shopify-section-{{ section.id }} .itm-product-title-row h2 { font-size: {{ section.settings.mob_heading_size }}px; }
    {%- endif -%}
    {%- if section.settings.mob_reviews_size > 0 -%}
    #shopify-section-{{ section.id }} .itm-product-col--info .jdgm-prev-badge,
    #shopify-section-{{ section.id }} .itm-product-col--info .jdgm-prev-badge * { font-size: {{ section.settings.mob_reviews_size }}px; }
    {%- endif -%}
    {%- if section.settings.mob_inv_size > 0 -%}
    #shopify-section-{{ section.id }} .product__inventory,
    #shopify-section-{{ section.id }} .itm-inv-mobile-copy { font-size: {{ section.settings.mob_inv_size }}px; }
    {%- endif -%}
    {%- if section.settings.mob_sku_size > 0 -%}
    #shopify-section-{{ section.id }} .itm-product-col--info .product__sku { font-size: {{ section.settings.mob_sku_size }}px; }
    {%- endif -%}
    {%- if section.settings.mob_price_size > 0 -%}
    #shopify-section-{{ section.id }} .itm-product-col--info .price { font-size: {{ section.settings.mob_price_size }}px; }
    {%- endif -%}
    {%- if section.settings.mob_body_size > 0 -%}
    #shopify-section-{{ section.id }} .itm-product-col--info .product__text,
    #shopify-section-{{ section.id }} .itm-product-col--info .product__description { font-size: {{ section.settings.mob_body_size }}px; }
    {%- endif -%}
    {%- if section.settings.mob_atc_size > 0 -%}
    #shopify-section-{{ section.id }} .itm-custom-atc-btn { font-size: {{ section.settings.mob_atc_size }}px; }
    {%- endif -%}

    /* Mobile-only padding above/below the reviews badge */
    #shopify-section-{{ section.id }} .itm-product-col--info .itm-reviews-stock-row,
    #shopify-section-{{ section.id }} .itm-product-col--info .rating-wrapper,
    #shopify-section-{{ section.id }} .itm-product-col--info .jdgm-prev-badge {
      padding-top: {{ section.settings.mob_reviews_pad_top | default: 0 }}px;
      padding-bottom: {{ section.settings.mob_reviews_pad_bottom | default: 0 }}px;
    }

    /* Mobile-only padding above/below the Pay in 4 line */
    #shopify-section-{{ section.id }} .itm-pay-in-4 {
      padding-top: {{ section.settings.payin4_mob_pad_top | default: 0 }}px;
      padding-bottom: {{ section.settings.payin4_mob_pad_bottom | default: 0 }}px;
    }

    /* Mobile-only padding above/below the price */
    #shopify-section-{{ section.id }} .itm-product-col--info [id^="price-"] {
      padding-top: {{ section.settings.price_mob_pad_top | default: 0 }}px;
      padding-bottom: {{ section.settings.price_mob_pad_bottom | default: 0 }}px;
    }

    /* Mobile-only padding above/below the SKU */
    #shopify-section-{{ section.id }} .itm-product-col--info .product__sku {
      padding-top: {{ section.settings.sku_mob_pad_top | default: 0 }}px;
      padding-bottom: {{ section.settings.sku_mob_pad_bottom | default: 0 }}px;
    }

    /* Mobile-only padding below the quantity / add-to-cart row */
    #shopify-section-{{ section.id }} .itm-product-col--info .itm-qty-atc-row,
    #shopify-section-{{ section.id }} .itm-product-col--info .product-form__buttons {
      padding-bottom: {{ section.settings.mob_pad_purchase_bottom | default: 0 }}px;
    }
  }

  /* ── Static rating (store-wide, gold stars — matches the Judge.me widget look) ── */
  .itm-static-rating {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .itm-static-rating-stars {
    position: relative;
    display: inline-block;
    font-family: Times, serif;
    font-size: 1.7rem;
    letter-spacing: 0.1rem;
    line-height: 1;
    white-space: nowrap;
  }
  .itm-static-rating-stars__bg {
    display: block;
    color: rgba(60, 60, 60, 0.2);
  }
  .itm-static-rating-stars__fill {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    overflow: hidden;
    white-space: nowrap;
    color: #e30613;
  }
  .itm-static-rating-text {
    margin: 0;
    font-size: 1.4rem;
  }

  /* ── Bundle contents (2x2 image + text grid) ── */
  .itm-bundle-contents {
    margin: 1.6rem 0;
  }
  .itm-bundle-contents__heading {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    margin: 0 0 1.2rem;
  }
  .itm-bundle-contents__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .itm-bundle-contents__item {
    text-align: center;
  }
  .itm-bundle-contents__img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 0;
  }
  .itm-bundle-contents__text {
    margin: 0.6rem 0 0;
    font-size: 1.3rem;
    font-weight: 600;
  }

  /* ── Sharpens icons ── */
  /* ── Sharpens icons ── */
  .itm-sharpens {
    margin: 1.2rem 0 0;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
  }
  .itm-sharpens__label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.55;
    margin: 0 0 10px;
  }
  .itm-sharpens__icons--desktop { display: grid; grid-template-columns: repeat(7, 1fr); }
  .itm-sharpens__icons--mobile  { display: none; }
  .itm-sharpens__slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 7px;
    padding: 12px 4px;
    min-height: 82px;
  }
  .itm-sharpens__slot:not(:first-child) {
    border-left: 1px solid rgba(var(--color-foreground), 0.12);
  }
  .itm-sharpens__slot:not(.itm-sharpens__slot--active) {
    opacity: 0.2;
    filter: grayscale(1);
  }
  .itm-sharpens__slot img {
    width: 52px;
    height: 52px;
    object-fit: contain;
    display: block;
  }
