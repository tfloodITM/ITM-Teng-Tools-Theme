    <script>
    (function() {
      document.querySelectorAll('[data-atc-form]').forEach(function(customBtn) {
        var formId = customBtn.dataset.atcForm;
        var nativeBtn = document.querySelector('#' + formId + ' [type="submit"]');
        if (!nativeBtn) return;

        function syncState() {
          var disabled = nativeBtn.getAttribute('aria-disabled') === 'true' || nativeBtn.disabled;
          customBtn.setAttribute('aria-disabled', disabled ? 'true' : 'false');
        }
        syncState();
        new MutationObserver(syncState).observe(nativeBtn, { attributes: true });

        customBtn.addEventListener('click', function() {
          if (customBtn.getAttribute('aria-disabled') !== 'true') {
            nativeBtn.click();
          }
        });
      });

      /* Sync mobile inventory copy (above title) when variant changes */
      (function() {
        var source = document.getElementById('Inventory-{{ section.id }}');
        var copy = document.querySelector('#itm-inv-mobile-copy-{{ section.id }} .itm-inv-mobile-copy');
        if (!source || !copy) return;
        new MutationObserver(function() {
          copy.innerHTML = source.innerHTML;
          if (source.classList.contains('visibility-hidden')) {
            copy.classList.add('visibility-hidden');
          } else {
            copy.classList.remove('visibility-hidden');
          }
        }).observe(source, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
      })();

      /* JS fallback: move inventory next to reviews badge if Liquid co-render didn't run */
      (function() {
        var inv = document.getElementById('Inventory-{{ section.id }}');
        if (!inv) return;
        if (inv.closest('.itm-reviews-stock-row')) return;

        function tryMove() {
          var sec = document.getElementById('shopify-section-{{ section.id }}');
          if (!sec) return false;
          var badge = sec.querySelector('.jdgm-prev-badge, .jdgm-widget-wrapper, .jdgm-all-reviews-link');
          if (!badge) return false;
          var row = badge.closest('.itm-reviews-stock-row');
          if (!row) {
            var badgeParent = badge.parentElement;
            row = document.createElement('div');
            row.className = 'itm-reviews-stock-row';
            var wrap = document.createElement('div');
            wrap.className = 'itm-reviews-stock-row__reviews';
            badgeParent.insertBefore(row, badge);
            wrap.appendChild(badge);
            row.appendChild(wrap);
          }
          if (!row.querySelector('#Inventory-{{ section.id }}')) {
            row.appendChild(inv);
          }
          return true;
        }

        if (!tryMove()) {
          var info = document.getElementById('ProductInfo-{{ section.id }}');
          if (info) {
            var obs = new MutationObserver(function() {
              if (tryMove()) { obs.disconnect(); clearTimeout(t); }
            });
            obs.observe(info, { childList: true, subtree: true });
            var t = setTimeout(function() { obs.disconnect(); }, 6000);
          }
        }
      })();
    })();
    </script>

    {%- if product.handle == 'wsbchpaj-i' -%}
      {%- comment -%}
        Hide one specific Judge.me review on this product only (Peter S.,
        22/07/2026, "Not very strong really a cheaply made product...").
        Judge.me loads reviews asynchronously, so this watches for them
        instead of just querying once on load.
      {%- endcomment -%}
      <script>
      (function () {
        var HIDE_REVIEW_SNIPPET = 'Not very strong really a cheaply made product';

        function hideMatchingReviews(root) {
          root.querySelectorAll('.jdgm-rev:not([data-itm-hidden-checked])').forEach(function (rev) {
            rev.setAttribute('data-itm-hidden-checked', 'true');
            var body = rev.querySelector('.jdgm-rev__body');
            if (body && body.textContent.indexOf(HIDE_REVIEW_SNIPPET) !== -1) {
              rev.style.display = 'none';
            }
          });
        }

        hideMatchingReviews(document);

        var observer = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(function (node) {
              if (node.nodeType !== 1) return;
              if (node.matches && node.matches('.jdgm-rev')) hideMatchingReviews(node.parentNode || document);
              else if (node.querySelector) hideMatchingReviews(node);
            });
          });
        });
        observer.observe(document.body, { childList: true, subtree: true });

        window.addEventListener('load', function () {
          setTimeout(function () { observer.disconnect(); }, 15000);
        });
      })();
      </script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </div>
</product-info>

