                    {% liquid
                      assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                      render 'share-button', block: block, share_link: share_url
                    %}
                  </div>

              {%- when 'shipping_notes' -%}
                  {%- assign standard_shipping_note = block.settings.standard_shipping_note -%}
                  {%- assign standard_shipping_icon = block.settings.standard_shipping_icon -%}
                  {%- assign express_shipping_note = block.settings.express_shipping_note -%}
                  {%- if standard_shipping_note != blank or express_shipping_note != blank -%}
                    <div class="pg__hero-share-notes pg__hero-aside-item" style="--pg-share-note-size: {{ block.settings.shipping_note_font_size | default: 14 | divided_by: 10.0 }}rem;" {{ block.shopify_attributes }}>
                      {%- if standard_shipping_note != blank -%}
                        <div class="pg__hero-share-note">
                          {%- if standard_shipping_icon != blank -%}
                            <span class="pg__hero-share-note-icon" aria-hidden="true">
                              {{ standard_shipping_icon }}
                            </span>
                          {%- endif -%}
                          <div class="pg__hero-share-note-text">{{ standard_shipping_note | newline_to_br }}</div>
                        </div>
                      {%- endif -%}

                      {%- if express_shipping_note != blank -%}
                        <div class="pg__hero-share-note">
                          {%- if block.settings.express_shipping_icon != blank -%}
                            <span class="pg__hero-share-note-icon" aria-hidden="true">
                              {{ block.settings.express_shipping_icon }}
                            </span>
                          {%- endif -%}
                          <div class="pg__hero-share-note-text">{{ express_shipping_note | newline_to_br }}</div>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                    {%- when 'guarantee' -%}
                      {%- assign guarantee_heading = block.settings.heading | strip -%}
                      {%- assign guarantee_text = block.settings.text | strip_html | strip -%}
                      {%- if guarantee_heading != blank or guarantee_text != blank -%}
                        <div class="pg__hero-share-notes pg__hero-aside-item" style="--pg-share-note-size: 1.4rem;" {{ block.shopify_attributes }}>
                          <div class="pg__hero-share-note">
                            {%- if block.settings.icon != blank -%}
                              <span class="pg__hero-share-note-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                            {%- endif -%}
                            <div class="pg__hero-share-note-text">
                              {%- if guarantee_heading != blank -%}<strong>{{ block.settings.heading | escape }}</strong>{%- endif -%}
