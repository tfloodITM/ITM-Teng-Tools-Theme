          <div class="itm-pdp-dots" role="tablist" aria-label="Product image navigation"></div>
          <script>
          (function () {
            var root = document.getElementById('shopify-section-{{ section.id }}');
            if (!root) return;
            var grid = root.querySelector('.itm-pdp-mediagrid');
            var dots = root.querySelector('.itm-pdp-dots');
            if (!grid || !dots) return;
            var mq = window.matchMedia('(max-width: 749px)');

            function cellCount() { return grid.querySelectorAll('.itm-pdp-mediacell').length; }
            function activeIndex() {
              var w = grid.clientWidth || 1;
              return Math.round(grid.scrollLeft / w);
            }
            function setActive(i) {
              for (var k = 0; k < dots.children.length; k++) {
                dots.children[k].classList.toggle('is-active', k === i);
              }
            }
            function buildDots() {
              var n = cellCount();
              dots.innerHTML = '';
              if (!mq.matches || n <= 1) return;   /* only on mobile, only if >1 image */
              for (var i = 0; i < n; i++) {
                (function (idx) {
                  var b = document.createElement('button');
                  b.type = 'button';
                  b.className = 'itm-pdp-dot' + (idx === 0 ? ' is-active' : '');
                  b.setAttribute('aria-label', 'Go to image ' + (idx + 1));
                  b.addEventListener('click', function () {
                    grid.scrollTo({ left: grid.clientWidth * idx, behavior: 'smooth' });
                  });
                  dots.appendChild(b);
                })(i);
              }
              setActive(activeIndex());
            }

            var raf;
            grid.addEventListener('scroll', function () {
              if (raf) cancelAnimationFrame(raf);
              raf = requestAnimationFrame(function () { setActive(activeIndex()); });
            }, { passive: true });

            /* Rebuild when cells are removed by the CDN 404 cleanup, on resize, and after load */
            new MutationObserver(buildDots).observe(grid, { childList: true });
            if (mq.addEventListener) { mq.addEventListener('change', buildDots); }
            else if (mq.addListener) { mq.addListener(buildDots); }
            window.addEventListener('load', buildDots);
            buildDots();
          })();
          </script>

          <script>
          (function () {
            var root = document.getElementById('shopify-section-{{ section.id }}');
            if (!root) return;
            var grid = root.querySelector('.itm-pdp-mediagrid');
            if (!grid) return;

            /* Build lightbox and append to body so nothing in the page stacking context can interfere */
            var lb = document.createElement('div');
            lb.className = 'itm-lb';
            lb.setAttribute('role', 'dialog');
            lb.setAttribute('aria-modal', 'true');
            lb.setAttribute('tabindex', '-1');
            lb.innerHTML =
              '<button class="itm-lb__close" aria-label="Close">&#215;</button>' +
              '<button class="itm-lb__arrow itm-lb__arrow--prev" aria-label="Previous">&#8249;</button>' +
              '<button class="itm-lb__arrow itm-lb__arrow--next" aria-label="Next">&#8250;</button>' +
              '<div class="itm-lb__img-wrap"><img class="itm-lb__img" src="" alt=""></div>' +
              '<div class="itm-lb__counter"></div>';
            document.body.appendChild(lb);

            var lbImg     = lb.querySelector('.itm-lb__img');
            var lbCounter = lb.querySelector('.itm-lb__counter');
            var lbPrev    = lb.querySelector('.itm-lb__arrow--prev');
            var lbNext    = lb.querySelector('.itm-lb__arrow--next');
            var lbClose   = lb.querySelector('.itm-lb__close');
            var idx = 0;

            function imgs() { return Array.from(grid.querySelectorAll('.itm-pdp-mediaimg')); }

            function update(list) {
              lbImg.src = list[idx].src;
              lbImg.alt = list[idx].alt;
              lbCounter.textContent = (idx + 1) + ' / ' + list.length;
              lbPrev.hidden = lbNext.hidden = list.length < 2;
            }

            function open(i) {
              var list = imgs();
              if (!list.length) return;
              idx = Math.max(0, Math.min(i, list.length - 1));
              update(list);
              lb.classList.add('is-open');
              document.body.style.overflow = 'hidden';
              lb.focus();
            }

            function close() {
              lb.classList.remove('is-open');
              document.body.style.overflow = '';
            }

            function nav(dir) {
              var list = imgs();
              idx = (idx + dir + list.length) % list.length;
              update(list);
            }

            grid.addEventListener('click', function (e) {
              var cell = e.target.closest('.itm-pdp-mediacell');
              if (!cell) return;
              var list = imgs();
              open(list.indexOf(cell.querySelector('.itm-pdp-mediaimg')));
            });

            lbClose.addEventListener('click', close);
            lbPrev.addEventListener('click', function () { nav(-1); });
            lbNext.addEventListener('click', function () { nav(1); });
            lb.addEventListener('click', function (e) { if (e.target === lb) close(); });

            document.addEventListener('keydown', function (e) {
              if (!lb.classList.contains('is-open')) return;
              if (e.key === 'Escape') close();
              if (e.key === 'ArrowLeft')  nav(-1);
              if (e.key === 'ArrowRight') nav(1);
            });

            var tsX = 0;
            lb.addEventListener('touchstart', function (e) { tsX = e.touches[0].clientX; }, { passive: true });
            lb.addEventListener('touchend', function (e) {
              var dx = e.changedTouches[0].clientX - tsX;
              if (Math.abs(dx) > 50) nav(dx < 0 ? 1 : -1);
            });
          })();
          </script>
        </div>

