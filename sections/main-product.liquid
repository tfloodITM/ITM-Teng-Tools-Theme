                      {%- endif -%}

                    {%- when 'custom_liquid' -%}
                      {%- assign rendered = block.settings.custom_liquid | strip_html | strip -%}
                      {%- if rendered != '' -%}
                        <div class="pg__hero-aside-item" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
                      {%- endif -%}

                    {%- when 'popup' -%}
