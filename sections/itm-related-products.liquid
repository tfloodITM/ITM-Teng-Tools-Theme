{%- comment -%}
  ITM Related Products (self-contained)
  -------------------------------------
  Shows Search & Discovery product recommendations using the "Shop by Category"
  (sbc) card — same look as the collection grid & homepage cards. Everything
  (card markup + CSS) is inline in THIS file so there are no external snippet or
  asset dependencies to sync. Stars, Add to Cart, and Save-to-list included.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .itm-rp { overflow-x: clip; }
  #shopify-section-{{ section.id }} .page-width { max-width: none; }
  /* Desktop: full width by default — the slider adds side padding back if wanted.
     Mobile keeps Dawn's 1.5rem padding so the grid's full-bleed math still works. */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .page-width {
      padding-left: {{ section.settings.side_padding_desktop | default: 0 }}px;
      padding-right: {{ section.settings.side_padding_desktop | default: 0 }}px;
    }
  }
  #shopify-section-{{ section.id }} .itm-rp__heading { text-align: center; text-transform: uppercase; margin: 0 0 8px; font-size: 24px !important; color: #000000 !important; }
  #shopify-section-{{ section.id }} .itm-rp__heading::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    background: #e30613;
    margin: 10px auto 0;
  }

  /* ── Grid (hairline borders, full-bleed on mobile) ── */
  #shopify-section-{{ section.id }} .itm-rp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    border-top: 1px solid #d0d0d0;
    border-left: 1px solid #d0d0d0;
    width: 100%;
    margin: 12px 0 0;
    box-sizing: border-box;
    list-style: none;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .itm-rp__grid > .sbc__card {
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .itm-rp__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr);
      width: auto;
      margin: 12px -1.5rem 0;
      border-left: none;
      border-right: none;
    }
    {%- if section.settings.columns_mobile != '1' -%}
    #shopify-section-{{ section.id }} .itm-rp__grid > .sbc__card:nth-child(2n) { border-right-color: transparent; }
    {%- endif -%}
  }

  /* ── Card ── */
  #shopify-section-{{ section.id }} .sbc__card { display: flex; flex-direction: column; box-sizing: border-box; min-width: 0; background: {{ section.settings.card_img_bg }}; }
  #shopify-section-{{ section.id }} .sbc__img-wrap { position: relative; }
  #shopify-section-{{ section.id }} .sbc__card-img-link { display: block; text-decoration: none; }
  #shopify-section-{{ section.id }} .sbc__card-img { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: {{ section.settings.card_img_bg }}; }
  #shopify-section-{{ section.id }} .sbc__slide { position: absolute; inset: 0; visibility: hidden; opacity: 0; }
  #shopify-section-{{ section.id }} .sbc__slide.is-active { visibility: visible; opacity: 1; }
  #shopify-section-{{ section.id }} .sbc__slide img { width: 100%; height: 100%; object-fit: contain; object-position: center; mix-blend-mode: multiply; }
  #shopify-section-{{ section.id }} .sbc__ph-svg { width: 100%; height: 100%; opacity: 0.2; }
  #shopify-section-{{ section.id }} .sbc__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; pointer-events: none; padding: 4px; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.22)); opacity: 0.85; color: {{ section.settings.arrow_color }}; }
  #shopify-section-{{ section.id }} .sbc__prev { left: 4px; }
  #shopify-section-{{ section.id }} .sbc__next { right: 4px; }
  #shopify-section-{{ section.id }} .sbc__zone { position: absolute; top: 0; bottom: 0; width: 10%; z-index: 2; background: transparent; border: none; padding: 0; cursor: pointer; }
  #shopify-section-{{ section.id }} .sbc__zone--prev { left: 0; }
  #shopify-section-{{ section.id }} .sbc__zone--next { right: 0; }

  /* ── ATC + Save-to-list row ── */
  #shopify-section-{{ section.id }} .sbc__actions { display: flex; align-items: stretch; min-height: {{ section.settings.atc_height | default: 40 }}px; }
  #shopify-section-{{ section.id }} .sbc__atc { flex: 1; display: flex; align-items: center; justify-content: center; padding: 0 8px; border: none; font-family: var(--font-heading-family); text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; text-decoration: none; transition: filter 0.15s ease; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; background: {{ section.settings.atc_bg }}; color: {{ section.settings.atc_color }}; font-size: {{ section.settings.atc_font_size | default: 12 }}px; font-weight: {{ section.settings.atc_font_weight }}; }
  #shopify-section-{{ section.id }} .sbc__atc:hover { filter: brightness(0.85); }
  #shopify-section-{{ section.id }} .sbc__atc:disabled { opacity: 0.45; cursor: default; pointer-events: none; }
  #shopify-section-{{ section.id }} .sbc__atc-arrow { flex-shrink: 0; width: 1em; height: 1em; margin-left: 6px; stroke-width: 2.5; overflow: visible; }
  #shopify-section-{{ section.id }} .sbc__atc-divider { display: block; width: 1px; align-self: stretch; flex-shrink: 0; background: {{ section.settings.actions_divider_color }}; }
  #shopify-section-{{ section.id }} .sbc__list-btn { position: relative; display: flex; align-items: center; justify-content: center; width: 10%; min-width: 36px; text-decoration: none; flex-shrink: 0; border: none; cursor: pointer; transition: filter 0.15s ease; background: {{ section.settings.list_btn_bg }}; color: {{ section.settings.atc_color }}; }
  #shopify-section-{{ section.id }} .sbc__list-btn:hover { filter: brightness(0.85); }
  #shopify-section-{{ section.id }} .sbc__icon-wrap { position: relative; display: inline-flex; align-items: center; justify-content: center; line-height: 0; }
  #shopify-section-{{ section.id }} .sbc__icon-wrap svg { width: 22px; height: 22px; }
  #shopify-section-{{ section.id }} .sbc__list-plus { position: absolute; bottom: -4px; right: -3px; width: 12px; height: 12px; border-radius: 50%; pointer-events: none; background: #000000; color: #ffc107; }
  #shopify-section-{{ section.id }} .sbc__list-plus::before, #shopify-section-{{ section.id }} .sbc__list-plus::after { content: ''; position: absolute; top: 50%; left: 50%; background: currentColor; border-radius: 1px; transform: translate(-50%, -50%); }
  #shopify-section-{{ section.id }} .sbc__list-plus::before { width: 55%; height: 2px; }
  #shopify-section-{{ section.id }} .sbc__list-plus::after { width: 2px; height: 55%; }
  #shopify-section-{{ section.id }} .sbc__list-btn.is-saved .sbc__list-plus { display: none; }

  /* ── Band (title / reviews / price) ── */
  #shopify-section-{{ section.id }} .sbc__card-band { display: flex; flex-direction: column; flex: 1 0 auto; text-decoration: none; color: inherit; }
  #shopify-section-{{ section.id }} .sbc__card-body { display: flex; flex-direction: column; justify-content: center; flex: 1; min-height: 52px; padding: 8px; background: {{ section.settings.card_band_bg }}; color: {{ section.settings.card_band_text }}; align-items: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}; text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .sbc__rating { display: flex; align-items: center; gap: 4px; height: 20px; margin-bottom: 3px; overflow: hidden; }
  #shopify-section-{{ section.id }} .sbc__stars { position: relative; display: inline-block; line-height: 1; letter-spacing: 1px; vertical-align: middle; font-size: {{ section.settings.star_size | default: 20 }}px; }
  #shopify-section-{{ section.id }} .sbc__stars-bg { display: block; line-height: 1; color: {{ section.settings.star_empty_color }}; }
  #shopify-section-{{ section.id }} .sbc__stars-fill { position: absolute; top: 0; left: 0; overflow: hidden; white-space: nowrap; display: block; line-height: 1; color: {{ section.settings.star_color }}; }
  #shopify-section-{{ section.id }} .sbc__review-count { font-weight: 400; opacity: 0.85; white-space: nowrap; line-height: 1; vertical-align: middle; font-size: 14px; color: #e3e3e3; }
  #shopify-section-{{ section.id }} .sbc__card-title { margin: 0 0 2px; font-family: var(--font-heading-family); text-transform: uppercase; font-style: italic; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: {{ section.settings.title_size | default: 16 }}px; font-weight: {{ section.settings.title_weight }}; color: {{ section.settings.card_band_text }}; }
  #shopify-section-{{ section.id }} .sbc__card-price { margin: 0; font-size: {{ section.settings.price_size | default: 16 }}px; font-weight: {{ section.settings.price_weight }}; color: {{ section.settings.price_color }}; }
  #shopify-section-{{ section.id }} .sbc__was { opacity: 0.55; margin-right: 4px; text-decoration: line-through; }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .sbc__stars { font-size: 11px; }
    #shopify-section-{{ section.id }} .sbc__review-count { font-size: 9px; }
    #shopify-section-{{ section.id }} .sbc__card-title { font-size: {{ section.settings.title_size_mobile | default: 11 }}px; }
    #shopify-section-{{ section.id }} .sbc__card-price { font-size: {{ section.settings.price_size_mobile | default: 10 }}px; }
    #shopify-section-{{ section.id }} .sbc__icon-wrap svg { width: 18px; height: 18px; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient itm-rp">
  <product-recommendations
    class="section-{{ section.id }}-padding isolate"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}&intent=related"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-itm-rp-section="{{ section.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <div class="page-width">
        <h2 class="itm-rp__heading inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        <ul class="itm-rp__grid list-unstyled" role="list">
          {% for recommendation in recommendations.products %}
            <li class="sbc__card">

              <div class="sbc__img-wrap">
                <a class="sbc__card-img-link" href="{{ recommendation.url }}">
                  <div class="sbc__card-img">
                    {%- for image in recommendation.images limit: 5 -%}
                      <div class="sbc__slide{% if forloop.first %} is-active{% endif %}">
                        {{ image | image_url: width: 600 | image_tag: alt: recommendation.title, loading: 'lazy', widths: '300, 400, 600' }}
                      </div>
                    {%- else -%}
                      <div class="sbc__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'sbc__ph-svg' }}</div>
                    {%- endfor -%}
                  </div>
                </a>
                {%- if recommendation.images.size > 1 -%}
                  <div class="sbc__arrow sbc__prev" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></div>
                  <div class="sbc__arrow sbc__next" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></div>
                  <button class="sbc__zone sbc__zone--prev" aria-label="Previous image" tabindex="-1"></button>
                  <button class="sbc__zone sbc__zone--next" aria-label="Next image" tabindex="-1"></button>
                {%- endif -%}
              </div>

              {%- if section.settings.show_atc -%}
                <div class="sbc__actions">
                  {%- if recommendation.variants.size == 1 and recommendation.available -%}
                    <button class="sbc__atc" data-variant-id="{{ recommendation.first_available_variant.id }}">Add to Cart</button>
                  {%- elsif recommendation.available -%}
                    <a href="{{ recommendation.url }}" class="sbc__atc sbc__atc--options">Choose Options</a>
                  {%- else -%}
                    <button class="sbc__atc" disabled>Sold Out</button>
                  {%- endif -%}
                  <span class="sbc__atc-divider" aria-hidden="true"></span>
                  <button class="sbc__list-btn" type="button"
                    data-wl-handle="{{ recommendation.handle }}"
                    data-wl-sku="{{ recommendation.selected_or_first_available_variant.sku | escape }}"
                    data-wl-title="{{ recommendation.title | escape }}"
                    data-wl-price="{{ recommendation.price_min | money | escape }}"
                    data-wl-vid="{{ recommendation.selected_or_first_available_variant.id }}"
                    aria-label="Save to list" title="Save to list">
                    <span class="sbc__icon-wrap">
                      <svg class="itm-wl-icon--list" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4.5h6a1 1 0 0 1 1 1v.5a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-.5a1 1 0 0 1 1-1z"/><path d="M8 5.5H6a2 2 0 0 0-2 2V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5a2 2 0 0 0-2-2h-2"/><path d="M9 11.5h6"/><path d="M9 15.5h6"/></svg>
                      <svg class="itm-wl-icon--saved" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      <span class="sbc__list-plus" aria-hidden="true"></span>
                    </span>
                  </button>
                </div>
              {%- endif -%}

              <a class="sbc__card-band" href="{{ recommendation.url }}">
                <div class="sbc__card-body">
                  {%- if section.settings.show_reviews -%}
                    {%- assign r_rating = recommendation.metafields.reviews.rating.value.rating -%}
                    {%- assign r_scale = recommendation.metafields.reviews.rating.value.scale_max | default: 5 -%}
                    {%- assign r_count = recommendation.metafields.reviews.rating_count.value -%}
                    {%- if r_rating != blank and r_count != blank and r_count > 0 -%}
                      {%- assign rating_pct = r_rating | divided_by: r_scale | times: 100 | round -%}
                      <div class="sbc__rating">
                        <span class="sbc__stars" aria-label="{{ r_count }} reviews"><span class="sbc__stars-bg" aria-hidden="true">★★★★★</span><span class="sbc__stars-fill" aria-hidden="true" style="width:{{ rating_pct }}%">★★★★★</span></span>
                        <span class="sbc__review-count">({{ r_count }} reviews)</span>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  <p class="sbc__card-title">{{ recommendation.title }}</p>
                  {%- if section.settings.show_price -%}
                    <p class="sbc__card-price">{%- if recommendation.compare_at_price > recommendation.price -%}<s class="sbc__was">{{ recommendation.compare_at_price | money }}</s>{%- endif -%}<span class="sbc__now">{{ recommendation.price_min | money }}</span></p>
                  {%- endif -%}
                </div>
              </a>

            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </product-recommendations>
</div>

<script>
(function () {
  var section = document.querySelector('[data-itm-rp-section="{{ section.id }}"]');
  if (!section) return;

  function initCarousel(card) {
    if (card.dataset.sbcInit === '1') return;
    var wrap = card.querySelector('.sbc__img-wrap');
    var slides = card.querySelectorAll('.sbc__slide');
    if (!wrap) return;
    card.dataset.sbcInit = '1';
    if (slides.length <= 1) return;
    var current = 0, isAnimating = false, DURATION = 270;
    function show(newIndex, direction) {
      if (isAnimating) return;
      newIndex = (newIndex + slides.length) % slides.length;
      if (newIndex === current) return;
      isAnimating = true;
      var out = slides[current], inn = slides[newIndex], dir = direction === 'next' ? 1 : -1;
      inn.style.visibility = 'visible'; inn.style.opacity = '1'; inn.style.transition = 'none';
      inn.style.transform = 'translateX(' + (dir * 110) + '%)';
      void inn.getBoundingClientRect();
      var ease = 'transform ' + DURATION + 'ms cubic-bezier(0.25,0.1,0.25,1)';
      inn.style.transition = ease; inn.style.transform = 'translateX(0)';
      out.style.transition = ease; out.style.transform = 'translateX(' + (-dir * 110) + '%)';
      setTimeout(function () {
        out.classList.remove('is-active'); out.style.cssText = '';
        inn.classList.add('is-active'); inn.style.cssText = '';
        current = newIndex; isAnimating = false;
      }, DURATION + 20);
    }
    var prevZone = wrap.querySelector('.sbc__zone--prev'), nextZone = wrap.querySelector('.sbc__zone--next');
    if (prevZone) prevZone.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); show(current - 1, 'prev'); });
    if (nextZone) nextZone.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); show(current + 1, 'next'); });
    var touchStartX = 0;
    wrap.addEventListener('touchstart', function (e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', function (e) {
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) show(diff > 0 ? current + 1 : current - 1, diff > 0 ? 'next' : 'prev');
    }, { passive: true });
  }
  function initCards() { section.querySelectorAll('.sbc__card').forEach(initCarousel); }

  function refreshCart(response, cart) {
    if (!cart || !response || !response.sections || !cart.getSectionsToRender) return;
    cart.getSectionsToRender().forEach(function (s) {
      var el = s.selector ? document.querySelector(s.selector) : document.getElementById(s.id);
      var html = response.sections[s.id];
      if (!el || html == null) return;
      var src = new DOMParser().parseFromString(html, 'text/html').querySelector(s.selector || '.shopify-section');
      if (src) el.innerHTML = src.innerHTML;
    });
    /* the drawer's own is-empty class isn't part of the swapped markup above — clear it
       manually or the empty-cart layout (hidden header/footer, centered grid) sticks around */
    if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
    var overlay = document.querySelector('#CartDrawer-Overlay');
    if (overlay && cart.close) overlay.addEventListener('click', cart.close.bind(cart));
  }

  section.addEventListener('click', function (e) {
    var btn = e.target.closest('.sbc__atc[data-variant-id]');
    if (!btn || !section.contains(btn)) return;
    e.preventDefault();
    if (btn.disabled) return;
    var variantId = btn.dataset.variantId, original = btn.textContent;
    btn.disabled = true; btn.textContent = 'Adding…';
    var cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
    var formData = new FormData();
    formData.append('id', variantId); formData.append('quantity', 1);
    if (cart && cart.getSectionsToRender) {
      formData.append('sections', cart.getSectionsToRender().map(function (s) { return s.id; }).join(','));
      formData.append('sections_url', window.location.pathname);
    }
    fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' }, body: formData })
      .then(function (r) { return r.json(); })
      .then(function (response) { if (response.status) { btn.textContent = 'Error'; return; } btn.textContent = 'Added!'; refreshCart(response, cart); })
      .catch(function () { btn.textContent = 'Error'; })
      .finally(function () { setTimeout(function () { btn.textContent = original; btn.disabled = false; }, 1500); });
  });

  initCards();
  if ('MutationObserver' in window) {
    new MutationObserver(function () { initCards(); document.dispatchEvent(new CustomEvent('itm:wishlist:change')); }).observe(section, { childList: true, subtree: true });
  }
})();
</script>

{% schema %}
{
  "name": "Related products (ITM)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Recommendations come from the Shopify Search & Discovery app. This section renders them as the Shop-by-Category style card." },
    { "type": "inline_richtext", "id": "heading", "default": "You may also be interested in...", "label": "Heading" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "default": 4, "label": "Maximum products to show" },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 6, "step": 1, "default": 4, "label": "Columns on desktop" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Card image" },
    { "type": "color", "id": "card_img_bg", "label": "Image area background", "default": "#f2f2f2" },
    { "type": "color", "id": "arrow_color", "label": "Carousel arrow colour", "default": "#000000" },
    { "type": "header", "content": "Card band" },
    { "type": "color", "id": "card_band_bg", "label": "Band background", "default": "#2e2e2e" },
    { "type": "color", "id": "card_band_text", "label": "Band text colour", "default": "#ffffff" },
    {
      "type": "select", "id": "text_align", "label": "Text alignment",
      "options": [ { "value": "center", "label": "Center" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ],
      "default": "left"
    },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show product reviews", "default": true },
    { "type": "range", "id": "star_size", "label": "Star size (px)", "min": 10, "max": 24, "step": 1, "default": 20 },
    { "type": "color", "id": "star_color", "label": "Filled star colour", "default": "#e30613" },
    { "type": "color", "id": "star_empty_color", "label": "Empty star colour", "default": "#e30613" },
    { "type": "header", "content": "Product title" },
    { "type": "range", "id": "title_size", "label": "Font size – desktop (px)", "min": 10, "max": 22, "step": 1, "default": 16 },
    { "type": "range", "id": "title_size_mobile", "label": "Font size – mobile (px)", "min": 8, "max": 18, "step": 1, "default": 11 },
