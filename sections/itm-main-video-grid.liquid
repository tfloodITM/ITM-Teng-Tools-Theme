{%- liquid
  assign video_source = section.settings.video_source | default: 'blocks'
  assign metafield_videos = ''

  if section.settings.video_metafield_id != blank and section.settings.video_metafield_id contains '.'
    assign ns = section.settings.video_metafield_id | split: '.' | first | strip
    assign key = section.settings.video_metafield_id | split: '.' | last | strip

    if page and page.metafields[ns] and page.metafields[ns][key] != blank
      assign metafield_videos = page.metafields[ns][key].value | default: page.metafields[ns][key]
    elsif product and product.metafields[ns] and product.metafields[ns][key] != blank
      assign metafield_videos = product.metafields[ns][key].value | default: product.metafields[ns][key]
    elsif collection and collection.metafields[ns] and collection.metafields[ns][key] != blank
      assign metafield_videos = collection.metafields[ns][key].value | default: collection.metafields[ns][key]
    elsif article and article.metafields[ns] and article.metafields[ns][key] != blank
      assign metafield_videos = article.metafields[ns][key].value | default: article.metafields[ns][key]
    elsif blog and blog.metafields[ns] and blog.metafields[ns][key] != blank
      assign metafield_videos = blog.metafields[ns][key].value | default: blog.metafields[ns][key]
    endif
  endif

  assign use_metafield_videos = false
  if video_source == 'metafield' and metafield_videos != blank
    assign use_metafield_videos = true
  endif
-%}


{%- capture video_grid_items -%}
  {%- liquid
    if use_metafield_videos
      assign normalized_videos = metafield_videos | newline_to_br | replace: '<br />', ',' | replace: '<br/>', ','
      assign video_items = normalized_videos | split: ','

      for raw_video in video_items
        assign video_input = raw_video | strip
        assign video_id = ''

        if video_input contains 'youtube.com/watch'
          assign video_id = video_input | split: 'v=' | last | split: '&' | first
        elsif video_input contains 'youtu.be/'
          assign video_id = video_input | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
        elsif video_input contains 'youtube.com/embed/'
          assign video_id = video_input | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first
        elsif video_input contains 'youtube.com/shorts/'
          assign video_id = video_input | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first
        else
          assign video_id = video_input
        endif

        if video_id != blank
          echo '<article class="video-grid__item">'
          echo '<div class="video-embed">'
          echo '<iframe src="https://www.youtube.com/embed/'
          echo video_id
          echo '" title="Video '
          echo forloop.index
          echo '" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>'
          echo '</div>'
          echo '</article>'
        endif
      endfor
    else
      for block in section.blocks
        if block.settings.youtube_id != blank or block.settings.vimeo_id != blank
          echo '<article class="video-grid__item" '
          echo block.shopify_attributes
          echo '>'
          echo '<div class="video-embed">'

          if block.settings.youtube_id != blank
            echo '<iframe src="https://www.youtube.com/embed/'
            echo block.settings.youtube_id
            echo '" title="Video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>'
          elsif block.settings.vimeo_id != blank
            echo '<iframe src="https://player.vimeo.com/video/'
            echo block.settings.vimeo_id
            echo '" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>'
          endif

          echo '</div>'

          if block.settings.title != blank
            echo '<h3 class="video-grid__band">'
            echo block.settings.title
            echo '</h3>'
          endif

          if block.settings.description != blank
            echo '<div class="video-grid__desc">'
            echo block.settings.description
            echo '</div>'
          endif

          echo '</article>'
        endif
      endfor
    endif
  -%}
{%- endcapture -%}

{%- assign video_grid_items = video_grid_items | strip -%}

{%- if video_grid_items != blank -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .section-{{ section.id }}-padding.itm-full-bleed {
      width: 100%;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      box-sizing: border-box;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding.itm-full-bleed {
        padding-left: 20px;
        padding-right: 20px;
      }
    }
  {%- endstyle -%}

<section class="video-grid">
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="{% if section.settings.full_width %}itm-full-bleed{% else %}page-width{% endif %} section-{{ section.id }}-padding">
      {% if section.settings.heading != blank %}
        <div class="video-grid__header">
          <h2 class="video-grid__title inline-richtext h2">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}

      <div class="video-grid__grid" style="--cols: {{ section.settings.columns_desktop | default: 3 }};">
        {{ video_grid_items }}
      </div>
    </div>
  </div>

  <style>
  .video-grid__header {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 2.4rem;
  }

  .video-grid__title {
    margin: 0;
    color: #000000 !important;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.04;
    font-size: 24px !important;
  }

  .video-grid__title::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    background: #e30613;
    margin: 10px auto 0;
  }

  .video-grid__grid{
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 2.4rem;
    align-items: start;
  }

  @media (max-width: 989px){
    .video-grid__grid{
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px){
    .video-grid__grid{
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .video-grid__item{
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
  }

  .video-embed{
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0;
    background: #000;
    margin: 0;
  }
  .video-embed iframe{ position:absolute; inset:0; width:100%; height:100%; }

  .video-grid__band{
    margin: 0.2rem 0 0;
    font-size: calc(var(--font-heading-scale) * 1.6rem);
    line-height: 1.2;
    text-transform: uppercase;
    text-align: center;
  }

  .video-grid__desc{
    margin: 0;
    color: rgba(var(--color-foreground), 0.8);
    font: inherit;
    line-height: calc(1 + 0.8 / var(--font-body-scale, 1));
    text-align: center;
  }
  .video-grid__desc p{ margin: 0 0 .6rem; }
  .video-grid__desc p:last-child{ margin-bottom: 0; }

  @media (max-width: 600px){
    .video-grid__title {
      font-size: calc(var(--font-heading-scale) * 2.4rem);
    }
  }
  </style>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Video grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "How-tos & Reviews" },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "Stretch content edge to edge instead of the standard page width.",
      "default": false
    },
    {
      "type": "select",
      "id": "video_source",
      "label": "Content source",
      "options": [
        { "value": "blocks", "label": "Manual blocks" },
        { "value": "metafield", "label": "Current resource metafield" }
      ],
      "default": "blocks"
    },
    {
      "type": "text",
      "id": "video_metafield_id",
      "label": "Metafield (namespace.key)",
      "info": "Use a comma-separated metafield of YouTube IDs or YouTube URLs on the current page, product, collection, article, or blog. Falls back to manual blocks if empty."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "text", "id": "youtube_id", "label": "YouTube ID" },
        { "type": "text", "id": "vimeo_id", "label": "Vimeo ID" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "Video grid", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }] }
  ]
}
{% endschema %}
