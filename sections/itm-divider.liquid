{%- style -%}
  #shopify-section-{{ section.id }} .itm-divider {
    display: {% if section.settings.show_on_mobile %}block{% else %}none{% endif %};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .itm-divider {
      display: {% if section.settings.show_on_desktop %}block{% else %}none{% endif %};
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} .itm-divider__line {
    display: block;
    width: 100%;
    height: {{ section.settings.thickness }}px;
    background-color: {{ section.settings.color }};
  }
{%- endstyle -%}

<div class="itm-divider">
  <div class="itm-divider__line"></div>
</div>

{%- comment -%}
  Dividers sit between content sections, but those sections hide themselves when a
  product has no data (no videos, specs, FAQs…). That left two lines stacked with an
  empty band between them. Collapse any divider whose previous visible section is
  also a divider (or nothing), or that's the last visible thing in <main>.
  Runs once per page however many dividers there are, then again whenever a
  section that fills in after load (Related Products) gets its content, so the
  divider above it isn't hidden just because it was still empty at page load.
{%- endcomment -%}
<script>
  (function () {
    if (window.itmDividerCollapse || (window.Shopify && Shopify.designMode)) return; // keep every divider selectable in the theme editor
    window.itmDividerCollapse = true;
    function collapse() {
      var main = document.querySelector('main') || document.body;
      // Start fresh each run: un-hide dividers this script hid last time.
      Array.prototype.forEach.call(main.querySelectorAll('[data-itm-collapsed]'), function (sec) {
        sec.style.display = '';
        sec.removeAttribute('data-itm-collapsed');
      });
      var sections = Array.prototype.filter.call(main.children, function (el) {
        return el.classList.contains('shopify-section');
      });
      var prevWasDivider = true; // a divider at the very top is redundant too
      var lastVisibleDivider = null;
      sections.forEach(function (sec) {
        var isDivider = !!sec.querySelector(':scope > .itm-divider');
        if (isDivider) {
          if (sec.querySelector('.itm-divider').offsetHeight === 0) return; // hidden on this breakpoint
          if (prevWasDivider) { sec.style.display = 'none'; sec.setAttribute('data-itm-collapsed', ''); return; }
          prevWasDivider = true;
          lastVisibleDivider = sec;
        } else if (sec.offsetHeight > 0) {
          prevWasDivider = false;
          lastVisibleDivider = null;
        }
      });
      if (lastVisibleDivider) {
        lastVisibleDivider.style.display = 'none';
        lastVisibleDivider.setAttribute('data-itm-collapsed', '');
      }
    }
    function start() {
      collapse();
      // Sections that load their content later (product recommendations): re-check when they fill in.
      Array.prototype.forEach.call(document.querySelectorAll('product-recommendations'), function (el) {
        new MutationObserver(function () { collapse(); }).observe(el, { childList: true });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>

{% schema %}
{
  "name": "Divider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "color",
      "label": "Line colour",
      "default": "#e3e3e3"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding — mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Padding — desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Divider"
    }
  ]
}
{% endschema %}
