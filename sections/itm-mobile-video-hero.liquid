{%- style -%}
  #shopify-section-{{ section.id }} {
    display: none;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      display: block;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.padding_bg }};
    }
    #shopify-section-{{ section.id }} .itm-mvh {
      position: relative;
      height: {{ section.settings.height }}px;
      background: {{ section.settings.bg }};
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .itm-mvh video,
    #shopify-section-{{ section.id }} .itm-mvh iframe {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border: 0;
    }
  }
{%- endstyle -%}

<div class="itm-mvh">
  {%- if section.settings.video != blank -%}
    {{
      section.settings.video
      | video_tag:
        autoplay: true,
        loop: true,
        controls: false,
        muted: true,
        image_size: '750x'
    }}
  {%- elsif section.settings.video_url != blank -%}
    <iframe
      src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&playsinline=1"
      frameborder="0"
      allow="autoplay; encrypted-media"
      title="Hero video"
    ></iframe>
  {%- else -%}
    {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Mobile Video Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Visible on mobile only (≤ 749 px). Place this directly below the Hero Split section so the video appears beneath the image panel on small screens."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL (YouTube / Vimeo fallback)",
      "info": "Used only if no Shopify video is selected above."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Video height",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Video background colour",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "padding_bg",
      "label": "Padding background colour",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Mobile Video Hero"
    }
  ]
}
{% endschema %}
