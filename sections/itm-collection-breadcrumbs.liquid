{%- comment -%} ITM Theme - Updated Dec 9 2025 17:00 AEST - Force Shopify sync {%- endcomment -%}
{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Wide collection layout — match grid/title/filters at 2560px */
  #shopify-section-{{ section.id }} .page-width { max-width: 2560px; }
{% endstyle %}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% render 'itm-collection-breadcrumbs', collection: collection %}
  </div>
</div>

{% schema %}
{
  "name": "Collection breadcrumbs",
  "class": "section",
  "enabled_on": {
    "templates": ["collection", "product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection breadcrumbs",
      "category": "Custom"
    }
  ]
}
{% endschema %}
