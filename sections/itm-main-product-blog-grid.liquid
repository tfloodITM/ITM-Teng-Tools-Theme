{%- assign selected_blog = blank -%}
{%- assign blog_source = section.settings.blog_source | default: 'product_metafield' -%}

{%- if blog_source == 'product_metafield' and product and section.settings.blog_metafield_id contains '.' -%}
  {%- assign blog_ns = section.settings.blog_metafield_id | split: '.' | first | strip -%}
  {%- assign blog_key = section.settings.blog_metafield_id | split: '.' | last | strip -%}
  {%- assign product_blog_metafield = product.metafields[blog_ns][blog_key] -%}

  {%- if product_blog_metafield != blank -%}
    {%- assign product_blog_type = product_blog_metafield.type | default: '' -%}

    {%- if product_blog_type contains 'blog_reference' and product_blog_metafield.value != blank -%}
      {%- assign selected_blog = product_blog_metafield.value -%}
    {%- else -%}
      {%- assign product_blog_handle = product_blog_metafield.value | default: product_blog_metafield | append: '' | strip -%}
      {%- if product_blog_handle != blank -%}
        {%- assign selected_blog = blogs[product_blog_handle] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- if selected_blog == blank -%}
  {%- assign selected_blog = section.settings.blog -%}
{%- endif -%}

{%- if selected_blog == blank and section.settings.blog != blank -%}
  {%- assign selected_blog = blogs[section.settings.blog] -%}
{%- endif -%}
{%- assign current_product_title = product.title | default: '' | strip | downcase -%}

{%- capture linked_article_cards -%}
  {%- liquid
    assign rendered_count = 0

    if product and selected_blog and current_product_title != blank
      for article in selected_blog.articles
        assign linked_products_metafield = article.metafields.custom.linked_products
        assign linked_products_type = linked_products_metafield.type | default: ''
        assign linked_products_value = ''
        assign article_matches = false

        if linked_products_metafield != blank
          if linked_products_type contains 'product_reference'
            if linked_products_type contains 'list.'
              for linked_product in linked_products_metafield.value
                if linked_product.id == product.id
                  assign article_matches = true
                  break
                endif
              endfor
            elsif linked_products_metafield.value and linked_products_metafield.value.id == product.id
              assign article_matches = true
            endif
          else
            assign linked_products_value = linked_products_metafield.value | default: linked_products_metafield | append: ''

            if linked_products_value != blank
              assign normalized_linked_products = linked_products_value | newline_to_br | replace: '<br />', ',' | replace: '<br/>', ',' | downcase
              assign normalized_linked_products = normalized_linked_products | replace: ', ', ',' | replace: ' ,', ','
              assign delimited_linked_products = ',' | append: normalized_linked_products | append: ','
              assign current_product_match = ',' | append: current_product_title | append: ','

              if delimited_linked_products contains current_product_match
                assign article_matches = true
              endif
            endif
          endif
        endif

        if article_matches
          echo '<article class="blog-card">'

          if section.settings.show_image and article.image
            echo '<a href="'
            echo article.url
            echo '" class="blog-card__media">'
            echo article.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1200px) 600px, 100vw', alt: article.title
            echo '</a>'
          endif

          if section.settings.show_tags and article.tags.size > 0
            echo '<div class="tags">'
            for tag in article.tags
              echo '<a class="tag-chip" href="'
              echo selected_blog.url
              echo '/tagged/'
              echo tag | handle
              echo '">'
              echo tag
              echo '</a>'
            endfor
            echo '</div>'
          endif

          echo '<a href="'
          echo article.url
          echo '"><h3 class="h3">'
          echo article.title
          echo '</h3></a>'

          if section.settings.show_date or section.settings.show_author
            echo '<div class="meta">'
            if section.settings.show_date
              echo '<time datetime="'
              echo article.published_at | date: '%Y-%m-%d'
              echo '">'
              echo article.published_at | date: format: 'date'
              echo '</time>'
            endif

            if section.settings.show_author and article.author
              if section.settings.show_date
                echo '&nbsp;•&nbsp;'
              endif
              echo article.author
            endif
            echo '</div>'
          endif

          echo '</article>'

          assign rendered_count = rendered_count | plus: 1
          if rendered_count >= section.settings.post_limit
            break
          endif
        endif
      endfor
    endif
  -%}
{%- endcapture -%}

{%- assign linked_article_cards = linked_article_cards | strip -%}

{%- if linked_article_cards != blank -%}
  <section class="simple-blog color-{{ section.settings.color_scheme }} gradient">
  {%- style -%}
    .section-{{ section.id }}-pad {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: calc({{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px + 20px);
    }
    @media (min-width: 750px){
      .section-{{ section.id }}-pad {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: calc({{ section.settings.padding_bottom }}px + 20px);
      }
    }

    .simple-blog .grid{
      display:grid; grid-template-columns: repeat(var(--cols, 3), minmax(0,1fr)); gap:24px;
    }

    @media (max-width: 989px){
      .simple-blog .grid{ --cols: 2; }
    }

    @media (max-width: 599px){
      .simple-blog .grid{
        grid-template-columns: repeat(2, minmax(0,1fr)) !important;
      }
      .simple-blog .grid > article:nth-child(n+3){
        display:none !important;
      }
    }

    .simple-blog .view-all{ margin-top:24px; text-align:center; }

    .simple-blog .blog-card{
      display:flex; flex-direction:column; gap:.35rem; height:100%;
    }

    .simple-blog .blog-card__media{
      aspect-ratio:16/9; overflow:hidden; border-radius:var(--media-radius,0);
    }
    .simple-blog .blog-card__media img{
      width:100%; height:100%; display:block; object-fit:cover; object-position:center;
    }

    .simple-blog.color-{{ section.settings.color_scheme }} .tags{
      display:flex; flex-wrap:wrap; justify-content: center; gap:.4rem; margin-top:.4rem;text-align: center; padding: 5px 0;
    }

    .simple-blog.color-{{ section.settings.color_scheme }} .tag-chip{
      display:flex; align-items:center; justify-content:center;
      padding:1rem; font-size:1.5rem; line-height:1; white-space:nowrap; font-style: italic;
      border-radius:var(--buttons-radius,8px);
      background: var(--color-button, var(--color-foreground));
      color: var(--color-button-text, var(--color-background));
      border: 1px solid var(--color-button, var(--color-foreground));
      background-color: rgba(var(--color-button, 0,0,0), 1);
      color: rgba(var(--color-button-text, 255,255,255), 1);
      border-color: rgba(var(--color-button, 0,0,0), 1);
      text-decoration:none; cursor:pointer;
      transition: transform .12s ease, opacity .12s ease, box-shadow .12s ease;
    }

    .simple-blog.color-{{ section.settings.color_scheme }} .tag-chip:hover{
      background-color: rgba(var(--color-button, 0,0,0), .9);
      border-color: rgba(var(--color-button, 0,0,0), .9);
      transform: translateY(-1px);
    }

    .simple-blog.color-{{ section.settings.color_scheme }} .tag-chip:focus-visible{
      outline: 2px solid rgba(var(--color-button, 0,0,0), 1);
      outline-offset: 2px;
    }

    .simple-blog .blog-card > a,
    .simple-blog .blog-card > a:visited,
    .simple-blog .blog-card > a:hover{
      color: inherit; text-decoration: none; border-bottom:0;
    }

    .simple-blog .blog-card h3{
      text-transform: uppercase; text-align: center;
      margin:.08rem 0 0; line-height:1.2; font-size:1.5rem;
    }

    .simple-blog .blog-card > a:hover h3{ opacity:.9; }

    .simple-blog .meta{ opacity:.8; font-size:.875rem; text-align:center; }

    .simple-blog .view-all{ margin-top:24px; }

    .simple-blog__heading {
      color: rgba(var(--color-button));
    }
  {%- endstyle -%}

    <div class="page-width section-{{ section.id }}-pad">
      {%- if section.settings.heading != blank -%}
        <h2 class="simple-blog__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="grid" style="--cols: {{ section.settings.columns_desktop | default: 3 }}">
        {{ linked_article_cards }}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Blog Posts Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Related articles" },
    {
      "type": "select",
      "id": "blog_source",
      "label": "Blog source",
      "options": [
        { "value": "product_metafield", "label": "Current product metafield" },
        { "value": "section", "label": "Section setting" }
      ],
      "default": "product_metafield"
    },
    { "type": "text", "id": "blog_metafield_id", "label": "Product blog metafield (namespace.key)", "default": "custom.related_blog", "info": "Supports a blog reference metafield or a text metafield containing the blog handle." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "paragraph", "content": "Shows articles from the resolved blog where article metafield custom.linked_products matches the current product." },
    { "type": "range", "id": "post_limit", "label": "Post count", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "checkbox", "id": "show_tags", "label": "Show tags", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [{ "name": "Blog Posts Grid" }]
}
{% endschema %}