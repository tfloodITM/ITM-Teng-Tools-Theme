{%- comment -%}
  ITM Hotspot Image
  -----------------
  A product photo with clickable "+" markers pinned at specific points
  (by percentage position, so it stays correct at any image size).
  Clicking a marker opens a small popover with a title + description;
  clicking another marker (or the same one again) closes the previous
  one. Markers pulse gently to draw the eye, same idea as the annotated
  product-feature photos used elsewhere in the tool storage industry.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
-%}

{%- style -%}
  #shopify-section-{{ sid }} .itm-hs {
    max-width: {{ section.settings.max_width_mobile | default: 400 }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .itm-hs {
      max-width: {{ section.settings.max_width | default: 900 }}px;
    }
  }
  #shopify-section-{{ sid }} .itm-hs__heading {
    font-weight: 800;
    text-align: center;
    margin: 0 0 32px;
  }
  #shopify-section-{{ sid }} .itm-hs__stage {
    position: relative;
    width: 100%;
    line-height: 0;
  }
  #shopify-section-{{ sid }} .itm-hs__stage img {
    width: 100%;
    height: auto;
    display: block;
  }
  #shopify-section-{{ sid }} .itm-hs__marker {
    position: absolute;
    left: var(--hs-x);
    top: var(--hs-y);
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 50%;
    border: none;
    background: {{ section.settings.marker_color | default: '#ffc233' }};
    color: #1a1a1a;
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.35);
    animation: itm-hs-pulse 2.2s ease-in-out infinite;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .itm-hs__marker.is-open {
    background: #1a1a1a;
    color: #fff;
    animation: none;
  }
  @keyframes itm-hs-pulse {
    0%, 100% { box-shadow: 0 2px 8px rgba(0,0,0,.35), 0 0 0 0 rgba(255,194,51,.55); }
    50%      { box-shadow: 0 2px 8px rgba(0,0,0,.35), 0 0 0 10px rgba(255,194,51,0); }
  }
  {%- comment -%}
    The popover's horizontal position is clamped, not a plain X% + -50%
    transform: at a hotspot placed near the left/right edge of the
    photo, a plain percentage position would push half the popover
    outside the image (and often off the visible page) at narrow
    widths. clamp() keeps its centre following the hotspot's X%
    everywhere in the middle of the image, but stops it short of
    running past either edge once it gets close — using the popover's
    own half-width (110px desktop, 85px mobile, from the widths below)
    as the clamp margin so it's always exactly as far as it can go
    without spilling over.
  {%- endcomment -%}
  #shopify-section-{{ sid }} .itm-hs__popover {
    position: absolute;
    z-index: 3;
    width: 220px;
    max-width: 60vw;
    left: clamp(110px, var(--hs-x, 50%), calc(100% - 110px));
    top: var(--hs-y, 50%);
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 8px 28px rgba(0,0,0,.22);
    padding: 14px 16px;
    display: none;
    transform: translate(-50%, 10px);
  }
  #shopify-section-{{ sid }} .itm-hs__popover.is-open {
    display: block;
  }
  #shopify-section-{{ sid }} .itm-hs__popover-title {
    font-weight: 800;
    font-size: 14px;
    margin: 0 0 4px;
    color: #1a1a1a;
  }
  #shopify-section-{{ sid }} .itm-hs__popover-text {
    font-size: 13px;
    color: #555555;
    margin: 0;
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .itm-hs__popover-close {
    position: absolute;
    top: 6px;
    right: 8px;
    border: none;
    background: none;
    font-size: 16px;
    line-height: 1;
    color: #999999;
    cursor: pointer;
    padding: 4px;
  }
  @media (max-width: 749px) {
    {%- comment -%}
      Reassigning --hs-x/--hs-y themselves (rather than duplicating the
      positioning rules) means every rule that already reads them — the
      marker's left/top, the popover's clamp() — automatically switches
      to each hotspot's mobile position with nothing else to keep in
      sync. Falls back to the desktop value already stored in --hs-x
      when a hotspot has no mobile override, since --hs-x-mobile always
      just mirrors --hs-x for those blocks (set in the markup above).
    {%- endcomment -%}
    #shopify-section-{{ sid }} .itm-hs__marker,
    #shopify-section-{{ sid }} .itm-hs__popover {
      --hs-x: var(--hs-x-mobile);
      --hs-y: var(--hs-y-mobile);
    }
    #shopify-section-{{ sid }} .itm-hs__marker {
      width: 28px;
      height: 28px;
      margin: -14px 0 0 -14px;
      font-size: 16px;
    }
    #shopify-section-{{ sid }} .itm-hs__popover {
      width: 170px;
      left: clamp(85px, var(--hs-x, 50%), calc(100% - 85px));
    }
  }
{%- endstyle -%}

<div class="itm-hs">
  {%- if section.settings.heading != blank -%}
    <h2 class="itm-hs__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    {%- comment -%}
      Reserving the image's real aspect ratio up front means the stage
      is already the exact right shape before the photo finishes
      loading, so the percentage-positioned markers land in their
      correct spot on first paint instead of jumping once the browser
      learns the image's true dimensions.
    {%- endcomment -%}
    <div class="itm-hs__stage" data-hs-stage="{{ sid }}" style="aspect-ratio: {{ section.settings.image.aspect_ratio | default: 1 }};">
      <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.heading | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">

      {%- for block in section.blocks -%}
        {%- liquid
          assign hs_mob_x = block.settings.x_percent
          assign hs_mob_y = block.settings.y_percent
          if block.settings.use_mobile_position
            assign hs_mob_x = block.settings.x_percent_mobile
            assign hs_mob_y = block.settings.y_percent_mobile
          endif
        -%}
        <button
          type="button"
          class="itm-hs__marker"
          style="--hs-x:{{ block.settings.x_percent }}%; --hs-y:{{ block.settings.y_percent }}%; --hs-x-mobile:{{ hs_mob_x }}%; --hs-y-mobile:{{ hs_mob_y }}%;"
          data-hs-marker="{{ forloop.index0 }}"
          aria-label="{{ block.settings.title | escape }}"
          {{ block.shopify_attributes }}
        >+</button>
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign hs_mob_x = block.settings.x_percent
          assign hs_mob_y = block.settings.y_percent
          if block.settings.use_mobile_position
            assign hs_mob_x = block.settings.x_percent_mobile
            assign hs_mob_y = block.settings.y_percent_mobile
          endif
        -%}
        <div
          class="itm-hs__popover"
          style="--hs-x:{{ block.settings.x_percent }}%; --hs-y:{{ block.settings.y_percent }}%; --hs-x-mobile:{{ hs_mob_x }}%; --hs-y-mobile:{{ hs_mob_y }}%;"
          data-hs-popover="{{ forloop.index0 }}"
        >
          <button type="button" class="itm-hs__popover-close" data-hs-close aria-label="Close">&times;</button>
          <p class="itm-hs__popover-title">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}
            <p class="itm-hs__popover-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p style="text-align:center;color:#999;">Add a product photo in the theme editor, then place hotspots on it.</p>
  {%- endif -%}
</div>

<script>
(function () {
  var stage = document.querySelector('[data-hs-stage="{{ sid }}"]');
  if (!stage) return;
  var markers = Array.prototype.slice.call(stage.querySelectorAll('[data-hs-marker]'));
  var popovers = Array.prototype.slice.call(stage.querySelectorAll('[data-hs-popover]'));

  function closeAll() {
    markers.forEach(function (m) { m.classList.remove('is-open'); });
    popovers.forEach(function (p) { p.classList.remove('is-open'); });
  }

  markers.forEach(function (marker) {
    marker.addEventListener('click', function () {
      var id = marker.getAttribute('data-hs-marker');
      var popover = stage.querySelector('[data-hs-popover="' + id + '"]');
      var wasOpen = marker.classList.contains('is-open');
      closeAll();
      if (!wasOpen && popover) {
        marker.classList.add('is-open');
        popover.classList.add('is-open');
      }
    });
  });

  popovers.forEach(function (popover) {
    var closeBtn = popover.querySelector('[data-hs-close]');
    if (closeBtn) closeBtn.addEventListener('click', closeAll);
  });

  document.addEventListener('click', function (e) {
    if (!stage.contains(e.target)) closeAll();
  });
})();
</script>

{% schema %}
{
  "name": "ITM — Hotspot Image",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product photo"
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Marker colour",
      "default": "#ffc233"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width (px) — desktop",
      "min": 400,
      "max": 1600,
      "step": 20,
      "default": 900
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "label": "Max content width (px) — mobile",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 400
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "x_percent",
          "label": "Horizontal position (%) — desktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "y_percent",
          "label": "Vertical position (%) — desktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "checkbox",
          "id": "use_mobile_position",
          "label": "Use a different position on mobile",
          "default": false
        },
        {
          "type": "range",
          "id": "x_percent_mobile",
          "label": "Horizontal position (%) — mobile",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "y_percent_mobile",
          "label": "Vertical position (%) — mobile",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature name"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ITM — Hotspot Image",
      "blocks": [
        { "type": "hotspot" },
        { "type": "hotspot" },
        { "type": "hotspot" }
      ]
    }
  ]
}
{% endschema %}
