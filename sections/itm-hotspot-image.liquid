{%- comment -%}
  ITM Hotspot Image
  -----------------
  A product photo with clickable "+" markers pinned at specific points
  (by percentage position, so it stays correct at any image size).
  Clicking a marker opens a small popover with a title + description;
  clicking another marker (or the same one again) closes the previous
  one. Markers pulse gently to draw the eye, same idea as the annotated
  product-feature photos used elsewhere in the tool storage industry.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
-%}

{%- style -%}
  #shopify-section-{{ sid }} .itm-hs {
    max-width: {{ section.settings.max_width | default: 900 }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ sid }} .itm-hs__heading {
    font-weight: 800;
    text-align: center;
    margin: 0 0 32px;
  }
  #shopify-section-{{ sid }} .itm-hs__stage {
    position: relative;
    width: 100%;
    line-height: 0;
  }
  #shopify-section-{{ sid }} .itm-hs__stage img {
    width: 100%;
    height: auto;
    display: block;
  }
  #shopify-section-{{ sid }} .itm-hs__marker {
    position: absolute;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 50%;
    border: none;
    background: {{ section.settings.marker_color | default: '#ffc233' }};
    color: #1a1a1a;
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.35);
    animation: itm-hs-pulse 2.2s ease-in-out infinite;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .itm-hs__marker.is-open {
    background: #1a1a1a;
    color: #fff;
    animation: none;
  }
  @keyframes itm-hs-pulse {
    0%, 100% { box-shadow: 0 2px 8px rgba(0,0,0,.35), 0 0 0 0 rgba(255,194,51,.55); }
    50%      { box-shadow: 0 2px 8px rgba(0,0,0,.35), 0 0 0 10px rgba(255,194,51,0); }
  }
  #shopify-section-{{ sid }} .itm-hs__popover {
    position: absolute;
    z-index: 3;
    width: 220px;
    max-width: 60vw;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 8px 28px rgba(0,0,0,.22);
    padding: 14px 16px;
    display: none;
    transform: translate(-50%, 10px);
  }
  #shopify-section-{{ sid }} .itm-hs__popover.is-open {
    display: block;
  }
  #shopify-section-{{ sid }} .itm-hs__popover-title {
    font-weight: 800;
    font-size: 14px;
    margin: 0 0 4px;
    color: #1a1a1a;
  }
  #shopify-section-{{ sid }} .itm-hs__popover-text {
    font-size: 13px;
    color: #555555;
    margin: 0;
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .itm-hs__popover-close {
    position: absolute;
    top: 6px;
    right: 8px;
    border: none;
    background: none;
    font-size: 16px;
    line-height: 1;
    color: #999999;
    cursor: pointer;
    padding: 4px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ sid }} .itm-hs__marker {
      width: 28px;
      height: 28px;
      margin: -14px 0 0 -14px;
      font-size: 16px;
    }
    #shopify-section-{{ sid }} .itm-hs__popover {
      width: 170px;
    }
  }
{%- endstyle -%}

<div class="itm-hs">
  {%- if section.settings.heading != blank -%}
    <h2 class="itm-hs__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    <div class="itm-hs__stage" data-hs-stage="{{ sid }}">
      <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">

      {%- for block in section.blocks -%}
        <button
          type="button"
          class="itm-hs__marker"
          style="left:{{ block.settings.x_percent }}%; top:{{ block.settings.y_percent }}%;"
          data-hs-marker="{{ forloop.index0 }}"
          aria-label="{{ block.settings.title | escape }}"
          {{ block.shopify_attributes }}
        >+</button>
      {%- endfor -%}

      {%- for block in section.blocks -%}
        <div
          class="itm-hs__popover"
          style="left:{{ block.settings.x_percent }}%; top:{{ block.settings.y_percent }}%;"
          data-hs-popover="{{ forloop.index0 }}"
        >
          <button type="button" class="itm-hs__popover-close" data-hs-close aria-label="Close">&times;</button>
          <p class="itm-hs__popover-title">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}
            <p class="itm-hs__popover-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p style="text-align:center;color:#999;">Add a product photo in the theme editor, then place hotspots on it.</p>
  {%- endif -%}
</div>

<script>
(function () {
  var stage = document.querySelector('[data-hs-stage="{{ sid }}"]');
  if (!stage) return;
  var markers = Array.prototype.slice.call(stage.querySelectorAll('[data-hs-marker]'));
  var popovers = Array.prototype.slice.call(stage.querySelectorAll('[data-hs-popover]'));

  function closeAll() {
    markers.forEach(function (m) { m.classList.remove('is-open'); });
    popovers.forEach(function (p) { p.classList.remove('is-open'); });
  }

  markers.forEach(function (marker) {
    marker.addEventListener('click', function () {
      var id = marker.getAttribute('data-hs-marker');
      var popover = stage.querySelector('[data-hs-popover="' + id + '"]');
      var wasOpen = marker.classList.contains('is-open');
      closeAll();
      if (!wasOpen && popover) {
        marker.classList.add('is-open');
        popover.classList.add('is-open');
      }
    });
  });

  popovers.forEach(function (popover) {
    var closeBtn = popover.querySelector('[data-hs-close]');
    if (closeBtn) closeBtn.addEventListener('click', closeAll);
  });

  document.addEventListener('click', function (e) {
    if (!stage.contains(e.target)) closeAll();
  });
})();
</script>

{% schema %}
{
  "name": "ITM — Hotspot Image",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product photo"
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Marker colour",
      "default": "#ffc233"
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Max content width (px)",
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "x_percent",
          "label": "Horizontal position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "y_percent",
          "label": "Vertical position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature name"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ITM — Hotspot Image",
      "blocks": [
        { "type": "hotspot" },
        { "type": "hotspot" },
        { "type": "hotspot" }
      ]
    }
  ]
}
{% endschema %}
