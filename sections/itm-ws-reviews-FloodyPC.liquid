{%- style -%}
  #shopify-section-{{ section.id }} {
    background: #f5f5f5;
    padding: 60px 0;
  }
  #shopify-section-{{ section.id }} .itm-rev__header {
    text-align: center;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .itm-rev__title {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .itm-rev__stars {
    color: #c8922a;
    font-size: 28px;
    margin-bottom: 6px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .itm-rev__count {
    font-size: 15px;
    color: #555;
  }
  #shopify-section-{{ section.id }} .itm-rev__wrap {
    position: relative;
    display: flex;
    align-items: flex-start;
    padding: 0 150px;
  }
  #shopify-section-{{ section.id }} .itm-rev__grid {
    display: flex;
    gap: 20px;
    overflow: hidden;
    scroll-behavior: smooth;
    flex: 1;
  }
  #shopify-section-{{ section.id }} .itm-rev-card {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 20px;
    flex: 0 0 calc(33.333% - 14px);
    min-width: calc(33.333% - 14px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__stars {
    color: #c8922a;
    font-size: 18px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__time {
    color: #999;
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__title {
    font-weight: 700;
    font-size: 15px;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__text {
    font-size: 14px;
    color: #333;
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__footer {
    border-top: 1px solid #eee;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__name {
    font-weight: 600;
    font-size: 14px;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__verified {
    color: #c8922a;
    font-size: 12px;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__helpful {
    font-size: 12px;
    color: #666;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__helpful-btn {
    padding: 2px 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #f9f9f9;
    cursor: pointer;
    font-size: 12px;
    transition: background 0.15s;
  }
  #shopify-section-{{ section.id }} .itm-rev-card__helpful-btn:hover {
    background: #eee;
  }
  #shopify-section-{{ section.id }} .itm-rev__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 28px;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    color: #333;
    transition: box-shadow 0.2s;
    line-height: 1;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .itm-rev__btn:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }
  #shopify-section-{{ section.id }} .itm-rev__btn--prev {
    left: 100px;
  }
  #shopify-section-{{ section.id }} .itm-rev__btn--next {
    right: 100px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .itm-rev__wrap {
      padding: 0 44px;
    }
    #shopify-section-{{ section.id }} .itm-rev-card {
      flex: 0 0 100%;
      min-width: 100%;
    }
    #shopify-section-{{ section.id }} .itm-rev__btn--prev {
      left: 0;
    }
    #shopify-section-{{ section.id }} .itm-rev__btn--next {
      right: 0;
    }
  }

  @media (min-width: 750px) and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .itm-rev__wrap {
      padding: 0 60px;
    }
    #shopify-section-{{ section.id }} .itm-rev-card {
      flex: 0 0 calc(50% - 10px);
      min-width: calc(50% - 10px);
    }
    #shopify-section-{{ section.id }} .itm-rev__btn--prev {
      left: 10px;
    }
    #shopify-section-{{ section.id }} .itm-rev__btn--next {
      right: 10px;
    }
  }
{%- endstyle -%}

<div class="itm-rev__header">
  <h2 class="itm-rev__title">{{ section.settings.heading }}</h2>
  <div class="itm-rev__stars">★★★★★</div>
  <div class="itm-rev__count">{{ section.settings.review_count_text }}</div>
</div>

<div class="itm-rev__wrap">
  <button class="itm-rev__btn itm-rev__btn--prev" id="itm-rev-prev-{{ section.id }}" aria-label="Previous reviews">&#8249;</button>

  <div class="itm-rev__grid" id="itm-rev-grid-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div class="itm-rev-card" {{ block.shopify_attributes }}>
        <div class="itm-rev-card__top">
          <div class="itm-rev-card__stars">★★★★★</div>
          <div class="itm-rev-card__time">{{ block.settings.time }}</div>
        </div>
        <p class="itm-rev-card__title">{{ block.settings.title }}</p>
        <p class="itm-rev-card__text">{{ block.settings.text }}</p>
        <div class="itm-rev-card__footer">
          <div class="itm-rev-card__author">
            <div class="itm-rev-card__avatar" style="background: {{ block.settings.avatar_color }}">
              {{ block.settings.initials }}
            </div>
            <div>
              <div class="itm-rev-card__name">{{ block.settings.name }}</div>
              <div class="itm-rev-card__verified">✔ Verified Buyer</div>
            </div>
          </div>
          <div class="itm-rev-card__helpful">
            Was this helpful?
            <span class="itm-rev-card__helpful-btn">👍 {{ block.settings.helpful_count }}</span>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  <button class="itm-rev__btn itm-rev__btn--next" id="itm-rev-next-{{ section.id }}" aria-label="Next reviews">&#8250;</button>
</div>

<script>
  (function () {
    var grid = document.getElementById('itm-rev-grid-{{ section.id }}');
    var prevBtn = document.getElementById('itm-rev-prev-{{ section.id }}');
    var nextBtn = document.getElementById('itm-rev-next-{{ section.id }}');
    if (!grid || !prevBtn || !nextBtn) return;

    function cardStep() {
      var card = grid.querySelector('.itm-rev-card');
      if (!card) return 0;
      var gap = parseFloat(getComputedStyle(grid).gap) || 20;
      return card.offsetWidth + gap;
    }

    nextBtn.addEventListener('click', function () {
      grid.scrollLeft += cardStep();
    });
    prevBtn.addEventListener('click', function () {
      grid.scrollLeft -= cardStep();
    });
  })();
</script>

{% schema %}
{
  "name": "Customer Reviews Carousel",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "default": "4,199 Reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Avatar initials (2 letters)",
          "default": "CU"
        },
        {
          "type": "color",
          "id": "avatar_color",
          "label": "Avatar background color",
          "default": "#5b8dd9"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time ago",
          "default": "1 year ago"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Great product!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Really happy with this purchase."
        },
        {
          "type": "range",
          "id": "helpful_count",
          "label": "Helpful count",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews Carousel",
      "blocks": [
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
