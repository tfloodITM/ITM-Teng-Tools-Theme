<style>
  html body #judgeme_product_reviews.jdgm-widget.jdgm-review-widget {
    max-width: none !important;
    width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  #shopify-section-{{ section.id }} .page-width:has(#judgeme_product_reviews) {
    max-width: none !important;
    padding-left: 1.5rem !important;
    padding-right: 1.5rem !important;
    box-sizing: border-box !important;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .page-width:has(#judgeme_product_reviews) {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }
  }

  #shopify-section-{{ section.id }} .itm-apps__heading {
    text-align: center;
    text-transform: uppercase;
    margin: 0 0 24px;
    padding: 0 1.5rem;
    font-size: 24px !important;
    color: #000000 !important;
  }

  #shopify-section-{{ section.id }} .itm-apps__heading::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    background: #e30613;
    margin: 10px auto 0;
  }
</style>

{%- if section.settings.heading != blank -%}
  <h2 class="itm-apps__heading inline-richtext h2" id="itm-apps-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
{%- endif -%}

<div class="{% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{%- comment -%}
  Judge.me's product-review metafields (reviews.rating_count etc.) aren't
  populated at all on this store, so there's no reliable Liquid-side signal
  for "does this product actually have reviews" — that's checked here in
  the browser instead, against what Judge.me's own widget actually renders
  (confirmed live: on a zero-review product #judgeme_product_reviews never
  gets created in the DOM at all, not merely left empty — so "the container
  doesn't exist" is itself the "no reviews" signal, not just a fallback).
  The heading stays visible by default (no flash-then-hide for the common
  case) and only disappears after giving Judge.me's async widget a few
  seconds to create/populate the container, so a slow connection doesn't
  get mistaken for "no reviews".
{%- endcomment -%}
<script>
(function () {
  var heading = document.getElementById('itm-apps-heading-{{ section.id }}');
  var container = document.getElementById('judgeme_product_reviews');
  if (!heading) return;
  if (!container) { heading.style.display = 'none'; return; }

  function hasContent() { return container.children.length > 0; }

  var observer = new MutationObserver(function () {
    if (hasContent()) {
      heading.style.display = '';
      observer.disconnect();
    }
  });
  observer.observe(container, { childList: true, subtree: true });

  setTimeout(function () {
    if (!hasContent()) heading.style.display = 'none';
  }, 2500);
})();
</script>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Optional heading shown above the app block(s). Leave blank to hide."
    },
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}
