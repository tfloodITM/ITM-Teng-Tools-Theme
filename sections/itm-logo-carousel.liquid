{%- comment -%}
  ITM Logo Carousel
  -----------------
  A continuous, auto-scrolling strip of client/brand logos ("trusted
  by" style row). CSS-only marquee — the track's content is duplicated
  once and the whole thing animates left on a loop, so it never needs
  to "reset" or jump.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign logo_count = section.blocks.size
-%}

{%- style -%}
  #shopify-section-{{ sid }} .itm-lc {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .itm-lc__heading {
    text-align: center;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    margin: 0 0 28px;
  }
  #shopify-section-{{ sid }} .itm-lc__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  #shopify-section-{{ sid }} .itm-lc__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: {{ section.settings.logo_gap }}px;
    animation: itm-lc-scroll {{ section.settings.speed_seconds | default: 30 }}s linear infinite;
  }
  #shopify-section-{{ sid }} .itm-lc__viewport:hover .itm-lc__track {
    animation-play-state: paused;
  }
  @keyframes itm-lc-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  #shopify-section-{{ sid }} .itm-lc__logo {
    flex: 0 0 auto;
    height: {{ section.settings.logo_height }}px;
    width: auto;
    max-width: {{ section.settings.logo_max_width }}px;
    object-fit: contain;
    {%- if section.settings.grayscale -%}
      filter: grayscale(100%);
      opacity: 0.6;
      transition: filter .2s, opacity .2s;
    {%- endif -%}
  }
  {%- if section.settings.grayscale -%}
    #shopify-section-{{ sid }} .itm-lc__logo:hover {
      filter: grayscale(0%);
      opacity: 1;
    }
  {%- endif -%}
  @media (max-width: 749px) {
    #shopify-section-{{ sid }} .itm-lc__logo {
      height: {{ section.settings.logo_height_mobile }}px;
      max-width: {{ section.settings.logo_max_width_mobile }}px;
    }
    #shopify-section-{{ sid }} .itm-lc__track {
      gap: {{ section.settings.logo_gap_mobile }}px;
      animation-duration: {{ section.settings.speed_seconds_mobile | default: 20 }}s;
    }
  }
{%- endstyle -%}

<div class="itm-lc">
  {%- if section.settings.heading != blank -%}
    <h2 class="itm-lc__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if logo_count > 0 -%}
    <div class="itm-lc__viewport">
      <div class="itm-lc__track">
        {%- comment -%}
          The track's content is rendered twice back to back, and the
          animation only ever moves it by exactly one copy's width
          (translateX(-50%) of the doubled track = 100% of one real
          copy) — so the moment it "resets" to 0%, the doubled copy is
          sitting in the exact same visual position, making the loop
          seamless with no visible jump.
        {%- endcomment -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.logo != blank -%}
              <img
                class="itm-lc__logo"
                src="{{ block.settings.logo | image_url: width: 300 }}"
                alt="{{ block.settings.name | escape }}"
                loading="lazy"
                aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <p style="text-align:center;color:#999;">Add logo blocks and pick an image for each one in the theme editor.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "ITM — Logo Carousel",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "default": "Trusted By Industry Leaders"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#1a1a1a"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in grayscale (colour on hover)",
      "default": true
    },
    {
      "type": "header",
      "content": "Speed"
    },
    {
      "type": "range",
      "id": "speed_seconds",
      "label": "Scroll speed — desktop (seconds per full loop)",
      "info": "Lower = faster.",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "speed_seconds_mobile",
      "label": "Scroll speed — mobile (seconds per full loop)",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 20
    },
    {
      "type": "header",
      "content": "Logo size"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height — desktop (px)",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height — mobile (px)",
      "min": 16,
      "max": 80,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width — desktop (px)",
      "min": 60,
      "max": 260,
      "step": 10,
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "label": "Logo max width — mobile (px)",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos — desktop (px)",
      "min": 16,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "logo_gap_mobile",
      "label": "Gap between logos — mobile (px)",
      "min": 8,
      "max": 80,
      "step": 4,
      "default": 36
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Company name (for accessibility)",
          "default": "Company"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ITM — Logo Carousel",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
