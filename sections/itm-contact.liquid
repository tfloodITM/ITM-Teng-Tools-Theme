{%- style -%}
  #itm-contact-{{ section.id }} {
    --itm-c-accent: {{ section.settings.accent_color }};
    --itm-c-info-bg: {{ section.settings.info_bg_color }};
    --itm-c-info-text: {{ section.settings.info_text_color }};
    background: {{ section.settings.page_bg_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #itm-contact-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #itm-contact-{{ section.id }} .itm-c__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  #itm-contact-{{ section.id }} .itm-c__page-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  #itm-contact-{{ section.id }} .itm-c__page-subtext {
    font-size: 1.6rem;
    color: #555;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.7;
  }
  @media screen and (min-width: 750px) {
    #itm-contact-{{ section.id }} .itm-c__page-subtext {
      font-size: 1.8rem;
    }
  }

  /* Main grid */
  #itm-contact-{{ section.id }} .itm-c__grid {
    display: flex;
    align-items: stretch;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 48px rgba(0,0,0,0.13);
  }

  /* ── Info panel ── */
  #itm-contact-{{ section.id }} .itm-c__info-panel {
    background: var(--itm-c-info-bg, #1a1a1a);
    color: var(--itm-c-info-text, #ffffff);
    flex: 0 0 42%;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    box-sizing: border-box;
  }
  #itm-contact-{{ section.id }} .itm-c__info-panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: var(--itm-c-accent, #f5a623);
  }
  #itm-contact-{{ section.id }} .itm-c__info-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--itm-c-info-text, #ffffff);
    margin: 0 0 0.5rem;
  }
  #itm-contact-{{ section.id }} .itm-c__info-intro {
    font-size: 15px;
    color: rgba(255,255,255,0.6);
    line-height: 1.65;
    margin: 0 0 2.5rem;
  }

  /* Detail items */
  #itm-contact-{{ section.id }} .itm-c__detail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  #itm-contact-{{ section.id }} .itm-c__detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  #itm-contact-{{ section.id }} .itm-c__detail-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.9);
  }
  #itm-contact-{{ section.id }} .itm-c__detail-icon svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  #itm-contact-{{ section.id }} .itm-c__detail-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--itm-c-accent, #f5a623);
    margin: 0 0 0.25rem;
  }
  #itm-contact-{{ section.id }} .itm-c__detail-text {
    font-size: 15px;
    color: rgba(255,255,255,0.85);
    line-height: 1.55;
    margin: 0;
  }
  #itm-contact-{{ section.id }} .itm-c__detail-text a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  #itm-contact-{{ section.id }} .itm-c__detail-text a:hover {
    color: var(--itm-c-accent, #f5a623);
    text-decoration: underline;
  }

  /* Social */
  #itm-contact-{{ section.id }} .itm-c__social {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  #itm-contact-{{ section.id }} .itm-c__social-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin: 0 0 1rem;
  }
  #itm-contact-{{ section.id }} .itm-c__social-links {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #itm-contact-{{ section.id }} .itm-c__social-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  #itm-contact-{{ section.id }} .itm-c__social-link:hover {
    background: var(--itm-c-accent, #f5a623);
    border-color: var(--itm-c-accent, #f5a623);
    color: #1a1a1a;
  }
  #itm-contact-{{ section.id }} .itm-c__social-link svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  /* ── Form column ── */
  #itm-contact-{{ section.id }} .itm-c__form-col {
    flex: 1;
    background: #ffffff;
    padding: 3rem;
    box-sizing: border-box;
  }
  #itm-contact-{{ section.id }} .itm-c__form-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.4rem;
  }
  #itm-contact-{{ section.id }} .itm-c__form-sub {
    font-size: 15px;
    color: #777;
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  /* Form fields */
  #itm-contact-{{ section.id }} .itm-c__row {
    display: flex;
    gap: 1rem;
    margin-bottom: 0;
  }
  #itm-contact-{{ section.id }} .itm-c__row .itm-c__field {
    flex: 1;
  }
  #itm-contact-{{ section.id }} .itm-c__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  #itm-contact-{{ section.id }} .itm-c__field label {
    font-size: 12px;
    font-weight: 700;
    color: #444;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  #itm-contact-{{ section.id }} .itm-c__field input,
  #itm-contact-{{ section.id }} .itm-c__field textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1.5px solid #e5e5e5;
    border-radius: 8px;
    font-size: 15px;
    color: #1a1a1a;
    background: #fafafa;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    outline: none;
    font-family: inherit;
    -webkit-appearance: none;
    appearance: none;
  }
  #itm-contact-{{ section.id }} .itm-c__field input:focus,
  #itm-contact-{{ section.id }} .itm-c__field textarea:focus {
    border-color: var(--itm-c-accent, #f5a623);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(245,166,35,0.14);
  }
  #itm-contact-{{ section.id }} .itm-c__field textarea {
    resize: vertical;
    min-height: 140px;
  }
  #itm-contact-{{ section.id }} .itm-c__field .itm-c__field-error {
    font-size: 13px;
    color: #b91c1c;
    margin: 0;
  }

  /* Status messages */
  #itm-contact-{{ section.id }} .itm-c__status {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-size: 15px;
    line-height: 1.5;
  }
  #itm-contact-{{ section.id }} .itm-c__status svg {
    flex-shrink: 0;
    margin-top: 1px;
  }
  #itm-contact-{{ section.id }} .itm-c__status--success {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  #itm-contact-{{ section.id }} .itm-c__status--error {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }

  /* Submit button */
  #itm-contact-{{ section.id }} .itm-c__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 1rem 2rem;
    background: var(--itm-c-accent, #f5a623);
    color: #1a1a1a;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    cursor: pointer;
    transition: filter 0.2s, transform 0.15s;
    margin-top: 0.5rem;
    font-family: inherit;
  }
  #itm-contact-{{ section.id }} .itm-c__submit:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  #itm-contact-{{ section.id }} .itm-c__submit:active {
    transform: translateY(0);
    filter: brightness(0.97);
  }

  /* ── Mobile ── */
  @media screen and (max-width: 899px) {
    #itm-contact-{{ section.id }} .itm-c__grid {
      flex-direction: column;
    }
    #itm-contact-{{ section.id }} .itm-c__info-panel {
      flex: none;
      width: 100%;
    }
    #itm-contact-{{ section.id }} .itm-c__social {
      margin-top: 2rem;
    }
    #itm-contact-{{ section.id }} .itm-c__form-col {
      padding: 2.5rem 1.5rem;
    }
    #itm-contact-{{ section.id }} .itm-c__row {
      flex-direction: column;
      gap: 0;
    }
  }
{%- endstyle -%}

<section id="itm-contact-{{ section.id }}">
  <div class="page-width">

    {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="itm-c__header">
        {%- if section.settings.heading != blank -%}
          <h1 class="itm-c__page-heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="itm-c__page-subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="itm-c__grid">

      <!-- ── Left: Contact Info Panel ── -->
      <div class="itm-c__info-panel">
        <h2 class="itm-c__info-title">Contact Information</h2>
        <p class="itm-c__info-intro">Fill out the form and our team will get back to you as soon as possible.</p>

        <ul class="itm-c__detail-list">

          {%- if section.settings.phone != blank -%}
          <li class="itm-c__detail-item">
            <div class="itm-c__detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6.06 6.06l.92-.92a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <span class="itm-c__detail-label">Phone</span>
              <p class="itm-c__detail-text">
                {%- assign phone_clean = section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
                <a href="tel:{{ phone_clean }}">{{ section.settings.phone }}</a>
              </p>
            </div>
          </li>
          {%- endif -%}

          {%- if section.settings.email != blank -%}
          <li class="itm-c__detail-item">
            <div class="itm-c__detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <span class="itm-c__detail-label">Email</span>
              <p class="itm-c__detail-text">
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </p>
            </div>
          </li>
          {%- endif -%}

          {%- if section.settings.address != blank -%}
          <li class="itm-c__detail-item">
            <div class="itm-c__detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <span class="itm-c__detail-label">Address</span>
              <p class="itm-c__detail-text">{{ section.settings.address | newline_to_br }}</p>
            </div>
          </li>
          {%- endif -%}

          {%- if section.settings.hours != blank -%}
          <li class="itm-c__detail-item">
            <div class="itm-c__detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <span class="itm-c__detail-label">Business Hours</span>
              <p class="itm-c__detail-text">{{ section.settings.hours | newline_to_br }}</p>
            </div>
          </li>
          {%- endif -%}

        </ul>

        {%- if section.settings.show_social -%}
          {%- assign has_social = false -%}
          {%- if section.settings.facebook_url != blank or section.settings.instagram_url != blank or section.settings.youtube_url != blank -%}
            {%- assign has_social = true -%}
          {%- endif -%}
          {%- if has_social -%}
          <div class="itm-c__social">
            <span class="itm-c__social-label">Follow Us</span>
            <ul class="itm-c__social-links">
              {%- if section.settings.facebook_url != blank -%}
              <li>
                <a href="{{ section.settings.facebook_url }}" class="itm-c__social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
              </li>
              {%- endif -%}
              {%- if section.settings.instagram_url != blank -%}
              <li>
                <a href="{{ section.settings.instagram_url }}" class="itm-c__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
                </a>
              </li>
              {%- endif -%}
              {%- if section.settings.youtube_url != blank -%}
              <li>
                <a href="{{ section.settings.youtube_url }}" class="itm-c__social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
              </li>
              {%- endif -%}
            </ul>
          </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <!-- ── Right: Contact Form ── -->
      <div class="itm-c__form-col">
        <h2 class="itm-c__form-title">Send Us a Message</h2>
        <p class="itm-c__form-sub">We'd love to hear from you. Send us a message and we'll get back to you as soon as possible.</p>

        {%- form 'contact', id: 'ContactFormITM' -%}

          {%- if form.posted_successfully? -%}
            <div class="itm-c__status itm-c__status--success" tabindex="-1" autofocus>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>Thank you! Your message has been sent. We'll be in touch shortly.</span>
            </div>
          {%- elsif form.errors -%}
            <div class="itm-c__status itm-c__status--error" role="alert" tabindex="-1" autofocus>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <span>Please check your details and try again.</span>
            </div>
          {%- endif -%}

          <div class="itm-c__row">
            <div class="itm-c__field">
              <label for="ContactFormITM-name">Name</label>
              <input
                type="text"
                id="ContactFormITM-name"
                name="contact[Name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Your full name"
              >
            </div>
            <div class="itm-c__field">
              <label for="ContactFormITM-phone">Phone</label>
              <input
                type="tel"
                id="ContactFormITM-phone"
                name="contact[Phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="e.g. 03 9123 4567"
              >
            </div>
          </div>

          <div class="itm-c__field">
            <label for="ContactFormITM-email">Email Address <span style="color:#e53e3e;font-weight:400">*</span></label>
            <input
              type="email"
              id="ContactFormITM-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="your@email.com"
              aria-required="true"
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
            {%- if form.errors contains 'email' -%}
              <p class="itm-c__field-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          </div>

          <div class="itm-c__field">
            <label for="ContactFormITM-subject">Subject</label>
            <input
              type="text"
              id="ContactFormITM-subject"
              name="contact[Subject]"
              placeholder="How can we help?"
            >
          </div>

          <div class="itm-c__field">
            <label for="ContactFormITM-body">Message <span style="color:#e53e3e;font-weight:400">*</span></label>
            <textarea
              id="ContactFormITM-body"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="Tell us a bit more about your enquiry..."
              aria-required="true"
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="itm-c__submit">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            Send Message
          </button>

        {%- endform -%}
      </div>

    </div>
  </div>
</section>

