{%- comment -%}
  ITM Build My Box
  ----------------
  Interactive kit builder: pick a source collection, customers add
  individual products (with quantity) into a running "box", then add
  everything to the cart in one /cart/add.js call. Each product uses its
  default/first-available variant (same one-variant-per-card convention
  used by the compact product cards elsewhere in this theme, e.g.
  itm-collection-grid.liquid's .sbc__atc) — no in-card variant picker.
{%- endcomment -%}

{%- liquid
  assign box_collection = collections[section.settings.collection]
  assign min_items = section.settings.min_items
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .itm-bb {
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .itm-bb__heading {
    font-weight: 800;
    text-align: center;
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .itm-bb__subtext {
    text-align: center;
    color: #666666;
    max-width: 640px;
    margin: 0 auto 40px;
  }
  #shopify-section-{{ section.id }} .itm-bb__layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 32px;
    align-items: start;
  }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .itm-bb__layout {
      grid-template-columns: 1fr;
    }
  }
  #shopify-section-{{ section.id }} .itm-bb__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 16px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .itm-bb__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  #shopify-section-{{ section.id }} .itm-bb-card {
    border: 1px solid #e2e2e2;
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color .2s;
  }
  #shopify-section-{{ section.id }} .itm-bb-card.is-selected {
    border-color: #e30613;
    box-shadow: 0 0 0 1px #e30613;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__img-wrap {
    aspect-ratio: 1 / 1;
    background: #f7f6f3;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__title {
    font-weight: 800;
    font-size: 13px;
    margin: 0;
    line-height: 1.35;
    color: #1a1a1a;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__price {
    font-size: 13px;
    color: #555555;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-top: auto;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__qty-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #d0d0d0;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    color: #1a1a1a;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__qty-btn:hover {
    border-color: #e30613;
    color: #e30613;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__qty-value {
    font-weight: 800;
    min-width: 20px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .itm-bb-card__soldout {
    font-size: 12px;
    color: #999999;
    text-align: center;
    padding: 6px 0;
  }

  /* Summary panel */
  #shopify-section-{{ section.id }} .itm-bb__summary {
    position: sticky;
    top: 20px;
    border: 1px solid #e2e2e2;
    border-radius: 8px;
    padding: 20px;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-heading {
    font-weight: 800;
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    max-height: 280px;
    overflow-y: auto;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-empty {
    font-size: 13px;
    color: #999999;
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 13px;
    padding: 6px 0;
    border-bottom: 1px solid #f0f0f0;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-row-name {
    color: #1a1a1a;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-row-meta {
    color: #999999;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-total {
    display: flex;
    justify-content: space-between;
    font-weight: 800;
    font-size: 16px;
    padding-top: 12px;
    border-top: 1px solid #e2e2e2;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .itm-bb__summary-min {
    font-size: 12px;
    color: #e30613;
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .itm-bb__submit {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 30px;
    background: #e30613;
    color: #fff;
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: .04em;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .itm-bb__submit:disabled {
    background: #cccccc;
    cursor: not-allowed;
  }
{%- endstyle -%}

<div class="itm-bb" data-itm-bb data-min-items="{{ min_items }}">
  {%- if section.settings.heading != blank -%}
    <h1 class="itm-bb__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.subtext != blank -%}
    <p class="itm-bb__subtext">{{ section.settings.subtext }}</p>
  {%- endif -%}

  {%- if box_collection == blank or box_collection.products.size == 0 -%}
    <p class="itm-bb__summary-empty">No products available to build a box from yet — pick a collection in the theme editor.</p>
  {%- else -%}
    <div class="itm-bb__layout">
      <div class="itm-bb__grid">
        {%- for product in box_collection.products -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          <div class="itm-bb-card" data-bb-card data-variant-id="{{ variant.id }}" data-title="{{ product.title | escape }}" data-price="{{ variant.price }}">
            <div class="itm-bb-card__img-wrap">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <p class="itm-bb-card__title">{{ product.title }}</p>
            <p class="itm-bb-card__price">{{ variant.price | money }}</p>
            {%- if variant.available -%}
              <div class="itm-bb-card__qty">
                <button type="button" class="itm-bb-card__qty-btn" data-bb-qty-down aria-label="Remove one">&minus;</button>
                <span class="itm-bb-card__qty-value" data-bb-qty-value>0</span>
                <button type="button" class="itm-bb-card__qty-btn" data-bb-qty-up aria-label="Add one">+</button>
              </div>
            {%- else -%}
              <div class="itm-bb-card__soldout">Sold out</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="itm-bb__summary">
        <h2 class="itm-bb__summary-heading">Your box</h2>
        <p class="itm-bb__summary-empty" data-bb-empty>No items selected yet.</p>
        <ul class="itm-bb__summary-list" data-bb-list hidden></ul>
        <div class="itm-bb__summary-total" data-bb-total hidden>
          <span>Total</span>
          <span data-bb-total-value>{{ 0 | money }}</span>
        </div>
        {%- if min_items > 0 -%}
          <p class="itm-bb__summary-min" data-bb-min-msg>Add at least {{ min_items }} item{% if min_items != 1 %}s{% endif %} to build your box.</p>
        {%- endif -%}
        <button type="button" class="itm-bb__submit" data-bb-submit disabled>{{ section.settings.button_text | default: 'Add box to cart' }}</button>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
(function () {
  var root = document.currentScript.previousElementSibling;
  if (!root || !root.hasAttribute('data-itm-bb')) {
    root = document.querySelector('#shopify-section-{{ section.id }} [data-itm-bb]');
  }
  if (!root) return;

  var minItems  = parseInt(root.getAttribute('data-min-items'), 10) || 0;
  var cards     = Array.prototype.slice.call(root.querySelectorAll('[data-bb-card]'));
  var listEl    = root.querySelector('[data-bb-list]');
  var emptyEl   = root.querySelector('[data-bb-empty]');
  var totalWrap = root.querySelector('[data-bb-total]');
  var totalEl   = root.querySelector('[data-bb-total-value]');
  var minMsgEl  = root.querySelector('[data-bb-min-msg]');
  var submitBtn = root.querySelector('[data-bb-submit]');

  var state = {}; // variantId -> { qty, title, price }

  function formatMoney(cents) {
    return ({{ cart.currency.symbol | default: '$' | json }}) + (cents / 100).toFixed(2);
  }

  function totalItemCount() {
    var n = 0;
    for (var id in state) { n += state[id].qty; }
    return n;
  }

  function render() {
    var ids = Object.keys(state).filter(function (id) { return state[id].qty > 0; });
    if (ids.length === 0) {
      emptyEl.hidden = false;
      listEl.hidden = true;
      totalWrap.hidden = true;
      listEl.innerHTML = '';
    } else {
      emptyEl.hidden = true;
      listEl.hidden = false;
      totalWrap.hidden = false;
      var total = 0;
      listEl.innerHTML = ids.map(function (id) {
        var item = state[id];
        total += item.price * item.qty;
        return '<li class="itm-bb__summary-row">' +
          '<span class="itm-bb__summary-row-name">' + item.title + '</span>' +
          '<span class="itm-bb__summary-row-meta">' + item.qty + ' &times; ' + formatMoney(item.price) + '</span>' +
          '</li>';
      }).join('');
      totalEl.textContent = formatMoney(total);
    }
    var count = totalItemCount();
    var meetsMin = count >= minItems;
    submitBtn.disabled = !meetsMin || count === 0;
    if (minMsgEl) minMsgEl.hidden = meetsMin;
  }

  cards.forEach(function (card) {
    var id    = card.getAttribute('data-variant-id');
    var title = card.getAttribute('data-title');
    var price = parseFloat(card.getAttribute('data-price')) || 0;
    var qtyEl = card.querySelector('[data-bb-qty-value]');
    var upBtn = card.querySelector('[data-bb-qty-up]');
    var downBtn = card.querySelector('[data-bb-qty-down]');
    if (!upBtn || !downBtn || !qtyEl || !id) return;

    function setQty(q) {
      q = Math.max(0, q);
      state[id] = { qty: q, title: title, price: price };
      qtyEl.textContent = q;
      card.classList.toggle('is-selected', q > 0);
      render();
    }

    upBtn.addEventListener('click', function () {
      setQty((state[id] ? state[id].qty : 0) + 1);
    });
    downBtn.addEventListener('click', function () {
      setQty((state[id] ? state[id].qty : 0) - 1);
    });
  });

  /* Same /cart/add.js + section-refresh pattern used elsewhere in this
     theme (see itm-collection-grid.liquid), extended to a multi-item
     payload since a box adds several variants in one request. */
  function refreshCart(response, cart) {
    if (!cart || !response || !response.sections || !cart.getSectionsToRender) return;
    cart.getSectionsToRender().forEach(function (s) {
      var el = s.selector ? document.querySelector(s.selector) : document.getElementById(s.id);
      var html = response.sections[s.id];
      if (!el || html == null) return;
      var src = new DOMParser().parseFromString(html, 'text/html').querySelector(s.selector || '.shopify-section');
      if (src) el.innerHTML = src.innerHTML;
    });
    if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
    if (cart.open) cart.open();
  }

  if (submitBtn) {
    submitBtn.addEventListener('click', function () {
      var items = Object.keys(state)
        .filter(function (id) { return state[id].qty > 0; })
        .map(function (id) { return { id: id, quantity: state[id].qty }; });
      if (!items.length) return;

      var cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
      var payload = { items: items };
      if (cart && cart.getSectionsToRender) {
        payload.sections = cart.getSectionsToRender().map(function (s) { return s.id; });
        payload.sections_url = window.location.pathname;
      }

      var original = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function (r) { return r.json(); })
        .then(function (response) {
          if (response.status) {
            submitBtn.textContent = 'Error — try again';
            setTimeout(function () { submitBtn.textContent = original; render(); }, 2000);
            return;
          }
          submitBtn.textContent = 'Added!';
          refreshCart(response, cart);
          state = {};
          cards.forEach(function (card) {
            var qtyEl = card.querySelector('[data-bb-qty-value]');
            if (qtyEl) qtyEl.textContent = '0';
            card.classList.remove('is-selected');
          });
          render();
          setTimeout(function () { submitBtn.textContent = original; }, 1500);
        })
        .catch(function () {
          submitBtn.textContent = 'Error — try again';
          setTimeout(function () { submitBtn.textContent = original; render(); }, 2000);
        });
    });
  }

  render();
})();
</script>

{% schema %}
{
  "name": "ITM — Build My Box",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build My Box"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Pick the tools you need and build your own custom box."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to build from",
      "info": "Every product in this collection becomes pickable. Each uses its default variant — no in-card variant picker."
    },
    {
      "type": "number",
      "id": "min_items",
      "label": "Minimum items required",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add box to cart"
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Max content width (px)",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "ITM — Build My Box"
    }
  ]
}
{% endschema %}
