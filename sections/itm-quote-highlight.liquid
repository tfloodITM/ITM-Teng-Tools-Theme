{%- comment -%}
  ITM Quote Highlight
  -------------------
  A single big standout pull-quote section, matching the style Teng Tools'
  own site (tengtools.com) uses for its two customer testimonials — large
  grey quotation mark, big quote text, circular headshot + name/title below.

  This is deliberately NOT the horizontal multi-card review carousel
  (itm-ws-reviews.liquid) — no star ratings, no "helpful" votes, no
  scrolling strip of cards. With 2+ blocks it quietly crossfades between
  them on a timer with small dot indicators (exactly like the reference
  site), never a swipeable carousel. With exactly 1 block it's just a
  static quote, no dots, no timer.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign block_count = section.blocks.size
-%}

{%- style -%}
  #shopify-section-{{ sid }} .itm-qh {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ sid }} .itm-qh__inner {
    max-width: {{ section.settings.max_width | default: 760 }}px;
    margin: 0 auto;
    text-align: center;
    position: relative;
  }
  #shopify-section-{{ sid }} .itm-qh__stage {
    position: relative;
  }
  #shopify-section-{{ sid }} .itm-qh__slide {
    display: none;
  }
  #shopify-section-{{ sid }} .itm-qh__slide.is-active {
    display: block;
    animation: itm-qh-fade .5s ease;
  }
  @keyframes itm-qh-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  #shopify-section-{{ sid }} .itm-qh__mark {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 64px;
    line-height: 1;
    color: {{ section.settings.mark_color }};
    margin-bottom: 4px;
  }
  #shopify-section-{{ sid }} .itm-qh__quote {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.45;
    color: {{ section.settings.text_color }};
    margin: 0 0 24px;
  }
  #shopify-section-{{ sid }} .itm-qh__person {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  #shopify-section-{{ sid }} .itm-qh__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
  }
  #shopify-section-{{ sid }} .itm-qh__person-text {
    text-align: left;
  }
  #shopify-section-{{ sid }} .itm-qh__name {
    display: block;
    font-weight: 700;
    font-size: 15px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ sid }} .itm-qh__title {
    display: block;
    font-size: 13px;
    color: {{ section.settings.subtext_color }};
  }
  #shopify-section-{{ sid }} .itm-qh__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }
  #shopify-section-{{ sid }} .itm-qh__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    padding: 0;
    border: none;
    background: {{ section.settings.mark_color }};
    opacity: .35;
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .itm-qh__dot.is-on {
    opacity: 1;
  }
{%- endstyle -%}

<div class="itm-qh">
  <div class="itm-qh__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="itm-qh__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="itm-qh__stage" data-qh-stage="{{ sid }}">
      {%- for block in section.blocks -%}
        <div class="itm-qh__slide{% if forloop.first %} is-active{% endif %}" data-qh-slide {{ block.shopify_attributes }}>
          <span class="itm-qh__mark" aria-hidden="true">&ldquo;</span>
          <p class="itm-qh__quote">{{ block.settings.quote }}</p>
          <div class="itm-qh__person">
            {%- if block.settings.photo != blank -%}
              <img class="itm-qh__avatar" src="{{ block.settings.photo | image_url: width: 96 }}" width="48" height="48" alt="" loading="lazy">
            {%- else -%}
              <div class="itm-qh__avatar" style="background:{{ block.settings.avatar_color }}">{{ block.settings.initials }}</div>
            {%- endif -%}
            <div class="itm-qh__person-text">
              <strong class="itm-qh__name">{{ block.settings.name }}</strong>
              <span class="itm-qh__title">{{ block.settings.title }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if block_count > 1 -%}
      <div class="itm-qh__dots" data-qh-dots="{{ sid }}">
        {%- for block in section.blocks -%}
          <button type="button" class="itm-qh__dot{% if forloop.first %} is-on{% endif %}" data-qh-dot="{{ forloop.index0 }}" aria-label="Show quote {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if block_count > 1 -%}
  <script>
  (function () {
    var stage = document.querySelector('[data-qh-stage="{{ sid }}"]');
    if (!stage) return;
    var slides = Array.from(stage.querySelectorAll('[data-qh-slide]'));
    var dotsWrap = document.querySelector('[data-qh-dots="{{ sid }}"]');
    var dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('[data-qh-dot]')) : [];
    var current = 0;
    var seconds = {{ section.settings.autoplay_seconds | default: 6 }};
    var timer = null;

    function show(idx) {
      current = idx;
      slides.forEach(function (s, i) { s.classList.toggle('is-active', i === idx); });
      dots.forEach(function (d, i) { d.classList.toggle('is-on', i === idx); });
    }
    function next() {
      show((current + 1) % slides.length);
    }
    function restart() {
      if (timer) clearInterval(timer);
      if (seconds > 0) timer = setInterval(next, seconds * 1000);
    }
    dots.forEach(function (d, i) {
      d.addEventListener('click', function () {
        show(i);
        restart();
      });
    });
    restart();
  })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "ITM — Quote highlight",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Quote / name colour",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Title / role colour",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "mark_color",
      "label": "Quotation mark / dots colour",
      "default": "#c9c9c9"
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Max content width (px)",
      "default": 760
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Seconds between quotes",
      "info": "Only used when there are 2 or more quotes. Set 0 to disable auto-rotation (dots still work by click).",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This tool changed the way we work."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title / role"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo (optional)",
          "info": "Falls back to initials below if left blank."
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Fallback initials (2 letters)",
          "default": "CU"
        },
        {
          "type": "color",
          "id": "avatar_color",
          "label": "Fallback avatar colour",
          "default": "#4a7cb5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ITM — Quote highlight",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "When you've got ten seconds to change everything, your tools can't fail. That's why we trust Teng Tools.",
            "name": "Jake Matthews",
            "title": "Race Technician, T-Sport Bernau",
            "initials": "JM",
            "avatar_color": "#4a7cb5"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Teng Tools has given us a controlled environment — everything is consistent, traceable, and easy to manage across the site.",
            "name": "Graham Finch",
            "title": "Senior Maintenance Excellence Manager",
            "initials": "GF",
            "avatar_color": "#7a8ea0"
          }
        }
      ]
    }
  ]
}
{% endschema %}
