-%}

<div class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  {% for block in section.blocks %}
  {% if block.type == 'text_nav' and block.settings.position == 'above' %}
    {% render 'header-text-nav', block: block %}
  {% endif %}
{% endfor %}
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}

  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">

    <div class="header__left-cluster">
      {%- if section.settings.menu != blank -%}
        {%- render 'header-drawer' -%}
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account header__icon--account-mobile link focus-inset"
          rel="nofollow"
          aria-label="{% if customer %}Account{% else %}Sign In{% endif %}">
          <span class="svg-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- else -%}
        <div class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
            {%- if settings.logo != blank -%}
              <div class="header__heading-logo-wrapper">
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
                {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                {{ settings.logo | image_url: width: 600 | image_tag:
                  class: 'header__heading-logo motion-reduce',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
                }}
              </div>
            {%- else -%}
              <span class="h2">{{ shop.name }}</span>
            {%- endif -%}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      if section.settings.enable_mega_menu
        render 'itm-mega-menu', section: section
      elsif section.settings.menu != blank
        if section.settings.menu_type_desktop == 'dropdown'
          render 'header-dropdown-menu'
        elsif section.settings.menu_type_desktop != 'drawer'
          render 'header-mega-menu'
        endif
      endif
    -%}

    <div class="itm-locale-nav" aria-hidden="true">
      <img src="https://flagcdn.com/w40/au.png" alt="" width="20" height="13" class="itm-locale-flag" loading="lazy">
      <span>AU</span>
    </div>

    <div class="header__search-row">
      {%- if settings.predictive_search_enabled -%}
        <predictive-search
          class="ws-search"
          data-loading-text="{{ 'accessibility.loading' | t }}"
        >
      {%- else -%}
        <search-form class="ws-search">
      {%- endif -%}

        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="search ws-search__form"
          aria-label="Site search"
        >
          <div>
            <input
              class="search__input ws-search__input"
              id="HeaderSearch"
              type="search"
              name="q"
              value=""
              placeholder="{{ section.settings.search_placeholder | default: 'What can we help you find today?' | escape }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- else -%}
                autocomplete="off"
              {%- endif -%}
            >
            <label class="field__label visually-hidden" for="HeaderSearch">
              {{ 'general.search.search' | t }}
            </label>

            <input type="hidden" name="options[prefix]" value="last">

            {%- if settings.predictive_search_enabled -%}
              <div
                class="predictive-search predictive-search--header"
                tabindex="-1"
                data-predictive-search
              >
                {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
              </div>

              <span
                class="predictive-search-status visually-hidden"
                role="status"
                aria-hidden="true"
              ></span>
            {%- endif -%}

            <span class="itm-locale-search" aria-hidden="true">
              <img src="https://flagcdn.com/w40/au.png" alt="" width="16" height="11" class="itm-locale-flag" loading="lazy">
              <span>AU</span>
            </span>

            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-reset.svg' | inline_asset_content -}}
              </span>
            </button>

            <button
              type="submit"
              class="search__button field__button ws-search__button"
              aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
            >
              <span class="ws-search__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path fill="currentColor" d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-1.06 1.06l.27.28v.79L20 21.5 21.5 20l-6-6zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/>
                </svg>
              </span>
            </button>
          </div>
        </form>

        <!-- Search Focus Panel -->
        {%- liquid
          assign wsfp_has_searches = false
          assign wsfp_has_products = false
          assign wsfp_col = false
          if section.settings.popular_searches != blank
            assign wsfp_has_searches = true
          endif
          if section.settings.popular_now_collection != blank
            assign wsfp_col = collections[section.settings.popular_now_collection]
            unless wsfp_col == empty
              assign wsfp_has_products = true
            endunless
          endif
        -%}
        {%- if wsfp_has_searches or wsfp_has_products -%}
        <div id="ws-focus-panel" class="ws-focus-panel" aria-hidden="true">
          <button class="ws-fp-close" id="ws-fp-close" type="button" aria-label="Close suggestions">
            <span class="svg-wrapper">{{- 'icon-reset.svg' | inline_asset_content -}}</span>
          </button>

          <!-- Recent searches — populated + shown by JS when localStorage has entries -->
          <div id="ws-fp-recent" class="ws-fp-pop-searches" hidden>
            <p class="ws-fp-heading">Recent searches</p>
            <ul id="ws-fp-recent-list" class="ws-fp-terms-list"></ul>
            <button id="ws-fp-clear-recent" class="ws-fp-clear-btn" type="button">Clear recent searches</button>
          </div>

          {%- if wsfp_has_searches -%}
          <!-- Popular searches — shown when no recent searches exist -->
          <div id="ws-fp-popular" class="ws-fp-pop-searches">
            <p class="ws-fp-heading">Popular searches</p>
            <ul class="ws-fp-terms-list">
              {%- assign wsfp_terms = section.settings.popular_searches | split: ',' -%}
              {%- for term in wsfp_terms -%}
                {%- assign t = term | strip -%}
                {%- if t != blank -%}
                  <li><a href="{{ routes.search_url }}?q={{ t | url_encode }}" class="ws-fp-term">{{ t }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}

          <!-- Typing results — populated by JS via MutationObserver on Dawn's predictive-search div -->
          <div id="ws-fp-typing" class="ws-fp-typing" hidden></div>

          {%- if wsfp_has_products -%}
          <div class="ws-fp-pop-now">
            <p class="ws-fp-heading">Popular right now</p>
            <ul class="ws-fp-products-list">
              {%- for product in wsfp_col.products limit: 4 -%}
                {%- capture wsfp_r_cap -%}{{ product.metafields.reviews.rating.value }}{%- endcapture -%}
                {%- assign wsfp_r_num = wsfp_r_cap | strip | plus: 0 -%}
                {%- assign wsfp_r_cnt = product.metafields.reviews.rating_count.value | plus: 0 -%}
                {%- assign wsfp_rpct = wsfp_r_num | times: 20 | round -%}
                <li>
                  <a href="{{ product.url }}" class="ws-fp-prod-link">
                    <div class="ws-fp-prod-img">
                      {%- if product.featured_image -%}
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="60" height="60">
                      {%- endif -%}
                    </div>
                    <div class="ws-fp-prod-details">
                      <p class="ws-fp-prod-title">{{ product.title | escape }}</p>
                      {%- if product.variants.first.sku != blank -%}
                        <p class="ws-fp-prod-sku">SKU: {{ product.variants.first.sku }}</p>
                      {%- endif -%}
                      {%- if wsfp_rpct > 0 -%}
                      <div class="ws-fp-prod-rating">
                        <span class="ws-fp-stars" aria-label="{{ wsfp_r_cnt }} reviews">
                          <span class="ws-fp-stars-bg" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                          <span class="ws-fp-stars-fill" aria-hidden="true" style="width:{{ wsfp_rpct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                        </span>
                        {%- if wsfp_r_cnt > 0 -%}<span class="ws-fp-r-count">({{ wsfp_r_cnt }})</span>{%- endif -%}
                      </div>
                      {%- endif -%}
                      <div class="ws-fp-prod-tags">
                        {%- for col in product.collections limit: 10 -%}
                          <span class="ws-fp-tag" data-href="{{ col.url }}">{{ col.title | remove: ' KNIFE SHARPENERS' | upcase }}</span>
                        {%- endfor -%}
                      </div>
                    </div>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}
        </div>
        {%- endif -%}

      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- else -%}
        </search-form>
      {%- endif -%}
    </div>

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account header__icon--account-desktop link focus-inset"
          rel="nofollow">
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="svg-wrapper">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                </span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
            <span class="svg-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            </span>
          {%- endif -%}
          <span class="header__icon-label">{%- if customer -%}Account{%- else -%}Sign In{%- endif -%}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_lists -%}
        <a
          href="{{ section.settings.lists_link | default: routes.account_url }}"
          class="header__icon header__icon--lists link focus-inset"
          id="lists-icon-bubble"
        >
          <span class="svg-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4.5h6a1 1 0 0 1 1 1v.5a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-.5a1 1 0 0 1 1-1z"/><path d="M8 5.5H6a2 2 0 0 0-2 2V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5a2 2 0 0 0-2-2h-2"/><path d="M9 11.5h6"/><path d="M9 15.5h6"/></svg>
          </span>
          <span class="header__icon-label">{{ section.settings.lists_label | default: 'Lists' }}</span>
          <div class="cart-count-bubble lists-count-bubble" data-lists-count hidden>
            <span aria-hidden="true">0</span>
          </div>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}{% render block %}
        {%- endcase -%}
      {%- endfor -%}

      {%- unless settings.information_only_mode -%}
      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        <span class="svg-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </span>
        <span class="header__icon-label">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
      {%- endunless -%}

      {%- comment -%} Moved AU indicator into the text nav bar below {%- endcomment -%}
    </div>

    {%- comment -%} Trust / USP bar — third header row, hides on scroll with the nav {%- endcomment -%}
    {%- if has_trust -%}
      <div class="trust-bar">
       <div class="trust-bar__track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="trust-bar__item" {{ block.shopify_attributes }}>
            {%- else -%}
              <div class="trust-bar__item" {{ block.shopify_attributes }}>
            {%- endif -%}
              {%- liquid
                assign t_icon_src = ''
                if block.settings.icon != blank
                  assign t_icon_src = block.settings.icon | image_url: width: 96
                elsif block.settings.icon_url != blank
                  assign t_icon_src = block.settings.icon_url
                endif
              -%}
              {%- if t_icon_src != blank -%}
                {%- if section.settings.trust_icon_color != blank -%}
                  <span class="trust-bar__icon trust-bar__icon--masked" style="-webkit-mask-image:url({{ t_icon_src }});mask-image:url({{ t_icon_src }});" role="img" aria-label="{{ block.settings.text | escape }}"></span>
                {%- else -%}
                  <span class="trust-bar__icon"><img src="{{ t_icon_src }}" alt="{{ block.settings.text | escape }}" loading="lazy"></span>
                {%- endif -%}
              {%- elsif block.settings.icon_preset != blank and block.settings.icon_preset != 'none' -%}
                <span class="trust-bar__icon">{% render 'itm-trust-icon', preset: block.settings.icon_preset %}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}<span class="trust-bar__text">{{ block.settings.text }}</span>{%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
       </div>
      </div>
    {%- endif -%}
  </header>
  {% for block in section.blocks %}
  {% if block.type == 'text_nav' and block.settings.position == 'below' %}
    {% render 'header-text-nav', block: block %}
  {% endif %}
{% endfor %}

