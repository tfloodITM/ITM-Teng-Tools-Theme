<script>
  /* Reflect saved favourites count on the Lists icon.
     Favouriting logic lives elsewhere; this just renders the badge.
     Store either a number in 'itm:lists:count' or a JSON array in 'itm:lists'. */
  (function () {
    var bubble = document.querySelector('[data-lists-count]');
    if (!bubble) return;
    function readCount() {
      try {
        var n = window.localStorage.getItem('itm:lists:count');
        if (n !== null) return parseInt(n, 10) || 0;
        var arr = JSON.parse(window.localStorage.getItem('itm:lists') || '[]');
        return Array.isArray(arr) ? arr.length : 0;
      } catch (e) { return 0; }
    }
    function render() {
      var count = readCount();
      var span = bubble.querySelector('span[aria-hidden="true"]');
      if (span) span.textContent = count < 100 ? count : '99+';
      if (count > 0) { bubble.removeAttribute('hidden'); }
      else { bubble.setAttribute('hidden', ''); }
    }
    render();
    window.addEventListener('storage', render);
    document.addEventListener('itm:lists:updated', render);
  })();
</script>

<script>
(function () {
  'use strict';
  var panel        = document.getElementById('ws-focus-panel');
  var closeBtn     = document.getElementById('ws-fp-close');
  var clearBtn     = document.getElementById('ws-fp-clear-recent');
  var recentSec    = document.getElementById('ws-fp-recent');
  var recentList   = document.getElementById('ws-fp-recent-list');
  var popularSec   = document.getElementById('ws-fp-popular');
  var typingSection = document.getElementById('ws-fp-typing');
  var input        = document.getElementById('HeaderSearch');
  if (!panel || !input) return;

  var productSection = panel.querySelector('.ws-fp-pop-now');
  var ws = input.closest('predictive-search, search-form');
  var dawnPanel = ws ? ws.querySelector('[data-predictive-search]') : null;

  var STORAGE_KEY = 'itm:recent-searches';
  var MAX_RECENT  = 8;

  function getRecent() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch(e) { return []; }
  }
  function saveRecent(arr) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(arr)); } catch(e) {}
  }
  function addRecent(term) {
    var arr = getRecent().filter(function(t) { return t !== term; });
    arr.unshift(term);
    saveRecent(arr.slice(0, MAX_RECENT));
  }
  function clearRecent() {
    try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
  }

  function renderSearches() {
    var recents = getRecent();
    if (recentSec && recentList) {
      if (recents.length > 0) {
        recentList.innerHTML = '';
        recents.forEach(function(term) {
          var li = document.createElement('li');
          var a  = document.createElement('a');
          a.href      = '/search?q=' + encodeURIComponent(term);
          a.className = 'ws-fp-term';
          a.textContent = term;
          li.appendChild(a);
          recentList.appendChild(li);
        });
        recentSec.removeAttribute('hidden');
        if (popularSec) popularSec.setAttribute('hidden', '');
      } else {
        recentSec.setAttribute('hidden', '');
        if (popularSec) popularSec.removeAttribute('hidden');
      }
    }
  }

  /* Show popular/recent searches + popular right now (no-typing state) */
  function showSearchesView() {
    if (typingSection) { typingSection.setAttribute('hidden', ''); typingSection.innerHTML = ''; }
    renderSearches();
    if (productSection) productSection.removeAttribute('hidden');
  }

  /* Show typing results in top section; popular right now stays visible at bottom */
  function showTypingView() {
    if (recentSec) recentSec.setAttribute('hidden', '');
    if (popularSec) popularSec.setAttribute('hidden', '');
    if (typingSection) typingSection.removeAttribute('hidden');
    /* productSection intentionally left unchanged — stays visible */
  }

  function openPanel() {
    showSearchesView();
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
  }

  function closePanel() {
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
  }

  /* Mirror Dawn's predictive search results into ws-fp-typing.
     Only switch the top section once real results exist — avoids a blank-panel flicker. */
  if (dawnPanel && typingSection) {
    var observer = new MutationObserver(function () {
      if (!input.value.trim()) return;
      var hasResults = !!dawnPanel.querySelector('#predictive-search-results');
      if (hasResults) {
        typingSection.innerHTML = dawnPanel.innerHTML;

        /* Move products group before suggestions group so products sit on the left / top */
        var grpWrapper = typingSection.querySelector('.predictive-search__results-groups-wrapper');
        if (grpWrapper) {
          var groups = grpWrapper.querySelectorAll(':scope > .predictive-search__result-group');
          if (groups.length >= 2) {
            grpWrapper.insertBefore(groups[1], groups[0]);
          }
          /* Apply ws-fp-heading class so headings are identical to POPULAR RIGHT NOW */
          grpWrapper.querySelectorAll('.predictive-search__heading').forEach(function (h) {
            h.classList.add('ws-fp-heading');
          });
        }

        showTypingView();
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
      }
    });
    observer.observe(dawnPanel, { childList: true, subtree: true });
  }

  /* "Search for X" button inside the mirrored results */
  if (typingSection) {
    typingSection.addEventListener('click', function (e) {
      var btn = e.target.closest('.predictive-search__item--term');
      if (btn) {
        e.preventDefault();
        var term = input.value.trim();
        if (term) addRecent(term);
        closePanel();
        if (frm) frm.submit();
      }
    });
  }

  /* Clickable collection tags — stopPropagation prevents the parent product link from also firing */
  panel.addEventListener('click', function (e) {
    var tag = e.target.closest('.ws-fp-tag[data-href]');
    if (tag) {
      e.preventDefault();
      e.stopPropagation();
      window.location.href = tag.getAttribute('data-href');
    }
  });

  input.addEventListener('focus', function () {
    if (!input.value.trim()) {
      openPanel();
    } else {
      /* Re-focused with existing text: keep panel open in its current view */
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
    }
  });

  input.addEventListener('input', function () {
    /* Keep panel open regardless. While typing, leave the searches/products visible
       until MutationObserver delivers real results — avoids a blank-panel flicker.
       When cleared, switch back to searches view. */
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    if (!input.value.trim()) {
      showSearchesView();
    }
  });

  var frm = input.closest('form');
  if (frm) {
    frm.addEventListener('submit', function () {
      var term = input.value.trim();
      if (term) addRecent(term);
      closePanel();
    });
    /* Reset button (clear X inside search bar) — close the panel */
    frm.addEventListener('reset', function () {
      setTimeout(function () { closePanel(); }, 0);
    });
  }

  if (closeBtn) closeBtn.addEventListener('click', function () { closePanel(); input.blur(); });

  if (clearBtn) clearBtn.addEventListener('click', function () {
    clearRecent();
    renderSearches();
  });

  document.addEventListener('click', function (e) {
    if (ws ? !ws.contains(e.target) : (!panel.contains(e.target) && e.target !== input)) closePanel();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closePanel();
  });
})();
</script>

{% schema %}
{
