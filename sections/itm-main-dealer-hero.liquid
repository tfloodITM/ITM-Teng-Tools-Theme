<section
  class="dealer-hero"
  style="
    --media-max: {{ section.settings.media_max_height }}px;
    --logo-max: {{ section.settings.info_image_max_width }}px;
  "
>
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <div class="dealer-hero__grid">

        <!-- LEFT: Info column (IMG, H1, Text, Button) -->
        <div class="dealer-hero__col dealer-hero__info">
          {% if section.settings.info_image != blank %}
            <div class="dealer-hero__logo">
              {{
                section.settings.info_image
                | image_url: width: 600
                | image_tag: loading: 'lazy', alt: section.settings.heading
              }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="dealer-hero__title">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.body != blank %}
            <div class="dealer-hero__body rte">{{ section.settings.body }}</div>
          {% endif %}

          {% if section.settings.cta_label != blank %}
            <a class="button" href="{{ section.settings.cta_link | default: '#' }}">
              {{ section.settings.cta_label }}
            </a>
          {% endif %}
        </div>

        <!-- RIGHT: Main image -->
        <div class="dealer-hero__col dealer-hero__media">
          {% if section.settings.side_image != blank %}
            {{
              section.settings.side_image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: section.settings.side_image_alt | default: section.settings.heading
            }}
          {% endif %}
        </div>

      </div>
    </div>
  </div>

  <style>
    .dealer-hero {
      position: relative;
    }

    /* Comfy vertical padding */
    .dealer-hero .page-width {
      padding-top: clamp(32px, 4vw, 64px);
      padding-bottom: clamp(32px, 4vw, 64px);
    }

    .dealer-hero__grid {
      display: grid;
      /* 60% text / 40% image */
      grid-template-columns: 3fr 2fr;
      gap: clamp(24px, 4vw, 48px);
      align-items: center;
    }

    .dealer-hero__col {
      position: relative;
    }

    .dealer-hero__info {
      display: grid;
      gap: clamp(12px, 1.5vw, 20px);
      padding-right: clamp(8px, 1vw, 16px);
    }

    .dealer-hero__logo img {
      max-width: var(--logo-max, 220px);
      height: auto;
      display: block;
    }

    .dealer-hero__title {
      margin: 0;
      font-size: clamp(1.4rem, 3.3vw, 2rem);
      line-height: 1.1;
      text-align: left;
    }

    .dealer-hero__body {
      opacity: 0.95;
    }

    /* Right column: keep image fully visible without cropping */
    .dealer-hero__media {
      display: grid;
      place-items: center;
      padding-left: clamp(8px, 1vw, 16px);
    }

    .dealer-hero__media img {
      max-width: 100%;
      max-height: var(--media-max, 560px);
      width: auto;
      height: auto;
      object-fit: contain; /* no cropping */
      display: block;
      border-radius: var(--radius, 0);
    }

    /* Mobile stack */
    @media (max-width: 989px) {
      .dealer-hero__grid {
        grid-template-columns: 1fr;
      }
      .dealer-hero__media {
        padding-left: 0;
      }
      .dealer-hero__media img {
        max-height: none;
        width: 100%;
        height: auto;
      }
    }
    .dealer-hero__media {
    display: grid;
    place-items: center;
    padding-left: clamp(8px, 1vw, 16px);
  }

  .dealer-hero__media img {
    /* Slider now controls BOTH dimensions */
    max-width: var(--media-max, 560px);
    max-height: var(--media-max, 560px);

    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: var(--radius, 0);
  }

  @media (max-width: 989px) {
    .dealer-hero__media {
      padding-left: 0;
    }
    .dealer-hero__media img {
      max-width: 100%;
      max-height: none; /* let it flow on mobile */
      width: 100%;
      height: auto;
    }
  }
  </style>

  {% schema %}
  {
    "name": "Dealer network hero",
    "settings": [
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },

      { "type": "image_picker", "id": "info_image", "label": "Info image (left column)" },
      { "type": "range", "id": "info_image_max_width", "label": "Info Image Max Width (px)", "min": 80, "max": 480, "step": 10, "default": 220 },

      { "type": "text", "id": "heading", "label": "Heading", "default": "Find a dealer near you" },
      { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Search our nationwide network of trusted dealers for sales, service and support.</p>" },

      { "type": "text", "id": "cta_label", "label": "Button label", "default": "Open dealer locator" },
      { "type": "url", "id": "cta_link", "label": "Button link" },

      { "type": "image_picker", "id": "side_image", "label": "Right column image" },
      { "type": "text", "id": "side_image_alt", "label": "Right image alt text", "default": "Dealer network" },
      { "type": "range", "id": "media_max_height", "label": "Right Image Max Height (px)", "min": 240, "max": 1000, "step": 20, "default": 560 }
    ],
    "presets": [
      { "name": "Dealer hero" }
    ]
  }
  {% endschema %}
</section>
