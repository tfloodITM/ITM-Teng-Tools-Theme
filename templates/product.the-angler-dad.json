    "custom_liquid_xcRbVR": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- assign guided = all_products['wsgfs221'] -%}\n{%- assign folding = all_products['wsedcffs'] -%}\n{%- assign component_total = 0 -%}\n{%- if guided != empty %}{% assign component_total = component_total | plus: guided.price %}{% endif -%}\n{%- if folding != empty %}{% assign component_total = component_total | plus: folding.price %}{% endif -%}\n{%- assign savings = component_total | minus: product.price -%}\n\n<div class=\"adb-root\">\n<style>\n  .adb-root{\n    --adb-black:#1c1c1c;--adb-gold:#e0a534;--adb-gold-dark:#c88f26;\n    --adb-gray:#f2f1ee;--adb-text:#232323;--adb-muted:#6b6b6b;--adb-border:#e5e2db;\n    font-family:inherit;color:var(--adb-text);line-height:1.55;\n  }\n  .adb-root *{box-sizing:border-box;}\n  .adb-root h1,.adb-root h2,.adb-root h3,.adb-root h4{margin:0;letter-spacing:.3px;}\n  .adb-root .adb-wrap{max-width:1080px;margin:0 auto;padding:0 24px;}\n  .adb-root .adb-eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:12px;font-weight:700;color:var(--adb-gold-dark);}\n  .adb-root .adb-btn{display:inline-block;background:var(--adb-gold);color:var(--adb-black);font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:16px 36px;border:0;border-radius:3px;text-decoration:none;font-size:15px;cursor:pointer;}\n  .adb-root .adb-btn:hover{background:var(--adb-gold-dark);}\n  .adb-root .adb-sec{padding:64px 0;}\n  .adb-root .adb-alt{background:var(--adb-gray);}\n  .adb-root .adb-hero{background:var(--adb-black);color:#fff;padding:70px 0;text-align:center;}\n  .adb-root .adb-hero .adb-eyebrow{color:var(--adb-gold);}\n  .adb-root .adb-hero h1{font-size:38px;color:#fff;margin:14px auto 18px;max-width:780px;}\n  .adb-root .adb-hero p{max-width:620px;margin:0 auto 28px;color:#d8d8d8;font-size:17px;}\n  .adb-root .adb-hero-stats{display:flex;gap:36px;justify-content:center;margin-top:34px;flex-wrap:wrap;}\n  .adb-root .adb-hero-stats div{font-size:13px;color:#bdbdbd;text-align:center;}\n  .adb-root .adb-hero-stats strong{display:block;color:#fff;font-size:20px;}\n  .adb-root .adb-story{display:grid;grid-template-columns:1fr 1.25fr;gap:48px;align-items:center;}\n  .adb-root .adb-story-quote{background:#fff;border-left:4px solid var(--adb-gold);padding:22px 26px;font-size:18px;font-style:italic;margin:22px 0;}\n  .adb-root .adb-story-quote span{display:block;font-style:normal;font-size:13px;color:var(--adb-muted);margin-top:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;}\n  .adb-root .adb-story-img{border-radius:8px;overflow:hidden;}\n  .adb-root .adb-story-img img{width:100%;height:auto;display:block;}\n  .adb-root .adb-objections h2{text-align:center;font-size:28px;margin-bottom:8px;}\n  .adb-root .adb-sub{text-align:center;color:var(--adb-muted);max-width:600px;margin:0 auto 40px;}\n  .adb-root .adb-obj-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}\n  .adb-root .adb-obj-card{background:#fff;border:1px solid var(--adb-border);border-radius:8px;padding:26px 20px;}\n  .adb-root .adb-obj-card .adb-tag{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#b23b3b;font-weight:700;margin-bottom:10px;}\n  .adb-root .adb-obj-card h4{font-size:16px;margin-bottom:10px;}\n  .adb-root .adb-obj-card p{font-size:14px;color:var(--adb-muted);margin:0;}\n  .adb-root .adb-proquotes h2{text-align:center;font-size:28px;}\n  .adb-root .adb-pq-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}\n  .adb-root .adb-pq-card{background:#fff;border:1px solid var(--adb-border);border-radius:8px;padding:24px;}\n  .adb-root .adb-pq-card .adb-stars{color:var(--adb-gold-dark);font-size:14px;margin-bottom:10px;}\n  .adb-root .adb-pq-card p.adb-quote{font-size:15px;margin:0 0 14px;}\n  .adb-root .adb-pq-name{font-size:13px;font-weight:700;}\n  .adb-root .adb-pq-role{font-size:12px;color:var(--adb-muted);}\n  .adb-root .adb-compare h2{text-align:center;font-size:28px;margin-bottom:40px;}\n  .adb-root .adb-compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}\n  .adb-root .adb-compare-card{background:#fff;border:1px solid var(--adb-border);border-radius:8px;padding:28px;}\n  .adb-root .adb-compare-card .adb-media{display:flex;align-items:center;gap:12px;margin-bottom:16px;}\n  .adb-root .adb-compare-card .adb-media img{width:56px;height:56px;object-fit:contain;border-radius:6px;background:var(--adb-gray);}\n  .adb-root .adb-compare-card h3{font-size:18px;margin-bottom:2px;}\n  .adb-root .adb-compare-card .adb-price{font-size:13px;color:var(--adb-muted);}\n  .adb-root .adb-compare-card .adb-when{font-size:13px;color:var(--adb-gold-dark);font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin:14px 0 16px;}\n  .adb-root .adb-compare-card ul{padding-left:18px;margin:0;font-size:14px;}\n  .adb-root .adb-compare-card li{margin-bottom:6px;}\n  .adb-root .adb-trustbar{display:flex;justify-content:center;gap:56px;flex-wrap:wrap;text-align:center;padding:36px 0;border-top:1px solid var(--adb-border);border-bottom:1px solid var(--adb-border);}\n  .adb-root .adb-trustbar div{font-size:13px;max-width:150px;color:var(--adb-muted);}\n  .adb-root .adb-trustbar strong{display:block;font-size:15px;color:var(--adb-text);margin-bottom:4px;}\n  .adb-root .adb-urgency{background:var(--adb-black);color:#fff;text-align:center;padding:34px 0;}\n  .adb-root .adb-urgency .adb-eyebrow{color:var(--adb-gold);}\n  .adb-root .adb-urgency h3{color:#fff;font-size:22px;margin:10px 0 6px;}\n  .adb-root .adb-urgency p{color:#c9c9c9;font-size:14px;margin:0;}\n  .adb-root .adb-faq h2{text-align:center;font-size:28px;margin-bottom:36px;}\n  .adb-root .adb-faq-item{border-bottom:1px solid var(--adb-border);padding:6px 0;}\n  .adb-root .adb-faq-item summary{font-size:15px;font-weight:700;padding:14px 0;cursor:pointer;list-style:none;}\n  .adb-root .adb-faq-item summary::-webkit-details-marker{display:none;}\n  .adb-root .adb-faq-item summary:after{content:\"+\";float:right;color:var(--adb-gold-dark);font-weight:700;}\n  .adb-root .adb-faq-item[open] summary:after{content:\"\\2013\";}\n  .adb-root .adb-faq-item p{font-size:14px;color:var(--adb-muted);margin:0 0 16px;}\n  .adb-root .adb-finalcta{text-align:center;background:var(--adb-gray);padding:60px 0;}\n  .adb-root .adb-finalcta h2{font-size:26px;margin-bottom:10px;}\n  .adb-root .adb-finalcta p{color:var(--adb-muted);margin-bottom:24px;}\n  .adb-root .adb-price-line{font-size:15px;color:var(--adb-muted);margin-top:16px;}\n  .adb-root .adb-price-line s{color:#b0b0b0;}\n  .adb-root .adb-price-line strong{color:var(--adb-text);font-size:18px;}\n  .adb-root .adb-savings{display:inline-block;margin-top:10px;background:#eef7ee;color:#2f6b2f;font-weight:700;font-size:13px;padding:6px 14px;border-radius:20px;}\n  @media(max-width:800px){\n    .adb-root .adb-story{grid-template-columns:1fr;}\n    .adb-root .adb-obj-grid{grid-template-columns:1fr 1fr;}\n    .adb-root .adb-pq-grid{grid-template-columns:1fr;}\n    .adb-root .adb-compare-grid{grid-template-columns:1fr;}\n  }\n</style>\n\n<!-- HERO -->\n<div class=\"adb-hero\">\n  <div class=\"adb-wrap\">\n    <div class=\"adb-eyebrow\">Father's Day &middot; The Angler Dad Bundle</div>\n    <h1>The Difference Between A Story About \"The One That Got Away\" And A Photo Of The One He Caught.</h1>\n    <p>A dull hook loses fish. A dull knife wastes the catch. This Father's Day, give the angler in your life the two tools that keep every edge &mdash; hook to fillet knife &mdash; sharp from the tackle box to the cleaning table.</p>\n    {% form 'product', product %}\n      <input type=\"hidden\" name=\"id\" value=\"{{ product.selected_or_first_available_variant.id }}\">\n      <button type=\"submit\" name=\"add\" class=\"adb-btn\">Shop The Angler Dad Bundle &mdash; {{ product.price | money }}</button>\n    {% endform %}\n    <div class=\"adb-hero-stats\">\n      <div><strong>4.9&#9733;</strong>1,500+ Reviews</div>\n      <div><strong>3 Yrs</strong>Warranty</div>\n      <div><strong>30 Days</strong>Money-Back</div>\n      <div><strong>2-in-1</strong>Pocket + Full Kit</div>\n    </div>\n  </div>\n</div>\n\n<!-- STORY -->\n<div class=\"adb-sec\">\n  <div class=\"adb-wrap\">\n    <div class=\"adb-story\">\n      <div>\n        <div class=\"adb-eyebrow\">Sharp Matters</div>\n        <h2 style=\"font-size:26px;margin:10px 0 16px;\">Even The Pros Miss Fish Over A Dull Hook</h2>\n        <p style=\"color:var(--adb-muted);\">Richy Harrod, Work Sharp's Lead Brand Ambassador, was on a hot walleye bite &mdash; hooking up again and again with a lure that had worked hundreds of times before. Then he started missing hook sets. Again. And again.</p>\n        <div class=\"adb-story-quote\">\n          \"I quickly checked the sharpness of the hook and found it 'dull as a post!' ... Once my hook was again laser sharp, I never missed a fish and we had an amazing day on the water.\"\n          <span>Richy Harrod &mdash; Lead Brand Ambassador, Work Sharp</span>\n        </div>\n        <p style=\"color:var(--adb-muted);font-size:14px;\">The fix takes 7&ndash;8 passes through a diamond groove. The Guided Field Sharpener in this bundle has that exact groove built in &mdash; so it's not a \"someday\" tool, it's the one already sitting in the tackle box when it matters.</p>\n      </div>\n      <div class=\"adb-story-img\"><img src=\"https://cdn.shopify.com/s/files/1/0778/6928/5630/files/ddc58593-8419-45e2-a449-748c62f93d6e.png?v=1785104083\" alt=\"Sharpening a fish hook on the water with the Work Sharp Guided Field Sharpener\" loading=\"lazy\"></div>\n    </div>\n  </div>\n</div>\n\n<!-- OBJECTIONS -->\n<div class=\"adb-sec adb-alt adb-objections\">\n  <div class=\"adb-wrap\">\n    <h2>Before You Add To Cart, Dad's Already Asking...</h2>\n    <p class=\"adb-sub\">The honest answers to what he'd actually say if he saw this in his stocking.</p>\n    <div class=\"adb-obj-grid\">\n      <div class=\"adb-obj-card\">\n        <div class=\"adb-tag\">\"I've already got one\"</div>\n        <h4>These aren't duplicates &mdash; they're a system.</h4>\n        <p>The Folding Sharpener rides in his pocket for a mid-cast touch-up. The Guided Field Sharpener stays in the tackle box or truck for full trip-prep &mdash; coarse to razor edge, plus a hook groove and fish-safe fillet honing the folding one doesn't have.</p>\n      </div>\n      <div class=\"adb-obj-card\">\n        <div class=\"adb-tag\">\"I'll mess it up\"</div>\n        <h4>Built-in angle guides do the thinking.</h4>\n        <p>20&deg;/25&deg; guides lock the angle for him &mdash; no freehand guesswork, no ruined edge. If he can run a hook through a slot 7&ndash;8 times, he can use this. That's the whole skill required.</p>\n      </div>\n      <div class=\"adb-obj-card\">\n        <div class=\"adb-tag\">\"Is it worth it?\"</div>\n        <h4>It's the tool between him and the fish.</h4>\n        <p>A $40 lure with a dull hook catches nothing. A $150 knife that won't hold an edge ruins the fillet. This bundle protects every dollar already spent on gear &mdash; and every fish he brings home.</p>\n      </div>\n      <div class=\"adb-obj-card\">\n        <div class=\"adb-tag\">\"Will it get there in time?\"</div>\n        <h4>In stock, ready to ship now.</h4>\n        <p>Father's Day (AU) lands Sunday, 6 September 2026. Order now and it's on the porch with plenty of room to spare &mdash; no last-minute panic-buying a gift card.</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- PRO STAFF QUOTES -->\n<div class=\"adb-sec adb-proquotes\">\n  <div class=\"adb-wrap\">\n    <h2>Trusted By The People Who Fish For A Living</h2>\n    <p class=\"adb-sub\">Not paid actors. Work Sharp's own pro staff and brand ambassadors reach for the Guided Field Sharpener on every trip.</p>\n    <div class=\"adb-pq-grid\">\n      <div class=\"adb-pq-card\">\n        <div class=\"adb-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"adb-quote\">\"I keep a Work Sharp Guided Field Sharpener nearby and religiously sharpen each of my lures before fishing. If the hook doesn't easily scratch the back of your fingernail, it needs to be sharpened.\"</p>\n        <div class=\"adb-pq-name\">Danny Coyne</div>\n        <div class=\"adb-pq-role\">Work Sharp Pro Staffer, Trout &amp; Kokanee Expert</div>\n      </div>\n      <div class=\"adb-pq-card\">\n        <div class=\"adb-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"adb-quote\">\"Upholding the integrity of the meat from a fish requires a razor sharp blade &mdash; one that won't tear at the delicate meat as you clean and portion out your catch. That's why we recommend having a Guided Field Sharpener in the tackle box, your fishing bib, or carrying pack.\"</p>\n        <div class=\"adb-pq-name\">Bobby &amp; Robin Shindelar</div>\n        <div class=\"adb-pq-role\">Founders, Western Ice Fishing Association</div>\n      </div>\n      <div class=\"adb-pq-card\">\n        <div class=\"adb-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"adb-quote\">\"My favorite sharpener for out in the field is the Guided Field Sharpener because I can carry it with me anywhere.\"</p>\n        <div class=\"adb-pq-name\">Ben Saurman</div>\n        <div class=\"adb-pq-role\">In-House Fishing Expert, Work Sharp</div>\n      </div>\n      <div class=\"adb-pq-card\">\n        <div class=\"adb-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"adb-quote\">\"When it comes time to clean a limit of trout... the blade should be clean and sharp. If it needs a touch-up, take a few swipes on the Work Sharp Guided Field Sharpener.\"</p>\n        <div class=\"adb-pq-name\">Gary Lewis</div>\n        <div class=\"adb-pq-role\">Work Sharp Pro Staff</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- COMPARISON -->\n<div class=\"adb-sec adb-alt adb-compare\">\n  <div class=\"adb-wrap\">\n    <h2>One Bundle. Every Moment Covered.</h2>\n    <div class=\"adb-compare-grid\">\n      <div class=\"adb-compare-card\">\n        <div class=\"adb-media\">\n          {% if folding != empty and folding.featured_image %}<img src=\"{{ folding.featured_image | image_url: width: 112 }}\" alt=\"{{ folding.title | escape }}\">{% endif %}\n          <div>\n            <h3>{% if folding != empty %}{{ folding.title }}{% else %}Folding Field Sharpener{% endif %}</h3>\n            {% if folding != empty %}<div class=\"adb-price\">{{ folding.price | money }}</div>{% endif %}\n          </div>\n        </div>\n        <div class=\"adb-when\">For: mid-cast, pocket, quick touch-ups</div>\n        <ul>\n          <li>400 grit diamond plate + 20&deg; guide</li>\n          <li>Fine ceramic plate + 25&deg; guide</li>\n          <li>Glass-filled nylon frame, folds shut</li>\n          <li>Metal pivot + pocket clip &mdash; clips to a vest or waders</li>\n          <li>Ultra-compact, goes wherever he goes</li>\n        </ul>\n      </div>\n      <div class=\"adb-compare-card\">\n        <div class=\"adb-media\">\n          {% if guided != empty and guided.featured_image %}<img src=\"{{ guided.featured_image | image_url: width: 112 }}\" alt=\"{{ guided.title | escape }}\">{% endif %}\n          <div>\n            <h3>{% if guided != empty %}{{ guided.title }}{% else %}Guided Field Sharpener{% endif %}</h3>\n            {% if guided != empty %}<div class=\"adb-price\">{{ guided.price | money }}</div>{% endif %}\n          </div>\n        </div>\n        <div class=\"adb-when\">For: tackle box, boat, full trip-prep</div>\n        <ul>\n          <li>220 grit coarse + 600 grit fine diamond plates (magnetic swap)</li>\n          <li>Fine ceramic rod with dedicated hook-sharpening groove</li>\n          <li>Second ceramic rod for serrations</li>\n          <li>Leather strop with chromium oxide compound for a razor finish</li>\n          <li>Broadhead wrench + lanyard hole, 4.6oz, 3-year warranty</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- TRUST BAR -->\n<div class=\"adb-wrap\">\n  <div class=\"adb-trustbar\">\n    <div><strong>3-Year Warranty</strong>Every Work Sharp tool, backed.</div>\n    <div><strong>30-Day Money Back</strong>No-questions-asked returns.</div>\n    <div><strong>1,500+ Reviews</strong>4.9 average rating.</div>\n    <div><strong>Guidefitter Partner</strong>Used by 450+ professional hunting &amp; fishing outfitters.</div>\n  </div>\n</div>\n\n<!-- URGENCY -->\n<div class=\"adb-urgency\">\n  <div class=\"adb-wrap\">\n    <div class=\"adb-eyebrow\">Father's Day is Sunday, 6 September 2026</div>\n    <h3>In Stock, Ready To Ship Today</h3>\n    <p>Order now to make sure it's wrapped and ready &mdash; not stuck in transit.</p>\n  </div>\n</div>\n\n<!-- FAQ -->\n<div class=\"adb-sec adb-faq\">\n  <div class=\"adb-wrap\">\n    <h2>Still Deciding?</h2>\n    <details class=\"adb-faq-item\">\n      <summary>Does he need to buy anything else to use it?</summary>\n      <p>No. Both sharpeners come ready to use out of the box &mdash; diamond plates, ceramic rods and (on the Guided Field Sharpener) a leather strop are all included. Nothing extra required.</p>\n    </details>\n    <details class=\"adb-faq-item\">\n      <summary>Is it only for knives?</summary>\n      <p>No &mdash; this bundle also handles fish hooks, broadheads, small axes, scissors and serrated blades. If Dad hunts as well as fishes, it covers that gear too.</p>\n    </details>\n    <details class=\"adb-faq-item\">\n      <summary>What if he's never sharpened anything in his life?</summary>\n      <p>That's exactly who this is built for. The angle guides remove the guesswork &mdash; there's no freehand technique to learn, just follow the built-in slot.</p>\n    </details>\n    <details class=\"adb-faq-item\">\n      <summary>What's the return policy if he already has a favourite sharpener?</summary>\n      <p>30-day money-back guarantee, no questions asked. Every Work Sharp product also carries a 3-year warranty.</p>\n    </details>\n  </div>\n</div>\n\n<!-- FINAL CTA -->\n<div class=\"adb-finalcta\">\n  <div class=\"adb-wrap\">\n    <h2>Give The Gift That Makes Every Trip Better</h2>\n    <p>The Angler Dad Bundle &mdash; Folding Field Sharpener + Guided Field Sharpener</p>\n    {% form 'product', product %}\n      <input type=\"hidden\" name=\"id\" value=\"{{ product.selected_or_first_available_variant.id }}\">\n      <button type=\"submit\" name=\"add\" class=\"adb-btn\">Add To Cart &mdash; {{ product.price | money }}</button>\n    {% endform %}\n    {% if guided != empty and folding != empty %}\n      <div class=\"adb-price-line\">\n        Buy separately: {{ folding.title }} {{ folding.price | money }} + {{ guided.title }} {{ guided.price | money }} = <s>{{ component_total | money }}</s>\n        &nbsp;&rarr;&nbsp; <strong>This bundle: {{ product.price | money }}</strong>\n      </div>\n      {% if savings > 0 %}<div class=\"adb-savings\">You save {{ savings | money }} bundling today</div>{% endif %}\n    {% endif %}\n  </div>\n</div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
