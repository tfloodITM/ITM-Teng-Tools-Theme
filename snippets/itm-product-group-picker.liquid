    layout/sidebar. z-index above the sticky Model/Price columns (3)
    since it needs to sit on top of the whole table, not behind it.
  {%- endcomment -%}
  .itm-pg-picker__floating-scroll {
    position: fixed;
    bottom: 0;
    height: 14px;
    z-index: 10;
    overflow-x: scroll;
    overflow-y: hidden;
