{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

{%- comment -%}
  ===== Modern app-style flyout list =====
  Top-level items get an icon in a soft, brand-tinted rounded square, the
  label, and a chevron — same shape as any category-list app menu. Shopify
  navigation links have no icon field of their own, so the icon is guessed
  from the link's own title (matching this theme's existing sharpening-
  capability icon set where the title mentions one) with a plain generic
  icon as the fallback for anything that doesn't match (accessories, gift
  cards, etc.) — there's no way to know the merchant's real menu titles
  ahead of time, so this degrades gracefully rather than guessing wrong.
{%- endcomment -%}
<style>
  /* Sits snug under the header — Dawn's own 3rem top padding is why it
     didn't before. (header.liquid already zeroes this too; repeated here so
     this snippet's own look doesn't depend on that other file.) */
  .menu-drawer__navigation{ padding-top:0 !important; padding-bottom:1rem; }
  .menu-drawer__menu.has-submenu.list-menu{ padding-top:2px; }
  .js .menu-drawer__menu li{ margin-bottom:0; }

  .itm-drawer-row{
    display:flex;
    align-items:center;
    gap:14px;
    width:100%;
    padding:12px 20px !important;
    border-bottom:1px solid rgba(0,0,0,.07);
    text-decoration:none;
  }
  .menu-drawer summary.menu-drawer__menu-item.itm-drawer-row{ padding-right:20px; }
  .itm-drawer-icon{
    flex:0 0 auto;
    width:40px;
    height:40px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    overflow:hidden;
    /* richer gradient + outer glow + a glossy highlight along the top edge */
    background:linear-gradient(145deg, rgba(227,6,19,.42), rgba(227,6,19,.10));
    box-shadow:0 0 10px rgba(227,6,19,.35), inset 0 1px 0 rgba(255,255,255,.45);
  }
  /* the shiny edge itself — a soft light sweep across the top-left corner */
  .itm-drawer-icon::before{
    content:'';
    position:absolute;
    inset:0;
    background:linear-gradient(135deg, rgba(255,255,255,.5) 0%, rgba(255,255,255,0) 45%);
    pointer-events:none;
  }
  .itm-drawer-icon img{ width:28px; height:28px; object-fit:contain; display:block; position:relative; z-index:1; }
  .itm-drawer-icon svg{ width:24px; height:24px; color:#e30613; position:relative; z-index:1; }
  .itm-drawer-label{
    flex:1 1 auto;
    min-width:0;
    font-size:15px;
    font-weight:600;
    line-height:1.2;
    color:#1a1a1a;
  }
  .itm-drawer-arrow{ flex:0 0 auto; width:9px; height:9px; opacity:.4; }
  .itm-drawer-arrow svg{ width:100%; height:100%; display:block; }

  /* Sub-menu levels: same row shape, no icon card (they're inside a
     category already), slightly smaller label so the hierarchy still reads. */
  .menu-drawer__submenu .itm-drawer-row{ padding-left:20px !important; }
  .menu-drawer__submenu .itm-drawer-label{ font-size:14px; font-weight:500; }
  .menu-drawer__close-button.itm-drawer-row{ font-weight:700; border-bottom-width:2px; }

  /* Dawn's own open/close indicator icons still exist in the markup (JS
     elsewhere may expect them), just visually replaced by the chevron above. */
  .itm-drawer-row > .svg-wrapper{ display:none; }
</style>

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            {%- comment -%}
              No standard Shopify link has an icon field of its own, so this
              guesses one from the title, matched against the store's real
              uploaded menu icons, falling back to a plain generic icon (not
              another external asset — no 404 risk) for anything that doesn't
              match a keyword (Resources, Contact Us, etc.). It's a
              best-effort visual, not a merchant-configurable one, since a
              nav link has nowhere of its own to store an icon choice.
            {%- endcomment -%}
            {%- capture itm_drawer_chevron -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>{%- endcapture -%}
            {%- capture itm_drawer_fallback_icon -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>{%- endcapture -%}
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                {%- liquid
                  assign itm_lt = link.title | downcase
                  assign itm_icon_url = ''
                  if itm_lt contains 'electric'
                    assign itm_icon_url = 'https://cdn.shopify.com/s/files/1/0778/6928/5630/files/ad303b1a-afc3-4e32-b538-7cef36b4b82b.png?v=1787185870'
                  elsif itm_lt contains 'pocket' or itm_lt contains 'portable'
                    assign itm_icon_url = 'https://cdn.shopify.com/s/files/1/0778/6928/5630/files/4115f9d5-7fa0-45c1-9a70-14066ac18646.png?v=1787185870'
                  elsif itm_lt contains 'bench'
                    assign itm_icon_url = 'https://cdn.shopify.com/s/files/1/0778/6928/5630/files/a5e8f11a-6beb-4a29-950e-7ae6fea53068.png?v=1787185870'
                  elsif itm_lt contains 'kitchen'
                    assign itm_icon_url = 'https://cdn.shopify.com/s/files/1/0778/6928/5630/files/0a38c568-5801-40cc-99d9-272b037d6c56.png?v=1787185871'
                  elsif itm_lt contains 'accessor' or itm_lt contains 'parts'
                    assign itm_icon_url = 'https://cdn.shopify.com/s/files/1/0778/6928/5630/files/f75695ee-d6f7-4f63-808d-1b4a5d2a9fa1.png?v=1787185871'
                  endif
                -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset itm-drawer-row{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        <span class="itm-drawer-icon" aria-hidden="true">
                          {%- if itm_icon_url != blank -%}
                            <img src="{{ itm_icon_url }}" alt="" width="22" height="22" loading="lazy">
                          {%- else -%}
                            {{ itm_drawer_fallback_icon }}
                          {%- endif -%}
                        </span>
                        <span class="itm-drawer-label">{{ link.title | escape }}</span>
                        <span class="itm-drawer-arrow" aria-hidden="true">{{ itm_drawer_chevron }}</span>
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset itm-drawer-row" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            <span class="itm-drawer-label">{{ link.title | escape }}</span>
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset itm-drawer-row{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    <span class="itm-drawer-label">{{ childlink.title | escape }}</span>
                                    <span class="itm-drawer-arrow" aria-hidden="true">{{ itm_drawer_chevron }}</span>
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset itm-drawer-row"
                                    >
                                      <span class="itm-drawer-label">{{ childlink.title | escape }}</span>
                                      <span class="itm-drawer-arrow" aria-hidden="true">{{ itm_drawer_chevron }}</span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset itm-drawer-row"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        <span class="itm-drawer-label">{{ childlink.title | escape }}</span>
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset itm-drawer-row{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              <span class="itm-drawer-label">{{ grandchildlink.title | escape }}</span>
                                              <span class="itm-drawer-arrow" aria-hidden="true">{{ itm_drawer_chevron }}</span>
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset itm-drawer-row{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span class="itm-drawer-icon" aria-hidden="true">
                        {%- if itm_icon_url != blank -%}
                          <img src="{{ itm_icon_url }}" alt="" width="22" height="22" loading="lazy">
                        {%- else -%}
                          {{ itm_drawer_fallback_icon }}
                        {%- endif -%}
                      </span>
                      <span class="itm-drawer-label">{{ link.title | escape }}</span>
                      <span class="itm-drawer-arrow" aria-hidden="true">{{ itm_drawer_chevron }}</span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          <div class="menu-drawer__utility-links">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="menu-drawer__account link focus-inset h5 medium-hide large-up-hide"
                rel="nofollow"
              >
                {%- if section.settings.enable_customer_avatar -%}
                  <account-icon>
                    {%- if customer and customer.has_avatar? -%}
                      {{ customer | avatar }}
                    {%- else -%}
                      <span class="svg-wrapper">
                        {{- 'icon-account.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </account-icon>
                {%- else -%}
                  <span class="svg-wrapper">
                    {{- 'icon-account.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
            {%- if localization.available_countries or localization.available_languages -%}
              <div class="menu-drawer__localization header-localization">
                {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-twitter.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-facebook.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-pinterest.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-instagram.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tiktok.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tumblr.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-snapchat.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-youtube.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-vimeo.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
