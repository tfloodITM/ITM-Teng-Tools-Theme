{{ 'itm-cta.css' | asset_url | stylesheet_tag }}

{% comment %}
  Product group layout snippet for nested belt/accessory collections.
  Renders hero + card/table dual-view with client-side filter chips.
{% endcomment %}

{%- assign pg = collection -%}

{%- assign primary_product = nil -%}

{%- if pg.metafields.custom.primary_product_ref -%}
  {%- assign primary_product = pg.metafields.custom.primary_product_ref.value
    | default: pg.metafields.custom.primary_product_ref -%}
{%- endif -%}

{%- if primary_product == blank -%}
  {%- for p in pg.products -%}
    {%- if p.metafields.custom.primary_product -%}
      {%- assign prim_val = p.metafields.custom.primary_product.value
        | default: p.metafields.custom.primary_product -%}
      {%- if prim_val == true or prim_val == 'true' or prim_val == 1 or prim_val == '1' -%}
        {%- assign primary_product = p -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if primary_product == blank and pg.products.first -%}
  {%- assign primary_product = pg.products.first -%}
{%- endif -%}

{%- assign primary_sku = '' -%}
{%- if primary_product -%}
  {%- assign primary_sku = primary_product.selected_or_first_available_variant.sku | default: primary_product.title | strip -%}
{%- endif -%}

{%- comment -%}
  Teng Tools rebrand: the Work Sharp collection-suffix → compatible-product
  switch map was removed here (it only matched template suffixes belonging
  to the deleted Work Sharp "accessories to suit X" collection templates,
  so it was unreachable dead code). related_product is now always blank,
  which disables the "Compatible with" card/table below. If Teng needs an
  equivalent feature later, this is the spot to wire up a real lookup
  (e.g. a collection metafield naming the related product handle).
{%- endcomment -%}
{%- assign pg_compatible_handle = nil -%}
{%- assign pg_discontinued = false -%}
{%- assign related_product = all_products[pg_compatible_handle] -%}

<section class="pg">
  <div>

    {%- if pg != blank -%}
      <!-- HERO -->
      <div class="pg__hero{% if related_product != blank or pg_discontinued %} pg__hero--has-product{% if pg_discontinued %} pg__hero--has-discontinued{% endif %}{% endif %}">
        <div class="pg__hero-img">
          {%- if pg.image -%}
            {{ pg.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', alt: pg.title
            }}
          {%- elsif primary_sku != blank -%}
            <img
              src="{% render 'itm-cdn-product-image', sku: primary_sku, image_number: 1 %}"
              alt="{{ primary_product.title | default: pg.title | escape }}"
              width="600"
              height="600"
              style="width: 100%; height: auto; object-fit: contain;"
              loading="lazy"
            >
          {%- elsif pg.products.first -%}
            {%- assign first_sku = pg.products.first.selected_or_first_available_variant.sku | default: pg.products.first.title | strip -%}
            {%- if first_sku != blank -%}
              <img
                src="{% render 'itm-cdn-product-image', sku: first_sku, image_number: 1 %}"
                alt="{{ pg.products.first.title | escape }}"
                width="600"
                height="600"
                style="width: 100%; height: auto; object-fit: contain;"
                loading="lazy"
              >
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="pg__hero-text">
          <h2 class="pg__title">{{ pg.title }}</h2>

          {%- if primary_product
                and primary_product.metafields.custom.web_features
                and primary_product.metafields.custom.web_features.value != blank -%}
            <div class="pg__description rte">
              {{ primary_product.metafields.custom.web_features.value }}
            </div>
          {%- endif -%}
        </div>

        <aside class="pg__hero-ctas{% if related_product != blank %} pg__hero-ctas--has-card{% endif %}">
          {%- if related_product != blank -%}
            {%- assign rp_label      = section.settings.pg_related_card_label | default: 'Compatible with' -%}
            {%- assign rp_label_size = section.settings.pg_related_label_size | default: 16 -%}
            {%- assign rp_bg         = section.settings.pg_related_card_bg | default: '#ffffff' -%}
            {%- assign rp_text       = section.settings.pg_related_card_text_color | default: '#000000' -%}
            {%- assign rp_stars      = section.settings.pg_related_card_star_color | default: '#e30613' -%}
            {%- assign rp_border     = section.settings.pg_related_card_border_color | default: '#000000' -%}
            <p class="pg__related-eyebrow" style="font-size: {{ rp_label_size }}px;">{{ rp_label }}</p>
            <div class="sbc__card pg__hero-sbc-card" style="--pgc-card-bg:{{ rp_bg }};--pgc-card-text:{{ rp_text }};--pgc-card-stars:{{ rp_stars }};--pgc-card-border:{{ rp_border }};">
              {%- render 'itm-card-product-sbc',
                product: related_product,
                show_atc: true,
                show_reviews: true,
                show_price: true
              -%}
            </div>
          {%- else -%}
            {%- if settings.allow_external_stockist -%}
            <a href="https://www.industrialtool.com.au/stockists" class="button pg__btn pg__btn--icon">
              <span class="pg__icon" aria-hidden="true">
                {{ 'ITM-Binocular--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
              </span>
              Find a stockist
            </a>
            {%- endif -%}

            {%- if section.settings.pg_show_enquiry_cta != false -%}
            <a href="/pages/contact" class="button pg__btn pg__btn--icon">
              <span class="pg__icon" aria-hidden="true">
                {{ 'ITM-Paper-Write--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
              </span>
              Make an enquiry
            </a>
            {%- endif -%}
          {%- endif -%}

          {%- if primary_sku != blank -%}
            <a href="{% render 'itm-cdn-product-image', sku: primary_sku, media_type: 'brochure' %}" class="button pg__btn pg__btn--icon hidden" data-check-exists="true" target="_blank" rel="noopener noreferrer">
              <span class="pg__icon" aria-hidden="true">
                {{ 'ITM-Book-Open-Bookmark--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
              </span>
              Product Brochure
            </a>

            <a href="{% render 'itm-cdn-product-image', sku: primary_sku, media_type: 'manual' %}" class="button pg__btn pg__btn--icon hidden" data-check-exists="true" target="_blank" rel="noopener noreferrer">
              <span class="pg__icon" aria-hidden="true">
                {{ 'ITM-Book-Book-Pages--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
              </span>
              User Manual
            </a>
          {%- elsif primary_product -%}
            {%- if primary_product.metafields.itm_media.brochure_url -%}
              <a href="{{ primary_product.metafields.itm_media.brochure_url }}" class="button pg__btn pg__btn--icon" target="_blank" rel="noopener noreferrer">
                <span class="pg__icon" aria-hidden="true">
                  {{ 'ITM-Book-Open-Bookmark--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
                </span>
                Product Brochure
              </a>
            {%- endif -%}

            {%- if primary_product.metafields.itm_media.manual_url -%}
              <a href="{{ primary_product.metafields.itm_media.manual_url }}" class="button pg__btn pg__btn--icon" target="_blank" rel="noopener noreferrer">
                <span class="pg__icon" aria-hidden="true">
                  {{ 'ITM-Book-Book-Pages--Streamline-Ultimate.svg' | inline_asset_content | replace: '<svg', '<svg class="pg__icon-svg"' }}
                </span>
                User Manual
              </a>
            {%- endif -%}
          {%- endif -%}
        </aside>
      </div>

      {%- if pg.products_count > 0 -%}

        <!-- TOOLBAR: filter chips + search + view toggle -->
        <div class="pgc__toolbar">
          {%- unless template.suffix == 'to-suit-ws-2000300' or template.suffix == 'abrasive-field-guide-sha' or template.suffix == 'suit-precision-adj-pro' or template.suffix == 'to-suit-precision-adjust' -%}
          <div class="pgc__chips" id="pgc-chips">
            <button class="pgc__chip pgc__chip--active" data-filter="all">All</button>
            <button class="pgc__chip" data-filter="shaping">Shaping</button>
            <button class="pgc__chip" data-filter="sharpening">Sharpening</button>
            <button class="pgc__chip" data-filter="honing">Honing</button>
            <button class="pgc__chip" data-filter="polishing">Polishing</button>
          </div>
          {%- endunless -%}
          <div class="pgc__search-wrap">
            <svg class="pgc__search-icon" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6.5" stroke="currentColor" stroke-width="2"/><path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input type="search" id="pgc-search" class="pgc__search-input" placeholder="Search products…" autocomplete="off" spellcheck="false">
          </div>
          <div class="pgc__view-toggle" id="pgc-view-toggle">
            <button class="pgc__view-btn pgc__view-btn--active" data-view="card" title="Card view" aria-label="Card view">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="7" height="7" rx="1"/><rect x="9" y="0" width="7" height="7" rx="1"/><rect x="0" y="9" width="7" height="7" rx="1"/><rect x="9" y="9" width="7" height="7" rx="1"/></svg>
            </button>
            <button class="pgc__view-btn" data-view="table" title="Table view" aria-label="Table view">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="16" height="3" rx="1"/><rect x="0" y="4.5" width="16" height="3" rx="1"/><rect x="0" y="9" width="16" height="3" rx="1"/><rect x="0" y="13.5" width="16" height="2.5" rx="1"/></svg>
            </button>
          </div>
        </div>

        <!-- CARD GRID VIEW -->
        <div class="pgc__card-grid" id="pgc-card-grid">
          <div class="pgc__loading">Loading products…</div>
        </div>

        <!-- TABLE VIEW (hidden by default) -->
        <div class="pgc__table-wrap" id="pgc-table-wrap" style="display:none">
          <div class="pg__table-scroller">
            <table
              class="pg__table"
              data-collection-url="{{ pg.url }}"
              data-primary-sku="{{ primary_sku | escape }}"
            >
              <thead>
                <tr>
                  <th>Image</th>
                  <th>Code</th>
                  <th>Product Name</th>
                  <th>Specifications</th>
                  {%- unless settings.information_only_mode -%}
                  <th>Stock Level</th>
                  <th>Price / Add to cart</th>
                  {%- endunless -%}
                </tr>
              </thead>
              <tbody id="pg-table-body">
                <tr><td colspan="6" style="text-align:center;">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- BUNDLE STRIP -->
        <div class="pgc__bundle-strip" id="pgc-bundle-strip" style="display:none">
          <div class="pgc__bundle-header">
            <span class="pgc__bundle-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </span>
            <h3 class="pgc__bundle-title">Save with a complete set</h3>
          </div>
          <div class="pgc__bundle-cards" id="pgc-bundle-cards"></div>
        </div>

      {%- else -%}
        <p>No products in this product group.</p>
      {%- endif -%}

    {%- endif -%}
  </div>
</section>

<!-- Lightbox -->
<div class="pg-lightbox hidden" id="pg-lightbox">
  <button type="button" class="pg-lightbox__backdrop" aria-label="Close image"></button>
  <div class="pg-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Product image preview">
    <button type="button" class="pg-lightbox__close" aria-label="Close image">&times;</button>
    <img class="pg-lightbox__image" alt="">
  </div>
</div>

{% assign _placeholder_url = 'image_coming_soon.png' | asset_url %}
{% assign _stock_icon_svg = 'icon-inventory-status.svg' | inline_asset_content %}

<script>
var _pgStockIconSvg = {{ _stock_icon_svg | json }};
(function() {
  var PG_VIEW_KEY = 'pgc-view';
  var currentFilter = 'all';
  var currentSearch = '';
  var currentView = localStorage.getItem(PG_VIEW_KEY) || 'card';
  var allRows = [];

  var placeholderSrc = '{{ _placeholder_url }}';

  var table = document.querySelector('.pg__table[data-collection-url]');
  if (!table) return;

  var tbody = document.getElementById('pg-table-body');
  var cardGrid = document.getElementById('pgc-card-grid');
  var tableWrap = document.getElementById('pgc-table-wrap');
  var bundleStrip = document.getElementById('pgc-bundle-strip');
  var bundleCards = document.getElementById('pgc-bundle-cards');
  var lightbox = document.getElementById('pg-lightbox');
  var lightboxImage = lightbox ? lightbox.querySelector('.pg-lightbox__image') : null;

  var collectionUrl = table.getAttribute('data-collection-url');
  var primarySku = (table.getAttribute('data-primary-sku') || '').toLowerCase();
  var cartUI = document.querySelector('cart-drawer') || document.querySelector('cart-notification');

  // Apply stored view preference immediately (before AJAX completes)
  setView(currentView);

  // -- View toggle --
  function setView(view) {
    currentView = view;
    localStorage.setItem(PG_VIEW_KEY, view);
    document.querySelectorAll('.pgc__view-btn').forEach(function(btn) {
      btn.classList.toggle('pgc__view-btn--active', btn.dataset.view === view);
    });
    if (view === 'card') {
      cardGrid.style.display = '';
      tableWrap.style.display = 'none';
    } else {
      cardGrid.style.display = 'none';
      tableWrap.style.display = '';
    }
  }

  document.querySelectorAll('.pgc__view-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { setView(btn.dataset.view); });
  });

  // -- Filter chips --
  function beltCategory(usesText) {
    var u = (usesText || '').toLowerCase();
    if (u.indexOf('shaping') !== -1 || u.indexOf('shape') !== -1) return 'shaping';
    if (u.indexOf('honing') !== -1 || u.indexOf('strop') !== -1) return 'honing';
    if (u.indexOf('polish') !== -1) return 'polishing';
    if (u.indexOf('sharpen') !== -1) return 'sharpening';
    return 'other';
  }

  function matchesSearch(el, term) {
    if (!term) return true;
    var title = (el.dataset.productTitle || '').toLowerCase();
    var sku   = (el.dataset.sku || '').toLowerCase();
    return title.indexOf(term) !== -1 || sku.indexOf(term) !== -1;
  }

  function applyFilter(filter) {
    currentFilter = filter;
    var term = currentSearch.toLowerCase().trim();
    document.querySelectorAll('.pgc__chip').forEach(function(chip) {
      chip.classList.toggle('pgc__chip--active', chip.dataset.filter === filter);
    });
    document.querySelectorAll('#pgc-card-grid .pgc__card').forEach(function(card) {
      var isBundle = card.dataset.filterCat === 'bundle';
      var catMatch = isBundle || filter === 'all' || card.dataset.filterCat === filter;
      var show = catMatch && matchesSearch(card, term);
      card.style.display = show ? '' : 'none';
    });
    allRows.forEach(function(row) {
      var cat = beltCategory(row.dataset.uses || '');
      var catMatch = filter === 'all' || cat === filter;
      var show = catMatch && matchesSearch(row, term);
      row.style.display = show ? '' : 'none';
    });
    equaliseCardHeights();
  }

  document.querySelectorAll('.pgc__chip').forEach(function(chip) {
    chip.addEventListener('click', function() { applyFilter(chip.dataset.filter); });
  });

  var pgcSearchEl = document.getElementById('pgc-search');
  if (pgcSearchEl) {
    pgcSearchEl.addEventListener('input', function() {
      currentSearch = this.value;
      applyFilter(currentFilter);
    });
  }

  // -- Belt colour by type/grit --
  function beltColor(beltType, grit) {
    var t = (beltType || '').toLowerCase();
    if (t.indexOf('extra coarse') !== -1) return '#8B4513';
    if (t.indexOf('coarse') !== -1) return '#D35400';
    if (t.indexOf('medium') !== -1) return '#27AE60';
    if (t.indexOf('fine') !== -1) {
      var g = parseInt((grit || '').replace(/[^0-9]/g, ''), 10) || 0;
      return g >= 3000 ? '#1A252F' : '#2471A3';
    }
    return '#777';
  }

  function bundleColor() { return '#E67E22'; }

  // -- HTML escape for innerHTML --
  function esc(str) {
    return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // -- Format price --
  function formatPrice(priceNum) {
    if (!priceNum || priceNum <= 0) return '';
    return '$' + parseFloat(priceNum).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  // -- Build a card element from a <tr> row --
  function buildCard(row, isBundle) {
    var sku = row.dataset.sku || '';
    var variantId = row.dataset.variantId || '';
    var available = row.dataset.available === 'true';
    var invQty = parseInt(row.dataset.inventoryQty || '0', 10);
    var price = parseFloat(row.dataset.price || '0');
    var productUrl = row.dataset.productUrl || '';
    var productTitle = row.dataset.productTitle || sku;
    var imgSrc = row.dataset.imgSrc || placeholderSrc;
    var beltType = row.dataset.beltType || '';
    var grit = row.dataset.grit || '';
    var uses = row.dataset.uses || '';
    var beltMaterial = row.dataset.beltMaterial || '';
    var beltSize = row.dataset.beltSize || '';

    var inStock = invQty > 0 || (available && invQty === 0);
    var color = isBundle ? bundleColor() : beltColor(beltType, grit);
    var cat = beltCategory(uses);
    var priceStr = formatPrice(price);

    var card = document.createElement('div');
    card.className = isBundle ? 'pgc__card pgc__card--bundle' : 'pgc__card';
    card.dataset.filterCat = isBundle ? 'bundle' : cat;
    card.dataset.productTitle = productTitle;
    card.dataset.sku = sku;

    var stockIconClass = inStock ? 'pgc__inventory-icon--in' : 'pgc__inventory-icon--out';
    var stockLabel = inStock ? 'In Stock' : 'Out of Stock';
    var stockHtml =
      '<p class="pgc__inventory">' +
        '<span class="svg-wrapper pgc__inventory-icon ' + stockIconClass + '">' + (_pgStockIconSvg || '') + '</span>' +
        stockLabel +
      '</p>';

    var atcHtml = '';
    if (available) {
      atcHtml = '<form class="pgc__cart-form pg__cart-form" method="post" action="/cart/add">' +
        '<input type="hidden" name="id" value="' + esc(variantId) + '">' +
        '<input type="number" name="quantity" value="1" min="1" class="pgc__qty pg__qty-input" aria-label="Quantity">' +
        '<button type="submit" class="button button--primary pgc__atc-btn pg__cart-btn">Add to Cart</button>' +
        '</form>';
    } else {
      atcHtml = '<button class="button button--secondary pgc__atc-btn pg__cart-btn" disabled>Sold out</button>';
    }

    card.innerHTML =
      '<div class="pgc__stripe" style="background:' + color + '"></div>' +
      (isBundle ? '<span class="pgc__bundle-badge">Complete Set</span>' : '') +
      '<button type="button" class="pgc__img-btn pg__image-trigger" aria-label="Preview ' + esc(productTitle) + '">' +
        '<div class="pgc__img-wrap">' +
          '<img src="' + esc(imgSrc) + '" alt="' + esc(productTitle) + '" width="240" height="240" loading="lazy" onerror="this.src=\'' + placeholderSrc + '\'">' +
        '</div>' +
      '</button>' +
      '<div class="pgc__body">' +
        stockHtml +
        '<div class="pgc__meta">' +
          (grit ? '<span class="pgc__grit-chip" style="background:' + color + '">' + esc(grit) + '</span>' : '') +
          (beltType ? '<span class="pgc__type-label">' + esc(beltType) + '</span>' : '') +
        '</div>' +
        '<a class="pgc__sku" href="' + esc(productUrl) + '">' + esc(productTitle) + '</a>' +
        (uses ? '<div class="pgc__uses">' + esc(uses) + '</div>' : '') +
        ((beltMaterial || beltSize) ?
          '<div class="pgc__specs-mini">' +
            (beltMaterial ? '<span>' + esc(beltMaterial) + '</span>' : '') +
            (beltMaterial && beltSize ? '<span class="pgc__specs-sep">·</span>' : '') +
            (beltSize ? '<span>' + esc(beltSize) + '</span>' : '') +
          '</div>'
        : '') +
        '<div class="pgc__body-spacer"></div>' +
        (priceStr ? '<div class="pgc__price">' + priceStr + '</div>' : '') +
        atcHtml +
      '</div>';

    return card;
  }

  // -- Render all views after all pages fetched --
  function renderAll() {
    if (!allRows.length) {
      if (cardGrid) cardGrid.innerHTML = '<p style="color:#888">No products found.</p>';
      if (tbody) tbody.innerHTML = '<tr><td colspan="6">No products in this product group.</td></tr>';
      return;
    }

    // Sort by price ascending
    allRows.sort(function(a, b) {
      var ap = parseFloat(a.dataset.price || '0') || 0;
      var bp = parseFloat(b.dataset.price || '0') || 0;
      return ap - bp;
    });

    // Primary SKU to top
    if (primarySku) {
      for (var i = 0; i < allRows.length; i++) {
        if ((allRows[i].dataset.sku || '').toLowerCase() === primarySku) {
          allRows.unshift(allRows.splice(i, 1)[0]);
          break;
        }
      }
    }

    // Split bundles
    var mainRows = [];
    var bundleRows = [];
    allRows.forEach(function(row) {
      if (row.dataset.isBundle === 'true') {
        bundleRows.push(row);
      } else {
        mainRows.push(row);
      }
    });

    // Build table
    if (tbody) {
      tbody.innerHTML = '';
      allRows.forEach(function(row) { tbody.appendChild(row); });
    }

    // Build cards — bundles first (highlighted), then individual belts
    if (cardGrid) {
      cardGrid.innerHTML = '';
      bundleRows.forEach(function(row) {
        cardGrid.appendChild(buildCard(row, true));
      });
      mainRows.forEach(function(row) {
        cardGrid.appendChild(buildCard(row, false));
      });
    }

    // Apply view and filter
    setView(currentView);
    applyFilter(currentFilter);

    // Equalise card heights so ATCs line up across all rows
    equaliseCardHeights();
  }

  function equaliseCardHeights() {
    var cards = Array.prototype.slice.call(
      document.querySelectorAll('#pgc-card-grid .pgc__card')
    );
    if (!cards.length) return;
    cards.forEach(function(c) { c.style.height = ''; });
    requestAnimationFrame(function() {
      var max = 0;
      cards.forEach(function(c) {
        if (c.style.display !== 'none') max = Math.max(max, c.offsetHeight);
      });
      if (max > 0) {
        cards.forEach(function(c) {
          if (c.style.display !== 'none') c.style.height = max + 'px';
        });
      }
    });
  }

  // -- AJAX fetch --
  function fetchPage(url) {
    fetch(url)
      .then(function(resp) { return resp.text(); })
      .then(function(html) {
        var temp = document.createElement('div');
        temp.innerHTML = html;

        var pageRows = Array.prototype.slice.call(temp.querySelectorAll('tbody tr'));
        var nextEl = temp.querySelector('#pg-next-url');
        var nextUrl = nextEl ? nextEl.getAttribute('data-next-url') : '';

        allRows = allRows.concat(pageRows);

        if (nextUrl) {
          fetchPage(nextUrl);
        } else {
          renderAll();
        }
      })
      .catch(function(err) {
        console.error('Product group fetch failed', err);
        if (cardGrid) cardGrid.innerHTML = '<p style="color:#c00">Failed to load products.</p>';
        if (tbody) tbody.innerHTML = '<tr><td colspan="6">Failed to load products.</td></tr>';
      });
  }

  // -- ATC handler (delegated from section) --
  var pgSection = document.querySelector('section.pg');
  if (pgSection) {
    pgSection.addEventListener('submit', function(event) {
      var form = event.target.closest('form.pg__cart-form');
      if (!form) return;
      event.preventDefault();

      var submitButton = form.querySelector('[type="submit"]');
      if (submitButton && submitButton.getAttribute('aria-disabled') === 'true') return;
      var originalLabel = submitButton ? submitButton.textContent : '';

      if (submitButton) {
        submitButton.setAttribute('aria-disabled', 'true');
        submitButton.classList.add('loading');
        submitButton.textContent = 'Adding…';
      }

      var endpoint = (window.routes && window.routes.cart_add_url) || form.getAttribute('action') || '/cart/add';
      var formData = new FormData(form);

      if (cartUI && typeof cartUI.getSectionsToRender === 'function') {
        formData.append('sections', cartUI.getSectionsToRender().map(function(s) { return s.id; }).join(','));
        formData.append('sections_url', window.location.pathname);
        if (typeof cartUI.setActiveElement === 'function') cartUI.setActiveElement(document.activeElement);
      }

      var reqConfig = (typeof fetchConfig === 'function') ? fetchConfig('javascript') : { method: 'POST', headers: {} };
      reqConfig.headers = reqConfig.headers || {};
      reqConfig.headers['X-Requested-With'] = 'XMLHttpRequest';
      delete reqConfig.headers['Content-Type'];
      reqConfig.body = formData;

      fetch(endpoint, reqConfig)
        .then(function(r) { return r.json(); })
        .then(function(response) {
          if (response.status) {
            window.location = (window.routes && window.routes.cart_url) || '/cart';
            return;
          }
          if (cartUI && typeof cartUI.renderContents === 'function') {
            cartUI.renderContents(response);
          } else {
            window.location = (window.routes && window.routes.cart_url) || '/cart';
          }
        })
        .catch(function() {
          window.location = (window.routes && window.routes.cart_url) || '/cart';
        })
        .finally(function() {
          if (submitButton) {
            submitButton.classList.remove('loading');
            submitButton.removeAttribute('aria-disabled');
            submitButton.textContent = originalLabel;
          }
        });
    });
  }

  // -- Lightbox --
  function openLightbox(src, alt) {
    if (!lightbox || !lightboxImage) return;
    lightboxImage.setAttribute('src', src);
    lightboxImage.setAttribute('alt', alt || '');
    lightbox.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    if (lightboxImage) { lightboxImage.setAttribute('src', ''); lightboxImage.setAttribute('alt', ''); }
  }

  if (lightbox) {
    lightbox.addEventListener('click', function(e) {
      if (e.target.closest('.pg-lightbox__close') || e.target.closest('.pg-lightbox__backdrop')) closeLightbox();
    });
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) closeLightbox();
  });

  // Delegate lightbox trigger from entire section (covers table AND cards)
  document.addEventListener('click', function(event) {
    var trigger = event.target.closest('.pg__image-trigger');
    if (!trigger) return;
    event.preventDefault();
    var img = trigger.querySelector('img');
    if (img) {
      openLightbox(img.src || placeholderSrc, img.getAttribute('alt') || '');
    } else {
      openLightbox(placeholderSrc, '');
    }
  });

  // Re-equalise on resize (debounced)
  var _pgResizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(_pgResizeTimer);
    _pgResizeTimer = setTimeout(equaliseCardHeights, 120);
  });

  // Kick off
  fetchPage(collectionUrl + '?view=pg-table');
})();
</script>

