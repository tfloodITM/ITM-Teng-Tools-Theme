{%- capture icon_vices -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h6v6H3zM15 9h6v6h-6z"/><path d="M9 12h6M11 6v3M13 15v3"/></svg>{%- endcapture -%}
{%- capture icon_generic -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="1.2"/><rect x="13" y="4" width="7" height="7" rx="1.2"/><rect x="4" y="13" width="7" height="7" rx="1.2"/><rect x="13" y="13" width="7" height="7" rx="1.2"/></svg>{%- endcapture -%}

{%- style -%}
  /* position:relative + z-index lifts the whole menu (and its drop-down panels)
     above the trust/USP bar that sits in the next grid row */
  .itm-mega{ --mega-accent: {{ accent }}; width:100%; position:relative; z-index:5; }
  .itm-mega__bar{
    position:relative;
    display:flex;
    align-items:center;
    /* shrink the gap as the screen narrows so items never wrap (drawer takes over at <=989px) */
    gap:clamp(10px, 1.5vw, 28px);
    /* Same value as gap above, duplicated as a custom property so the
       hover ::before on .itm-mega__products-trigger (a descendant) can
       reference it in a calc() and extend exactly to the divider — gap
       itself isn't readable from CSS any other way, and it's a fluid
       clamp(), not a fixed px a comment could just repeat correctly at
       every viewport width. */
    --mega-gap:clamp(10px, 1.5vw, 28px);
    list-style:none;
    margin:0;
    padding:0;
    flex-wrap:nowrap;
  }
  .itm-mega__item{ margin:0; }
  .itm-mega__item--dropdown{ position:relative; }
  .itm-mega__top{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:{{ section.settings.nav_padding_y | default: 8 }}px 0;
    font-weight:700;
    font-size:{{ section.settings.nav_font_size | default: 15 }}px;
    letter-spacing:.01em;
    color:rgb(var(--color-foreground, 17,17,17));
    text-decoration:none;
    border-bottom:3px solid transparent;
    cursor:pointer;
    white-space:nowrap;
  }
  .itm-mega__item:hover > .itm-mega__top,
  .itm-mega__item:focus-within > .itm-mega__top{
    border-bottom-color:var(--mega-accent);
  }
  {%- comment -%}
    Products is exempt from the red hover-underline every other item gets —
    it already has its own full-cube hover highlight, and the border-bottom
    here isn't decorative for it in the first place: it's a load-bearing
    3px-transparent placeholder (see the big comment on
    .itm-mega__products-trigger above) that keeps its box exactly as tall
    as its siblings'. Turning it red on hover would work visually, but
    "transparent" is what that border is actually FOR here, so it stays
    transparent regardless of hover/focus state. Same specificity as the
    shared rule above (three class-level selectors each) — !important
    rather than relying on source order, since this needs to hold no
    matter where either rule ends up relative to the other.
  {%- endcomment -%}
  .itm-mega__item--products:hover > .itm-mega__top,
  .itm-mega__item--products:focus-within > .itm-mega__top{
    border-bottom-color:transparent !important;
  }
  {%- comment -%}
    Both "Products" and every top-level link's title used to be a bare
    text node dropped directly inside its inline-flex container (button
    or <a>). With no wrapping element, each becomes an ANONYMOUS flex
    item, and Chromium sizes those using font-metric heuristics that
    come out very slightly different depending on what icon markup sits
    next to the text (raw <svg> siblings here vs a <span> caret over on
    Support & Resources) — a couple of px of box height either way, and
    with it a ~1.5px vertical drift in the text's actual glyph position
    that no amount of matching font-size/line-height fixes, because
    those were never what differed. Wrapping the label text in a real
    element removes the ambiguity: it's now an ordinary flex item sized
    only by its own line-height, identically for every .itm-mega__top.
  {%- endcomment -%}
  .itm-mega__label{ display:inline-block; }
  .itm-mega__caret{ display:inline-flex; transition:transform .15s ease; }
  .itm-mega__caret svg{ width:11px; height:11px; }
  .itm-mega__item:hover > .itm-mega__top .itm-mega__caret,
  .itm-mega__item:focus-within > .itm-mega__top .itm-mega__caret{ transform:rotate(180deg); }

  /* ---- panels ---- */
  .itm-mega__panel{
    position:absolute;
    top:100%;
    z-index:50;
    background:#fff;
    /* the panel is always a light surface, so force dark text regardless of the
       header colour scheme (header foreground is white on the dark bar, which
       would otherwise render the links white-on-white / invisible) */
    color:#111;
    --color-foreground:17,17,17;
    box-shadow:0 16px 30px rgba(0,0,0,.12);
    border-top:1px solid rgba(0,0,0,.06);
    opacity:0;
    visibility:hidden;
    pointer-events:none;
    transition:opacity .15s ease, visibility .15s ease;
  }
  .itm-mega__item:hover > .itm-mega__panel,
  .itm-mega__item:focus-within > .itm-mega__panel{
    opacity:1;
    visibility:visible;
    pointer-events:auto;
  }

  /* full-width panels (columns + cards) span the nav bar width */
  .itm-mega__panel--columns,
  .itm-mega__panel--cards{ left:0; right:0; }
  .itm-mega__inner{ margin:0 auto; padding:32px 20px 40px; }
  .itm-mega__panel--columns .itm-mega__inner{ max-width:1100px; display:flex; gap:56px; justify-content:center; }
  .itm-mega__panel--cards .itm-mega__inner{
    max-width:1700px;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(170px, 1fr));
    gap:16px;
  }

  /* columns */
  .itm-mega__col{ min-width:150px; }
  .itm-mega__col-heading{
    margin:0 0 14px;
    font-weight:700;
    font-size:15px;
    color:rgb(var(--color-foreground, 17,17,17));
  }
  .itm-mega__links{ list-style:none; margin:0; padding:0; }
  .itm-mega__links li{ margin:0 0 12px; }
  .itm-mega__link{
    text-decoration:none;
    font-size:14px;
    color:rgba(var(--color-foreground, 17,17,17), .8);
    transition:color .15s ease;
  }
  .itm-mega__link:hover{ color:var(--mega-accent); }

  /* promo tile */
  .itm-mega__promo{
    position:relative;
    flex:0 0 280px;
    min-height:240px;
    border-radius:4px;
    overflow:hidden;
    display:flex;
    text-decoration:none;
    background:#222;
  }
  .itm-mega__promo-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .itm-mega__promo-body{
    position:relative;
    z-index:1;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    padding:20px;
    width:100%;
    background:linear-gradient(to top, rgba(0,0,0,.45), rgba(0,0,0,.05) 60%, transparent);
  }
  .itm-mega__promo-heading{ color:#fff; font-size:22px; font-weight:700; line-height:1.2; max-width:80%; }

  /* image cards */
  .itm-mega__card{
    position:relative;
    display:flex;
    min-height:230px;
    border-radius:2px;
    overflow:hidden;
    text-decoration:none;
    background:#222;
  }
  .itm-mega__card-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .itm-mega__card::after{
    content:'';
    position:absolute; inset:0;
    background:linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,.1) 55%, rgba(0,0,0,.15));
  }
  .itm-mega__card-label{
    position:absolute; top:14px; left:14px; z-index:1;
    color:#fff; font-size:17px; font-weight:700;
  }
  .itm-mega__card-btn{ position:absolute; left:14px; bottom:14px; z-index:1; }

  /* shared button */
  .itm-mega__btn{
    display:inline-block;
    background:var(--mega-accent);
    color:#111;
    font-weight:700;
    font-size:13px;
    letter-spacing:.06em;
    text-transform:uppercase;
    padding:11px 22px;
    border-radius:2px;
    align-self:flex-start;
  }

  /* simple dropdown */
  .itm-mega__panel--dropdown{ left:0; min-width:240px; }
  .itm-mega__panel--dropdown .itm-mega__inner{ padding:18px 26px; display:block; }
  .itm-mega__panel--dropdown .itm-mega__col-heading{ display:none; }
  .itm-mega__panel--dropdown .itm-mega__links li{ margin:0; }
  .itm-mega__panel--dropdown .itm-mega__link{
    display:block;
    padding:11px 0;
    font-weight:600;
    font-size:15px;
    color:rgb(var(--color-foreground, 17,17,17));
  }
  .itm-mega__panel--dropdown .itm-mega__link:hover{ color:var(--mega-accent); }

  /* The header section forces `.header__inline-menu a { color:#fff !important }`
     (white text on the dark bar). That rule also hits the panel's links, making
     them white-on-white on the light panel. Re-assert dark text with a more
     specific selector + !important so the links are actually visible. */
  .itm-mega__panel a.itm-mega__link{ color:#111 !important; }
  .itm-mega__panel a.itm-mega__link:hover{ color:var(--mega-accent) !important; }

  /* ==================================================================
     "Products": trigger stays inline in the bar. The panel + scrim are
     built here but get moved to a direct child of <body> by the script
     below, the instant the page loads — .header-wrapper permanently
     GPU-composites itself (transform:translateZ(0), see the comment
     above .header-wrapper in header.liquid — load-bearing for a border-
     rendering fix), which makes it the containing block for anything
     position:fixed underneath it. A fixed panel left inside it renders
     pinned to THAT box instead of the viewport (looks "trapped in the
     header"). Moving it out to <body> — which has no such transform —
     is what lets position:fixed anchor to the real viewport instead.
     ================================================================== */
  {%- assign trigger_text_color = section.settings.menu_bar_text_color | default: section.settings.header_text_color | default: '#ffffff' -%}
  {%- comment -%}
    Reset: it's a real <button> now (needed for click + aria-expanded),
    which means the theme's own `.header__inline-menu a { color:#fff
    !important }` rule (see the comment a little above this one) never
    reaches it — that rule only matches <a> tags. Browsers also give
    <button> its own default grey chrome (background/border/padding)
    that .itm-mega__top alone doesn't strip. Both fixed here explicitly.
  {%- endcomment -%}
  .itm-mega__products-trigger{
    display:inline-flex; align-items:center; gap:8px;
    -webkit-appearance:none; appearance:none;
    background:none !important; border:0; margin:0;
    /* border:0 above kills the invisible border-bottom:3px solid
       transparent that .itm-mega__top gives every other nav item (it's
       the red hover-underline's placeholder). Same selector specificity,
       declared later, so it wins outright here — leaving this button's
       box 3px SHORTER than its siblings'. Everything still measured
       identically (font-size, line-height, padding) because that's not
       where the 3px was: it's this missing border. With every item
       vertically centered as a group in the shared flex bar, that
       missing 3px at the bottom shifts THIS item's content down by half
       the gap relative to the others — the ~1.5px text offset. Restoring
       an invisible placeholder border of the same width fixes the box
       height without adding a visible line (Products doesn't hover-
       underline; it opens on click). */
    border-bottom:3px solid transparent;
    font-family:inherit; line-height:inherit; cursor:pointer;
    /* NOT font-size:inherit — .itm-mega__top (shared with every other nav
       item, including Support & Resources) already sets the correct size
       from the nav_font_size setting. Overriding it back to inherit here
       made this button render 2px larger than its sibling, which was
       exactly what threw the vertical alignment off between the two.
       line-height:inherit IS needed though: unlike the <a> Support &
       Resources uses, a <button> doesn't inherit line-height from its
       ancestors by default (form elements opt out of that) — it was
       silently falling back to the browser's own "normal", a few px
       taller than what everything else here actually resolves to. */
    font-weight:800; /* `font:inherit` here was quietly wiping out the
      bold weight .itm-mega__top otherwise gives every other nav item —
      set explicitly, and a touch bolder than the rest since Products is
      the primary trigger */
    color:{{ trigger_text_color }} !important;
    /* Padding-left/right only — top/bottom stay whatever .itm-mega__top's
       shorthand + the border-bottom fix above already resolve to, so this
       doesn't disturb the pixel-measured vertical alignment. Widening the
       button is what turns "Products" into its own visual block, and the
       divider <li> right after it (see .itm-mega__divider) rides the
       extra width along automatically since it's a normal flex sibling. */
    padding-left:14px; padding-right:14px;
    position:relative; /* positioning context for the ::before hover-cube below */
  }
  {%- comment -%}
    The hover highlight is a separate ::before, not a background on the
    button itself: the button's own box is only the bar's content height
    (46.6px), but nav.header__inline-menu wraps that bar in 6px of its own
    top/bottom padding to reach the full row height (58.6px) — that 6px is
    where "Lifetime Warranty" etc. sit below and the row's own edge sits
    above. Bunnings' hover cube fills that whole row, edge to edge, not
    just the text's own box, so this pseudo-element stretches past the
    button by that same 6px top and bottom via negative inset rather than
    touching the button's real box model (which the vertical-alignment fix
    above depends on staying exactly as measured).
  {%- endcomment -%}
  .itm-mega__products-trigger::before{
    content:'';
    position:absolute;
    top:-6px; bottom:-6px; left:0;
    /* right:0 alone stopped at the button's own padding edge, leaving the
       real .itm-mega__bar gap (confirmed live: ~21.6px) between the
       highlight and the divider completely unlit — that's what "not
       lighting up whole products box" was pointing at. Extending past the
       button's own edge by the bar's actual gap (the --mega-gap custom
       property above) reaches exactly the divider's near edge, so the
       highlight fills the entire block, edge to edge, with nothing left
       unlit in between. */
    right:calc(var(--mega-gap) * -1);
    background:transparent;
    transition:background-color .15s ease;
    pointer-events:none;
  }
  .itm-mega__products-trigger:hover::before,
  .itm-mega__products-trigger:focus-visible::before{
    background:color-mix(in srgb, var(--mega-accent) 10%, transparent);
  }
  .itm-mega__products-trigger .icon-hamburger,
  .itm-mega__products-trigger .icon-close{ color:{{ trigger_text_color }}; }
  .itm-mega__products-trigger .icon-hamburger{ display:block; }
  .itm-mega__products-trigger .icon-close{ display:none; }
  .itm-mega__products-trigger.is-open .icon-hamburger{ display:none; }
  .itm-mega__products-trigger.is-open .icon-close{ display:block; }
  .itm-mega__products-trigger svg{ width:18px; height:18px; }

  {%- comment -%}
    A real flex sibling, not a border/pseudo-element on the Products <li> —
    .itm-mega__bar's gap is a fluid clamp(), so a divider that's just
    another flex item gets the same gap spacing on both sides automatically
    and stays centered no matter what the clamp() currently resolves to.
  {%- endcomment -%}
  .itm-mega__divider{
    align-self:stretch;
    flex:0 0 auto;
    width:1px;
    /* align-self:stretch only fills the BAR's own height (46.6px, sized to
       the trigger button's content box) — the same 6px top/bottom the
       hover-cube above compensates for is missing here too, so pull it
       back out with a negative margin to reach the full 58.6px row. */
    margin:-6px 0;
    background:color-mix(in srgb, currentColor 20%, transparent);
  }

  {%- comment -%}
    popover="manual" (not <dialog>/showModal()): renders in the browser's
    "top layer", above every stacking context unconditionally — that's
    what escapes .header-wrapper's transform-containing-block trap.
    showModal() ALSO makes literally everything outside the dialog inert
    — including the header, and the Products trigger itself, which is
    why close-by-click stopped working there. A popover doesn't
    auto-block anything, so the header stays genuinely usable.

    ONE popover only — #itm-products-panel — not two coordinated ones.
    It spans the full remaining page area below the header; the scrim
    (dark, click-to-close) and the visible 360px column are both just
    ordinary children positioned inside it. Two independently-shown
    popovers turned out not to be reliable (the scrim one just never
    visibly took), and there's no real need for it to be its own
    popover — position:fixed doesn't require a child to stay inside its
    parent's own box, and both children ride along in the same top-layer
    promotion as their one popover parent regardless.
  {%- endcomment -%}
  [popover]#itm-products-panel{ margin:0; padding:0; border:0; }
  #itm-products-panel{
    max-width:none; max-height:none; overflow:visible;
    position:fixed;
    top:var(--itm-pd-header-h, 0px); left:0; right:0; bottom:0;
    width:auto; height:auto;
    background:none;
  }

  {%- comment -%}
    The scrim's actual position/size/colour all now live as an inline
    style="" on the element itself (see the markup below) — highest
    possible specificity, and independent fixed sizing rather than
    inset:0 against its parent's box. No opacity fade: the scrim's
    shown/hidden state is already fully handled by its popover parent's
    own native display:none <-> block toggle.
  {%- endcomment -%}

  .itm-products-panel__inner{
    position:absolute; top:0; left:0; bottom:0; z-index:2; /* above the scrim's z-index:1 */
    width:min(360px, 88vw); height:auto;
    background:#f4f4f4; color:#1a1a1a;
    box-shadow:24px 0 40px rgba(0,0,0,.2);
    transform:translateX(-100%);
    transition:transform .28s ease;
    display:flex; flex-direction:column;
    overscroll-behavior:contain; /* hovering the panel scrolls the panel, not the page */
  }

  .itm-products-panel__list{ list-style:none; margin:0; padding:6px 0; overflow-y:auto; flex:1 1 auto; }

  .itm-mega__products-row{
    display:flex; align-items:center; gap:14px;
    padding:12px 18px;
    text-decoration:none; color:#1a1a1a !important;
    border-bottom:1px solid rgba(0,0,0,.06);
  }
  .itm-mega__products-row:hover{ background:#ececec; color:var(--mega-accent) !important; }
  .itm-mega__products-icon{
    flex:0 0 auto; width:38px; height:38px; border-radius:11px;
    display:flex; align-items:center; justify-content:center;
    position:relative; overflow:hidden;
    background:linear-gradient(145deg, rgba(227,6,19,.16), rgba(227,6,19,.05));
  }
  .itm-mega__products-icon::before{
    content:''; position:absolute; inset:0;
    background:linear-gradient(135deg, rgba(255,255,255,.6) 0%, rgba(255,255,255,0) 45%);
  }
  .itm-mega__products-icon svg{ width:19px; height:19px; color:var(--mega-accent); position:relative; z-index:1; }
  .itm-mega__products-label{ flex:1 1 auto; min-width:0; font-size:14px; font-weight:600; }
  .itm-mega__products-arrow{ flex:0 0 auto; width:8px; height:8px; opacity:.4; }
  .itm-mega__products-arrow svg{ width:100%; height:100%; display:block; }
{%- endstyle -%}

<nav class="header__inline-menu itm-mega" aria-label="{{ 'sections.header.menu' | t | default: 'Primary' }}">
  <ul class="itm-mega__bar" role="list">
    {%- comment -%}
      "Products" — a single item, first in the SAME bar as everything
      else. Click (not hover) opens a full-height panel flush with the
      left edge of the viewport, with a page-dimming scrim — see the big
      comment above .itm-products-panel for why the panel gets relocated
      to <body> by the script at the bottom of this file.
    {%- endcomment -%}
    <li class="itm-mega__item itm-mega__item--products">
      <button
        type="button"
        id="itm-products-trigger"
        class="itm-mega__top itm-mega__products-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="itm-products-panel"
      >
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
        <span class="itm-mega__label">Products</span>
      </button>
    </li>
    <li class="itm-mega__divider" role="presentation" aria-hidden="true"></li>

    <div id="itm-products-panel" popover="manual" role="dialog" aria-label="Shop by category">
      {%- comment -%}
        No title bar / close button in here — closing happens the same
        way opening does, via the Products trigger itself (which is why
        it morphs to an X), same as Bunnings. Clicking the dimmed scrim
        also closes it — see the click listener in the script below.
      {%- endcomment -%}
      {%- comment -%}
        Inline style, deliberately, on top of the stylesheet rule of the
        same name — highest possible CSS specificity, short of !important
        on a competing rule (and nothing here has that). Whatever's been
        stopping the scrim from visibly painting, an inline background
        can't lose a cascade fight to it.
      {%- endcomment -%}
      {%- comment -%}
        Independent viewport-relative sizing (vw/vh, not inset:0 against
        the parent's own box) plus forced-color-adjust:none, in case
        either a containing-block edge case or a forced-colors/high-
        contrast mode is what's been quietly stripping this. JS syncs
        `top` the same way it already does for the panel itself.
      {%- endcomment -%}
      {%- comment -%}
        Root cause, finally confirmed by actually driving this in a real
        browser: base.css has a global reset — `div:empty { display:
        none; }` — and this scrim is a deliberately empty div (it's pure
        background colour, no content by design). Every other property
        (background, opacity, z-index, position) was correct the entire
        time; that one unrelated rule was just nullifying all of it via
        `display`, which nothing here had set to override it. Fixed by
        setting display explicitly.
      {%- endcomment -%}
      <div id="itm-products-scrim" style="display:block; position:fixed; top:0; left:0; width:100vw; height:100vh; background-color:rgba(17,17,17,.55); forced-color-adjust:none; z-index:1;"></div>
      <div class="itm-products-panel__inner">
      <ul class="itm-products-panel__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'mega_item' and block.settings.layout != 'dropdown' -%}
              {%- assign t = block.settings.title | downcase -%}
              {%- assign icon = icon_generic -%}
              {%- if t contains 'storage' -%}
                {%- assign icon = icon_storage -%}
              {%- elsif t contains 'kit' -%}
                {%- assign icon = icon_kits -%}
              {%- elsif t contains 'socket' -%}
                {%- assign icon = icon_sockets -%}
              {%- elsif t contains 'torque' -%}
                {%- assign icon = icon_torque -%}
              {%- elsif t contains 'spanner' or t contains 'wrench' -%}
                {%- assign icon = icon_spanners -%}
              {%- elsif t contains 'automotive' -%}
                {%- assign icon = icon_auto -%}
              {%- elsif t contains 'screwdriver' -%}
                {%- assign icon = icon_screwdrivers -%}
              {%- elsif t contains 'cutter' or t contains 'plier' -%}
                {%- assign icon = icon_cutters -%}
              {%- elsif t contains 'cutting' -%}
                {%- assign icon = icon_cutting -%}
              {%- elsif t contains 'hex' or t contains 'torx' -%}
                {%- assign icon = icon_hex -%}
              {%- elsif t contains 'measur' or t contains 'mark' -%}
                {%- assign icon = icon_measuring -%}
              {%- elsif t contains 'striking' -%}
                {%- assign icon = icon_striking -%}
              {%- elsif t contains 'hand tools' -%}
                {%- assign icon = icon_hand_tools -%}
              {%- elsif t contains 'air tools' -%}
                {%- assign icon = icon_air -%}
              {%- elsif t contains 'clamp' -%}
                {%- assign icon = icon_clamps -%}
              {%- elsif t contains 'bit' or t contains 'driver' -%}
                {%- assign icon = icon_bits -%}
              {%- elsif t contains 'vice' -%}
                {%- assign icon = icon_vices -%}
              {%- endif -%}
              <li>
                <a class="itm-mega__products-row" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                  <span class="itm-mega__products-icon" aria-hidden="true">{{ icon }}</span>
                  <span class="itm-mega__products-label">{{ block.settings.title }}</span>
                  <span class="itm-mega__products-arrow" aria-hidden="true">{{ pm_chevron }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
      </ul>
      </div>
    </div>

    <script>
      (function () {
        function init() {
          var trigger = document.getElementById('itm-products-trigger');
          var panel = document.getElementById('itm-products-panel');
          var scrim = document.getElementById('itm-products-scrim');
          var inner = panel && panel.querySelector('.itm-products-panel__inner');
          if (!trigger || !panel || !scrim || !inner) return;
          if (trigger.dataset.itmPdReady) return; /* don't wire up twice */
          trigger.dataset.itmPdReady = '1';

          if (typeof panel.showPopover !== 'function') {
            /* Ancient-browser fallback: without Popover API support there's
               nothing to open, so just let the trigger link through to the
               all-products page instead of doing nothing. */
            trigger.removeAttribute('aria-controls');
            return;
          }

          /* Relocate to <body> — see the big comment above the popover
             CSS rules in this file's <style> block for why: popover
             already renders in the browser's top layer (above everything,
             regardless of any ancestor's z-index or transform) once
             shown, but it still needs to not be a descendant of
             .header-wrapper for its OWN layout — .header-wrapper's
             transform would otherwise make it the containing block for
             `position:fixed` underneath it. */
          document.body.appendChild(panel);

          function headerHeight() {
            /* Sit below the nav/menu row (Products + Support & Resources
               live in it) but ABOVE the trust bar — i.e. the panel covers
               the trust bar rather than starting below it. The trigger's
               own closest .header__inline-menu ancestor IS that row, so
               there's no selector-guessing needed: whatever row it's
               actually rendered inside is definitionally the right one. */
            var navRow = trigger.closest('.header__inline-menu');
            if (navRow) return Math.round(navRow.getBoundingClientRect().bottom);

            /* Fallback, if the header markup ever changes shape enough
               that the trigger isn't inside .header__inline-menu anymore. */
            var candidates = ['.section-header', '.header-wrapper', '.header'];
            var bottom = 0;
            candidates.forEach(function (sel) {
              var el = document.querySelector(sel);
              if (el) bottom = Math.max(bottom, Math.round(el.getBoundingClientRect().bottom));
            });
            return bottom;
          }

          function positionBelowHeader() {
            var h = headerHeight() + 'px';
            document.documentElement.style.setProperty('--itm-pd-header-h', h);
            panel.style.top = h;
            scrim.style.top = h; /* scrim is independently position:fixed now, syncs itself */
          }

          function setTriggerOpen(open) {
            trigger.classList.toggle('is-open', open);
            trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          }

          var isOpen = false;

          function openMenu() {
            positionBelowHeader();
            panel.showPopover(); /* one popover; scrim + inner just ride along as its children */
            isOpen = true;
            setTriggerOpen(true);
            /* Lock the page (not the header — the header isn't part of
               body's own scroll, so this doesn't touch it) using the
               exact same class Dawn's own header-drawer.js already
               applies for its mobile menu (see HeaderDrawer in
               global.js) — reusing it instead of a one-off inline style
               keeps this consistent with how scroll-locking already
               works everywhere else in this theme. */
            document.body.classList.add('overflow-hidden-desktop');
            /* slide-in: start off-screen, then animate to 0 next frame */
            inner.style.transform = 'translateX(-100%)';
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                inner.style.transform = 'translateX(0)';
              });
            });
          }

          function closeMenu() {
            /* animate the slide-out first, then actually hidePopover()
               once the transition ends — hiding immediately would just
               vanish it with no animation. */
            isOpen = false;
            setTriggerOpen(false);
            document.body.classList.remove('overflow-hidden-desktop');
            inner.style.transform = 'translateX(-100%)';
            var done = false;
            function finish() {
              if (done) return;
              done = true;
              panel.hidePopover();
            }
            inner.addEventListener('transitionend', finish, { once: true });
            setTimeout(finish, 350); /* fallback if transitionend never fires */
          }

          trigger.addEventListener('click', function (e) {
            e.preventDefault();
            if (isOpen) {
              closeMenu();
            } else {
              openMenu();
            }
          });

          /* Clicking outside the visible 360px column — anywhere in the
             popover that isn't the inner panel or one of its descendants
             — closes it. Listening on the popover root itself (not just
             the scrim) so this still works even if some other element
             ever ends up covering part of the scrim. */
          panel.addEventListener('click', function (e) {
            if (!inner.contains(e.target)) closeMenu();
          });

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && isOpen) closeMenu();
          });

          window.addEventListener('resize', function () {
            if (isOpen) positionBelowHeader();
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    {%- assign panel_open = false -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'mega_item' -%}
          {%- if panel_open -%}</div></div></li>{%- assign panel_open = false -%}{%- endif -%}
          {%- assign lay = block.settings.layout -%}
          {%- comment -%}
            "cards" and "link" layout items are already listed inside the
            "Products" item above; only "dropdown" items (e.g. Support &
            Resources) still render here as a plain top-level nav link.
          {%- endcomment -%}
          {%- if lay == 'cards' or lay == 'link' -%}
            {%- comment -%} skipped — already listed in the Products panel {%- endcomment -%}
          {%- else -%}
            <li class="itm-mega__item itm-mega__item--{{ lay }}" {{ block.shopify_attributes }}>
              <a class="itm-mega__top" href="{{ block.settings.link | default: '#' }}" aria-haspopup="true">
                <span class="itm-mega__label">{{ block.settings.title }}</span>
                <span class="itm-mega__caret" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </a>
              <div class="itm-mega__panel itm-mega__panel--{{ lay }}">
                <div class="itm-mega__inner">
            {%- assign panel_open = true -%}
          {%- endif -%}

        {%- when 'mega_column' -%}
          {%- if panel_open -%}
            <div class="itm-mega__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="itm-mega__col-heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="itm-mega__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a class="itm-mega__link" href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'mega_promo' -%}
          {%- if panel_open -%}
            <a class="itm-mega__promo" href="{{ block.settings.button_link | default: '#' }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'itm-mega__promo-img', alt: block.settings.heading }}
              {%- elsif block.settings.image_url != blank -%}
                <img class="itm-mega__promo-img" src="{{ block.settings.image_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
              {%- endif -%}
              <span class="itm-mega__promo-body">
                {%- if block.settings.heading != blank -%}<span class="itm-mega__promo-heading">{{ block.settings.heading }}</span>{%- endif -%}
                {%- if block.settings.button_label != blank -%}<span class="itm-mega__btn">{{ block.settings.button_label }}</span>{%- endif -%}
              </span>
            </a>
          {%- endif -%}

        {%- when 'mega_card' -%}
          {%- if panel_open -%}
            <a class="itm-mega__card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'itm-mega__card-img', alt: block.settings.label }}
              {%- elsif block.settings.image_url != blank -%}
                <img class="itm-mega__card-img" src="{{ block.settings.image_url }}" alt="{{ block.settings.label | escape }}" loading="lazy">
              {%- endif -%}
              {%- if block.settings.label != blank -%}<span class="itm-mega__card-label">{{ block.settings.label }}</span>{%- endif -%}
              {%- if block.settings.button_label != blank -%}<span class="itm-mega__btn itm-mega__card-btn">{{ block.settings.button_label }}</span>{%- endif -%}
            </a>
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}
    {%- if panel_open -%}</div></div></li>{%- endif -%}
  </ul>
</nav>
