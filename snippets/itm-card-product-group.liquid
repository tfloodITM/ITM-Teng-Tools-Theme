{%- comment -%}
  MACC-style card for product-group collections.
  Renders using the sbc__card structure to match itm-card-product-sbc visually.

  Params:
    - group_collection (Collection) – required
{%- endcomment -%}

{%- assign coll = group_collection -%}

{%- assign is_product_group = false -%}
{%- if coll.metafields.custom.product_group -%}
  {%- assign pg_val = coll.metafields.custom.product_group.value | default: coll.metafields.custom.product_group -%}
  {%- if pg_val == true or pg_val == 'true' or pg_val == 1 or pg_val == '1' -%}
    {%- assign is_product_group = true -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  primary_product_ref (a direct product_reference metafield on the GROUP
  collection itself) is the source of truth NetSuite writes — cleaner and
  cheaper than scanning every product in the collection for a boolean flag.
  The old scan stays as a fallback for any group collection that predates
  that metafield, then finally just the first product, so a group is never
  left with no image at all.
{%- endcomment -%}
{%- assign primary_product = coll.metafields.custom.primary_product_ref.value -%}
{%- if primary_product == blank -%}
  {%- for p in coll.products -%}
    {%- if p.metafields.custom.primary_product -%}
      {%- assign prim_val = p.metafields.custom.primary_product.value | default: p.metafields.custom.primary_product -%}
      {%- if prim_val == true or prim_val == 'true' or prim_val == 1 or prim_val == '1' -%}
        {%- assign primary_product = p -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if primary_product == blank and coll.products.first -%}
  {%- assign primary_product = coll.products.first -%}
{%- endif -%}

{%- assign primary_variant = nil -%}
{%- if primary_product -%}
  {%- assign primary_variant = primary_product.selected_or_first_available_variant -%}
{%- endif -%}

<div class="sbc__img-wrap">
  <a class="sbc__card-img-link" href="{{ coll.url }}">
    <div class="sbc__card-img">
      {%- comment -%}
        resolved_image / resolved_product are worked out by the caller
        (itm-collection-grid.liquid), walking down through
        product_group_children when this hub has neither an image nor
        products of its own — done there, not in a nested snippet, because
        Liquid's metafield resolution on a referenced object stopped being
        reliable a couple of render levels deep. Falls back to this card's
        own coll/primary_product (the shallow, no-walk case) if the caller
        didn't pass anything, so this snippet still works standalone.
      {%- endcomment -%}
      {%- assign img_source = resolved_image | default: coll.image -%}
      {%- assign img_product = resolved_product | default: primary_product -%}
      {%- if img_source -%}
        <div class="sbc__slide is-active">
          {{ img_source | image_url: width: 600 | image_tag: loading: 'lazy', alt: coll.title }}
        </div>
      {%- elsif img_product.featured_image -%}
        <div class="sbc__slide is-active">
          {{ img_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: img_product.title }}
        </div>
      {%- elsif img_product -%}
        {%- comment -%}
          Last resort for the rare product with no Shopify image uploaded
          at all — guesses a path on ITM's own CDN from its SKU.
        {%- endcomment -%}
        {%- assign group_sku = img_product.selected_or_first_available_variant.sku | default: img_product.title | strip -%}
        <div class="sbc__slide is-active">
          <img
            src="{% render 'itm-cdn-product-image', sku: group_sku, image_number: 1 %}"
            data-cdn-fallback-src="{{ 'image_coming_soon.png' | asset_url }}"
            alt="{{ img_product.title | escape }}"
            width="600"
            height="600"
            loading="lazy"
          >
        </div>
      {%- else -%}
        <div class="sbc__slide is-active">
          <img src="{{ 'image_coming_soon.png' | asset_url }}" alt="{{ coll.title | escape }}" width="600" height="600" loading="lazy">
        </div>
      {%- endif -%}
    </div>
  </a>
</div>

<div class="sbc__actions">
  <a href="{{ coll.url }}" class="sbc__atc">
    Shop Range
    <svg class="sbc__atc-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
  </a>
</div>

<a class="sbc__card-band" href="{{ coll.url }}">
  <div class="sbc__card-body">
    <div class="sbc__rating">
      <span class="sbc__review-count" style="text-transform:uppercase;letter-spacing:0.04em;">Product Category</span>
    </div>
    <p class="sbc__card-title">{{ coll.title }}</p>
    {%- if is_product_group and primary_variant and primary_variant.price > 0 -%}
      <p class="sbc__card-price">From {{ primary_variant.price | money }}</p>
    {%- endif -%}
  </div>
</a>
