{%- liquid
  assign icon = ''
  if icon_title contains 'storage'
    assign icon = icon_storage
  elsif icon_title contains 'kit'
    assign icon = icon_kits
  elsif icon_title contains 'socket'
    assign icon = icon_sockets
  elsif icon_title contains 'torque'
    assign icon = icon_torque
  elsif icon_title contains 'spanner' or icon_title contains 'wrench'
    assign icon = icon_spanners
  elsif icon_title contains 'automotive'
    assign icon = icon_auto
  elsif icon_title contains 'screwdriver'
    assign icon = icon_screwdrivers
  elsif icon_title contains 'cutter' or icon_title contains 'plier'
    assign icon = icon_cutters
  elsif icon_title contains 'cutting'
    assign icon = icon_cutting
  elsif icon_title contains 'hex' or icon_title contains 'torx'
    assign icon = icon_hex
  elsif icon_title contains 'measur' or icon_title contains 'mark'
    assign icon = icon_measuring
  elsif icon_title contains 'striking'
    assign icon = icon_striking
  elsif icon_title contains 'hand tools'
    assign icon = icon_hand_tools
  elsif icon_title contains 'air tools'
    assign icon = icon_air
  elsif icon_title contains 'clamp'
    assign icon = icon_clamps
  elsif icon_title contains 'bit' or icon_title contains 'driver'
    assign icon = icon_bits
  elsif icon_title contains 'vice'
    assign icon = icon_vices
  else
    assign icon = icon_generic
  endif
-%}
{{- icon -}}
