{%- style -%}
  .itm-pm{ position:relative; z-index:5; }

  .itm-pm__trigger{
    display:inline-flex;
    align-items:center;
    gap:8px;
    border:0;
    background:none;
    padding:{{ section.settings.nav_padding_y | default: 8 }}px 0;
    font-weight:700;
    font-size:{{ section.settings.nav_font_size | default: 15 }}px;
    letter-spacing:.01em;
    color:inherit;
    cursor:pointer;
    list-style:none;
  }
  .itm-pm__trigger::-webkit-details-marker{ display:none; }
  .itm-pm__trigger svg{ width:20px; height:20px; flex:none; }

  .itm-pm__scrim{
    position:fixed; inset:0; background:rgba(17,17,17,.45);
    opacity:0; pointer-events:none; transition:opacity .2s ease; z-index:190;
  }
  .itm-pm details[open] ~ .itm-pm__scrim{ opacity:1; pointer-events:auto; }

  .itm-pm__panel{
    position:fixed; top:0; left:0; bottom:0;
    width:min(380px, 88vw);
    background:#f4f4f4;
    color:#1a1a1a;
    box-shadow:24px 0 40px rgba(0,0,0,.18);
    transform:translateX(-100%);
    transition:transform .28s ease;
    z-index:200;
    display:flex;
    flex-direction:column;
  }
  .itm-pm details[open] .itm-pm__panel{ transform:translateX(0); }

  .itm-pm__head{
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 20px; background:#1a1a1a; color:#fff; flex:none;
  }
  .itm-pm__head strong{ font-size:16px; letter-spacing:.02em; }
  .itm-pm__close{ background:none; border:0; cursor:pointer; padding:6px; line-height:0; color:#fff; }
  .itm-pm__close svg{ width:18px; height:18px; }

  .itm-pm__list{ list-style:none; margin:0; padding:6px 0; overflow-y:auto; flex:1 1 auto; }

  .itm-pm-row{
    display:flex;
    align-items:center;
    gap:14px;
    width:100%;
    padding:11px 18px;
    border-bottom:1px solid rgba(0,0,0,.06);
    text-decoration:none;
    color:#1a1a1a;
  }
  .itm-pm-row:hover{ background:#ececec; }
  .itm-pm-icon{
    flex:0 0 auto;
    width:38px; height:38px;
    border-radius:11px;
    display:flex; align-items:center; justify-content:center;
    position:relative; overflow:hidden;
    background:linear-gradient(145deg, rgba(227,6,19,.16), rgba(227,6,19,.05));
  }
  .itm-pm-icon::before{
    content:''; position:absolute; inset:0;
    background:linear-gradient(135deg, rgba(255,255,255,.6) 0%, rgba(255,255,255,0) 45%);
    pointer-events:none;
  }
  .itm-pm-icon svg{ width:20px; height:20px; color:{{ accent }}; position:relative; z-index:1; }
  .itm-pm-label{ flex:1 1 auto; min-width:0; font-size:14px; font-weight:600; line-height:1.2; }
  .itm-pm-arrow{ flex:0 0 auto; width:8px; height:8px; opacity:.4; }
  .itm-pm-arrow svg{ width:100%; height:100%; display:block; }

  @media (max-width: 989px){
    .itm-pm{ display:none; } /* mobile keeps the standard slide-out drawer instead */
  }
{%- endstyle -%}

<div class="itm-pm">
  <details id="itm-pm-details">
    <summary class="itm-pm__trigger" aria-label="Shop by category">
      {{- 'icon-hamburger.svg' | inline_asset_content -}}
      Products
    </summary>

    <div class="itm-pm__panel">
      <div class="itm-pm__head">
        <strong>Products</strong>
        <button type="button" class="itm-pm__close" onclick="document.getElementById('itm-pm-details').removeAttribute('open')" aria-label="Close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      <ul class="itm-pm__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_item' and block.settings.layout != 'dropdown' -%}
            {%- assign t = block.settings.title | downcase -%}
            {%- assign icon = icon_generic -%}
            {%- if t contains 'storage' -%}
              {%- assign icon = icon_storage -%}
            {%- elsif t contains 'kit' -%}
              {%- assign icon = icon_kits -%}
            {%- elsif t contains 'socket' -%}
              {%- assign icon = icon_sockets -%}
            {%- elsif t contains 'torque' -%}
              {%- assign icon = icon_torque -%}
            {%- elsif t contains 'spanner' or t contains 'wrench' -%}
              {%- assign icon = icon_spanners -%}
            {%- elsif t contains 'automotive' -%}
              {%- assign icon = icon_auto -%}
            {%- elsif t contains 'screwdriver' -%}
              {%- assign icon = icon_screwdrivers -%}
            {%- elsif t contains 'cutter' or t contains 'plier' -%}
              {%- assign icon = icon_cutters -%}
            {%- elsif t contains 'cutting' -%}
              {%- assign icon = icon_cutting -%}
            {%- elsif t contains 'hex' or t contains 'torx' -%}
              {%- assign icon = icon_hex -%}
            {%- elsif t contains 'measur' or t contains 'mark' -%}
              {%- assign icon = icon_measuring -%}
            {%- elsif t contains 'striking' -%}
              {%- assign icon = icon_striking -%}
            {%- elsif t contains 'hand tools' -%}
              {%- assign icon = icon_hand_tools -%}
            {%- elsif t contains 'air tools' -%}
              {%- assign icon = icon_air -%}
            {%- elsif t contains 'clamp' -%}
              {%- assign icon = icon_clamps -%}
            {%- elsif t contains 'bit' or t contains 'driver' -%}
              {%- assign icon = icon_bits -%}
            {%- elsif t contains 'vice' -%}
              {%- assign icon = icon_vices -%}
            {%- endif -%}
            <li>
              <a class="itm-pm-row" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="itm-pm-icon" aria-hidden="true">{{ icon }}</span>
                <span class="itm-pm-label">{{ block.settings.title }}</span>
                <span class="itm-pm-arrow" aria-hidden="true">{{ pm_chevron }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </details>
  <div class="itm-pm__scrim" onclick="document.getElementById('itm-pm-details').removeAttribute('open')"></div>
</div>
