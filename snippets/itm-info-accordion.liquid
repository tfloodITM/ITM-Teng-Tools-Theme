{%- comment -%}
  ITM info accordion (Features / Specifications style, shared)
  -----------------------------------------------------------
  Params:
    product    (Product)  required
    heading    (string)   accordion title
    source     (string)   'metafield' (default) or 'richtext'
    metafield  (string)   'namespace.key' used when source = metafield (e.g. custom.web_features)
    content    (richtext) used when source = richtext
    open       (boolean)  open by default
    table      (boolean)  render as an Attribute/Value table instead of raw
                          HTML — for spec-style metafields, which are raw
                          NetSuite HTML ("<li>Label: value</li>" pairs), not
                          real prose. Parsed via the shared itm-spec-parser
                          snippet (same parser the sortable product-group
                          table already uses) so this logic exists in one
                          place. Ignored when source = richtext, since that
                          content is genuine prose, not label/value pairs.
{%- endcomment -%}
{%- liquid
  assign acc_value = ''
  if source == 'richtext'
    assign acc_value = content
  else
    assign mf_parts = metafield | default: '' | split: '.'
    assign mf_ns = mf_parts[0]
    assign mf_key = mf_parts[1]
    if mf_ns != blank and mf_key != blank
      assign acc_value = product.metafields[mf_ns][mf_key]
    endif
  endif
  assign acc_check = acc_value | strip_html | strip

  assign acc_pairs = ''
  if table and source != 'richtext' and acc_check != ''
    comment
      append: '' forces acc_value (a metafield object, not yet a plain
      string) to stringify here — it already auto-stringifies fine on
      direct output ({{ acc_value }} below), but itm-spec-parser needs to
      run Liquid's split filter on it, which expects a real string rather
      than relying on the same implicit conversion.
    endcomment
    assign acc_value_str = acc_value | append: ''
    capture acc_pairs
      render 'itm-spec-parser', raw_html: acc_value_str
    endcapture
    assign acc_pairs = acc_pairs | strip
  endif
-%}
{%- if heading != blank and acc_check != '' -%}
  <div class="product__accordion accordion quick-add-hidden itm-info-accordion">
    <details{% if open %} open{% endif %}>
      <summary>
        <div class="summary__title">
          <h2 class="accordion__title itm-acc-title">{{ heading | escape }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte itm-acc-content">
        {%- if acc_pairs != '' -%}
          <table class="itm-spec-table">
            <thead>
              <tr>
                <th>Attribute</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              {%- for pair in acc_pairs | split: ';;' -%}
                {%- unless pair == blank -%}
                  {%- assign spec_label = pair | split: '=' | first -%}
                  {%- assign spec_value = pair | remove_first: spec_label | remove_first: '=' -%}
                  <tr>
                    <td>{{ spec_label }}</td>
                    <td>{{ spec_value }}</td>
                  </tr>
                {%- endunless -%}
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          {{ acc_value }}
        {%- endif -%}
      </div>
    </details>
  </div>
{%- endif -%}

<style>
  .itm-spec-table {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    border-collapse: collapse;
    font-size: 14px;
  }
  .itm-spec-table th,
  .itm-spec-table td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }
  .itm-spec-table th {
    font-weight: 700;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.2);
  }
  .itm-spec-table tbody tr:nth-child(odd) {
    background: rgba(var(--color-foreground), 0.035);
  }
</style>
