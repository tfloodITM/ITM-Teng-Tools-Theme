{%- comment -%}
  ITM info accordion (Features / Specifications / Warranty style, shared)
  -------------------------------------------------------------------
  Params:
    product    (Product)  required
    heading    (string)   accordion title
    source     (string)   'metafield' (default) or 'richtext'
    metafield  (string)   'namespace.key' used when source = metafield (e.g. custom.web_features)
    content    (richtext) used when source = richtext
    open       (boolean)  open by default
    table      (boolean)  render as an Attribute/Value table instead of raw
                          HTML — for spec-style metafields, which are raw
                          NetSuite HTML ("<li>Label: value</li>" pairs), not
                          real prose. Rendered via the shared itm-spec-table
                          snippet (same one sections/itm-product-html-section.liquid
                          uses for its own Specifications block) so this
                          logic exists in one place. Ignored when
                          source = richtext, since that content is genuine
                          prose, not label/value pairs.
    icon       (string)   optional leading icon before the title. Only
                          'question' is defined right now (a plain circled
                          "?", used for the Warranty accordion) — left as a
                          string rather than a plain boolean so more icons
                          can be added here later without a new param.
{%- endcomment -%}
{%- liquid
  assign acc_value = ''
  if source == 'richtext'
    assign acc_value = content
  else
    assign mf_parts = metafield | default: '' | split: '.'
    assign mf_ns = mf_parts[0]
    assign mf_key = mf_parts[1]
    if mf_ns != blank and mf_key != blank
      assign acc_value = product.metafields[mf_ns][mf_key]
    endif
  endif
  assign acc_check = acc_value | strip_html | strip

  assign acc_table_html = ''
  if table and source != 'richtext' and acc_check != ''
    capture acc_table_html
      render 'itm-spec-table', raw_html: acc_value
    endcapture
    assign acc_table_html = acc_table_html | strip
  endif
-%}
{%- if heading != blank and acc_check != '' -%}
  <div class="product__accordion accordion quick-add-hidden itm-info-accordion">
    <details{% if open %} open{% endif %}>
      <summary>
        <div class="summary__title">
          {%- if icon == 'question' -%}
            <span class="itm-acc-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9.5 9a2.5 2.5 0 0 1 4.9.8c0 1.7-2.4 2-2.4 3.7"/>
                <line x1="12" y1="17.2" x2="12" y2="17.2"/>
              </svg>
            </span>
          {%- endif -%}
          <h2 class="accordion__title itm-acc-title">{{ heading | escape }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte itm-acc-content">
        {%- if acc_table_html != '' -%}
          {{ acc_table_html }}
        {%- else -%}
          {{ acc_value }}
        {%- endif -%}
      </div>
    </details>
  </div>
{%- endif -%}

{%- comment -%}
  Scoped to .itm-info-accordion specifically — .summary__title is a shared
  Dawn class also used by the cart drawer and elsewhere, so an unscoped
  rule here would leak into every accordion on the site, not just this one.
{%- endcomment -%}
<style>
  .itm-info-accordion .summary__title { display: flex; align-items: center; gap: 10px; }
  .itm-acc-icon { flex: 0 0 auto; display: inline-flex; }
  .itm-acc-icon svg { width: 20px; height: 20px; display: block; }
</style>
